# Cloudflare Pages headers.
# Portable brand embeds are loaded cross-origin from other projects, so they
# need permissive CORS (module scripts are fetched in CORS mode, and so are
# their relative imports — e.g. om-diamond.js → brand-colors.js).
/embeds/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, must-revalidate

# Design tokens, generated from src/tokens/ at build (see prebuild). Served so
# any project can fetch or <link> the canonical CSS without cloning the repo.
/tokens/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, must-revalidate
