{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "name": "OpenMined v2 tokens",
  "version": "2025.10",
  "description": "Resolves the v2 tokens for a mode. The base set is the same in every mode; the theme modifier adds the mode's hues, gradient, shadows and roles.",
  "sets": {
    "base": {
      "description": "Same in every mode: gray, white, black, hue keys, chart series, corner radius, line widths, type, spacing, motion, stacking, page layout, interaction states.",
      "sources": [
        {
          "$ref": "base/gray.json"
        },
        {
          "$ref": "base/keys.json"
        },
        {
          "$ref": "base/radius.json"
        },
        {
          "$ref": "base/stroke.json"
        },
        {
          "$ref": "base/type.json"
        },
        {
          "$ref": "base/space.json"
        },
        {
          "$ref": "base/motion.json"
        },
        {
          "$ref": "base/layer.json"
        },
        {
          "$ref": "base/layout.json"
        },
        {
          "$ref": "base/state.json"
        }
      ]
    }
  },
  "modifiers": {
    "theme": {
      "description": "Color mode",
      "contexts": {
        "light": [
          {
            "$ref": "light/hues.json"
          },
          {
            "$ref": "light/gradient.json"
          },
          {
            "$ref": "light/shadows.json"
          },
          {
            "$ref": "light/roles.json"
          }
        ],
        "dark": [
          {
            "$ref": "dark/hues.json"
          },
          {
            "$ref": "dark/gradient.json"
          },
          {
            "$ref": "dark/shadows.json"
          },
          {
            "$ref": "dark/roles.json"
          }
        ]
      },
      "default": "light"
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/base"
    },
    {
      "$ref": "#/modifiers/theme"
    }
  ]
}
