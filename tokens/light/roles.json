    },
    "muted": {
      "$value": "{gray.500}",
      "$description": "Captions, labels.",
      "$extensions": {
        "org.openmined": {
          "status": "released"
        }
      }
    }
  },
  "on-key": {
    "$type": "color",
    "$value": "{white}",
    "$description": "Text or icon on any key: every hue and status, both modes.",
    "$extensions": {
      "org.openmined": {
