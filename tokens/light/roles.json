{
  "$description": "Hand-written roles, light mode. Each role points at a primitive. Status: `working` is the current direction; `exploring` is a placeholder or an option still being compared.",
  "surface": {
    "$type": "color",
    "sunken": {
      "$value": "{gray.200}",
      "$description": "A well set into a surface (\u22121). Never a page or section ground.",
      "$extensions": {
        "org.openmined": {
          "status": "working"
        }
      }
    },
    "base": {
      "$value": "{gray.100}",
      "$description": "The page background (0).",
      "$extensions": {
        "org.openmined": {
          "status": "working"
        }
      }
    },
    "raise-1": {
      "$value": "{gray.50}",
      "$description": "A panel on the page (+1).",
      "$extensions": {
        "org.openmined": {
          "status": "working"
        }
      }
    },
    "raise-2": {
      "$value": "{white}",
      "$description": "Raised more (+2): cards over panels, menus, popovers.",
      "$extensions": {
        "org.openmined": {
          "status": "working"
        }
      }
    }
  },
  "line": {
    "$type": "color",
    "$root": {
      "$value": "{gray.300}",
      "$description": "Dividers: a single edge between two things. One step darker than the sunken level, so it shows there too.",
      "$extensions": {
        "org.openmined": {
          "status": "working"
        }
      }
    },
    "strong": {
      "$value": "{gray.600}",
      "$description": "The line style: outlines, the secondary button's outline, link underlines. The same gray step as text.body, so every drawn line matches; never a container.",
      "$extensions": {
        "org.openmined": {
          "status": "working"
        }
      }
    },
    "focus": {
      "$value": "{gray.500}",
      "$description": "The focus line on form controls: a field's edge on focus, 1px outside a checkbox, radio or toggle. Reaches 3:1 on every surface and the field's fill (gray-500 in light, gray-400 in dark).",
      "$extensions": {
        "org.openmined": {
          "status": "working"
        }
      }
    }
  },
