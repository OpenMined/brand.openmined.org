{
  "$description": "Hand-written roles, dark mode. Each role points at a primitive. Status: `working` is the current direction; `exploring` is a placeholder or an option still being compared.",
  "surface": {
    "$type": "color",
    "sunken": {
      "$value": "{gray.950}",
      "$description": "A well set into a surface (−1). Never a page or section ground.",
      "$extensions": {
        "org.openmined": {
          "status": "released"
        }
      }
    },
    "base": {
      "$value": "{gray.900}",
      "$description": "The page background (0).",
      "$extensions": {
        "org.openmined": {
          "status": "released"
        }
      }
    },
    "raise-1": {
      "$value": "{gray.800}",
      "$description": "A panel on the page (+1).",
      "$extensions": {
        "org.openmined": {
          "status": "released"
        }
      }
    },
    "raise-2": {
      "$value": "{gray.700}",
      "$description": "Raised more (+2): cards over panels, menus, popovers.",
      "$extensions": {
        "org.openmined": {
          "status": "released"
        }
      }
    }
  },
  "line": {
    "$type": "color",
    "$root": {
      "$value": "{gray.600}",
      "$description": "Dividers: a single edge between two things.",
      "$extensions": {
        "org.openmined": {
          "status": "released"
        }
      }
    },
    "strong": {
      "$value": "{gray.200}",
      "$description": "The line style: outlines, the secondary button's outline, link underlines. The same gray step as text.body, so every drawn line matches; never a container.",
      "$extensions": {
        "org.openmined": {
          "status": "released"
        }
      }
    },
    "focus": {
      "$value": "{gray.400}",
      "$description": "The focus line on form controls: a field's edge on focus, 1px outside a checkbox, radio or toggle. Reaches 3:1 on every surface and the field's fill (gray-500 in light, gray-400 in dark).",
      "$extensions": {
        "org.openmined": {
          "status": "released"
        }
      }
    }
  },
