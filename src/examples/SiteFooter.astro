---
/** Example partial: a site footer, locked dark in both modes (data-section). A
 *  pattern for the full-page examples, not a component. */
const COLS: [string, string[]][] = [['Learn more', ['Foundation', 'Blog', 'Careers']], ['Solutions', ['Syft Space', 'SyftHub', 'PySyft']], ['Programs', ['Research', 'Fellowships', 'Courses']]];
---
<footer class="sf page-band" data-section="always-dark">
  <div class="container sf__in">
    <div class="sf__cols">
      {COLS.map(([h, items]) => <div><p class="sf__h">{h}</p><ul>{items.map(i => <li><a class="link-text" href="#"><span class="link-text__label">{i}</span></a></li>)}</ul></div>)}
    </div>
    <div class="sf__cta">
      <p class="h4">Support the mission</p>
      <p>Our vision for the future is ambitious. Here is how you can help.</p>
      <div class="sf__actions"><a class="btn btn--solid" href="#">Get involved</a><a class="btn" href="#">Donate</a></div>
    </div>
  </div>
  <div class="container sf__base text-small"><img src="/logos/OpenMined-Icon.svg" alt="" width="20" height="20" /> © 2026 OpenMined Foundation</div>
</footer>
<style is:inline>
  .sf { padding-block: var(--spacing-5xl) var(--spacing-2xl); }
  .sf__in { display: grid; grid-template-columns: 2fr 1fr; gap: var(--spacing-4xl); }
  .sf__cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--spacing-2xl); }
  .sf__h { margin: 0 0 var(--spacing-md); font-weight: var(--font-weight-semibold); color: var(--text-headline); }
  .sf ul { display: grid; gap: var(--spacing-xs); margin: 0; padding: 0; list-style: none; }
  .sf__cta p { margin: 0 0 var(--spacing-md); }
  .sf__actions { display: flex; gap: var(--spacing-md); }
  .sf__base { display: flex; align-items: center; gap: var(--spacing-sm); margin-top: var(--spacing-4xl); padding-top: var(--spacing-lg); border-top: var(--stroke-sm) solid var(--line); color: var(--text-muted); }
  @media (max-width: 991px) { .sf__in { grid-template-columns: 1fr; } }
</style>
