---
/**
 * HomePressRoom — "Press Room" card grid of outbound press links + a
 * "Keep Exploring" CTA. Page-specific (home content); drop the Home prefix if a
 * second page reuses it.
 *
 * Rebuilt from live #brxe-e88833 (+ the live "Keep Exploring" mini-section
 * #brxe-1254b5, folded in here). Measured off the live page.
 *
 * Press items are section-local content (not registry data): each references an
 * org by `id` for the logo; the headline is local (it's the press outlet's
 * headline, not our post title). Items link to our own blog by `post` (public
 * slug, validated at build via `@utils/posts → postHref`) so the URL stays
 * relative and in sync with the post; `href` is only for genuinely external
 * destinations, which LogoCard opens in a new tab.
 *
 * Cards are `always-light` (per design): logos always sit on a light surface,
 * so each renders in its natural color (no theme flip) and dark text stays
 * legible in both page themes.
 *
 * Live → token mapping:
 *   section margin-block   154/60px (mobile 100/50) → --spacing-full (standardized rhythm)
 *   heading "Press Room"   Rubik 27px               → h4 default
 *   divider                1px line                 → --border-color; mt --spacing-S, mb --spacing-3XL
 *   grid                   auto-fill minmax(310px)  → same; gap --spacing-XL (20px ✓)
 *   card padding           48/24/18px               → 5XL / 2XL / L
 *   card min-height        310px                    → raw (no token)
 *   card radius            6px                      → --border-radius-S
 *   card shadow            0 24 48 -8 …             → --shadow-lg (exact ✓)
 *   card bg                #fff                     → --surface-background-default (always-light)
 *   headline               Inter 14px/500/21        → 14px / 500 / 1.5
 *   keep-exploring heading Rubik 27px, centered     → h4; mb --spacing-2XL
 */
import LogoCard from '../../elements/LogoCard.astro';
import Button from '../../ui/Button.astro';
import Text from '../../ui/Text.astro';
// PORT (page reviews): organizations from JSON; post links go to the live blog (no posts collection here).
import ORGS from '../../../data/organizations.json';
const postHref = (_posts: unknown, slug: string) => `https://openmined.org/blog/${slug}/`;

type PressItem = { orgId: string; title: string } & ({ post: string } | { href: string });

const press: PressItem[] = [
  { orgId: 'deepmind', post: 'double-blind-evaluation-frontier-ai-model', title: 'Piloting the world’s first double-blind AI evaluations' },
  { orgId: 'anthropic', post: 'secure-enclaves-for-ai-evaluation', title: 'Secure Enclaves for AI Evaluation' },
  { orgId: 'aisi', post: 'uk-frontier-ai-taskforce-partners-with-openmined-to-advance-ai-safety-research', title: 'Frontier AI Taskforce: second progress report' },
  { orgId: 'royal-society', post: 'from-privacy-to-partnership-the-royal-society-makes-the-case-for-pets-powered-collaboration', title: 'From privacy to partnership: The role of PETs in data governance and collaborative analysis' },
  { orgId: 'uk-dsit', post: 'pysyft-featured-in-uk-dsit-portfolio-of-ai-assurance-techniques', title: 'Privacy-preserving third-party audits on Unreleased Digital Assets with PySyft' },
  { orgId: 'us-nist', post: 'openmined-deepmined-announced-as-a-winner-in-the-uk-us-pets-prize-challenge', title: 'Winners Announced in First Phase of UK-US PETs Prize Challenges' },
  { orgId: 'us-white-house', post: 'openmined-participates-in-white-house-event-on-opportunities-at-the-frontier-of-ai-research', title: 'OSTP-NSF-PCAST Event on Opportunities at the AI Research Frontier' },
  { orgId: 'us-senate', post: 'openmineds-contributions-to-ai-transparency-and-explainability-in-u-s-senate-ai-policy-roadmap', title: 'Driving US Innovation in AI: A Roadmap for AI Policy in the US Senate' },
  { orgId: 'us-executive-office', post: 'pysyft-recognized-in-the-us-national-strategy-to-advance-privacy-preserving-data-sharing-and-analytics', title: 'National Strategy to Advance Privacy-Preserving Data Sharing and Analytics' },
  { orgId: 'us-nsf', post: 'openmined-joins-as-launch-partner-for-the-nairr-pilot-democratizing-access-to-ai-resources-in-the-us', title: 'Democratizing the future of AI R&D: NSF to launch National AI Research Resource pilot' },
  { orgId: 'us-census', post: 'bridging-borders-protecting-privacy-how-pysyft-is-revolutionizing-international-statistical-collaboration', title: 'A New Model for International, Privacy-Preserving Data Science' },
  { orgId: 'us-ntia', href: 'https://www.ntia.gov/sites/default/files/publications/ntia-ai-report-final.pdf', title: 'AI Accountability Policy Report' },
  { orgId: 'christchurch-call', post: 'new-research-shows-promise-for-safe-secure-private-auditing-of-social-media-algorithms', title: 'Christchurch Call Initiative on Algorithmic Outcomes' },
  { orgId: 'microsoft', post: 'openmined-partners-with-microsoft-to-advance-privacy-preserving-ai-research-for-the-christchurch-call', title: 'Expanding our commitments to countering violent extremism online' },
  { orgId: 'x', post: 'announcing-our-partnership-with-twitter-to-advance-algorithmic-transparency', title: 'Investing in privacy enhancing tech to advance transparency in ML' },
  { orgId: 'reddit', post: 'announcing-our-partnership-with-reddit-to-expand-privacy-preserving-researcher-access', title: 'Introducing a New Subreddit for Researchers' },
  { orgId: 'meta', post: 'facebook-partners-with-openmined-to-advance-privacy-preserving-ai', title: 'Privacy and Machine Learning Courses' },
  { orgId: 'google', post: 'announcing-pipelinedp-an-api-for-applying-differential-privacy-in-production', title: 'Partnering with Google to make differential privacy more widely accessible' },
  { orgId: 'pytorch', post: 'openmined-and-pytorch-join-forces-to-advance-privacy-preserving-machine-learning', title: 'OpenMined and PyTorch partner to launch fellowship funding for privacy-preserving ML community' },
  { orgId: 'un-big-data', post: 'syft-featured-in-guide-on-pets-in-official-statistics', title: 'The PET Guide' },
  { orgId: 'technologists-public-good', post: 'facilitating-access-to-non-public-data-a-world-in-which-all-data-is-open', title: 'Facilitating Access to Non-Public Data: A World in Which All Data is “Open”' },
  { orgId: 'stanford-ssir', post: 'openmined-recognized-in-stanford-social-innovation-review-for-advancing-ai-transparency', title: 'Reimagining Our High-Tech World' },
];

const orgById = Object.fromEntries(ORGS.map(o => [o.id, o]));

// Same draft filter as the blog routes, so a link can't outrun its post.
const posts = null;

// Resolve each item's org; drop any that don't resolve (defensive). Post
// references resolve through postHref, which throws on an unknown slug.
const cards = press
  .map((item) => ({
    ...item,
    org: orgById[item.orgId],
    href: 'post' in item ? postHref(posts, item.post) : item.href,
  }))
  .filter((c) => c.org !== undefined);
---

<section class="press">
  <div class="container">
    <Text as="h4" class="press__heading">Press Room</Text>
    <div class="press__divider" role="presentation"></div>

    <div class="press__grid">
      {cards.map((c) => (
        <LogoCard org={c.org!} href={c.href} title={c.title} />
      ))}
    </div>

    <div class="press__explore">
      <Text as="h4" class="press__explore-heading">Keep Exploring</Text>
      <Button href="/blog/">Read the latest updates</Button>
    </div>
  </div>
</section>

<style>
  /* Live section margin is 154px top / 60px bottom — above the spacing scale
     (max --spacing-full 88px). Standardized to --spacing-full for consistent
     home-section vertical rhythm (approved). */
  .press {
    margin-block: var(--spacing-full);
  }

  .press__heading {
    margin-bottom: 0;
  }

  .press__divider {
    border-top: var(--border-strong);
    margin-top: var(--spacing-S);     /* live: 8px ✓ */
    margin-bottom: var(--spacing-3XL); /* live: 32px ✓ */
  }

  .press__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
    gap: var(--spacing-XL); /* live: 20px ✓ — 290px track holds the live 4-up
                               inside .container's padded width with margin to
                               spare (300px sat exactly on the wrap threshold) */
  }

  /* Card anatomy lives in @elements/LogoCard (shared with for-ai-auditors). */

  .press__explore {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-top: var(--spacing-full); /* live keep-exploring section gap */
  }
  .press__explore-heading {
    margin-bottom: var(--spacing-2XL); /* live: 24px ✓ */
  }

  @media (max-width: 991px) {
    .press {
      margin-block: var(--spacing-5XL); /* live mobile: 50px → 48 */
    }
  }
</style>
