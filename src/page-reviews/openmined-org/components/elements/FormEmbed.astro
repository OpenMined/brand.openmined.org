---
/**
 * PORT (page reviews) — replaces openmined.org's FormEmbed, which loads the real
 * HubSpot form (and could submit to the CRM). Here the form is a static mock in
 * HubSpot's embed markup, so the site's own hubspot-form.css styles it exactly as
 * on live. Fields come from the forms' public definitions, fetched 2026-10-09 into
 * data/forms.json (visible fields only). Submitting does nothing.
 * Approximations: fields with no label render none (the placeholder is the
 * label, as on live), and the fieldset reset below stands in for the minimal
 * CSS HubSpot's embed script injects.
 */
import FORMS from '../../data/forms.json';

interface Props {
  formId: string;
  portalId?: string;
  region?: string;
  fullWidth?: boolean;
  class?: string;
}
const { formId, fullWidth = true, class: extra } = Astro.props;
const form = (FORMS as Record<string, { submit: string; groups: { name: string; type: string; label: string; placeholder: string; required: boolean }[][] }>)[formId];
if (!form) throw new Error(`FormEmbed mock: no snapshot for form ${formId}`);
const classes = ['hs-form-embed', fullWidth && 'form-button-fullwidth', extra].filter(Boolean).join(' ');
---
<div class={classes} data-form-id={formId} data-hs-ready="true">
  <div class="hbspt-form">
    <form class="hs-form stacked hs-form-private" novalidate onsubmit="return false">
      {form.groups.map((g) => (
        <fieldset class={`form-columns-${g.length}`}>
          {g.map((f) => (
            f.type === 'booleancheckbox' ? (
              <div class={`hs_${f.name} hs-${f.name} hs-fieldtype-booleancheckbox field hs-form-field`}>
                <div class="input">
                  <ul class="inputs-list" role="checkbox">
                    <li class="hs-form-booleancheckbox">
                      <label class="hs-form-booleancheckbox-display">
                        <input class="hs-input" type="checkbox" name={f.name} value="true" />
                        <span>{f.label}</span>
                      </label>
                    </li>
                  </ul>
                </div>
              </div>
            ) : (
              <div class={`hs_${f.name} hs-${f.name} hs-fieldtype-${f.type} field hs-form-field`}>
                {f.label && (
                  <label for={`${formId}-${f.name}`}>
                    <span>{f.label}</span>{f.required && <span class="hs-form-required">*</span>}
                  </label>
                )}
                <div class="input">
                  {f.type === 'textarea'
                    ? <textarea id={`${formId}-${f.name}`} class="hs-input" name={f.name} placeholder={f.placeholder} aria-label={f.placeholder}></textarea>
                    : <input id={`${formId}-${f.name}`} class="hs-input" type={f.name === 'email' ? 'email' : 'text'} name={f.name} placeholder={f.placeholder} aria-label={f.placeholder} />}
                </div>
              </div>
            )
          ))}
        </fieldset>
      ))}
      <div class="hs_submit hs-submit">
        <div class="actions">
          <input type="submit" class="hs-button primary large" value={form.submit} />
        </div>
      </div>
    </form>
  </div>
</div>

<style is:global>
  .hs-form-embed .hs-form fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
</style>
