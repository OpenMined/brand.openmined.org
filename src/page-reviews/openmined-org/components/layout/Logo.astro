---
interface Props {
  class?: string;
  alt?: string;
}
const { class: className = '', alt = 'OpenMined' } = Astro.props;
---

<span class:list={['logo', className]}>
  <img src="/logos/OpenMined-Logo.svg" alt={alt} class="logo-color" />
  <img src="/logos/OpenMined-Logo-Dark.svg" alt={alt} class="logo-white" />
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
  }
  /* Visibility swap (.logo-color/.logo-white) is handled globally by theme. */
  .logo img {
    height: var(--logo-height, 28px);
    width: auto;
  }
</style>
