---
/**
 * PORT (page reviews) — openmined.org Base.astro, cut down for the brand site.
 * Removed: Seo, JsonLd, Analytics, the Astro Fonts API (Astro 7; this repo is on 4
 * — Google Fonts link instead), DonateModal, SearchModal, the Ionicons loader and
 * the HubSpot form loader (forms render as static mocks, see FormEmbed.astro).
 * CSS imports moved out to the review shells (src/page-reviews/Live.astro / V2.astro),
 * so the live and v2 routes can load different stylesheets over the same markup.
 * Kept verbatim: theme init + toggle, image fade-in, scroll reveal, tabs, card tilt.
 */
import ReviewHead from '../../ReviewHead.astro';
import ReviewBar from '../../ReviewBar.astro';
import V2Pass from '../../v2/V2Pass.astro';
interface Props { title?: string; description?: string; }
const { title = "OpenMined" } = Astro.props;
// Set by the review route (src/pages/page-reviews/…): which page, which system.
const review = (Astro.locals as any).review as { page: 'home' | 'syfthub'; system: 'live' | 'v2' };
---
<!DOCTYPE html>
<html lang="en" data-system={review.system}>
  <head>
    <script is:inline>
      // Mark JS available so CSS can pre-hide fade-in images (`.js img[data-fade]`).
      // Set here, before stylesheets, so images that fade never flash unhidden.
      document.documentElement.classList.add('js');

      const stored = localStorage.getItem('theme');
      const system = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.setAttribute('data-theme',
        stored ?? (system ? 'dark' : 'light'));
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" href="/logos/OpenMined-Icon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,100..900;1,100..900&family=Rubik:wght@300..900&family=Sometype+Mono:wght@400..700&display=swap" rel="stylesheet" />
    <ReviewHead system={review.system} />
  </head>
  <body>
    <slot />
    <ReviewBar page={review.page} system={review.system} />
    {review.system === 'v2' && <V2Pass />}

    <!-- Theme toggle handler — wires any .js-switch-theme button on the page -->
    <script>
      const syncSwitches = () => {
        const dark = document.documentElement.getAttribute('data-theme') === 'dark';
        document
          .querySelectorAll('.js-switch-theme[role="switch"]')
          .forEach((el) => el.setAttribute('aria-checked', String(dark)));
      };

      document.addEventListener('click', (e: MouseEvent) => {
        const target = e.target as HTMLElement;
        if (target.closest('.js-switch-theme')) {
          const html = document.documentElement;
          const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          html.setAttribute('data-theme', next);
          localStorage.setItem('theme', next);
        }
      });

      // Reflect the page theme onto every switch's aria-checked — role="switch"
      // requires it (WCAG 4.1.2). Observing data-theme covers ANY theme change
      // (click here, or a future system / cross-tab sync) from one place, so no
      // toggle can drift out of sync regardless of which ones are on the page.
      new MutationObserver(syncSwitches).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
      syncSwitches();
    </script>

    <script is:inline>
      // Load-in fade — reveals each `[data-fade]` element once it's ready, then
      // it fades in (paired with the `.js [data-fade]` rule in global.css). Two
      // modes by tag:
      //   • <img> → reveal when THAT file finishes loading, tracked per-file.
      //   • other → reveal on page load (deferred to after first paint).
      // Either way the reveal is deferred to a post-paint frame (double rAF) when
      // the element is already ready, so the fade starts from a painted opacity:0
      // and is actually seen — revealing during parse lets the 0.4s fade finish
      // before first paint (which is blocked on the render-blocking font CSS), so
      // it'd be invisible. `is:inline` so it runs on parse without the bundle.
      (function () {
        function reveal(el) { el.classList.add('is-loaded'); }
        function revealNextPaint(el) {
          requestAnimationFrame(function () { requestAnimationFrame(function () { reveal(el); }); });
        }
        function watch(el) {
          if (el.__omFadeWatched || el.classList.contains('is-loaded')) return;
          el.__omFadeWatched = true;
          // Non-<img> (no load event) or an already-loaded img → fade on page load.
          if (el.tagName !== 'IMG' || (el.complete && el.naturalWidth > 0)) {
            revealNextPaint(el);
            return;
          }
          var done = function () { reveal(el); }; // load fires after paint → already visible
          el.addEventListener('load', done, { once: true });
          el.addEventListener('error', done, { once: true }); // never leave a broken img invisible
        }
        function scan(root) {
          root.querySelectorAll('[data-fade]').forEach(watch);
        }
        scan(document);
        // Re-scan on Astro view transitions (harmless if never fired).
        document.addEventListener('astro:page-load', function () { scan(document); });
        // Catch elements injected after load — e.g. blog infinite-scroll appends
        // cards (BlogPagination.astro) long after this initial scan.
        if ('MutationObserver' in window) {
          new MutationObserver(function (mutations) {
            mutations.forEach(function (m) {
              m.addedNodes.forEach(function (node) {
                if (node.nodeType !== 1) return; // elements only
                if (node.matches && node.matches('[data-fade]')) watch(node);
                if (node.querySelectorAll) scan(node);
              });
            });
          }).observe(document.body, { childList: true, subtree: true });
        }
      })();
    </script>

    <script is:inline>
      // Scroll reveal — adds `.is-revealed` (once) to each `[data-reveal]` when
      // it first enters the viewport (paired with `.js [data-reveal]` in
      // global.css; opt-in, sibling of the load-in fade above). Elements
      // already in the first viewport reveal immediately on the IO's first
      // callback, so nothing above the fold waits for a scroll. No
      // IntersectionObserver (or reduced motion) → reveal everything now.
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('is-revealed'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            var d = e.target.getAttribute('data-reveal-delay');
            if (d) e.target.style.setProperty('--reveal-delay', d + 'ms');
            e.target.classList.add('is-revealed');
            io.unobserve(e.target);
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>


    <script>
      // Tabs initializer — wires any `[data-tabs]` group anywhere on the page:
      // the @elements/Tabs.astro component AND raw-HTML tabs hand-authored in
      // blog `.md` bodies (WordPress easy-tabs). Lives in Base so both surfaces
      // share one implementation (styling is global in global.css → `.tabs`).
      // Progressive enhancement: panels render visible without JS; this hides
      // inactive ones and adds ARIA tab semantics + arrow-key nav.
      function initTabs(root: HTMLElement) {
        const base = root.dataset.base || 'tabs';
        const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
        const panelHost = root.querySelector<HTMLElement>('.tabs__panels');
        if (!panelHost || tabs.length === 0) return;
        const panels = Array.from(panelHost.children) as HTMLElement[];

        panels.forEach((panel, i) => {
          panel.id = `${base}-panel-${i}`;
          panel.setAttribute('role', 'tabpanel');
          panel.setAttribute('aria-labelledby', `${base}-tab-${i}`);
          panel.setAttribute('tabindex', '0');
        });

        const select = (index: number, focus = false) => {
          tabs.forEach((tab, i) => {
            const active = i === index;
            tab.setAttribute('aria-selected', active ? 'true' : 'false');
            tab.tabIndex = active ? 0 : -1;
            if (active && focus) tab.focus();
          });
          panels.forEach((panel, i) => { panel.hidden = i !== index; });
        };

        select(Number(root.dataset.initial) || 0);

        tabs.forEach((tab, i) => {
          tab.addEventListener('click', () => select(i, true));
          tab.addEventListener('keydown', (e) => {
            let next = -1;
            if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
            else if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
            else if (e.key === 'Home') next = 0;
            else if (e.key === 'End') next = tabs.length - 1;
            if (next >= 0) { e.preventDefault(); select(next, true); }
          });
        });
      }
      document.querySelectorAll<HTMLElement>('[data-tabs]').forEach(initTabs);
    </script>

    <script>
      // Card tilt — supplies the pointer-driven half of `.card-float` (global.css).
      // The look lives entirely in CSS; this only writes two angles per frame.
      //
      // Delegated from the document ON PURPOSE, rather than initialising each card
      // (the vanilla-tilt approach): the blog listing appends cards on scroll, so a
      // per-element init would need a MutationObserver to catch them. One listener
      // that resolves `.card-float` by closest() covers cards that don't exist yet.
      const tiltOK =
        window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (tiltOK) {
        let active: HTMLElement | null = null;
        let latest: PointerEvent | null = null;
        let queued = false;

        // Drop every property this script set, so the card falls back to the CSS
        // defaults: 0deg tilt, and the slow ease-out settle for the release.
        const release = (card: HTMLElement) => {
          card.style.removeProperty('--card-tilt-x');
          card.style.removeProperty('--card-tilt-y');
          card.style.removeProperty('--card-tilt-transition');
        };

        const paint = () => {
          queued = false;
          const e = latest;
          if (!e) return;
          const card =
            e.target instanceof Element ? e.target.closest<HTMLElement>('.card-float') : null;

          if (card !== active) {
            if (active) release(active);
            active = card;
          }
          if (!card) return;

          const r = card.getBoundingClientRect();
          if (!r.width || !r.height) return;

          // Pointer position within the card, -1 (left/top) … 1 (right/bottom).
          const nx = ((e.clientX - r.left) / r.width) * 2 - 1;
          const ny = ((e.clientY - r.top) / r.height) * 2 - 1;
          const cs = getComputedStyle(card);
          const max = parseFloat(cs.getPropertyValue('--card-tilt-max')) || 0;
          if (!max) return; // --card-tilt-max: 0deg — lift only, tilt opted out

          // PORT: the tilt is set as a distortion, not an angle, so cards of any
          // size read alike. At full pointer travel the near edge looks
          // --card-tilt-keystone % longer than the far edge on a 320px card; the
          // target eases off as cards grow (× (size / 320) ^ --card-tilt-falloff,
          // size = the longer side), since a large card's same percentage covers
          // more pixels. Each axis then takes the angle that gives that keystone
          // at its own length under the fixed perspective, so a wide card rocks
          // as much up-down as left-right. --card-tilt-max caps thin cards.
          const persp = parseFloat(cs.getPropertyValue('--card-tilt-perspective')) || 1000;
          const k = ((parseFloat(cs.getPropertyValue('--card-tilt-keystone')) || 0) / 100) *
            (Math.max(r.width, r.height) / 320) ** (parseFloat(cs.getPropertyValue('--card-tilt-falloff')) || 0);
          // Edges at ±len/2 under rotation a: keystone = len·sin a / (persp − len/2·sin a).
          const angle = (len: number) => Math.min(max, (Math.asin(Math.min(1, (2 * k * persp) / (len * (2 + k)))) * 180) / Math.PI);

          // Signs make the card press AWAY under the cursor: rotateY(+) sends the
          // right edge back, rotateX(+) brings the bottom forward. Negate both to
          // flip it to leaning toward the pointer instead.
          card.style.setProperty('--card-tilt-y', `${(nx * angle(r.width)).toFixed(2)}deg`);
          card.style.setProperty('--card-tilt-x', `${(-ny * angle(r.height)).toFixed(2)}deg`);
          // Swap the transition to the fast track only while actually tracking.
          card.style.setProperty('--card-tilt-transition', 'var(--card-tilt-track)');
        };

        // rAF-coalesced: pointermove fires far more often than the screen repaints,
        // and each paint() does a layout read (getBoundingClientRect).
        document.addEventListener(
          'pointermove',
          (e) => {
            latest = e;
            if (!queued) {
              queued = true;
              requestAnimationFrame(paint);
            }
          },
          { passive: true },
        );

        // The pointer leaving the window fires no further move events, so clear the
        // last card here. (Angles left on a card that is no longer hovered are inert
        // — the transform is :hover-gated — but re-entering on the same card would
        // show the stale lean for a frame before the first move lands.)
        document.addEventListener('pointerleave', () => {
          if (active) release(active);
          active = null;
        });
      }
    </script>
  </body>
</html>