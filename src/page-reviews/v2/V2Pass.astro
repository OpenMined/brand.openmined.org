---
/**
 * PAGE REVIEWS — the v2 pass's markup changes, made at runtime so the port
 * stays as it is. Rendered by the ported Base.astro on v2 routes only.
 *  - A gradient map (<om-mesh>, the brand embed, in the Graphics page's setting)
 *    behind each call-to-action that used the live raster. Its colors are
 *    --gradient-map's stops, re-read when the mode changes.
 *  - Color and interaction (motion.css; buttons via src/scripts/button-hover.ts). Icons
 *    take a set hue with a blurred copy behind: those inside
 *    [data-color-icons] in order (green, amber, red, blue), and any element
 *    marked data-icon-hue="<hue>" with that hue; hover cards' icons color on the
 *    card's hover (the card's data-hover-hue, or the next of a set order).
 */
import { listStops, twoToneStops } from '../../lib/tokens';
const stops = listStops('map');
// Each hue's two-tone gradient, as its stop tokens (mode-aware: --gradient-two-tone-<hue>-base …).
const twoTone = Object.fromEntries(['red', 'amber', 'green', 'teal', 'blue', 'violet'].map(h => [h, twoToneStops(h)]));
---
<script type="module" src="/embeds/om-mesh.js" is:inline></script>
<script is:inline define:vars={{ stops }}>
  document.querySelectorAll('.cta--gradient, .cta--subtle').forEach((cta) => {
    const m = document.createElement('om-mesh');
    Object.entries({ 'aria-hidden': 'true', mode: 'clouds', speed: '1', drift: '0.15', flow: '0.11', edge: '0', size: '0.8', cover: '4', soft: '0.65', billow: '1', opacity: '0.6', saturation: '1.1' })
      .forEach(([k, v]) => m.setAttribute(k, v));
    cta.prepend(m);
  });
  const h = document.documentElement;
  const sync = () => {
    const cs = getComputedStyle(h);
    const read = (v) => cs.getPropertyValue(`--${v}`).trim();
    document.querySelectorAll('.cta > om-mesh').forEach((el) => {
      el.setAttribute('colors', stops.split(',').map(read).join(','));
      el.setAttribute('haze', read('surface-base'));
    });
  };
  sync();
  new MutationObserver(sync).observe(h, { attributes: true, attributeFilter: ['data-theme'] });
</script>
<script>
  import { buttonHover } from '../../scripts/button-hover';
  // Only on v2 routes (the port's seams can render it elsewhere).
  if (document.documentElement.dataset.system === 'v2') buttonHover();
</script>
<script is:inline define:vars={{ twoTone }}>
  (() => {
    // A light that eases toward the pointer each frame, so it trails a little.
    const follow = (el) => {
      let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
      const step = () => {
        x += (tx - x) * 0.15; y += (ty - y) * 0.15;
        el.style.setProperty('--mx', `${x}px`); el.style.setProperty('--my', `${y}px`);
        raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(step) : 0;
      };
      el.addEventListener('pointerenter', (e) => { const r = el.getBoundingClientRect(); x = tx = e.clientX - r.left; y = ty = e.clientY - r.top; step(); });
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect(); tx = e.clientX - r.left; ty = e.clientY - r.top;
        if (!raf) raf = requestAnimationFrame(step);
      });
    };
    // Hover cards: the same pointer light, in grayscale (motion.css).
    document.querySelectorAll('.card-float').forEach((card) => {
      card.classList.add('has-light');
      card.insertAdjacentHTML('beforeend', '<span class="card-light" aria-hidden="true"></span>');
      follow(card);
    });

    // Icons in a set hue: the hue's two-tone gradient token (its companion set per
    // hue in tools/palette/inputs.json), bottom left → top right, repeating every
    // 96 units of the 24 grid (2× the earlier 48, so the band never fits inside
    // the icon), slid one period per 8s. The line and its blurred copy share it.
    const ORDER = ['green', 'amber', 'red', 'blue'];
    const targets = [];
    document.querySelectorAll('[data-color-icons]').forEach((g) =>
      g.querySelectorAll('span.icon').forEach((el, i) => targets.push([el, ORDER[i % ORDER.length]])));
    document.querySelectorAll('[data-icon-hue]').forEach((el) => targets.push([el, el.dataset.iconHue]));
    // Hover cards with an icon: colored only on hover. The card may name its hue
    // (data-hover-hue on the card); otherwise the next of HOVER, in page order.
    const HOVER = ['amber', 'blue', 'green', 'teal', 'violet', 'red'];
    const hoverIcons = [];
    document.querySelectorAll('.card-float').forEach((card) => {
      const el = card.querySelector('span.icon');
      if (el && el.querySelector('svg')) hoverIcons.push([el, card.dataset.hoverHue || HOVER[hoverIcons.length % HOVER.length]]);
    });
    if (!targets.length && !hoverIcons.length) return;
    // Stops 1 and 3 (the lighter and darker shades) mix back toward the base by --ci-keep
    // (motion.css); the key and the companion stay as the token has them.
    const stop = (h, i) => {
      const k = twoTone[h][0], v = `var(--${twoTone[h][i]})`;
      return i === 1 || i === 3 ? `color-mix(in oklch, var(--${k}) var(--ci-keep), ${v})` : v;
    };
    const grad = (h) => `<linearGradient id="ci-${h}" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="96" y2="0" spreadMethod="repeat" gradientTransform="rotate(-45 12 12)">${[0, 1, 2, 3, 4].map((i) => `<stop offset="${i / 4}" style="stop-color:${stop(h, i)}"/>`).join('')}<animateTransform attributeName="gradientTransform" type="translate" from="0 0" to="96 0" dur="8s" repeatCount="indefinite" additive="sum"/></linearGradient>`;
    const hues = [...new Set([...targets, ...hoverIcons].map(([, h]) => h))];
    document.body.insertAdjacentHTML('beforeend', `<svg class="color-icon-defs" width="0" height="0" aria-hidden="true" focusable="false"><defs>${hues.map(grad).join('')}</defs></svg>`);
    targets.forEach(([el, h]) => {
      const svg = el.querySelector('svg');
      if (!svg) return;
      el.classList.add('color-icon');
      el.dataset.hue = h;
      el.style.setProperty('--ci-stroke', `url(#ci-${h})`);
      const glow = document.createElement('span');
      glow.className = 'color-icon__glow';
      glow.setAttribute('aria-hidden', 'true');
      glow.append(svg.cloneNode(true));
      el.prepend(glow);
    });
    // Hover icons: the mono drawing stays; a colored copy and its glow sit over and
    // under it and fade in on the card's hover (a stroke can't fade from a color
    // to a gradient, so the two are separate layers).
    hoverIcons.forEach(([el, h]) => {
      const svg = el.querySelector('svg');
      el.classList.add('hover-icon');
      el.style.setProperty('--ci-stroke', `url(#ci-${h})`);
      const layer = (cls) => { const s = document.createElement('span'); s.className = cls; s.setAttribute('aria-hidden', 'true'); s.append(svg.cloneNode(true)); return s; };
      el.prepend(layer('hover-icon__glow'));
      el.append(layer('hover-icon__color'));
    });
    // SMIL ignores prefers-reduced-motion; pause it by hand.
    const defs = document.querySelector('.color-icon-defs'), rm = matchMedia('(prefers-reduced-motion: reduce)');
    const sync = () => (rm.matches ? defs.pauseAnimations() : defs.unpauseAnimations());
    sync(); rm.addEventListener('change', sync);
  })();
</script>
