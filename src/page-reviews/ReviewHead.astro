---
/**
 * PAGE REVIEWS — head of a review route (rendered by the ported Base.astro).
 * On v2 routes, hands the two
 * WebGL graphics their colors from the v2 tokens (see the PORT SEAM comments in
 * DiamondEmbed / StreamEmbed): the same stops the live site uses, read from the
 * v2 gradient. A getter, so the tokens are read when the graphic boots, after
 * the stylesheet has loaded.
 */
import type { System } from './reviews';
interface Props { system: System }
const { system } = Astro.props;
---
<script is:inline define:vars={{ system }}>
  if (system === 'v2') {
    const read = (n) => getComputedStyle(document.documentElement).getPropertyValue(`--${n}`).trim();
    Object.defineProperty(window, 'OM_REVIEW_COLORS', {
      configurable: true,
      get: () => ({
        // Diamond: the live nine-stop spectrum, stop for stop.
        diamond: ['gold', 'orange', 'red', 'violet', 'blue', 'teal', 'green', 'lime', 'yellow'].map((s) => read(`gradient-${s}`)),
        // Colorflow: the live six stops, which are v2's flow gradient.
        stream: ['red', 'gold', 'violet', 'blue', 'teal', 'green'].map((s) => read(`gradient-${s}`)),
        label: read('gray-800'),
        labelDark: read('gray-50'),
      }),
    });
  }
</script>
