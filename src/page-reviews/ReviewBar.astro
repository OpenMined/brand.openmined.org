---
/**
 * PAGE REVIEWS — the floating review bar on every review route (rendered by
 * the ported Base.astro). Switches page and links back to the review notes on
 * the brand site.
 *
 * Options (a popover above the bar): switches for trying the Color and
 * interaction round's options on the page. Button hover sets data-btn-hover on
 * <html> (v2/button-options.ts, BUTTON_HOVERS); icon speed sets
 * data-icon-speed (seconds per loop, src/lib/icon-speed.ts; v2/V2Pass.astro reads
 * it). Picks are remembered in this browser across review pages; ?buttons=<key>
 * and ?iconspeed=<s> in the URL set them. Card light sets data-card-light
 * (v2/motion.css; ?cardlight=shade|light|none). Card colorflow sets data-card-flow
 * (src/scripts/gl/card-flow.ts; ?cardflow=off|ribbon|ribbon-wave), and its speed
 * data-flow-speed (?flowspeed=1|2).
 * More sections can be added to OPTIONS later.
 *
 * Also points the ported page's own links somewhere sensible: links to a page
 * under review stay in the review (same system); every other site link goes
 * to openmined.org.
 */
import { PAGES, routeFor, type PageKey, type System } from './reviews';
import { BUTTON_HOVERS } from './v2/button-options';
import { ICON_SPEEDS, ICON_SPEED_DEFAULT } from '../lib/icon-speed';
interface Props { page: PageKey; system: System }
const { page, system } = Astro.props;
const reviewed = Object.fromEntries(PAGES.map((p) => [new URL(p.live).pathname, routeFor(p.key)]));
// Each section: a URL parameter, the <html> attribute it sets, its choices and
// the default (the working favorite).
const OPTIONS = [
  { param: 'buttons', attr: 'data-btn-hover', label: 'Button hover', def: 'j', choices: BUTTON_HOVERS.map(({ key, label }) => ({ key, label })) },
  { param: 'iconspeed', attr: 'data-icon-speed', label: 'Icon speed', def: String(ICON_SPEED_DEFAULT), choices: ICON_SPEEDS.map((t) => ({ key: String(t), label: `${t}s per loop` })) },
  { param: 'cardflow', attr: 'data-card-flow', label: 'Card colorflow', def: 'ribbon-wave', choices: [
    { key: 'off', label: 'None' },
    { key: 'ribbon', label: 'Ribbon, mild wave' },
    { key: 'ribbon-wave', label: 'Ribbon, strong wave' },
  ] },
  { param: 'flowspeed', attr: 'data-flow-speed', label: 'Card colorflow speed', def: '1', choices: [
    { key: '1', label: '1× (the flow’s own pace)' },
    { key: '2', label: '2× (twice as fast)' },
  ] },
  { param: 'cardlight', attr: 'data-card-light', label: 'Card light', def: 'shade', choices: [
    { key: 'shade', label: 'Shade away from the pointer, clear at it (light mode; dark keeps the white light)' },
    { key: 'light', label: 'White light at the pointer' },
    { key: 'none', label: 'No pointer light' },
  ] },
];
---
<nav class="rv" aria-label="Page review" data-section="always-dark">
  <a class="rv__home" href={`/page-reviews/#${page}`} title="Review notes on the brand site">Page review</a>
  <span class="rv__sep" aria-hidden="true"></span>
  {PAGES.map((p) => (
    <a class="rv__opt" href={routeFor(p.key)} aria-current={p.key === page ? 'page' : undefined}>{p.label}</a>
  ))}
  <span class="rv__sep" aria-hidden="true"></span>
  <button type="button" class="rv__opt rv__btn" popovertarget="rv-options">Options</button>
</nav>
<div id="rv-options" class="rv-pop" popover data-section="always-dark" aria-label="Review options">
  {OPTIONS.map((o) => (
    <fieldset class="rv-pop__set">
      <legend>{o.label}</legend>
      {o.choices.map((c) => (
        <label class="rv-pop__choice">
          <input type="radio" name={o.param} value={c.key} data-attr={o.attr} checked={c.key === o.def} />
          <span>{c.label}{c.key === o.def && <span class="rv-pop__fav"> · working favorite</span>}</span>
        </label>
      ))}
    </fieldset>
  ))}
</div>

<script is:inline define:vars={{ OPTIONS }}>
  // Options: URL parameter, then this browser's last pick, then the default.
  // Only a clicked choice is saved, so a fresh load follows the defaults as they
  // change; the key is versioned so picks saved before that rule are dropped.
  (() => {
    const KEY = 'page-review-options-2';
    let saved = {};
    try { localStorage.removeItem('page-review-options'); saved = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch {}
    const q = new URLSearchParams(location.search);
    const h = document.documentElement;
    OPTIONS.forEach((o) => {
      const keys = o.choices.map((c) => c.key);
      const pick = [q.get(o.param), saved[o.param]].find((v) => keys.includes(v)) || o.def;
      h.setAttribute(o.attr, pick);
      document.querySelectorAll(`#rv-options input[name="${o.param}"]`).forEach((r) => {
        r.checked = r.value === pick;
        r.addEventListener('change', () => {
          h.setAttribute(o.attr, r.value);
          saved[o.param] = r.value;
          try { localStorage.setItem(KEY, JSON.stringify(saved)); } catch {}
        });
      });
    });
  })();
</script>

<script is:inline define:vars={{ reviewed }}>
  document.querySelectorAll('a[href^="/"]').forEach((a) => {
    if (a.closest('.rv')) return;
    const href = a.getAttribute('href');
    if (href.startsWith('/page-reviews/') || href.startsWith('/logos/')) return;
    const path = href.split(/[?#]/)[0];
    a.setAttribute('href', reviewed[path] ?? `https://openmined.org${href}`);
  });
</script>

<style>
  .rv {
    position: fixed;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    z-index: 10000;
    display: flex;
    align-items: center;
    gap: 2px;
    max-width: calc(100vw - 32px);
    padding: 4px;
    border-radius: var(--radius-lg, var(--border-radius-L));
    background: var(--surface-raise-2, var(--surface-background-bright));
    box-shadow: var(--shadow-raise-2, var(--shadow-md));
    font: 500 13px/1 var(--font-primary, sans-serif);
    overflow-x: auto;
  }
  .rv__btn { border: 0; background: none; font: inherit; cursor: pointer; }
  .rv__btn:focus-visible { outline: 2px solid var(--accent-key, currentColor); outline-offset: 1px; }
  .rv a { text-decoration: none; background-image: none; white-space: nowrap; }
  .rv__home, .rv__opt {
    padding: 8px 10px;
    border-radius: var(--radius-md, var(--border-radius-S));
    color: var(--text-headline);
  }
  .rv__home { color: var(--text-muted, var(--text-subtle)); }
  .rv__home:hover, .rv__opt:hover { background: var(--surface-sunken, var(--surface-foreground-default)); }
  .rv__opt[aria-current] { background: var(--accent-solid, var(--button-dark-color)); color: var(--accent-on, var(--button-light-color)); }
  .rv__sep { width: 1px; align-self: stretch; margin: 6px 4px; background: var(--line, var(--surface-foreground-high)); }
  .rv__key { padding: 0 8px 0 6px; color: var(--text-muted, var(--text-subtle)); white-space: nowrap; }
  .rv__key kbd { font: inherit; }
  @media (max-width: 560px) { .rv__key { display: none; } }

  /* Options popover: in the top layer, above the bar. */
  .rv-pop {
    position: fixed;
    inset: auto auto 72px 50%;
    transform: translateX(-50%);
    margin: 0;
    width: min(380px, calc(100vw - 32px));
    max-height: calc(100vh - 104px);
    overflow-y: auto;
    padding: 12px;
    border: 0;
    border-radius: var(--radius-lg, var(--border-radius-L));
    background: var(--surface-raise-2, var(--surface-background-bright));
    box-shadow: var(--shadow-raise-2, var(--shadow-md));
    color: var(--text-headline);
    font: 500 13px/1.35 var(--font-primary, sans-serif);
  }
  .rv-pop__set { margin: 0; padding: 0; border: 0; display: grid; gap: 2px; }
  .rv-pop__set + .rv-pop__set { margin-top: 12px; }
  .rv-pop legend { padding: 0 8px 6px; color: var(--text-muted, var(--text-subtle)); }
  .rv-pop__choice { display: flex; gap: 8px; align-items: flex-start; padding: 8px; border-radius: var(--radius-md, var(--border-radius-S)); cursor: pointer; }
  .rv-pop__choice:hover { background: var(--surface-sunken, var(--surface-foreground-default)); }
  /* The ported site styles inputs; start from the browser's own radio. */
  .rv-pop__choice input { all: revert; flex: none; margin: 1px 0 0; accent-color: var(--accent-key, currentColor); }
  .rv-pop__choice > span { flex: 1; text-align: left; }
  .rv-pop__fav { color: var(--text-muted, var(--text-subtle)); }
</style>
