---
/**
 * PAGE REVIEWS — the floating review bar on every review route (rendered by
 * the ported Base.astro). Switches page and links back to the review notes on
 * the brand site.
 *
 * Also points the ported page's own links somewhere sensible: links to a page
 * under review stay in the review (same system); every other site link goes
 * to openmined.org.
 */
import { PAGES, routeFor, type PageKey, type System } from './reviews';
interface Props { page: PageKey; system: System }
const { page, system } = Astro.props;
const reviewed = Object.fromEntries(PAGES.map((p) => [new URL(p.live).pathname, routeFor(p.key)]));
---
<nav class="rv" aria-label="Page review" data-section="always-dark">
  <a class="rv__home" href={`/page-reviews/#${page}`} title="Review notes on the brand site">Page review</a>
  <span class="rv__sep" aria-hidden="true"></span>
  {PAGES.map((p) => (
    <a class="rv__opt" href={routeFor(p.key)} aria-current={p.key === page ? 'page' : undefined}>{p.label}</a>
  ))}
</nav>

<script is:inline define:vars={{ reviewed }}>
  document.querySelectorAll('a[href^="/"]').forEach((a) => {
    if (a.closest('.rv')) return;
    const href = a.getAttribute('href');
    if (href.startsWith('/page-reviews/') || href.startsWith('/logos/')) return;
    const path = href.split(/[?#]/)[0];
    a.setAttribute('href', reviewed[path] ?? `https://openmined.org${href}`);
  });
</script>

<style>
  .rv {
    position: fixed;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    z-index: 10000;
    display: flex;
    align-items: center;
    gap: 2px;
    max-width: calc(100vw - 32px);
    padding: 4px;
    border-radius: var(--radius-lg, var(--border-radius-L));
    background: var(--surface-raise-2, var(--surface-background-bright));
    box-shadow: var(--shadow-raise-2, var(--shadow-md));
    font: 500 13px/1 var(--font-primary, sans-serif);
    overflow-x: auto;
  }
  .rv a { text-decoration: none; background-image: none; white-space: nowrap; }
  .rv__home, .rv__opt {
    padding: 8px 10px;
    border-radius: var(--radius-md, var(--border-radius-S));
    color: var(--text-headline);
  }
  .rv__home { color: var(--text-muted, var(--text-subtle)); }
  .rv__home:hover, .rv__opt:hover { background: var(--surface-sunken, var(--surface-foreground-default)); }
  .rv__opt[aria-current] { background: var(--accent-solid, var(--button-dark-color)); color: var(--accent-on, var(--button-light-color)); }
  .rv__sep { width: 1px; align-self: stretch; margin: 6px 4px; background: var(--line, var(--surface-foreground-high)); }
  .rv__key { padding: 0 8px 0 6px; color: var(--text-muted, var(--text-subtle)); white-space: nowrap; }
  .rv__key kbd { font: inherit; }
  @media (max-width: 560px) { .rv__key { display: none; } }
</style>
