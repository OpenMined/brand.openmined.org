---
/**
 * BRAND SITE (v2) — Layout: spacing, the page and its grid, articles and
 * breakouts, breakpoints, stacking. Words from design/foundations/spacing.md
 * (tag `layout`); values from the v2 build; each token's use from its
 * description (tokens/base/space.json, layout.json, layer.json). The grid and
 * article drawings are to scale against the 1300px page.
 */
import Site from '../../layouts/Site.astro';
import PageHero from '../../components/site/PageHero.astro';
import TokenTable from '../../components/site/TokenTable.astro';
import BuildRef from '../../components/site/BuildRef.astro';
import { componentCode } from '../../lib/components';
import DecisionList from '../../components/site/DecisionList.astro';
import { doc, decisionsFor, paragraph } from '../../lib/design';
import { readFileSync } from 'node:fs';
import { tok } from '../../lib/tokens';
import SPACE from '../../../tokens/base/space.json';
import LAYER from '../../../tokens/base/layer.json';
import LAYOUT from '../../../tokens/base/layout.json';

const foundation = doc('foundations/spacing');
const { Content } = foundation;
const decisions = decisionsFor('layout');
const steps = Object.entries(SPACE.spacing as Record<string, any>).filter(([k]) => !k.startsWith('$'))
  .map(([k, t]) => ({ name: `--spacing-${k}`, px: tok('light', `--spacing-${k}`).resolved, use: t.$description as string }));
const layers = Object.entries(LAYER.z as Record<string, any>).filter(([k]) => !k.startsWith('$'))
  .map(([k, t]) => ({ name: `--z-${k}`, value: tok('light', `--z-${k}`).resolved, use: t.$description as string })).reverse();
const PAGE = parseFloat(tok('light', '--page-width').resolved);
const pct = (name: string) => `${(parseFloat(tok('light', name).resolved) / PAGE * 100).toFixed(2)}%`;
const GAP = pct('--grid-gap');
const spans = Object.entries((LAYOUT.grid.span as Record<string, any>)).filter(([k]) => !k.startsWith('$'))
  .map(([k, t]) => ({ name: `--grid-span-${k}`, cls: `.max-span-${k}`, px: tok('light', `--grid-span-${k}`).resolved, use: t.$description as string })).reverse();
const ZONES = [
  { name: '--prose-full', cls: 'full', label: 'full · .breakout--full' },
  { name: '--prose-wide', cls: 'wide', label: 'wide · .breakout' },
  { name: '--prose-content', cls: 'content', label: 'content · every block' },
].map(z => ({ ...z, px: tok('light', z.name).resolved, w: pct(z.name) }));
const CODE = componentCode(['layout']);
/** The stack's steps, read from its rules in components/layout.css, so the table can't drift. */
const STACK_CSS = readFileSync('components/layout.css', 'utf8');
const STACKS = [...STACK_CSS.matchAll(/^\.stack(?:--([a-z0-9]+))? \{[^}]*?\bgap: var\(--spacing-([a-z0-9]+)\);[^}]*\}/gm)]
  .map(m => ({ cls: m[1] ? `.stack--${m[1]}` : '.stack', step: m[2], px: tok('light', `--spacing-${m[2]}`).resolved }))
  .filter(r => r.cls !== '.stack--lg');
if (STACKS.length < 2) throw new Error('Layout page: the stack rules in components/layout.css no longer parse');
const px = (step: string) => tok('light', `--spacing-${step}`).resolved;
const NAV: [string, string][] = [['spacing', 'Spacing'], ['stacks', 'Stacks'], ['grid', 'Page and grid'], ['articles', 'Articles'], ['breakpoints', 'Breakpoints'], ['stacking', 'Stacking'], ['guidance', 'Guidance'], ...(decisions.length ? [['decisions', 'Decisions'] as [string, string]] : [])];
---
<Site title={foundation.title} description={foundation.description} current="layout">
  <PageHero eyebrow="Foundations" title={foundation.title} description={foundation.description} status={foundation.status} nav={NAV} />

  <section class="band" id="spacing">
    <div class="wrap">
      <header class="sec"><h2>Spacing</h2><p>Every gap, padding and margin takes a step. Each bar is the step's length; the note is where the components use it today.</p></header>
      <article class="card">
        <ol class="space-steps">
          {steps.map(s => (
            <li>
              <code>{s.name}</code>
              <span class="space-steps__px">{s.px}</span>
              <span class="space-steps__bar" style={`width:var(${s.name})`} aria-hidden="true"></span>
              <span class="space-steps__use">{s.use}</span>
            </li>
          ))}
        </ol>
      </article>
      <BuildRef tokens={steps.map(s => s.name)} />
    </div>
  </section>

  <section class="band" id="stacks">
    <div class="wrap">
      <header class="sec"><h2>Stacks</h2><p class="measure">Why the container, not the element, sets the space, and how a stack does it.</p></header>
      <div class="guide-prose prose">
        <Fragment set:html={paragraph(foundation, 'Space belongs to the container.')} />
        <Fragment set:html={paragraph(foundation, 'Stacks.')} />
      </div>
      <div class="grid grid--2">
        <figure class="stack-demo">
          <div class="stack stack-demo__stack">
            <h5>Feedback</h5>
            <p>Tell us what didn't fit.</p>
            <h5>What's new</h5>
            <p>The latest changes.</p>
          </div>
          <figcaption><code>class="stack"</code><span class="muted">Flat: every gap is {px('lg')}, so the second heading sits as far from its own text as from the text above it.</span></figcaption>
        </figure>
        <figure class="stack-demo">
          <div class="stack stack--2xl stack-demo__stack">
            <div class="stack stack--sm stack-demo__group">
              <h5>Feedback</h5>
              <p>Tell us what didn't fit.</p>
            </div>
            <div class="stack stack--sm stack-demo__group">
              <h5>What's new</h5>
              <p>The latest changes.</p>
            </div>
          </div>
          <figcaption><span><code>class="stack stack--2xl"</code> around <code>class="stack stack--sm"</code></span><span class="muted">Nested: each heading {px('sm')} from its text, the groups {px('2xl')} apart.</span></figcaption>
        </figure>
      </div>
      <div class="tbl-wrap">
        <table>
          <thead><tr><th>Class</th><th>Between children</th></tr></thead>
          <tbody>{STACKS.map(r => <tr><td><code>{r.cls}</code>{r.cls === '.stack' && <span class="muted"> (lg, the default)</span>}</td><td><code>--spacing-{r.step}</code> · {r.px}</td></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="band" id="grid">
    <div class="wrap">
      <header class="sec"><h2>Page and grid</h2><p>Content runs to the page width with a gutter outside it, on twelve columns, and a block can be narrowed to a column width without the grid. The columns are drawn to scale against the 1300px page (below 991px the grid is one column); the max widths are drawn with their own classes, so each keeps its width until the window is narrower, then fills it.</p></header>
      <article class="card">
        <div class="grid-draw" style={`--gd-gap:${GAP}`} aria-label="Twelve columns across the page width">
          {Array.from({ length: 12 }, (_, i) => <span>{i + 1}</span>)}
        </div>
        <div class="guide-prose prose"><Fragment set:html={paragraph(foundation, 'Max widths.')} /></div>
        <ol class="span-draw">
          {spans.map(s => (
            <li>
              <code>{s.cls}</code>
              <span class="span-draw__px">{s.px}</span>
              <span class="span-draw__track"><span class:list={['span-draw__bar', s.cls.slice(1)]}></span></span>
              <span class="span-draw__use">{s.use}</span>
            </li>
          ))}
        </ol>
      </article>
      <BuildRef code={CODE} tokens={['--page-width', '--page-width-wide', '--page-gutter', '--grid-columns', '--grid-gap', '--grid-column', ...spans.map(s => s.name).reverse()]} />
    </div>
  </section>

  <section class="band" id="articles">
    <div class="wrap">
      <header class="sec"><h2>Articles</h2><p>A blog post or long read sits on three zones, as on openmined.org, and blocks are placed by zone name. Text and every block take the reading column; a figure, table or embed can break out to the wide zone, or leave the article for the page width. The reading column and the wide zone are set on their own, not from the grid. Drawn to scale.</p></header>
      <article class="card">
        <div class="zones" aria-label="The three article zones">
          {ZONES.map(z => (
            <div class={`zones__row zones__row--${z.cls}`} style={`width:${z.w}`}>
              <span class="zones__label"><code>{z.name}</code> {z.px} · {z.label}</span>
            </div>
          ))}
        </div>
        <div class="zones-art" aria-label="An article with a wide and a full breakout">
          <div class="zones-art__text" style={`width:${ZONES[2].w}`}><i></i><i></i><i></i><i></i></div>
          <figure class="zones-art__fig" style={`width:${ZONES[1].w}`}><figcaption>.breakout</figcaption></figure>
          <div class="zones-art__text" style={`width:${ZONES[2].w}`}><i></i><i></i><i></i></div>
          <figure class="zones-art__fig zones-art__fig--full"><figcaption>.breakout--full</figcaption></figure>
          <div class="zones-art__text" style={`width:${ZONES[2].w}`}><i></i><i></i></div>
        </div>
      </article>
      <BuildRef code={CODE} tokens={['--prose-content', '--prose-wide', '--prose-full']} />
    </div>
  </section>

  <section class="band" id="breakpoints">
    <div class="wrap">
      <header class="sec"><h2>Breakpoints</h2><p>Three widths where layouts change. Media queries can't read tokens, so write the number; the tokens name the set and serve scripts.</p></header>
      <TokenTable names={['--breakpoint-lg', '--breakpoint-md', '--breakpoint-sm']} />
    </div>
  </section>

  <section class="band" id="stacking">
    <div class="wrap">
      <header class="sec"><h2>Stacking</h2><p>Six fixed layers, highest first, so nothing invents a z-index.</p></header>
      <article class="card">
        <ol class="z-layers">
          {layers.map(l => <li><code>{l.name}</code><span class="z-layers__val">{l.value}</span><span>{l.use}</span></li>)}
        </ol>
      </article>
      <BuildRef tokens={layers.map(l => l.name)} />
    </div>
  </section>

  <section class="band" id="guidance">
    <div class="wrap">
      <header class="sec"><h2>Guidance</h2></header>
      <div class="prose prose--downsize-2 guide-prose"><Content /></div>
    </div>
  </section>

  {decisions.length > 0 && (
    <section class="band" id="decisions">
      <div class="wrap">
        <header class="sec"><h2>Decisions</h2><p>Why things are the way they are, oldest first. Open a row for the full record.</p></header>
        <DecisionList docs={decisions} />
      </div>
    </section>
  )}
</Site>
