---
/**
 * BRAND SITE (v2) — Logos: OpenMined's logo files, the tool marks (tools we
 * integrate with) and organizations (who we work with). Words from design/ (tag
 * `logos`); marks from public/logos/ (tools.json, orgs.json are the sources).
 */
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import Site from '../../layouts/Site.astro';
import PageHero from '../../components/site/PageHero.astro';
import DocGrid from '../../components/site/DocGrid.astro';
import ExampleLinks from '../../components/site/ExampleLinks.astro';
import ToolLogo from '../../components/ToolLogo.astro';
import { doc, byTag } from '../../lib/design';
import { BRANDS, TOOLS_DIR } from '../../lib/tools';
import { ORGS as ORG_REGISTRY } from '../../lib/orgs';

const logo = doc('foundations/logo');
const LogoContent = logo.Content;
const rules = byTag('logos', 'Guideline');
const GROUPS = [
  { group: 'Horizontal', logos: [['OpenMined-Logo.svg', 'Full color', false], ['OpenMined-Logo-Dark.svg', 'Reversed', true], ['OpenMined-Logo-Ghost.svg', 'Ghost', true], ['OpenMined-Logo-Mono-White.svg', 'Mono white', true], ['OpenMined-Logo-Mono-Black.svg', 'Mono black', false]] },
  { group: 'Stacked', logos: [['OpenMined-Logo-Stacked.svg', 'Full color', false], ['OpenMined-Logo-Stacked-Dark.svg', 'Reversed', true], ['OpenMined-Logo-Stacked-Ghost.svg', 'Ghost', true], ['OpenMined-Logo-Stacked-Mono-White.svg', 'Mono white', true], ['OpenMined-Logo-Stacked-Mono-Black.svg', 'Mono black', false]] },
  { group: 'Icon mark', logos: [['OpenMined-Icon.svg', 'Icon mark', false]] },
] as { group: string; logos: [string, string, boolean][] }[];
const RASTER = ['OpenMined-Logo-Dark.png', 'OpenMined-Logo-Mono-Black.png', 'OpenMined-Icon.png'];

/* Tool marks (moved from Graphics): one color by default, the official color one switch away. */
const TOOLS = Object.entries(BRANDS)
  .map(([key, b]) => ({
    key, name: b.name, owner: b.trademark,
    color: Boolean(b.iconColor && existsSync(join(TOOLS_DIR, b.iconColor))), dark: Boolean(b.dark?.iconColor), derived: Boolean(b.dark?.derived),
    mono: readFileSync(join(TOOLS_DIR, b.icon), 'utf8').replace(/<svg/, '<svg class="toolmark__glyph" aria-hidden="true" focusable="false"'),
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
const toolRule = doc('guidelines/tool-marks-as-supplied');

/* Organizations (public/logos/orgs/orgs.json): marks of organizations OpenMined has
   worked with, as shown on openmined.org. Not OpenMined assets; used nominatively. */
const ORGS = Object.entries(ORG_REGISTRY).map(([slug, o]) => ({ slug, ...o }));
const mono = (slug: string, file?: string) => file ? readFileSync(`public/logos/orgs/${slug}/${file}`, 'utf8') : '';

const NAV: [string, string][] = [['logo', 'The logo'], ['files', 'Files'], ['tools', 'Tool marks'], ['orgs', 'Organizations'], ['rules', 'Rules'], ['examples', 'Examples']];
---
<Site title="Logos" description={logo.description} current="logos">
  <PageHero eyebrow="Foundations" title="Logos" description={logo.description} status={logo.status} source="files in public/logos/" nav={NAV} />

  <section class="band" id="logo">
    <div class="wrap">
      <header class="sec"><h2>The logo</h2></header>
      {GROUPS.map(g => (
        <div class="logo-group">
          <h3>{g.group}</h3>
          <div class="logo-grid">
            {g.logos.map(([file, label, dark]) => (
              <figure class="logo-tile page-band" data-section={dark ? 'always-dark' : 'always-light'}>
                <img src={`/logos/${file}`} alt={`OpenMined, ${label.toLowerCase()}`} />
                <figcaption class="text-small"><span>{label}</span> <span><a class="link-content" href={`/logos/${file}`} download={file}>{file}</a></span></figcaption>
              </figure>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="band" id="files">
    <div class="wrap wrap--read">
      <div class="prose prose--downsize-2 guide-prose"><LogoContent /></div>
      <p class="text-small">Raster: {RASTER.map((f, i) => <>{i > 0 && ' · '}<a class="link-content" href={`/logos/raster/${f}`} download={f}>{f}</a></>)}</p>
    </div>
  </section>

  <section class="band" id="tools">
    <div class="wrap">
      <header class="sec"><h2>Tool marks</h2><p>{toolRule.description} {TOOLS.length} tools and services, from <code>public/logos/tools/</code> (<code>tools.json</code> records each mark's owner, official source, variants and gaps). One color by default, in the color of the text around them; {TOOLS.filter(p => p.color).length} also have an official color file, shown in the page's mode. {TOOLS.filter(p => p.dark).length} need a dark-mode file to read on dark ({TOOLS.filter(p => p.dark).map(p => p.name).join(' and ')}). The build fails on any color file that would vanish in one mode.</p></header>
      <div class="tabs tabs--sm" data-tabs>
        <div class="tabs__list" role="tablist" aria-label="Show tool marks in">
          <button type="button" class="tabs__tab" role="tab" aria-selected="true">One color</button>
          <button type="button" class="tabs__tab" role="tab" aria-selected="false">Official color</button>
        </div>
        <div class="tabs__panel" role="tabpanel">
          <ul class="toolmarks">
            {TOOLS.map(p => (
              <li title={`${p.name}, a trademark of ${p.owner}`}>
                <span class="toolmark__mark"><Fragment set:html={p.mono} /></span>
                <span class="toolmark__name">{p.name}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="tabs__panel" role="tabpanel">
          <ul class="toolmarks">
            {TOOLS.map(p => (
              <li title={`${p.name}, a trademark of ${p.owner}`}>
                <span class="toolmark__mark">{p.color ? <ToolLogo brand={p.key} variant="icon-color" size={32} alt="" /> : <Fragment set:html={p.mono} />}</span>
                <span class="toolmark__name">{p.name}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <p class="muted">Each mark is the trademark of its owner, served at <code>/logos/tools/&lt;name&gt;/</code>. Used inline next to text, they follow the <a href="/icons/#sizes">icon sizes</a>.</p>
    </div>
  </section>

  <section class="band" id="orgs">
    <div class="wrap">
      <header class="sec"><h2>Organizations</h2><p>Organizations OpenMined has worked with, as shown on openmined.org. Not OpenMined assets, and not governed by the system's tokens: used to name them, never recolored. Logos shown together take one treatment: all follow the color mode, or all sit on white plates as supplied (<a class="link-content" href="#guidelines-logo-groups-one-treatment">Logos in a group all follow the mode, or all sit on white</a>). An organization can follow the mode only with a checked one-color file; one without, such as a detailed seal or a mark traced from an image, sits on white, and so does its group.</p></header>
      <div class="logo-grid logo-grid--orgs">
        {ORGS.map(o => (
          <figure class="org-tile">
            <div class="org-tile__row">
              {o.color ? <span class="org-tile__plate page-band" data-section="always-light"><img src={`/logos/orgs/${o.color}`} alt={o.name} /></span> : <span class="org-tile__plate org-tile__plate--mono page-band" data-section="always-light" set:html={mono(o.slug, o.mono.split('/').pop())} />}
              {o.mono ? <span class="org-tile__plate org-tile__plate--mono page-band" data-section="always-dark" set:html={mono(o.slug, o.mono.split('/').pop())} /> : <span class="org-tile__plate org-tile__plate--none text-small">White plate only</span>}
            </div>
            <figcaption class="text-small">{o.name}{o.mono ? ' · can follow the mode' : ''}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="band" id="rules">
    <div class="wrap">
      <header class="sec"><h2>Rules</h2></header>
      <DocGrid docs={rules} />
    </div>
  </section>

  <ExampleLinks slugs={["press-cards", "home", "dashboard"]} />

</Site>
