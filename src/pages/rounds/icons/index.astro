---
/**
 * ROUND — Icons: the live site to the v2 set (moved from the brand site's Icons
 * page, 2026-10-13: migration material, not guidance). Every icon on the live
 * style guide (./_live-icons.json, a snapshot), next to the set icon that
 * replaces it (icons/set.json → live), with how close the match is and the set
 * icon's review status. All drawings come through src/lib/icons.ts.
 */
import Site from '../../../layouts/Site.astro';
import Icon from '../../../components/site/Icon.astro';
import LIVE_SNAPSHOT from './_live-icons.json';
import { ICONS, LIVE } from '../../../lib/icons';

/** Every live icon (the snapshot) with the set icon that replaces it (icons/set.json → live). */
const MATCH: Record<string, string> = { exact: 'Same idea', close: 'Closest match', none: 'No match', status: 'Status color', partner: 'Partner mark', gap: 'No partner mark yet' };
const GROUPS = (LIVE_SNAPSHOT as any).groups.map((g: any) => ({ ...g, items: g.items.map((it: any) => ({ ...it, ...LIVE[it.name] })) })) as { title: string; desc: string; ionicons?: boolean; items: { name: string; svg: string; use: string | null; match: string }[] }[];
const TOTAL = GROUPS.reduce((n, g) => n + g.items.length, 0);
const COUNT = (m: string) => GROUPS.reduce((n, g) => n + g.items.filter(i => i.match === m).length, 0);
const liveSvg = (svg: string) => svg.replace('<svg', '<svg width="24" height="24" aria-hidden="true" focusable="false"');
---
<Site title="Icons round" description="Every icon on the live site, next to the v2 set icon that replaces it.">
  <section class="wrap hero">
    <span class="eyebrow"><span class="eyebrow__dot"></span>Round · opened 9 Oct 2026</span>
    <h1>Icons: live to v2</h1>
    <p class="lead">Every icon on openmined.org’s style guide, mapped to the v2 set. The set itself, and how icons are used, are on the <a href="/icons/">Icons page</a>.</p>
  </section>

  <section class="band" id="live">
    <div class="wrap">
      <header class="sec"><h2>From the live site</h2><p>Every icon on the live site’s style guide (<a href="https://openmined.org/style-guide/#icons">openmined.org/style-guide</a>), next to the set icon that replaces it, in the live guide’s groups: {TOTAL} icons, {COUNT('exact')} with a same-idea Iconoir icon, {COUNT('close')} with the closest match, {COUNT('none')} with none. The live set mixes sources (2px and 1.5px strokes, five already from Iconoir, a filled check and X). A dash means no replacement is chosen yet, so the live drawing stays wherever it’s used.</p></header>
      {GROUPS.map(g => (
        <article class="card">
          <h3>{g.title} <span class="muted">({g.items.length})</span></h3>
          <p class="muted">{g.desc}</p>
          <div class="tbl-wrap">
            <table class="tbl icon-cmp">
              <thead><tr><th>Live</th><th>Name</th><th>v2</th><th>Name</th><th>Match</th><th>Status</th></tr></thead>
              <tbody>
                {g.items.map(it => (
                  <tr class={`is-${it.match}`}>
                    <td class="icon-cmp__glyph"><Fragment set:html={liveSvg(it.svg)} /></td>
                    <td><code>{it.name}</code></td>
                    <td class={`icon-cmp__glyph${it.match === 'status' ? (it.name.startsWith('x') ? ' is-danger' : ' is-success') : ''}`}>
                      {it.use ? <Icon name={it.use} size={24} /> : <span class="muted">—</span>}
                    </td>
                    <td>{it.use ? <code>{it.use}</code> : <span class="muted">—</span>}</td>
                    <td>{MATCH[it.match]}</td>
                    <td>{it.use ? (ICONS[it.use].status === 'approved' ? <b>approved</b> : <span class="muted">proposed</span>) : <span class="muted">—</span>}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </article>
      ))}
      <div class="notes"><div><ul>
        <li><b>No match ({COUNT('none')}):</b> {GROUPS.flatMap(g => g.items.filter(i => i.match === 'none').map(i => i.name)).join(', ')}. Draw our own on Iconoir’s grid and stroke, or import the live drawing (<code>npm run icons:import</code>).</li>
        <li><b>Status:</b> the live check and X are filled and colored; v2 draws them outlined in their status color, like every icon. To keep the filled ones, import them as <code>solid</code> icons.</li>
        <li><b>Brands without a partner mark:</b> {GROUPS.flatMap(g => g.items.filter(i => i.match === 'gap').map(i => i.name.replace('logo-', ''))).join(', ')}. Add official files to <code>public/logos/partners/</code>. Brand marks are fills in every version.</li>
      </ul></div></div>
    </div>
  </section>

</Site>
