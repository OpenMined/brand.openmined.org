---
/**
 * REVIEW ROUNDS — the index. Every round, oldest first, with where its working
 * favorites now live: the brand guide pages are the working favorites, and each
 * round stays as the record of how they got there. Read from src/lib/rounds.ts.
 */
import Site from '../../layouts/Site.astro';
import { ROUNDS, REVIEW_PAGES } from '../../lib/rounds';
import { iconSvg } from '../../lib/icons';

const LIST = ROUNDS.filter(r => r.key !== 'all');
const fmt = (d?: string) => d ? new Date(`${d}T12:00:00`).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
const ARR = iconSvg('arrow-right');
---
<Site title="Review rounds" description="Every review round, oldest first, and where its working favorites live in the brand guide.">
  <section class="wrap hero">
    <span class="eyebrow"><span class="eyebrow__dot"></span>Review rounds</span>
    <h1>Review rounds</h1>
    <p class="lead">Each round explored one question with options side by side. What it settled is on the brand guide pages, which show the current working favorites; the round stays as the record of how they got there.</p>
  </section>

  <section class="band">
    <div class="wrap">
      <header class="sec"><h2>Rounds</h2></header>
      <article class="card">
        <div class="tbl-wrap">
          <table class="tbl">
            <thead><tr><th>Round</th><th>Opened</th><th>Explored</th><th>Working favorites</th></tr></thead>
            <tbody>
              {LIST.map(r => (
                <tr>
                  <td><a href={r.href}><b>{r.label}</b></a></td>
                  <td class="muted">{fmt(r.opened)}</td>
                  <td>{r.about}</td>
                  <td>{r.lives?.length ? r.lives.map(([t, h], i) => <>{i > 0 && <br />}<a href={h}>{t}</a></>) : <span class="muted">Still exploring</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </article>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <header class="sec"><h2>Page reviews</h2><p>Real openmined.org pages with the working favorites applied.</p></header>
      <div class="grid grid--3">
        {REVIEW_PAGES.map((p, i) => (
          <a class="card card--link" href={p.href}><h3 class="card__h">{i === 0 ? 'Notes' : p.label} <Fragment set:html={ARR} /></h3></a>
        ))}
      </div>
    </div>
  </section>
</Site>
