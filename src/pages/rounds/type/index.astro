---
/**
 * ROUND — Type (opened 2026-10-28, after v2 type was carried from openmined.org).
 * The type review: what the carry-over left as design calls. Display headings
 * (leading per level and tracking, switchable on one specimen), h5 and h6, the
 * caption size, the muted text color, the line roles and the pull quote. The
 * first option in each section is the current value (the Typography page);
 * nothing here is decided. Every color is a v2 token; the muted-text retune is
 * previewed as a mix between neighboring gray steps.
 */
import Site from '../../../layouts/Site.astro';
import LongRead from '../../../components/site/LongRead.astro';
import { hex, contrast, type Mode, MODES } from '../../../lib/tokens';

const SURFACES = ['sunken', 'base', 'raise-1', 'raise-2'];
const fmt = (n: number) => `${n.toFixed(2)}:1`;
const pass = (n: number, min: number) => (n >= min ? 'is-pass' : 'is-fail');
/** Contrast of a color (token name) against each surface, per mode. */
const onSurfaces = (pick: (m: Mode) => string) => Object.fromEntries(MODES.map(m => [m, SURFACES.map(s => ({ s, c: contrast(hex(m, pick(m)), hex(m, `surface-${s}`)) }))])) as Record<Mode, { s: string; c: number }[]>;

/* 1. Display headings: leading per level and tracking. Values per option, h1–h4. */
const LEADING = [
  { k: 'flat', name: 'Even leading', note: '1.2 on every display level (openmined.org).', v: [1.2, 1.2, 1.2, 1.2] },
  { k: 'gentle', name: 'Gentle ramp', note: 'Tighter as headings grow: 1.1, 1.15, 1.2, 1.25.', v: [1.1, 1.15, 1.2, 1.25] },
  { k: 'tight', name: 'Tight ramp', note: 'Tighter still on the largest: 1.05, 1.1, 1.15, 1.2.', v: [1.05, 1.1, 1.15, 1.2] },
];
const TRACKING = [
  { k: 'none', name: 'No tracking', note: 'Rubik as drawn at every size (openmined.org).', v: [0, 0, 0, 0] },
  { k: 'slight', name: 'Slight on display', note: '−0.01em on h1–h4.', v: [-0.01, -0.01, -0.01, -0.01] },
  { k: 'ramp', name: 'Tracking ramp', note: 'More on the largest: −0.02em on h1 and h2, −0.01em on h3 and h4.', v: [-0.02, -0.02, -0.01, -0.01] },
];
const leadVars = (v: number[]) => v.map((x, i) => `--rt-lh-${i + 1}:${x}`).join(';');
const trackVars = (v: number[]) => v.map((x, i) => `--rt-ls-${i + 1}:${x}em`).join(';');

/* 5. Muted text. */
const MUTED = [
  { k: 'before', name: 'Muted as carried over', note: 'gray 500 in light, gray 400 in dark, before the retune. Under AA on the light sunken level and dark raise-2.',
    css: 'before', c: null },
  { k: 'retune', name: 'Gray 400 and 500 retuned', note: 'The two steps themselves move: gray 500 20% toward 600, gray 400 10% toward 300. Muted still names its step; everything else on these steps gains a little contrast too (light focus line, dark field edges).',
    css: '', c: onSurfaces(m => (m === 'light' ? 'gray-500' : 'gray-400')) },
  { k: 'rule', name: 'Muted kept off two levels', note: 'The values before the retune, with a rule: no muted text on the sunken level in light mode or on raise-2 in dark. Field placeholders take body text.',
    css: 'before', c: null },
];
/* The values before the retune (gray 500 at t 0.75, gray 400 at t 0.5), measured 2026-10-28. */
const BEFORE = { light: [4.15, 5.07, 5.38, 5.61], dark: [5.50, 5.25, 4.85, 4.45] } as Record<Mode, number[]>;

/* 6. Line roles. */
const LINES = [
  { t: 'line', job: 'Dividers: one edge between two things. Decorative, so no contrast minimum. In light mode it is the sunken level\'s own gray (1.00:1): a divider never shows on sunken.', min: 0 },
  { t: 'line-strong', job: 'The line style: outlines, the secondary button, underlines, quotes. The body text step.', min: 3 },
  { t: 'line-focus', job: 'Focus on form controls. Needs 3:1 on every surface.', min: 3 },
].map(l => ({ ...l, c: onSurfaces(m => l.t) }));
---
<Site title="Type round" description="The type review: display leading and tracking, h5 and h6, the caption, muted text, the line roles and the pull quote.">
  <section class="wrap hero">
    <span class="eyebrow"><span class="eyebrow__dot"></span>Round · opened 28 Oct 2026</span>
    <h1>Type</h1>
    <p class="lead">v2 type is openmined.org's system, carried over with obvious cleanup (<a href="/typography/">Typography</a>). These are the calls that change how it looks. Picked 28 Oct 2026 (Kyle), now on the Typography page: tight leading ramp with slight display tracking; h5 and h6 with page and long-read treatments; 12px captions; gray 400 and 500 retuned; <code>--line</code> one step darker in light; the pull quote wide, on a left line; the Spacious prose rhythm.</p>
    <nav class="page-nav" aria-label="On this page"><a href="#display">Display headings</a><a href="#h5h6">h5 and h6</a><a href="#caption">Caption size</a><a href="#muted">Muted text</a><a href="#lines">Line roles</a><a href="#pullquote">Pull quote</a><a href="#rhythm">Prose rhythm</a><a href="#numbers">Numbers</a></nav>
  </section>

  <section class="band" id="display">
    <div class="wrap">
      <header class="sec"><h2>1 · Display headings: leading and tracking</h2><p>Leading and tracking on h1–h4 (Rubik), switched together on one specimen, since each changes how the other reads. Headlines are set at their maximum size, in a reading-width column so they wrap.</p></header>
      <div class="rt-switches">
        <fieldset class="rt-switch"><legend class="fld__label">Leading</legend>
          <ul class="opts">{LEADING.map((o, i) => <li><label class="opt"><input class="opt__box" type="radio" name="rt-lead" value={o.k} checked={o.k === 'tight'} data-vars={leadVars(o.v)} /><span><b>{o.name}</b> · {o.note}</span></label></li>)}</ul>
        </fieldset>
        <fieldset class="rt-switch"><legend class="fld__label">Tracking</legend>
          <ul class="opts">{TRACKING.map((o, i) => <li><label class="opt"><input class="opt__box" type="radio" name="rt-track" value={o.k} checked={o.k === 'slight'} data-vars={trackVars(o.v)} /><span><b>{o.name}</b> · {o.note}</span></label></li>)}</ul>
        </fieldset>
      </div>
      <article class="card rt-display" id="rt-display" style={`${leadVars(LEADING[2].v)};${trackVars(TRACKING[1].v)}`}>
        {[1, 2, 3, 4].map(n => (
          <div class="rt-display__row">
            <span class="rt-meta">h{n}</span>
            <p class={`h${n} rt-h${n}`}>Researchers answer questions about data they never see</p>
          </div>
        ))}
        <div class="rt-display__row">
          <span class="rt-meta">In a hero</span>
          <div class="rt-hero">
            <p class="h1 rt-h1">Data stays where it lives</p>
            <p class="text-lead">Attribution-based control lets a researcher ask a question of data without ever seeing it.</p>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="band" id="h5h6">
    <div class="wrap">
      <header class="sec"><h2>2 · h5 and h6</h2><p>The live site sets h5 and h6 two ways. v2 takes its long-read treatment everywhere. Confirm, or keep two.</p></header>
      <div class="grid grid--2">
        <article class="card">
          <span class="rt-meta"><b>One treatment</b> · today in v2: Inter 600, 18–20 and 16–18px</span>
          <div class="prose rt-h-sample">
            <p class="h4">Running a question</p>
            <p class="h5">Before it runs</p>
            <p>The owner reviews the code and its purpose.</p>
            <p class="h6">After it runs</p>
            <p>Only the agreed result leaves the owner's servers.</p>
          </div>
        </article>
        <article class="card">
          <span class="rt-meta"><b>The live site's page treatment</b> · Inter 400, 18–21 and 16–20px (outside long reads)</span>
          <div class="prose rt-h-sample rt-h-live">
            <p class="h4">Running a question</p>
            <p class="h5">Before it runs</p>
            <p>The owner reviews the code and its purpose.</p>
            <p class="h6">After it runs</p>
            <p>Only the agreed result leaves the owner's servers.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="band" id="caption">
    <div class="wrap">
      <header class="sec"><h2>3 · Caption size</h2><p>The caption (<code>--font-size-xs</code>) labels graphics and dense figures. 11px is the live value; 12px is the smallest size many accessibility guides suggest for text people need to read.</p></header>
      <div class="grid grid--2">
        {[{ k: '11', name: '11px', note: 'Today, as on openmined.org.' }, { k: '12', name: '12px', note: 'One pixel up: 0.75rem.' }].map(o => (
          <article class="card">
            <span class="rt-meta"><b>{o.name}</b> · {o.note}</span>
            <div class={`rt-caption rt-caption--${o.k}`}>
              <div class="rt-caption__fig" aria-hidden="true"><span>Researcher</span><span>Data owner</span><span>Answer</span></div>
              <p class="text-caption">Figure 2 · A question travels to each owner; only the agreed result comes back.</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" id="muted">
    <div class="wrap">
      <header class="sec"><h2>4 · Muted text</h2><p><code>--text-muted</code> carries secondary text: the lead, captions, notes, placeholders. It must reach 4.5:1 on every level it sits on. Samples show the current mode; the readouts cover both.</p></header>
      <div class="rt-muted">
        {MUTED.map(o => (
          <article class="card">
            <span class="rt-meta"><b>{o.name}</b></span>
            <p class="rt-note">{o.note}</p>
            <div class={`rt-levels ${o.css ? `rt-levels--${o.css}` : ''}`}>
              {SURFACES.filter(s => o.k !== 'rule' || true).map(s => (
                <div class={`rt-level rt-level--${s}`}><span class="rt-muted__text">Updated 28 October · {s}</span></div>
              ))}
            </div>
            <table class="rt-read">
              <thead><tr><th></th>{SURFACES.map(s => <th>{s}</th>)}</tr></thead>
              <tbody>
                {MODES.map(m => (
                  <tr><th>{m}</th>{SURFACES.map((s, i) => {
                    const c = o.c ? o.c[m][i].c : BEFORE[m][i];
                    const off = o.k === 'rule' && ((m === 'light' && s === 'sunken') || (m === 'dark' && s === 'raise-2'));
                    return <td class={off ? 'is-off' : pass(c, 4.5)}>{off ? 'not used' : fmt(c)}</td>;
                  })}</tr>
                ))}
              </tbody>
            </table>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" id="lines">
    <div class="wrap">
      <header class="sec"><h2>5 · Line roles</h2><p>The three lines, as they stand. Confirm, or name one to change. Readouts are against each surface, both modes.</p></header>
      <article class="card">
        <div class="rt-lines">
          {LINES.map(l => (
            <div class="rt-lines__row">
              <span class="rt-meta"><b><code>--{l.t}</code></b> · {l.job}</span>
              <div class="rt-levels">{SURFACES.map(s => <div class={`rt-level rt-level--${s}`}><span class="rt-line" style={`background:var(--${l.t})`}></span></div>)}</div>
              <table class="rt-read">
                <thead><tr><th></th>{SURFACES.map(s => <th>{s}</th>)}</tr></thead>
                <tbody>{MODES.map(m => <tr><th>{m}</th>{l.c[m].map(x => <td class={l.min ? pass(x.c, l.min) : ''}>{fmt(x.c)}</td>)}</tr>)}</tbody>
              </table>
            </div>
          ))}
        </div>
      </article>
    </div>
  </section>

  <section class="band" id="pullquote">
    <div class="wrap">
      <header class="sec"><h2>6 · Pull quote</h2><p>New in v2: the live site has none. A line lifted from the text, set apart from a quotation (the blockquote), in a long read.</p></header>
      <div class="rt-pq">
        {[
          { k: 'lines', name: 'Between two lines', note: 'Display face at h4 size, a line of the line style above and below.' },
          { k: 'wide', name: 'Wide, on a left line', note: 'Display face at h3 size, broken out to the wide zone, the line style on its left like a blockquote.' },
          { k: 'open', name: 'Open, with air', note: 'Display face at h3 size, no lines, centered, with a break\'s air above and below.' },
        ].map(o => (
          <article class="card rt-pq__card">
            <span class="rt-meta"><b>{o.name}</b> · {o.note}</span>
            <div class="prose prose-article content-links">
              <p>A question goes out to every data owner that agreed to take part. Each one runs it locally and returns a result.</p>
              <aside class={`pullquote rt-pq--${o.k}`}><p>The researcher gets an answer, never a row, and the owner never gives up a copy of their data.</p></aside>
              <p>The owner keeps the data, and every answer is signed and logged.</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="band" id="rhythm">
    <div class="wrap">
      <header class="sec"><h2>7 · Prose rhythm</h2><p>The space around headings, lists and figures in a long read. The live blog's values are the same as v2's today: 32px above an h2, 24px above h3–h6, 16px between blocks. Its authors hand-added spacers above h2s on long posts (118 of them) to reach 88px, which became the opt-in "spacious sections". Space above a heading holds whatever comes before it.</p></header>
      <fieldset class="rt-switch rt-rhythm-switch"><legend class="fld__label">Rhythm</legend>
        <ul class="opts">
          <li><label class="opt"><input class="opt__box" type="radio" name="rt-rhythm" value="live" /><span><b>As the live site</b> · above h2 32, h3–h6 24; 16 after a list; 16 before a figure, 24 after.</span></label></li>
          <li><label class="opt"><input class="opt__box" type="radio" name="rt-rhythm" value="air" /><span><b>Headings with more air</b> · above h2 48, h3 40, h4 32, h5–h6 24; 24 after a list; 24 before and after a figure.</span></label></li>
          <li><label class="opt"><input class="opt__box" type="radio" name="rt-rhythm" value="spacious" checked /><span><b>Spacious</b> · above h2 88 (the live opt-in), h3 48, h4 40, h5–h6 32; 24 after a list; 24 before and after a figure.</span></label></li>
        </ul>
      </fieldset>
      <article class="card type-article rt-rhythm" id="rt-rhythm" data-rhythm="spacious"><LongRead /></article>
    </div>
  </section>
  <section class="band" id="numbers">
    <div class="wrap">
      <header class="sec"><h2>8 · Numbers in tables</h2><p>Inter draws its digits at different widths by default (proportional figures), so a column of numbers doesn't line up. Tabular figures give every digit the same width. The same table both ways; numeric columns are right-aligned in both.</p></header>
      <div class="grid grid--2">
        {[{ k: 'prop', name: 'Proportional figures', note: 'Today: Inter as drawn.' }, { k: 'tab', name: 'Tabular figures', note: 'Every digit the same width (font-variant-numeric: tabular-nums).' }].map(o => (
          <article class="card">
            <span class="rt-meta"><b>{o.name}</b> · {o.note}</span>
            <div class={`prose rt-num rt-num--${o.k}`}>
              <table>
                <thead><tr><th>Site</th><th class="rt-r">Patients</th><th class="rt-r">Queries</th><th class="rt-r">Review (days)</th></tr></thead>
                <tbody>
                  <tr><td>North</td><td class="rt-r">11,118</td><td class="rt-r">141</td><td class="rt-r">1.1</td></tr>
                  <tr><td>Harbor</td><td class="rt-r">8,806</td><td class="rt-r">980</td><td class="rt-r">7.9</td></tr>
                  <tr><td>Valley</td><td class="rt-r">1,711</td><td class="rt-r">17</td><td class="rt-r">14.0</td></tr>
                  <tr><td>Coast</td><td class="rt-r">40,390</td><td class="rt-r">2,368</td><td class="rt-r">3.6</td></tr>
                  <tr><td>Total</td><td class="rt-r">62,025</td><td class="rt-r">3,506</td><td class="rt-r">6.7</td></tr>
                </tbody>
              </table>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Site>

<script>
  // Prose rhythm: the picked option on the long read.
  const rhythm = document.getElementById('rt-rhythm');
  document.querySelectorAll<HTMLInputElement>('input[name="rt-rhythm"]').forEach(r => r.addEventListener('change', () => { if (rhythm && r.checked) rhythm.dataset.rhythm = r.value; }));
  // Display headings: each radio carries its option's custom properties; picking one sets them on the specimen.
  const spec = document.getElementById('rt-display');
  document.querySelectorAll<HTMLInputElement>('input[name="rt-lead"], input[name="rt-track"]').forEach(r => r.addEventListener('change', () => {
    if (!spec || !r.checked) return;
    (r.dataset.vars ?? '').split(';').forEach(d => { const [k, v] = d.split(':'); spec.style.setProperty(k, v); });
  }));
</script>

<style>
  .rt-meta { display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: var(--spacing-md); }
  .rt-meta b { color: var(--text-headline); font-weight: 600; }
  .rt-note { font-size: 0.85rem; margin-bottom: var(--spacing-lg); }
  .rt-switches { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--spacing-2xl); }
  @media (max-width: 800px) { .rt-switches { grid-template-columns: minmax(0, 1fr); } }
  .rt-switch { border: 0; padding: 0; margin: 0; display: grid; gap: var(--spacing-sm); }
  .rt-switch .opt span { font-size: 0.9rem; }
  /* The display specimen: headlines at their maximum, in a reading-width column. */
  .rt-display { display: grid; gap: var(--spacing-3xl); }
  .rt-display__row { display: grid; grid-template-columns: 120px minmax(0, 860px); gap: var(--spacing-xl); align-items: start; }
  @media (max-width: 800px) { .rt-display__row { grid-template-columns: minmax(0, 1fr); } }
  .rt-display p { margin: 0; }
  .rt-display .rt-h1 { font-size: var(--font-size-h1-max); line-height: var(--rt-lh-1); letter-spacing: var(--rt-ls-1); }
  .rt-display .rt-h2 { font-size: var(--font-size-h2-max); line-height: var(--rt-lh-2); letter-spacing: var(--rt-ls-2); }
  .rt-display .rt-h3 { font-size: var(--font-size-h3-max); line-height: var(--rt-lh-3); letter-spacing: var(--rt-ls-3); max-width: 640px; }
  .rt-display .rt-h4 { font-size: var(--font-size-h4-max); line-height: var(--rt-lh-4); letter-spacing: var(--rt-ls-4); max-width: 420px; }
  .rt-hero { display: grid; gap: var(--spacing-lg); max-width: 640px; }
  /* h5 and h6: the live site's page treatment for comparison. */
  .rt-h-sample > * + * { margin-top: var(--spacing-md); }
  .rt-h-live .h5 { font-weight: var(--font-weight-regular); font-size: clamp(var(--font-size-h5-min), 1.62vw, 1.3125rem); line-height: 1.4; }
  .rt-h-live .h6 { font-weight: var(--font-weight-regular); font-size: clamp(var(--font-size-h6-min), 1.54vw, 1.25rem); line-height: 1.5; }
  /* Caption sizes. */
  .rt-caption { display: grid; gap: var(--spacing-sm); }
  .rt-caption__fig { display: flex; justify-content: space-between; padding: var(--spacing-2xl) var(--spacing-lg); border-radius: var(--radius-md); background: var(--surface-sunken); }
  .rt-caption__fig span { font-size: var(--rt-cap); font-weight: var(--font-weight-medium); color: var(--text-body); }
  .rt-caption .text-caption { font-size: var(--rt-cap); color: var(--text-muted); }
  .rt-caption--11 { --rt-cap: 0.6875rem; }
  .rt-caption--12 { --rt-cap: 0.75rem; }
  /* Levels: one tile per surface, showing a sample on it. */
  .rt-muted { display: grid; gap: var(--spacing-xl); }
  .rt-levels { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--spacing-md); margin-bottom: var(--spacing-lg); }
  .rt-level { padding: var(--spacing-lg); border-radius: var(--radius-md); }
  .rt-level--sunken { background: var(--surface-sunken); box-shadow: var(--shadow-sunken); }
  .rt-level--base { background: var(--surface-base); box-shadow: inset 0 0 0 var(--stroke-sm) var(--line); }
  .rt-level--raise-1 { background: var(--surface-raise-1); box-shadow: var(--shadow-raise-1); }
  .rt-level--raise-2 { background: var(--surface-raise-2); box-shadow: var(--shadow-raise-2); }
  .rt-muted__text { font-size: var(--font-size-sm); color: var(--text-muted); }
  /* The steps before the retune, approximated from today's neighbors. */
  :root .rt-levels--before { --text-muted: color-mix(in oklab, var(--gray-500) 85%, var(--gray-400)); }
  :root[data-theme="dark"] .rt-levels--before { --text-muted: color-mix(in oklab, var(--gray-400) 92%, var(--gray-500)); }
  .rt-read { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
  .rt-read :is(th, td) { padding: 6px 8px; text-align: left; border-bottom: var(--stroke-sm) solid var(--line); }
  .rt-read th { font-weight: 500; color: var(--text-muted); }
  .rt-read td.is-pass { color: var(--text-body); }
  .rt-read td.is-fail { color: var(--danger-fg); font-weight: 600; }
  .rt-read td.is-off { color: var(--text-muted); font-style: italic; }
  /* Line roles. */
  .rt-lines { display: grid; gap: var(--spacing-3xl); }
  .rt-line { display: block; height: 1px; }
  /* Pull quote options (the first is components/prose.css as it stands). */
  .rt-pq { display: grid; gap: var(--spacing-xl); }
  .rt-pq__card { padding-block: var(--spacing-3xl); }
  .prose .pullquote.rt-pq--lines { grid-column: content; padding: var(--spacing-xl) 0; border: 0; border-block: var(--stroke-sm) solid var(--line-strong); font-size: clamp(var(--font-size-h4-min), 2.08vw, var(--font-size-h4-max)); line-height: 1.2; letter-spacing: 0; }
  .prose .pullquote.rt-pq--wide { grid-column: wide; padding-block: 0; padding-left: var(--spacing-xl); border-block: 0; border-left: var(--stroke-sm) solid var(--line-strong); font-size: clamp(var(--font-size-h3-min), 2.77vw, var(--font-size-h3-max)); }
  .prose .pullquote.rt-pq--open { grid-column: content; padding: 0; border: 0; text-align: center; font-size: clamp(var(--font-size-h3-min), 2.77vw, var(--font-size-h3-max)); }
  .prose :is(*) + .pullquote.rt-pq--open, .prose .pullquote.rt-pq--open + * { margin-top: var(--prose-gap-break); }
  /* Prose rhythm options (Spacious is components/prose.css as it stands; the others are written out). */
  .rt-rhythm[data-rhythm="live"] :global(.prose :not(.prose-divider) + h2) { margin-top: var(--spacing-3xl); }
  .rt-rhythm[data-rhythm="live"] :global(.prose * + :is(h3, h4, h5, h6)) { margin-top: var(--spacing-2xl); }
  .rt-rhythm[data-rhythm="live"] :global(.prose :is(ul, ol) + :not(h2, h3, h4, h5, h6)) { margin-top: var(--spacing-lg); }
