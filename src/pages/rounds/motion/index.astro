---
/**
 * ROUND — Color and interaction (opened 2026-10-12 as Color in motion). "If color,
 * then motion" (design/decisions/2026-10-12-if-color-then-motion.md), and interaction
 * beyond it:
 *   1. Button hover: a moving fill with a glow (E the full OM gradient; G–J without the
 *      pointer light, H–J in hue keys from a start other than green).
 *   2. Icons in a set color: a gradient moves inside the stroke, with a glow that
 *      moves with it (E: the two-tone tokens). Layout from SyftHub's Core Components.
 *   3. Hover cards: a pointer light; icons take their color on hover.
 *   4. Links: a colored line over the resting underline.
 *   5. Form fields, grayscale: a pointer light and outline on hover; a gray focus line.
 * The glow is the /research diamonds' technique: a copy behind, blurred and faded.
 * Colors are palette steps and tokens; nothing here is a loose value.
 */
import { ICON_SPEEDS, ICON_SPEED_DEFAULT } from '../../../lib/icon-speed';
import Site from '../../../layouts/Site.astro';
import HoverCard from '../../../components/site/HoverCard.astro';
import TwoToneDefs from '../../../components/site/TwoToneDefs.astro';
import { iconSvg, liveToSet } from '../../../lib/icons';
import { twoToneStops, TWO_TONE_COMPANION, listStops } from '../../../lib/tokens';

type Glow = { b1: number; o1: number; b2: number; o2: number; o1Light?: number };
// Glow 1's opacity can differ by mode (o1Light in light, o1 in dark).
const glowVars = (g: Glow) => `--g1-b:${g.b1}px;--g1-o-d:${g.o1};--g1-o-l:${g.o1Light ?? g.o1};--g2-b:${g.b2}px;--g2-o:${g.o2}`;
const glowText = (g: Glow) => [g.o1 && (g.o1Light !== undefined && g.o1Light !== g.o1 ? `blur ${g.b1}px at ${g.o1Light} light, ${g.o1} dark` : `blur ${g.b1}px at ${g.o1}`), g.o2 && `blur ${g.b2}px at ${g.o2}`].filter(Boolean).join(' + ') || 'no glow';

// Buttons: every variant takes the same glow; the fill changes.
// E: the full OM gradient as a long loop that starts on green, under a grayscale
// shimmer (two striped layers crossing at 20° and −40°, each flowing one way), with
// a neutral (white) pointer light, since it rides over changing colors. G is E
// without the light. H–J are G in the hue keys (no pale stop to start on), with the
// loop starting somewhere other than green: H at a random point on every hover, I
// at a point set by the clock (one turn of the loop per minute), J as I with the
// secondary button half a loop from the primary (opposite on the wheel).
// One glow copy: fewer moving layers and blurs.
const BTN_GLOW: Glow = { b1: 8, o1: 0.3, b2: 0, o2: 0 };
// H–J's loop: the --gradient-interactive token's stops (hue keys), laid out as
// a 1200px repeating loop that starts on green 150px in, like the spectrum's.
// Colors arrive from the loop's end, so the stops are laid out in reverse: a hover
// runs green → teal → blue → violet → red → amber → green.
// Blended in OKLCH (shorter hue), so neighbors pass through clean hues: in sRGB,
// amber → green went through a muddy olive.
const KEYS = listStops('interactive').split(',').reverse();
const KEYS_LOOP = `repeating-linear-gradient(90deg in oklch, ${KEYS.map((k, i) => `var(--${k}) ${(150 + (1200 * i) / (KEYS.length - 1)).toFixed(1)}px`).join(', ')})`;
const BUTTONS: { k: string; name: string; note: string; fill: string; cursor?: boolean; start?: 'random' | 'clock' | 'clock-opposite'; fav?: string }[] = [
  { k: 'e', name: 'E · Full OM gradient from green + shimmer + pointer light', note: 'The full OM gradient drifting slowly (1200px, 30s), every hover starting on green, under a faint grayscale shimmer (two crossing striped layers: white at 20°, dark at −40°), with one blurred copy behind as the glow. A soft white light follows the pointer. The white label dips in contrast while the pale stops (gold, yellow, lime) pass.', fill: 'specb', cursor: true },
  { k: 'g', name: 'G · Full OM gradient from green + shimmer, no pointer light', note: 'The full OM gradient drifting slowly (1200px, 30s), every hover starting on green, under a faint grayscale shimmer (two crossing striped layers: white at 20°, dark at −40°), with one blurred copy behind as the glow. Nothing follows the pointer. The white label dips in contrast while the pale stops (gold, yellow, lime) pass.', fill: 'specb' },
  { k: 'h', name: 'H · Hue keys from a random point + shimmer, no pointer light', note: 'The hue keys only (--gradient-interactive: green, teal, blue, violet, red, amber; blended in OKLCH), drifting slowly (1200px, 30s), under a faint grayscale shimmer (two crossing striped layers: white at 20°, dark at −40°), with one blurred copy behind as the glow. Each hover starts at a random point in the loop, so the first color is anywhere on the wheel. Nothing follows the pointer. No pale stops, so the white label stays at about 3.8:1 or better.', fill: 'specb-keys', start: 'random' },
  { k: 'i', name: 'I · Hue keys from the clock + shimmer, no pointer light', note: 'The hue keys only (--gradient-interactive: green, teal, blue, violet, red, amber; blended in OKLCH), drifting slowly (1200px, 30s), under a faint grayscale shimmer (two crossing striped layers: white at 20°, dark at −40°), with one blurred copy behind as the glow. The start is set by the clock: the starting point moves once around the loop every minute (about 10 seconds per hue key), so it changes over time but is the same for every button, every page and every visitor at a given moment. Both buttons start on the same color. Nothing follows the pointer. No pale stops, so the white label stays at about 3.8:1 or better.', fill: 'specb-keys', start: 'clock' },
  { k: 'j', name: 'J · Hue keys from the clock, secondary opposite + shimmer, no pointer light', note: 'The hue keys only (--gradient-interactive: green, teal, blue, violet, red, amber; blended in OKLCH), drifting slowly (1200px, 30s), under a faint grayscale shimmer (two crossing striped layers: white at 20°, dark at −40°), with one blurred copy behind as the glow. The start is set by the clock: the starting point moves once around the loop every minute (about 10 seconds per hue key), the same for every button, every page and every visitor at a given moment. The secondary button starts half a loop from the primary, so the two always sit opposite each other on the wheel (green with violet, teal with red, blue with amber). Nothing follows the pointer. No pale stops, so the white label stays at about 3.8:1 or better.', fill: 'specb-keys', start: 'clock-opposite', fav: 'both modes · on the guide and the page reviews' },
];

// Links: the content link's hover line as a moving gradient with a 3px glow band.
const LINK_ROWS: { k: string; name: string; note: string; cls: string; fav?: string }[] = [
  { k: 'a', name: 'A · Before', note: 'The accent key (green), 1px, grows over the underline from the left.', cls: 'mo-lk--green' },
  { k: 'b', name: 'B · Spectrum + glow', note: 'The full OM gradient moves along the line (each hue spans the link’s length, so two colors at most; one hue every 1.7s), with a glow band of the same colors at 35% behind it: the line plus 1px on every side.', cls: 'mo-lk--spec', fav: 'both modes · on the guide and the page reviews' },
  { k: 'c', name: 'C · Hue keys + glow', note: 'The hue keys (--gradient-interactive) move along the line, running green → teal → blue → violet → red → amber, blended in OKLCH (each hue spans the link’s length; one hue every 1.7s), with a glow band of the same colors at 35% behind it: the line plus 1px on every side.', cls: 'mo-lk--keys' },
];

// Icons: SyftHub › Core Components, one hue per card.
const CARDS = [
  { live: 'database', hue: 'green', title: 'Datasets', body: 'Upload documents or connect vector databases like Weaviate, Qdrant, or ChromaDB. Files are automatically indexed for AI search.' },
  { live: 'sparkles', hue: 'amber', title: 'Models', body: 'Connect OpenAI, Anthropic, Ollama, vLLM, or any OpenAI-compatible provider. Your choice, your keys.' },
  { live: 'code', hue: 'red', title: 'Endpoints', body: 'Combine datasets and models into queryable RAG endpoints. Configure output as search results, AI summaries, or both.' },
  { live: 'settings', hue: 'blue', title: 'Policies', body: 'Control access, set rate limits, and configure pricing. Your knowledge, your terms.' },
].map(c => ({ ...c, svg: iconSvg(liveToSet(c.live) ?? c.live, { size: 32 }) }));
const HUES = [...new Set(CARDS.map(c => c.hue))];

// Hover cards: SyftHub's link cards and the home page's press cards (white plates).
const LINKS = [
  { icon: 'zap', hue: 'amber', title: 'Quickstart', sub: 'Get up and running in 5 minutes' },
  { icon: 'installation', hue: 'blue', title: 'Installation', sub: 'Desktop app or Docker deployment' },
  { icon: 'core-concepts', hue: 'green', title: 'Core Concepts', sub: 'Learn the building blocks' },
].map(l => ({ ...l, svg: iconSvg(liveToSet(l.icon) ?? 'arrow-right', { size: 24 }) }));
const PRESS = [
  { org: 'Partner one', title: 'Secure enclaves for AI evaluation' },
  { org: 'Partner two', title: 'Privacy-preserving data science' },
  { org: 'Partner three', title: 'Federated learning in practice' },
];
const ARROW = iconSvg('arrow-right', { size: 24 });
// Card colorflow: three structures for the flow a hover card fades in across its
// lower third (src/scripts/gl/units/hover-flow.ts), in the card's two-tone.
const FLOWS = [
  { k: 'ribbon', name: 'Ribbon, mild wave', note: 'A thick soft band near the bottom edge, mostly its top half showing, shaped as one mild sine wave across the card at any size (0.13 of the strip’s height) with small ripples on top; its color moves along it through the hue’s two-tone: base, darker, companion, lighter.' },
  { k: 'ribbon-wave', name: 'Ribbon, strong wave', fav: true, note: 'A thick soft band near the bottom edge, mostly its top half showing, shaped as one sine wave across the card at any size, twice as tall (0.26 of the strip’s height) so the curve reads plainly, with small ripples on top; its color moves along it through the hue’s two-tone.' },
];
/** Form fields: a pointer light inside the field on hover; a gray line on focus. */
const FIELD_ROWS: { k: string; name: string; note: string; hover?: string; focus?: string; vals: string; fav?: string }[] = [
  { k: 'a', name: 'A · Before', note: 'No change on hover; on focus the inset deepens. Click a field to focus it.', vals: '--shadow-sunken' },
  { k: 'b', name: 'B · Pointer light + moving gray line', note: 'On hover, a soft white light inside the field follows the pointer; in light mode the field takes a gray outline that lightens near the pointer, in dark its edge lights up in gray near the pointer. On focus, a gray line with a slightly lighter gray traveling around it.', hover: 'edge', focus: 'moving', vals: 'light: gray-300 outline, white at 0.5 on the edge near the pointer (240px across), white light inside 320px across at 0.4 · dark: edge 1px, 240px across, gray-500 at 0.5, white light at 0.0175 · focus line 1px, light gray-500 → 200, dark gray-500 → 600, one turn per 6s' },
  { k: 'c', name: 'C · Pointer light + solid gray line', note: 'On hover, a soft white light inside the field follows the pointer; in light mode the field takes a gray outline that lightens near the pointer, in dark its edge lights up in gray near the pointer. On focus, a solid gray line.', hover: 'edge', focus: 'solid', vals: 'light: gray-300 outline, white at 0.5 on the edge near the pointer (240px across), white light inside 320px across at 0.4 · dark: edge 1px, 240px across, gray-500 at 0.5, white light at 0.0175 · focus line 1px, light gray-500, dark gray-500', fav: 'both modes · on the guide and the page reviews' },
];

const ICONS: { k: string; name: string; note: string; mono?: boolean; g: Glow; fav?: string; tone?: 'token' | 'prev' }[] = [
  { k: 'mono', name: 'Mono · today', note: 'The text color, still. The reference.', mono: true, g: { b1: 0, o1: 0, b2: 0, o2: 0 } },
  { k: 'a', name: 'A · Color in the stroke', note: 'The hue moves inside the line; no glow.', g: { b1: 0, o1: 0, b2: 0, o2: 0 } },
  { k: 'b', name: 'B · Tight glow', note: 'One copy close to the line, so it reads as light rather than haze.', g: { b1: 3, o1: 0.4, b2: 0, o2: 0 } },
  { k: 'c', name: 'C · Soft glow', note: 'One copy, blurred more.', g: { b1: 6, o1: 0.4, o1Light: 0.25, b2: 0, o2: 0 } },
  { k: 'd', name: 'D · Tight + wide', note: 'A close copy for the line, a wide faint one around it.', g: { b1: 2, o1: 0.35, b2: 10, o2: 0.2 } },
  { k: 'e', name: 'E · Two-tone, companion per hue + soft glow', note: 'Each hue’s two-tone token (--gradient-two-tone-<hue>) moves inside the line: the hue with its companion passing through once per loop. One glow copy, blurred more.', g: { b1: 6, o1: 0.4, o1Light: 0.25, b2: 0, o2: 0 }, tone: 'token', fav: 'both modes · on the guide and the page reviews' },
  { k: 'f', name: 'F · Two-tone, hue one step back + soft glow', note: 'The hue moves inside the line with the hue one step back around the wheel (automatic) passing through once per loop. One glow copy, blurred more.', g: { b1: 6, o1: 0.4, o1Light: 0.25, b2: 0, o2: 0 }, tone: 'prev' },
];
// One moving gradient per hue (id `${prefix}-${hue}`), shared by every icon of that
// hue and its glow copies, so the glow moves with the line. Bottom left → top right
// (−45° about the icon's center), repeating every 96 units (4× the icon), slid
// one period along that axis per loop: seamless, like the diamonds. Stop colors
// resolve where the gradient sits, so each range context gets its own set.
// The palette's hues in order around the wheel; a hue's neighbors are one step
// either way (red wraps to violet).
const WHEEL = ['red', 'amber', 'green', 'teal', 'blue', 'violet'];
const prevHue = (h: string) => WHEEL[(WHEEL.indexOf(h) + WHEEL.length - 1) % WHEEL.length];
const mix = (h: string, s: number) => `color-mix(in oklch, var(--${h}-500) var(--mo-ic-keep), var(--${h}-${s}))`;
// One hue: key → lighter → key → darker → key. Two-tone (automatic): the neighbor's
// key takes the middle stop, so it passes through once per loop.
const stopsFor = (h: string, n?: string) => [
  `var(--${h}-500)`, mix(h, 400), n ? `var(--${n}-500)` : `var(--${h}-500)`, mix(h, 600), `var(--${h}-500)`,
];
// Two-tone token: gradient.two-tone-<hue> (its companion chosen per hue in
// tools/palette/inputs.json); stops 1 and 3 mix back toward the key by the range.
const TWO_TONE = Object.fromEntries(WHEEL.map(h => [h, twoToneStops(h)]));
const companion = (h: string) => TWO_TONE_COMPANION[h];
const tokenStops = (h: string) => TWO_TONE[h].map((t, i) =>
  i === 1 || i === 3 ? `color-mix(in oklch, var(--${TWO_TONE[h][0]}) var(--mo-ic-keep), var(--${t}))` : `var(--${t})`);
// 96 units (4× the icon's 24 grid), slid one period per 4s loop, so the
// whole band never fits inside the icon.
const grad = (id: string, stops: string[]) => `<linearGradient id="${id}" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="96" y2="0" spreadMethod="repeat" gradientTransform="rotate(-45 12 12)">${stops.map((c, i) => `<stop offset="${i / 4}" style="stop-color:${c}"/>`).join('')}<animateTransform attributeName="gradientTransform" type="translate" from="0 0" to="96 0" dur="4s" repeatCount="indefinite" additive="sum"/></linearGradient>`;
const defs = (prefix: string) => `<svg class="mo-defs" width="0" height="0" aria-hidden="true" focusable="false"><defs>${HUES.map(h =>
  grad(`${prefix}-${h}`, stopsFor(h)) + grad(`${prefix}-${h}-token`, tokenStops(h)) + grad(`${prefix}-${h}-prev`, stopsFor(h, prevHue(h)))).join('')}</defs></svg>`;

---
<Site title="Color and interaction round" description="If color, then motion, and interaction beyond it: button and link hovers, icons in color, hover cards and form fields.">
  <div class="mo" data-range="normal">
    <!-- One moving gradient per hue, shared by every icon of that hue (and its glow
         copies, so the glow moves with the line). Turned to run bottom left → top right (−45° about the icon's center), repeating every 96 units (4× the
         icon), slid one period along that axis per loop: seamless, like the diamonds. -->
    <Fragment set:html={defs('flow')} />

    <section class="wrap hero">
      <span class="eyebrow"><span class="eyebrow__dot"></span>Round · opened 12 Oct 2026</span>
      <h1>Color and interaction</h1>
      <p class="lead"><em>If color, then motion</em>, and interaction beyond it: button hovers, icons in a set color, hover cards, links and form fields. The glow is the /research diamonds’ technique: a copy behind, blurred and faded.</p>
      <p class="status">Status: <b>exploring</b> · each hue moves around its key (500) · working favorites: buttons J, icons E, hover cards, links B, fields C · icons A–D and F 400–600 · <i>One step subtler</i>: icons halfway; pointer, card and field lights halved</p>
      <div class="mo-ctl">
        <label class="mo-ctl__item">
          <button type="button" class="switch js-pin" role="switch" aria-checked="false" aria-label="Show every button in its hover state"><span class="switch__knob"></span></button>
          <span>Pin buttons in hover</span>
        </label>
        <label class="mo-ctl__item">
          <button type="button" class="switch js-slow" role="switch" aria-checked="false" aria-label="Slower animation"><span class="switch__knob"></span></button>
          <span>Slower <span class="muted">(⅔ speed)</span></span>
        </label>
        <label class="mo-ctl__item">
          <button type="button" class="switch js-range" role="switch" aria-checked="false" aria-label="One step subtler"><span class="switch__knob"></span></button>
          <span>One step subtler <span class="muted">(each element one notch past its pick)</span></span>
        </label>
      </div>
    </section>

    <section class="band" id="buttons">
      <div class="wrap">
        <header class="sec">
          <h2>1 · Button hover</h2>
          <p>Hover either button. Both are grayscale at rest. Each option is named for its fill, where its loop starts and whether a light follows the pointer. The glow takes the same moving colors; every option has the same glow (one blurred copy).</p>
        </header>
        <div class="mo-btns">
          {BUTTONS.map(v => (
            <figure class="mo-panel">
              <div class="mo-stage">
                <div class="actions" style={glowVars(BTN_GLOW) + (v.fill === 'specb-keys' ? `;--mo-spectrum:${KEYS_LOOP}` : '')} data-fill={v.fill} data-cursor={v.cursor ? '' : undefined} data-start={v.start}>
                  <a class="btn btn--solid mbtn" href="#buttons" onclick="return false"><span class="mbtn__layer mbtn__g1" aria-hidden="true"><i></i><i></i><i></i></span><span class="mbtn__layer mbtn__fill" aria-hidden="true"><i></i><i></i><i></i>{v.cursor && <b class="mbtn__hl"></b>}</span><span class="mbtn__label">Get started</span></a>
                  <a class="btn mbtn" href="#buttons" onclick="return false"><span class="mbtn__layer mbtn__g1" aria-hidden="true"><i></i><i></i><i></i></span><span class="mbtn__layer mbtn__fill" aria-hidden="true"><i></i><i></i><i></i>{v.cursor && <b class="mbtn__hl"></b>}</span><span class="mbtn__label">Read the docs</span></a>
                </div>
              </div>
              <figcaption><b>{v.name}{v.fav && <span class="mo-fav">Working favorite · {v.fav}</span>}</b><span>{v.note}</span><code>{v.fill}{v.cursor ? ' + cursor' : ''}{v.start ? ` · ${v.start} start` : ''} · glow {glowText(BTN_GLOW)}</code></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="band" id="icons">
      <div class="wrap">
        <header class="sec">
          <h2>2 · Icons in a set color</h2>
          <p>SyftHub’s Core Components, one hue per card: green, amber (gold), red, blue. The hue moves inside the stroke (4s per loop, over a gradient 4× the icon’s width). The line keeps its weight by size; nothing is filled.</p>
          <div class="actions mo-speed" role="group" aria-label="Icon speed, seconds per loop">
            <span class="muted">Speed</span>
            {ICON_SPEEDS.map(t => <button type="button" class="btn js-icon-speed" data-speed={t} aria-pressed={t === ICON_SPEED_DEFAULT ? 'true' : 'false'}>{t}s{t === ICON_SPEED_DEFAULT && ' · favorite'}</button>)}
          </div>
        </header>
        {ICONS.map(v => (
          <div class="mo-row" style={glowVars(v.g)}>
            <p class="mo-row__h"><b>{v.name}{v.fav && <span class="mo-fav">Working favorite · {v.fav}</span>}</b> <span>{v.note}</span> <code>{v.mono ? 'text color' : glowText(v.g)}{v.tone && ` · ${CARDS.map(c => `${c.hue} + ${v.tone === 'token' ? companion(c.hue) : prevHue(c.hue)}`).join(', ')}`}</code></p>
            <div class="mo-cards">
              {CARDS.map(c => (
                <div class="mo-card">
                  <span class:list={['cicon', { 'cicon--mono': v.mono }]} data-hue={c.hue} style={v.mono ? undefined : `--ci-stroke:url(#flow-${c.hue}${v.tone ? `-${v.tone}` : ''})`}>
                    {!v.mono && <span class="cicon__g2"><Fragment set:html={c.svg} /></span>}
                    {!v.mono && <span class="cicon__g1"><Fragment set:html={c.svg} /></span>}
                    <span class="cicon__line"><Fragment set:html={c.svg} /></span>
                  </span>
                  <h3 class="mo-card__title">{c.title}</h3>
                  <p class="mo-card__body">{c.body}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="band" id="cards">
      <div class="wrap">
        <header class="sec">
          <h2>3 · Hover cards</h2>
          <p>Hover a card: a soft white light follows the pointer, over the card and its content, so the text and marks pick up the glow too. Always-light cards take the light-mode value in either mode. The working favorite in light mode, and on always-light cards, is a shade instead: the card darkens except around the pointer (the guide’s <a href="/interface/#hover-cards">hover cards</a>; the page reviews’ Options, Card light).</p>
        </header>
        <div class="mo-row">
          <p class="mo-row__h"><b>Link cards <span class="mo-fav">Working favorite · dark mode</span></b> <span>SyftHub’s Quickstart, Installation, Core Concepts. On hover the icon takes its hue’s two-tone (amber, blue, green), the arrow stays mono.</span> <code>white, 480px, over card and content · dark 0.03 · light 0.2</code></p>
          <div class="mo-links">
            {LINKS.map(l => (
              <a class="mo-hcard mo-link" href="#cards" onclick="return false">
                <span class="mo-link__icon mo-hicon" style={`--ci-stroke:url(#flow-${l.hue}-token)`}><span class="mo-hicon__glow" aria-hidden="true"><Fragment set:html={l.svg} /></span><Fragment set:html={l.svg} /><span class="mo-hicon__color" aria-hidden="true"><Fragment set:html={l.svg} /></span></span>
                <span class="mo-link__text"><strong>{l.title}</strong><span>{l.sub}</span></span>
                <span class="mo-link__arrow"><Fragment set:html={ARROW} /></span>
                <span class="mo-hcard__light" aria-hidden="true"></span>
              </a>
            ))}
          </div>
        </div>
        <div class="mo-row">
          <p class="mo-row__h"><b>Press cards, always light</b> <span>The home page’s white plates: the light version in either mode.</span> <code>white, 480px, over card and content · 0.2</code></p>
          <div class="mo-press">
            {PRESS.map(c => (
              <a class="mo-hcard mo-pcard" data-section="always-light" href="#cards" onclick="return false">
                <span class="mo-pcard__mark">{c.org}</span>
                <span class="mo-pcard__title">{c.title}</span>
                <span class="mo-hcard__light" aria-hidden="true"></span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="band" id="flows">
      <div class="wrap">
        <header class="sec">
          <h2>3b · Card colorflow</h2>
          <p>Hover a card: a small colorflow fades in across its lower third, behind the text, in the card’s hue and its two-tone companion. One WebGL context draws every flow on the page; a card’s flow is made on hover and removed after it fades. Reduced motion shows a still frame. Two wave heights, each on three cards and one wide card.</p>
        </header>
        {FLOWS.map(f => (
          <div class="mo-row">
            <p class="mo-row__h"><b>{f.name}{f.fav && <span class="mo-fav">Working favorite · both modes</span>}</b> <span>{f.note}</span> <code>lower third · 0.55 light, 0.45 dark · two-tone stops</code></p>
            <div class="hcards">
              {CARDS.slice(0, 3).map(c => <HoverCard href="#flows" icon={liveToSet(c.live) ?? c.live} hue={c.hue} title={c.title} text={c.body} flow={f.k} />)}
            </div>
            <div class="mo-flow-wide">
