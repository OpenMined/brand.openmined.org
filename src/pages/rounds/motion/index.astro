  <script is:inline>
    (() => {
      const mo = document.querySelector('.mo');
      const pin = document.querySelector('.js-pin'), range = document.querySelector('.js-range');
      pin.addEventListener('click', () => {
        const on = pin.getAttribute('aria-checked') !== 'true';
        pin.setAttribute('aria-checked', on);
        mo.classList.toggle('is-pinned', on);
      });
      range.addEventListener('click', () => {
        const on = range.getAttribute('aria-checked') !== 'true';
        range.setAttribute('aria-checked', on);
        mo.dataset.range = on ? 'subtle' : 'normal';
      });
      // Icon speed: seconds per loop (the speed buttons; ?iconspeed=<s>), × 1.5 when Slower is on.
      const slow = document.querySelector('.js-slow');
      const speeds = [...document.querySelectorAll('.js-icon-speed')];
      let iconSpeed = Number(speeds.find(b => b.getAttribute('aria-pressed') === 'true').dataset.speed);
      const applyIconSpeed = () => {
        const t = iconSpeed * (mo.classList.contains('is-slow') ? 1.5 : 1);
        document.querySelectorAll('.mo-defs animateTransform').forEach(a => a.setAttribute('dur', `${t}s`));
        speeds.forEach(b => b.setAttribute('aria-pressed', String(Number(b.dataset.speed) === iconSpeed)));
      };
      speeds.forEach(b => b.addEventListener('click', () => { iconSpeed = Number(b.dataset.speed); applyIconSpeed(); }));
      slow.addEventListener('click', () => {
        const on = slow.getAttribute('aria-checked') !== 'true';
        slow.setAttribute('aria-checked', on);
        mo.classList.toggle('is-slow', on);
        applyIconSpeed();
      });
      // ?pin and ?subtle open the page with those switches on (for screenshots).
      const q = new URLSearchParams(location.search);
      if (q.has('pin')) pin.click();
      if (speeds.some(b => b.dataset.speed === q.get('iconspeed'))) { iconSpeed = Number(q.get('iconspeed')); applyIconSpeed(); }
      if (q.has('subtle')) range.click();
      // Pointer light (buttons and hover cards): ease toward the pointer each
      // frame, so it trails a little.
      document.querySelectorAll('[data-cursor] .mbtn, .mo-hcard, .mo-fm[data-hover] .ctl').forEach(btn => {
        let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
        const step = () => {
          x += (tx - x) * 0.15; y += (ty - y) * 0.15;
          btn.style.setProperty('--mx', `${x}px`); btn.style.setProperty('--my', `${y}px`);
          raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(step) : 0;
        };
        btn.addEventListener('pointerenter', e => { const r = btn.getBoundingClientRect(); x = tx = e.clientX - r.left; y = ty = e.clientY - r.top; step(); });
        btn.addEventListener('pointermove', e => {
          const r = btn.getBoundingClientRect(); tx = e.clientX - r.left; ty = e.clientY - r.top;
          if (!raf) raf = requestAnimationFrame(step);
        });
      });
      // H and I: where the spectrum loop starts, as a fraction of one loop
      // (--mo-start; the CSS turns it into a negative delay). Set on each hover,
      // and once now for Pin hover.
      const MINUTE = 60000;
      // J: the secondary button sits half a loop on (opposite on the wheel).
      const startAt = (mode, btn) => mode === 'random' ? Math.random()
        : ((Date.now() % MINUTE) / MINUTE + (mode === 'clock-opposite' && !btn.classList.contains('btn--solid') ? 0.5 : 0)) % 1;
      document.querySelectorAll('[data-start]').forEach(row => {
        const mode = row.getAttribute('data-start');
        row.querySelectorAll('.mbtn').forEach(btn => {
          const set = () => btn.style.setProperty('--mo-start', startAt(mode, btn).toFixed(4));
          set();
          btn.addEventListener('mo-start', set);
        });
      });
      // Every button: the color keeps running (.is-flowing) until the fill has
      // faded out, so mouseout doesn't snap it back to its first frame. A new
      // start (H–J) only when the button was fully at rest.
      document.querySelectorAll('.mbtn').forEach(btn => {
        const fill = btn.querySelector('.mbtn__fill');
        btn.addEventListener('pointerenter', () => {
          if (!btn.classList.contains('is-flowing')) btn.dispatchEvent(new Event('mo-start'));
          btn.classList.add('is-flowing');
        });
        fill.addEventListener('transitionend', e => {
          if (e.propertyName === 'opacity' && getComputedStyle(fill).opacity === '0') btn.classList.remove('is-flowing');
        });
      });
      // SMIL ignores prefers-reduced-motion; pause it by hand.
      const rm = matchMedia('(prefers-reduced-motion: reduce)'), defs = document.querySelectorAll('.mo-defs');
      const sync = () => defs.forEach(d => (rm.matches ? d.pauseAnimations() : d.unpauseAnimations()));
      sync(); rm.addEventListener('change', sync);
    })();
  </script>
</Site>

<style is:global>
  /* Ranges. Each shade is a mix of the key (500) and its neighbor (400 or 600);
     "keep" is how much of the key stays: 0% = the neighbor itself, 50% = halfway
     (no palette step sits there; exploration only). Defaults are the working
     favorites; One step subtler moves each one notch quieter.
       icons             400–600 → halfway
       pointer light     45% toward 300 → 22.5%
       hover-card light  0.2 light, 0.03 dark → half that
     Each mode keeps its own rule, so the two can be tuned apart; for now the
     dark values match light (Bennett reviews in dark and found it too subtle),
     except the hover-card light, where white on a dark card reads far stronger. */
  .mo { --mo-hl-keep: 55%; --mo-ic-keep: 0% }
  [data-theme="dark"] .mo { --mo-ic-keep: 0% }
  .mo[data-range="subtle"] { --mo-hl-keep: 77.5%; --mo-ic-keep: 50% }
  [data-theme="dark"] .mo[data-range="subtle"] { --mo-ic-keep: 50% }
