---
/**
 * ROUND — Color in motion (opened 2026-10-12). First tries at "if color, then
 * motion" (design/decisions/2026-10-12-if-color-then-motion.md):
 *   1. Button hover: the green fill becomes a slow shimmer of green steps, with a
 *      glow that carries the same moving colors.
 *   2. Icons in a set color: a gradient of one hue moves inside the stroke, with a
 *      glow that moves with it. Layout from SyftHub's Core Components.
 * The glow is the /research diamonds' technique: copies of the element behind it,
 * blurred and faded. Every variant draws the same fill; only the glow copies'
 * blur and opacity change (two copies, so one tight and one wide can be tried).
 * Colors are palette steps around each hue's key (500); nothing here is a loose value.
 */
import Site from '../../../layouts/Site.astro';
import { iconSvg, liveToSet } from '../../../lib/icons';
import { twoToneStops, TWO_TONE_COMPANION, listStops } from '../../../lib/tokens';

type Glow = { b1: number; o1: number; b2: number; o2: number; o1Light?: number };
// Glow 1's opacity can differ by mode (o1Light in light, o1 in dark).
const glowVars = (g: Glow) => `--g1-b:${g.b1}px;--g1-o-d:${g.o1};--g1-o-l:${g.o1Light ?? g.o1};--g2-b:${g.b2}px;--g2-o:${g.o2}`;
const glowText = (g: Glow) => [g.o1 && (g.o1Light !== undefined && g.o1Light !== g.o1 ? `blur ${g.b1}px at ${g.o1Light} light, ${g.o1} dark` : `blur ${g.b1}px at ${g.o1}`), g.o2 && `blur ${g.b2}px at ${g.o2}`].filter(Boolean).join(' + ') || 'no glow';

// Buttons: every variant takes the same glow (tight + wide); the fill changes.
// B: two green striped layers crossing at different angles, each flowing one way
// (the working favorite; earlier options, drifting patches and two-tone, pruned
// 2026-10-13). E–F: a long color loop (E the full OM gradient, F the hue keys) that starts on green, with
// layers crossing over it for shimmer. All carry the pointer light; on the
// spectrum it's neutral (white), since it rides over changing colors.
// One glow copy (was two, 3px at 0.35 + 14px at 0.2): fewer moving layers and blurs.
const BTN_GLOW: Glow = { b1: 8, o1: 0.3, b2: 0, o2: 0 };
// Option F's loop: the --gradient-interactive token's stops (hue keys), laid out as
// a 1200px repeating loop that starts on green 150px in, like the spectrum's.
// Colors arrive from the loop's end, so the stops are laid out in reverse: a hover
// runs green → teal → blue → violet → red → amber → green.
// Blended in OKLCH (shorter hue), so neighbors pass through clean hues: in sRGB,
// amber → green went through a muddy olive.
const KEYS = listStops('interactive').split(',').reverse();
const KEYS_LOOP = `repeating-linear-gradient(90deg in oklch, ${KEYS.map((k, i) => `var(--${k}) ${(150 + (1200 * i) / (KEYS.length - 1)).toFixed(1)}px`).join(', ')})`;
const BUTTONS: { k: string; name: string; note: string; fill: string; cursor?: boolean; fav?: string }[] = [
  { k: 'b', name: 'B · Crossing flows + cursor', note: 'Two striped green layers at 20° and −40°, each flowing one way (6s and 8.7s): lighter stripes underneath, faint darker ones over them; a soft light follows the pointer.', fill: 'flow', cursor: true },
  { k: 'e', name: 'E · Spectrum under B’s shimmer + cursor', note: 'B’s two crossing layers in grayscale (white stripes at 20°, dark at −40°, B’s sizes and speeds), faint, over the full OM gradient drifting slowly (1200px, 30s). Starts on green.', fill: 'specb', cursor: true, fav: 'both modes · on the guide and the page reviews' },
  { k: 'f', name: 'F · Hue keys under B’s shimmer + cursor', note: 'E, with the loop in hue keys only (--gradient-interactive): green, teal, blue, violet, red, amber. The pale stops are gone, so the white label stays at the green key’s contrast (about 3.8:1) or better. Runs green → teal → blue → violet → red → amber; blended in OKLCH.', fill: 'specb-keys', cursor: true },
];

// Links: the content link's hover line as a moving gradient with a 3px glow band.
const LINK_ROWS: { k: string; name: string; note: string; cls: string; fav?: string }[] = [
  { k: 'a', name: 'A · Before', note: 'The accent key (green), 1px, grows over the underline from the left.', cls: 'mo-lk--green' },
  { k: 'b', name: 'B · Spectrum + glow', note: 'The full OM gradient moves along the line (each hue spans the link’s length, so two colors at most; one hue every 1.7s), with a glow band of the same colors at 35% behind it: the line plus 1px on every side.', cls: 'mo-lk--spec', fav: 'both modes · on the guide and the page reviews' },
  { k: 'c', name: 'C · Hue keys + glow', note: 'B with --gradient-interactive, running green → teal → blue → violet → red → amber, blended in OKLCH.', cls: 'mo-lk--keys' },
];

// Icons: SyftHub › Core Components, one hue per card.
const CARDS = [
  { live: 'database', hue: 'green', title: 'Datasets', body: 'Upload documents or connect vector databases like Weaviate, Qdrant, or ChromaDB. Files are automatically indexed for AI search.' },
  { live: 'sparkles', hue: 'amber', title: 'Models', body: 'Connect OpenAI, Anthropic, Ollama, vLLM, or any OpenAI-compatible provider. Your choice, your keys.' },
  { live: 'code', hue: 'red', title: 'Endpoints', body: 'Combine datasets and models into queryable RAG endpoints. Configure output as search results, AI summaries, or both.' },
  { live: 'settings', hue: 'blue', title: 'Policies', body: 'Control access, set rate limits, and configure pricing. Your knowledge, your terms.' },
].map(c => ({ ...c, svg: iconSvg(liveToSet(c.live) ?? c.live, { size: 32 }) }));
const HUES = [...new Set(CARDS.map(c => c.hue))];

// Hover cards: SyftHub's link cards and the home page's press cards (white plates).
const LINKS = [
  { icon: 'zap', hue: 'amber', title: 'Quickstart', sub: 'Get up and running in 5 minutes' },
  { icon: 'installation', hue: 'blue', title: 'Installation', sub: 'Desktop app or Docker deployment' },
  { icon: 'core-concepts', hue: 'green', title: 'Core Concepts', sub: 'Learn the building blocks' },
].map(l => ({ ...l, svg: iconSvg(liveToSet(l.icon) ?? 'arrow-right', { size: 24 }) }));
const PRESS = [
  { org: 'Partner one', title: 'Secure enclaves for AI evaluation' },
  { org: 'Partner two', title: 'Privacy-preserving data science' },
  { org: 'Partner three', title: 'Federated learning in practice' },
];
const ARROW = iconSvg('arrow-right', { size: 24 });

const ICONS: { k: string; name: string; note: string; mono?: boolean; g: Glow; fav?: string; tone?: 'token' | 'prev' }[] = [
  { k: 'mono', name: 'Mono · today', note: 'The text color, still. The reference.', mono: true, g: { b1: 0, o1: 0, b2: 0, o2: 0 } },
  { k: 'a', name: 'A · Color in the stroke', note: 'The hue moves inside the line; no glow.', g: { b1: 0, o1: 0, b2: 0, o2: 0 } },
  { k: 'b', name: 'B · Tight glow', note: 'One copy close to the line, so it reads as light rather than haze.', g: { b1: 3, o1: 0.4, b2: 0, o2: 0 } },
  { k: 'c', name: 'C · Soft glow', note: 'One copy, blurred more.', g: { b1: 6, o1: 0.4, o1Light: 0.25, b2: 0, o2: 0 } },
  { k: 'd', name: 'D · Tight + wide', note: 'A close copy for the line, a wide faint one around it.', g: { b1: 2, o1: 0.35, b2: 10, o2: 0.2 } },
  { k: 'e', name: 'E · Two-tone, companion per hue', note: 'C, with each hue’s two-tone token (--gradient-two-tone-<hue>): its companion passes through once per loop.', g: { b1: 6, o1: 0.4, o1Light: 0.25, b2: 0, o2: 0 }, tone: 'token', fav: 'both modes · 400–600' },
  { k: 'f', name: 'F · Two-tone, other side', note: 'C, with the hue one step back around the wheel (automatic).', g: { b1: 6, o1: 0.4, o1Light: 0.25, b2: 0, o2: 0 }, tone: 'prev' },
];
// One moving gradient per hue (id `${prefix}-${hue}`), shared by every icon of that
// hue and its glow copies, so the glow moves with the line. Bottom left → top right
// (−45° about the icon's center), repeating every 48 units (twice the icon), slid
// one period along that axis per loop: seamless, like the diamonds. Stop colors
// resolve where the gradient sits, so each range context gets its own set.
// The palette's hues in order around the wheel; a hue's neighbors are one step
// either way (red wraps to violet).
const WHEEL = ['red', 'amber', 'green', 'teal', 'blue', 'violet'];
const prevHue = (h: string) => WHEEL[(WHEEL.indexOf(h) + WHEEL.length - 1) % WHEEL.length];
const mix = (h: string, s: number) => `color-mix(in oklch, var(--${h}-500) var(--mo-ic-keep), var(--${h}-${s}))`;
// One hue: key → lighter → key → darker → key. Two-tone (automatic): the neighbor's
// key takes the middle stop, so it passes through once per loop.
const stopsFor = (h: string, n?: string) => [
  `var(--${h}-500)`, mix(h, 400), n ? `var(--${n}-500)` : `var(--${h}-500)`, mix(h, 600), `var(--${h}-500)`,
];
// Two-tone token: gradient.two-tone-<hue> (its companion chosen per hue in
// tools/palette/inputs.json); stops 1 and 3 mix back toward the key by the range.
const TWO_TONE = Object.fromEntries(WHEEL.map(h => [h, twoToneStops(h)]));
const companion = (h: string) => TWO_TONE_COMPANION[h];
const tokenStops = (h: string) => TWO_TONE[h].map((t, i) =>
  i === 1 || i === 3 ? `color-mix(in oklch, var(--${TWO_TONE[h][0]}) var(--mo-ic-keep), var(--${t}))` : `var(--${t})`);
// 96 units (2× the earlier 48; 4× the icon's 24 grid), slid one period per
// loop, so the whole band never fits inside the icon. 8s keeps the earlier speed.
const grad = (id: string, stops: string[]) => `<linearGradient id="${id}" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="96" y2="0" spreadMethod="repeat" gradientTransform="rotate(-45 12 12)">${stops.map((c, i) => `<stop offset="${i / 4}" style="stop-color:${c}"/>`).join('')}<animateTransform attributeName="gradientTransform" type="translate" from="0 0" to="96 0" dur="8s" repeatCount="indefinite" additive="sum"/></linearGradient>`;
const defs = (prefix: string) => `<svg class="mo-defs" width="0" height="0" aria-hidden="true" focusable="false"><defs>${HUES.map(h =>
  grad(`${prefix}-${h}`, stopsFor(h)) + grad(`${prefix}-${h}-token`, tokenStops(h)) + grad(`${prefix}-${h}-prev`, stopsFor(h, prevHue(h)))).join('')}</defs></svg>`;

---
<Site title="Color in motion round" description="If color, then motion: button hover shimmer and icons in a set color, with a glow that moves.">
  <div class="mo" data-range="normal">
    <!-- One moving gradient per hue, shared by every icon of that hue (and its glow
         copies, so the glow moves with the line). Turned to run bottom left → top right (−45° about the icon's center), repeating every 48 units (twice the
         icon), slid one period along that axis per loop: seamless, like the diamonds. -->
    <Fragment set:html={defs('flow')} />

    <section class="wrap hero">
      <span class="eyebrow"><span class="eyebrow__dot"></span>Round · opened 12 Oct 2026</span>
      <h1>Color in motion</h1>
      <p class="lead">First tries at <em>if color, then motion</em>: the button hover as a moving fill with a glow, and icons in a set color whose line moves and glows. The glow is the /research diamonds’ technique: copies behind, blurred and faded.</p>
      <p class="status">Status: <b>exploring</b> · each hue moves around its key (500) · defaults are the working favorites, set per mode (the same in both for now): buttons 300–700; icons 400–600 · <i>One step subtler</i>: buttons 400–600; icons halfway; pointer and card lights halved</p>
      <div class="mo-ctl">
        <label class="mo-ctl__item">
          <button type="button" class="switch js-pin" role="switch" aria-checked="false" aria-label="Show every button in its hover state"><span class="switch__knob"></span></button>
          <span>Pin buttons in hover</span>
        </label>
        <label class="mo-ctl__item">
          <button type="button" class="switch js-slow" role="switch" aria-checked="false" aria-label="Slower animation"><span class="switch__knob"></span></button>
          <span>Slower <span class="muted">(⅔ speed)</span></span>
        </label>
        <label class="mo-ctl__item">
          <button type="button" class="switch js-range" role="switch" aria-checked="false" aria-label="One step subtler"><span class="switch__knob"></span></button>
          <span>One step subtler <span class="muted">(each element one notch past its pick)</span></span>
        </label>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <header class="sec">
          <h2>1 · Button hover</h2>
          <p>Hover either button. Both are grayscale at rest. B moves through the green steps around the key (<code>--accent-key</code>); E and F start on green and drift around the wheel: E through the full OM gradient, F through the hue keys only. The glow takes the same moving colors. Every variant has the same glow (one blurred copy); the fill changes.</p>
        </header>
        <div class="mo-btns">
          {BUTTONS.map(v => (
            <figure class="mo-panel">
              <div class="mo-stage">
                <div class="actions" style={glowVars(BTN_GLOW) + (v.fill === 'specb-keys' ? `;--mo-spectrum:${KEYS_LOOP}` : '')} data-fill={v.fill} data-cursor={v.cursor ? '' : undefined}>
                  <a class="btn btn--solid mbtn" href="#buttons" onclick="return false"><span class="mbtn__layer mbtn__g1" aria-hidden="true"><i></i><i></i><i></i></span><span class="mbtn__layer mbtn__fill" aria-hidden="true"><i></i><i></i><i></i>{v.cursor && <b class="mbtn__hl"></b>}</span><span class="mbtn__label">Get started</span></a>
                  <a class="btn mbtn" href="#buttons" onclick="return false"><span class="mbtn__layer mbtn__g1" aria-hidden="true"><i></i><i></i><i></i></span><span class="mbtn__layer mbtn__fill" aria-hidden="true"><i></i><i></i><i></i>{v.cursor && <b class="mbtn__hl"></b>}</span><span class="mbtn__label">Read the docs</span></a>
                </div>
              </div>
              <figcaption><b>{v.name}{v.fav && <span class="mo-fav">Working favorite · {v.fav}</span>}</b><span>{v.note}</span><code>{v.fill}{v.cursor ? ' + cursor' : ''} · glow {glowText(BTN_GLOW)}</code></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <header class="sec">
          <h2>2 · Icons in a set color</h2>
          <p>SyftHub’s Core Components, one hue per card: green, amber (gold), red, blue. The hue moves inside the stroke (6s per loop, over a gradient 3× the icon’s width). The line keeps its weight by size; nothing is filled.</p>
        </header>
        {ICONS.map(v => (
          <div class="mo-row" style={glowVars(v.g)}>
            <p class="mo-row__h"><b>{v.name}{v.fav && <span class="mo-fav">Working favorite · {v.fav}</span>}</b> <span>{v.note}</span> <code>{v.mono ? 'text color' : glowText(v.g)}{v.tone && ` · ${CARDS.map(c => `${c.hue} + ${v.tone === 'token' ? companion(c.hue) : prevHue(c.hue)}`).join(', ')}`}</code></p>
            <div class="mo-cards">
              {CARDS.map(c => (
                <div class="mo-card">
                  <span class:list={['cicon', { 'cicon--mono': v.mono }]} data-hue={c.hue} style={v.mono ? undefined : `--ci-stroke:url(#flow-${c.hue}${v.tone ? `-${v.tone}` : ''})`}>
                    {!v.mono && <span class="cicon__g2"><Fragment set:html={c.svg} /></span>}
                    {!v.mono && <span class="cicon__g1"><Fragment set:html={c.svg} /></span>}
                    <span class="cicon__line"><Fragment set:html={c.svg} /></span>
                  </span>
                  <h3 class="mo-card__title">{c.title}</h3>
                  <p class="mo-card__body">{c.body}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <header class="sec">
          <h2>3 · Hover cards</h2>
          <p>Hover a card: a soft white light follows the pointer, over the card and its content, so the text and marks pick up the glow too. Always-light cards take the light-mode value in either mode.</p>
        </header>
        <div class="mo-row">
          <p class="mo-row__h"><b>Link cards <span class="mo-fav">Working favorite · both modes</span></b> <span>SyftHub’s Quickstart, Installation, Core Concepts. On hover the icon takes its hue’s two-tone (amber, blue, green), the arrow stays mono.</span> <code>white, 480px, over card and content · dark 0.03 · light 0.2</code></p>
          <div class="mo-links">
            {LINKS.map(l => (
              <a class="mo-hcard mo-link" href="#cards" onclick="return false">
                <span class="mo-link__icon mo-hicon" style={`--ci-stroke:url(#flow-${l.hue}-token)`}><span class="mo-hicon__glow" aria-hidden="true"><Fragment set:html={l.svg} /></span><Fragment set:html={l.svg} /><span class="mo-hicon__color" aria-hidden="true"><Fragment set:html={l.svg} /></span></span>
                <span class="mo-link__text"><strong>{l.title}</strong><span>{l.sub}</span></span>
                <span class="mo-link__arrow"><Fragment set:html={ARROW} /></span>
                <span class="mo-hcard__light" aria-hidden="true"></span>
              </a>
            ))}
          </div>
        </div>
        <div class="mo-row">
          <p class="mo-row__h"><b>Press cards, always light <span class="mo-fav">Working favorite · both modes</span></b> <span>The home page’s white plates: the light version in either mode.</span> <code>white, 480px, over card and content · 0.2</code></p>
          <div class="mo-press">
            {PRESS.map(c => (
              <a class="mo-hcard mo-pcard" data-section="always-light" href="#cards" onclick="return false">
                <span class="mo-pcard__mark">{c.org}</span>
                <span class="mo-pcard__title">{c.title}</span>
                <span class="mo-hcard__light" aria-hidden="true"></span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <header class="sec">
          <h2>4 · Links</h2>
          <p>Hover the links in each line. Only content links, the ones with a resting gray underline, get a colored line; links without one (nav, footer, text buttons) still draw a gray line in their own color. Text keeps its color; the line does the work. Pure CSS, no added markup: the hover line is a background layer whose gradient stops shift (a registered custom property), and the glow is one more background layer, so it wraps with the link.</p>
        </header>
        {LINK_ROWS.map(r => (
          <div class="mo-row">
            <p class="mo-row__h"><b>{r.name}{r.fav && <span class="mo-fav">Working favorite · {r.fav}</span>}</b> <span>{r.note}</span></p>
            <p class="mo-lk-demo">A link inside running text, like <a class:list={['link-content', 'mo-lk', r.cls]} href="#links" onclick="return false">attribution-based control</a>, or a longer one that may wrap onto the next line, like <a class:list={['link-content', 'mo-lk', r.cls]} href="#links" onclick="return false">structured transparency for governing information flows</a>, keeps the color of the text around it.</p>
          </div>
        ))}
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <header class="sec"><h2>Open</h2></header>
        <div class="notes"><div><ul>
          <li>Which glow reads as light, not blur (Bennett: “if they look blurry, it’ll be a bummer”). Judge in both modes, at 100% zoom.</li>
          <li>Range: the key’s neighbors (400–600), halfway, or a quarter of the way (mixes; no palette step sits there). The button’s white label has to hold its contrast across the whole loop.</li>
          <li>Speed: icons 8s per loop (96-unit gradient); button flows 6s and 8.7s; button patches 4.7–9.3s. <i>Slower</i>: icons 12s; flows 9s and 13s; patches 7–14s. The diamonds take 16s for the whole spectrum.</li>
          <li>Whether four hues in one row is lively or a kaleidoscope. This round only tries the treatment, not where it belongs.</li>
          <li>Reduced motion: everything here stops and the color stays.</li>
        </ul></div></div>
      </div>
    </section>
  </div>

  <script is:inline>
    (() => {
      const mo = document.querySelector('.mo');
      const pin = document.querySelector('.js-pin'), range = document.querySelector('.js-range');
      pin.addEventListener('click', () => {
        const on = pin.getAttribute('aria-checked') !== 'true';
        pin.setAttribute('aria-checked', on);
        mo.classList.toggle('is-pinned', on);
      });
      range.addEventListener('click', () => {
        const on = range.getAttribute('aria-checked') !== 'true';
        range.setAttribute('aria-checked', on);
        mo.dataset.range = on ? 'subtle' : 'normal';
      });
      const slow = document.querySelector('.js-slow');
      slow.addEventListener('click', () => {
        const on = slow.getAttribute('aria-checked') !== 'true';
        slow.setAttribute('aria-checked', on);
        mo.classList.toggle('is-slow', on);
        document.querySelectorAll('.mo-defs animateTransform').forEach(a => a.setAttribute('dur', on ? '12s' : '8s'));
      });
      // ?pin and ?subtle open the page with those switches on (for screenshots).
      const q = new URLSearchParams(location.search);
      if (q.has('pin')) pin.click();
      if (q.has('subtle')) range.click();
      // Pointer light (buttons and hover cards): ease toward the pointer each
      // frame, so it trails a little.
      document.querySelectorAll('[data-cursor] .mbtn, .mo-hcard').forEach(btn => {
        let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
        const step = () => {
          x += (tx - x) * 0.15; y += (ty - y) * 0.15;
          btn.style.setProperty('--mx', `${x}px`); btn.style.setProperty('--my', `${y}px`);
          raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(step) : 0;
        };
        btn.addEventListener('pointerenter', e => { const r = btn.getBoundingClientRect(); x = tx = e.clientX - r.left; y = ty = e.clientY - r.top; step(); });
        btn.addEventListener('pointermove', e => {
          const r = btn.getBoundingClientRect(); tx = e.clientX - r.left; ty = e.clientY - r.top;
          if (!raf) raf = requestAnimationFrame(step);
        });
      });
      // SMIL ignores prefers-reduced-motion; pause it by hand.
      const rm = matchMedia('(prefers-reduced-motion: reduce)'), defs = document.querySelectorAll('.mo-defs');
      const sync = () => defs.forEach(d => (rm.matches ? d.pauseAnimations() : d.unpauseAnimations()));
      sync(); rm.addEventListener('change', sync);
    })();
  </script>
</Site>

<style is:global>
  /* Ranges. Each shade is a mix of the key (500) and its neighbor (400 or 600);
     "keep" is how much of the key stays: 0% = the neighbor itself, 50% = halfway
     (no palette step sits there; exploration only). Defaults are the working
     favorites; One step subtler moves each one notch quieter.
       buttons           300–700 → 400–600
       icons             400–600 → halfway
       pointer light     45% toward 300 → 22.5%
       hover-card light  0.2 light, 0.03 dark → half that
     Each mode keeps its own rule, so the two can be tuned apart; for now the
     dark values match light (Bennett reviews in dark and found it too subtle),
     except the hover-card light, where white on a dark card reads far stronger. */
  .mo { --mo-hl-keep: 55%; --mo-ic-keep: 0%; --mo-green-lo: var(--green-300); --mo-green-hi: var(--green-700); }
  [data-theme="dark"] .mo { --mo-ic-keep: 0%; --mo-green-lo: var(--green-300); --mo-green-hi: var(--green-700); }
  .mo[data-range="subtle"] { --mo-hl-keep: 77.5%; --mo-ic-keep: 50%; --mo-green-lo: var(--green-400); --mo-green-hi: var(--green-600); }
  [data-theme="dark"] .mo[data-range="subtle"] { --mo-ic-keep: 50%; --mo-green-lo: var(--green-400); --mo-green-hi: var(--green-600); }
  .mo { --mo-hl: color-mix(in oklch, var(--green-500) var(--mo-hl-keep), var(--green-300)); }
  .mo-defs { position: absolute; width: 0; height: 0; overflow: hidden; }

  /* Speed: 1.5 by default; Slower sets 1 (durations are written at speed 1). */
  .mo { --mo-speed: 1.5; }
