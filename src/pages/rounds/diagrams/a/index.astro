---
import Shell from '../_Shell.astro';
import Fig1 from '../_a/Fig1.astro';
import Fig2 from '../_a/Fig2.astro';
import Fig3 from '../_a/Fig3.astro';
---
<Shell dir="a" name="A · Attribution in color" levelMarks
  note="Color carries the argument. Each source keeps its own hue from the palette; where attribution is lost the colors drain to gray, and where it is kept they arrive intact. Figures sit on a dark stage in both color modes.">
  <Fig1 slot="fig1" />
  <Fig2 slot="fig2" />
  <Fig3 slot="fig3" />
</Shell>
