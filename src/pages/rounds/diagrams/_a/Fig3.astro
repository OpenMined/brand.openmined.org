---
/**
 * A3 — The medical student, drawn as attribution in color.
 *
 * Four kinds of source, one hue each. Traditional: the colors run into the
 * model and blur together — literally mixed, with a Gaussian blur inside
 * the "erased" zone — so what reaches the student is gray. The three
 * non-fixes are labeled where they act. ABC: the journals' teal reaches the
 * student intact, and the student's ring says which sources answered.
 */
import { spread, hcurve } from '../_geo';

const GROUPS = [
  { label: ['Peer-reviewed', 'journals'], hue: 'teal' },
  { label: ['Blogs'], hue: 'amber' },
  { label: ['Fantasy novel'], hue: 'violet' },
  { label: ['TV shows'], hue: 'red' },
];
const PER = 4, XS = 122, CY = 190, XU = 398;
const Y = spread(GROUPS.length * PER, 40, 340);
const G = (i: number) => GROUPS[Math.floor(i / PER)];
const col = (i: number) => `var(--${G(i).hue}-key)`;
const mid = (g: number) => (Y[g * PER] + Y[g * PER + PER - 1]) / 2;
// The zone where attribution is erased
const ZX = 226, ZR = 48;
const AI1 = 300, AI2 = 350, R = 17;
---

<div class="fig fig-a">
  <div class="panels">
    <div>
      <p class="panel__head"><span class="panel__eyebrow">Today</span><span class="panel__title">Open- and closed-source AI</span></p>
      <svg viewBox="0 0 460 360" role="img" aria-label="Journals, blogs, a fantasy novel and TV shows each have a color. Their lines blur together into gray inside the model, where attribution is erased. RLHF, influence functions and oversight each act elsewhere and leave the core problem untouched. The medical student receives a gray answer.">
        <defs>
          <mask id="a3-outside"><rect width="460" height="360" fill="white" /><circle cx={ZX} cy={CY} r={ZR} fill="black" /></mask>
          <clipPath id="a3-inside"><circle cx={ZX} cy={CY} r={ZR} /></clipPath>
          <filter id="a3-mix" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="9" /></filter>
          <marker id="a3-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L8,4 L0,8 z" class="fill-m" /></marker>
        </defs>

        <text class="col-label" x="16" y="22">People with data</text>
        {GROUPS.map((g, k) => (
          <g>
            <path d={`M${XS - 16},${Y[k * PER]} h-4 V${Y[k * PER + PER - 1]} h4`} class="bracket" />
            {g.label.map((t, j) => <text x={XS - 26} y={mid(k) + 4 + (j - (g.label.length - 1) / 2) * 15} class="grp" text-anchor="end">{t}</text>)}
          </g>
        ))}

        <g mask="url(#a3-outside)">
          {Y.map((y, i) => <path d={hcurve(XS, y, ZX, CY, 0.55)} style={`stroke:${col(i)}`} class="line-src" />)}
        </g>
        <g clip-path="url(#a3-inside)">
          <circle cx={ZX} cy={CY} r={ZR} class="zone-bg" />
          <g filter="url(#a3-mix)">
            {Y.map((y, i) => <path d={hcurve(XS, y, ZX + 30, CY, 0.55)} style={`stroke:${col(i)}`} class="line-mix" />)}
          </g>
          <circle cx={ZX} cy={CY} r={ZR} class="zone-dull" />
        </g>
        <circle cx={ZX} cy={CY} r={ZR} class="zone-edge" />
        <text x={ZX} y={CY - 5} class="zone-k mono" text-anchor="middle">core problem</text>
        <text x={ZX} y={CY + 12} class="zone-t" text-anchor="middle">Erased data</text>

        <path d={`M${ZX + ZR},${CY} H${AI1 - R}`} class="line-out" />
        <path d={`M${AI1 + 4},${CY - R - 2} C${AI1 + 12},${CY - 50} ${AI2 - 12},${CY - 50} ${AI2 - 4},${CY - R - 3}`} class="line-deploy" marker-end="url(#a3-arrow)" />
        {[AI1, AI2].map(x => (<g><circle cx={x} cy={CY} r={R} class="ai" /><text x={x} y={CY + 4} class="ai-t mono" text-anchor="middle">AI</text></g>))}
        <path d={`M${AI2 + R},${CY} H${XU - 6}`} class="line-ask" />
        <circle cx={XU} cy={CY} r="5.5" class="ask" />
        <text x={XU + 12} y={CY - 3} class="who"><tspan x={XU + 12}>Medical</tspan><tspan x={XU + 12} dy="15">student</tspan></text>

        {/* The three non-fixes, labeled where each one acts */}
        <circle cx={ZX} cy={CY - ZR - 38} r="5" class="added" />
        <path d={`M${ZX},${CY - ZR - 32} V${CY - ZR - 4}`} class="lead" />
        <path d={`M${ZX},${CY - ZR - 44} V52`} class="lead" />
        <text x={ZX + 40} y="30" class="note" text-anchor="middle"><tspan x={ZX + 40}>RLHF just adds more data…</tspan><tspan x={ZX + 40} dy="14">not the core problem</tspan></text>

        <path d={`M${AI1 - 6},${CY - R - 1} C${AI1 - 22},${CY - 56} ${ZX + 36},${CY - 62} ${ZX + 30},${CY - ZR + 6}`} class="lead lead--dash" marker-end="url(#a3-arrow)" />
        <text x="456" y="100" class="note" text-anchor="end"><tspan x="456">Influence functions look for</tspan><tspan x="456" dy="14">data that’s already gone</tspan></text>

        <path d={`M${(AI2 + R + XU) / 2},${CY + 6} V${CY + 58}`} class="lead" />
        <text x="456" y={CY + 74} class="note" text-anchor="end"><tspan x="456">Oversight just watches what</tspan><tspan x="456" dy="14">comes out… not the core problem</tspan></text>

        {Y.map((y, i) => <circle cx={XS} cy={y} r="4.5" style={`fill:${col(i)}`} />)}
      </svg>
    </div>

    <div>
      <p class="panel__head"><span class="panel__eyebrow">With ABC</span><span class="panel__title">ABC-enabled AI</span></p>
      <svg viewBox="0 0 460 360" role="img" aria-label="The same sources connect straight to the medical student. The peer-reviewed journals' lines arrive in full color; the others stay dim. The student's ring shows the journals' color: the answer knows its source.">
        <text class="col-label" x="16" y="22">People with data</text>
        {GROUPS.map((g, k) => (
          <g>
            <path d={`M${XS - 16},${Y[k * PER]} h-4 V${Y[k * PER + PER - 1]} h4`} class="bracket" />
            {g.label.map((t, j) => <text x={XS - 26} y={mid(k) + 4 + (j - (g.label.length - 1) / 2) * 15} class="grp" text-anchor="end">{t}</text>)}
          </g>
        ))}

        {Y.map((y, i) => i >= PER && <path d={hcurve(XS, y, XU - 14, CY, 0.6)} style={`stroke:${col(i)}`} class="line-idle" />)}
        {Y.map((y, i) => i < PER && <path d={hcurve(XS, y, XU - 14, CY, 0.6)} style={`stroke:${col(i)}`} class="line-kept" />)}
        {Y.map((y, i) => <circle cx={XS} cy={y} r="4.5" style={`fill:${col(i)}`} class={i < PER ? '' : 'idle'} />)}

        <circle cx={XU} cy={CY} r="10" class="ring" style="stroke:var(--teal-key)" />
        <circle cx={XU} cy={CY} r="4.5" class="ask" />
        <text x={XU + 12} y={CY - 3} class="who"><tspan x={XU + 12}>Medical</tspan><tspan x={XU + 12} dy="15">student</tspan></text>

        <path d={`M${XU},${CY + 16} V${CY + 50}`} class="lead" />
        <text x={XU} y={CY + 66} class="note" text-anchor="middle"><tspan x={XU}>Solution is</tspan><tspan x={XU} dy="14">clarity here</tspan></text>
      </svg>
    </div>
  </div>
</div>

<style>
  .fig-a { background: var(--c-raise-1); box-shadow: var(--c-shadow-1); border-radius: var(--border-radius-L); padding: 28px 28px 20px; }
  .col-label { font-size: 12.5px; fill: var(--c-b); }
  .grp { font-size: 11.5px; fill: var(--c-b); }
  .bracket { fill: none; stroke: var(--c-line-strong); stroke-width: 1; }
  .line-src { fill: none; stroke-width: 1.25; opacity: 0.9; }
  .line-mix { fill: none; stroke-width: 7; }
  .zone-bg { fill: var(--c-raise-1); }
  .zone-dull { fill: var(--c-line-strong); opacity: 0.55; }
  .zone-edge { fill: none; stroke: var(--c-m); stroke-width: 1; stroke-dasharray: 2 3; }
  .zone-k { font-size: 8.5px; letter-spacing: 0.08em; text-transform: uppercase; fill: var(--c-b); }
  .zone-t { font-size: 12.5px; font-weight: 600; fill: var(--c-h); }
  .line-out { fill: none; stroke: var(--connector); stroke-width: 1.25; }
  .line-ask { fill: none; stroke: var(--connector); stroke-width: 1.75; }
  .line-deploy { fill: none; stroke: var(--c-m); stroke-width: 1.25; }
  .fill-m { fill: var(--c-m); }
  .ai { fill: var(--c-line-strong); stroke: var(--connector); stroke-width: 1; }
  .ai-t { font-size: 11px; font-weight: 600; fill: var(--c-h); }
  .ask { fill: var(--c-h); }
  .who { font-size: 13px; font-weight: 600; fill: var(--c-h); }
  .added { fill: var(--c-raise-1); stroke: var(--c-b); stroke-width: 1.25; stroke-dasharray: 2 2; }
  .lead { fill: none; stroke: var(--c-m); stroke-width: 1; }
  .lead--dash { stroke-dasharray: 3 3; }
  .note { font-size: 11px; font-style: italic; fill: var(--c-b); }
  .line-kept { fill: none; stroke-width: 1.75; }
  .line-idle { fill: none; stroke-width: 1; opacity: 0.16; }
  .idle { opacity: 0.35; }
  .ring { fill: none; stroke-width: 3; }
</style>
