---
/**
 * COLOR ROUND — gray midtone boost (moved from the brand site's Color page,
 * 2026-10-13: review material, not guidance). Adds chroma to the gray ramp on a
 * bell curve over lightness: chroma += amount × exp(−(L − center)² / (2 · width²)),
 * in OKLCH, each step's own L and H kept. The default (amount 0.008, center 54,
 * width 15; review, 2026-10-12) is built into the gray tokens
 * (tools/palette/inputs.json gray.midtone_boost). The sliders preview on this
 * section's swatches and table only; nothing is saved.
 */
import GRAY_FILE from '../../../../tokens/base/gray.json';
const STEPS = ['50', '100', '200', '300', '400', '500', '600', '700', '800', '900', '950'];
const BOOST = { amount: 0.008, center: 54, width: 15 };
const GR = STEPS.map(s => {
  const t = (GRAY_FILE as any).gray[s], c = t.$extensions['org.openmined'].beforeBoost ?? t.$value;
  return { step: s, hex: c.hex, built: t.$value.hex, L: c.components[0] * 100, C: c.components[1], H: c.components[2] };
});
---
<section class="band" id="gray-boost">
  <div class="wrap">
    <header class="sec">
      <span class="sec__n">06</span>
      <h2>Gray midtone boost</h2>
      <p>Closed: the default is built into the gray tokens. Adds chroma on a bell curve over lightness, most at the center, little or none at the light and dark ends; each step keeps its own hue. The sliders preview on the swatches and table below only; nothing is saved.</p>
    </header>
    <div class="gbr" data-grays={JSON.stringify(GR)}>
      <div class="gbr__row">{GR.map(g => <div class="gbr__cell"><span class="gbr__sw" data-step={g.step} style={`background:${g.built}`}></span><b>{g.step}</b><code class="js-sw-hex" data-step={g.step}>{g.built}</code></div>)}</div>
      <div class="gbr__ctl">
        <label>Amount <b class="js-gb-out" data-for="amount">{BOOST.amount.toFixed(3)}</b><input type="range" class="js-gb" data-k="amount" min="0" max="0.04" step="0.002" value={BOOST.amount} /></label>
        <label>Center (lightness) <b class="js-gb-out" data-for="center">{BOOST.center}</b><input type="range" class="js-gb" data-k="center" min="35" max="85" step="1" value={BOOST.center} /></label>
        <label>Width <b class="js-gb-out" data-for="width">{BOOST.width}</b><input type="range" class="js-gb" data-k="width" min="6" max="30" step="1" value={BOOST.width} /></label>
        <button type="button" class="gbr__btn js-gb-reset">No boost</button>
        <button type="button" class="gbr__btn js-gb-preset" data-amount={BOOST.amount} data-center={BOOST.center} data-width={BOOST.width}>Default</button>
      </div>
      <table class="gbr__tbl">
        <thead><tr><th>Step</th><th>Lightness</th><th>Chroma before boost</th><th>Added</th><th>Chroma</th><th>Before boost</th><th>Becomes</th></tr></thead>
        <tbody>{GR.map(g => <tr data-step={g.step}><td>gray {g.step}</td><td>{g.L.toFixed(1)}</td><td>{g.C.toFixed(4)}</td><td class="js-add">…</td><td class="js-c">…</td><td><code>{g.hex}</code></td><td><span class="gbr__chip" style={`background:${g.built}`}></span><code class="js-hex">{g.built}</code></td></tr>)}</tbody>
      </table>
    </div>
  </div>
</section>

<script>
  const box = document.querySelector<HTMLElement>('.gbr');
  if (box) {
    const GR: { step: string; hex: string; built: string; L: number; C: number; H: number }[] = JSON.parse(box.dataset.grays!);
    const toRgb = (L: number, C: number, H: number) => {
      const h = (H * Math.PI) / 180, Lf = L / 100, A = C * Math.cos(h), B = C * Math.sin(h);
      const l = (Lf + 0.3963377774 * A + 0.2158037573 * B) ** 3, m = (Lf - 0.1055613458 * A - 0.0638541728 * B) ** 3, s = (Lf - 0.0894841775 * A - 1.291485548 * B) ** 3;
      return [4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s, -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s, -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s];
    };
    const gam = (c: number) => (c <= 0.0031308 ? 12.92 * c : 1.055 * c ** (1 / 2.4) - 0.055);
    const inGamut = (rgb: number[]) => rgb.every(v => v >= -0.0005 && v <= 1.0005);
    const hexOf = (L: number, C: number, H: number) => {
      let c = C; let rgb = toRgb(L, c, H);
      while (!inGamut(rgb) && c > 0) { c -= 0.0005; rgb = toRgb(L, c, H); } // keep L and H, reduce chroma to fit
      return { hex: '#' + rgb.map(v => Math.round(Math.min(1, Math.max(0, gam(Math.min(1, Math.max(0, v))))) * 255).toString(16).padStart(2, '0')).join(''), c };
    };
    const val = (k: string) => +(box.querySelector<HTMLInputElement>(`.js-gb[data-k="${k}"]`)!.value);
    const apply = () => {
      const amount = val('amount'), center = val('center'), width = val('width');
      box.querySelectorAll<HTMLElement>('.js-gb-out').forEach(o => { const v = val(o.dataset.for!); o.textContent = o.dataset.for === 'amount' ? v.toFixed(3) : String(v); });
      GR.forEach(g => {
        const add = amount * Math.exp(-((g.L - center) ** 2) / (2 * width * width));
        const { hex, c } = amount ? hexOf(g.L, g.C + add, g.H) : { hex: g.hex, c: g.C };
        const row = box.querySelector<HTMLElement>(`tr[data-step="${g.step}"]`)!;
        row.querySelector('.js-add')!.textContent = (c - g.C).toFixed(4);
        row.querySelector('.js-c')!.textContent = c.toFixed(4);
        row.querySelector('.js-hex')!.textContent = hex;
        row.querySelector<HTMLElement>('.gbr__chip')!.style.background = hex;
        box.querySelector<HTMLElement>(`.gbr__sw[data-step="${g.step}"]`)!.style.background = hex;
        box.querySelector(`.js-sw-hex[data-step="${g.step}"]`)!.textContent = hex;
      });
    };
    box.querySelectorAll('.js-gb').forEach(i => i.addEventListener('input', apply));
    apply();
    box.querySelectorAll<HTMLButtonElement>('.js-gb-preset').forEach(b => b.addEventListener('click', () => {
      (['amount', 'center', 'width'] as const).forEach(k => ((box.querySelector(`.js-gb[data-k="${k}"]`) as HTMLInputElement).value = b.dataset[k]!));
      apply();
    }));
    box.querySelector('.js-gb-reset')!.addEventListener('click', () => {
      (box.querySelector('.js-gb[data-k="amount"]') as HTMLInputElement).value = '0';
      apply();
    });
  }
</script>

<style>
  .gbr { display: grid; gap: var(--spacing-L); }
  .gbr__row { display: grid; grid-template-columns: repeat(11, minmax(64px, 1fr)); gap: 6px; overflow-x: auto; }
  .gbr__cell { display: grid; gap: 4px; font-size: 0.72rem; color: var(--c-b); }
  .gbr__cell b { color: var(--c-h); }
  .gbr__sw { display: block; height: 56px; border-radius: var(--radius-sm, 4px); }
  .gbr__ctl { display: flex; flex-wrap: wrap; align-items: end; gap: var(--spacing-L) var(--spacing-2XL); font-size: 0.82rem; }
  .gbr__ctl label { display: grid; gap: 4px; min-width: 180px; color: var(--c-b); }
  .gbr__ctl input { width: 100%; accent-color: var(--c-h); }
  .gbr__btn { min-height: 36px; padding: 6px 12px; font: 500 0.85rem var(--font-b); color: var(--c-h); background: transparent; border: 1px solid var(--c-line-strong); border-radius: var(--radius-md, 6px); cursor: pointer; }
  .gbr__tbl { width: 100%; border-collapse: collapse; font-size: 0.8rem; color: var(--c-b); }
  .gbr__tbl :is(th, td) { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--c-line); }
  .gbr__tbl th { color: var(--c-m); font-weight: 500; }
  .gbr__chip { display: inline-block; width: 14px; height: 14px; border-radius: 3px; vertical-align: middle; margin-right: 6px; }
</style>
