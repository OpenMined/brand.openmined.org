      <script is:inline>
        // Palette-following assets: every [data-follow] element gets its
        // `colors` (and `haze`, from data-follow-haze) from the named custom
        // properties. Inline and after the
        // last embed, so the first colors are set before the embed modules
        // boot (no flash of the default gradient). Re-reads on palette or
        // mode change.
        (() => {
          const h = document.documentElement;
          const sync = () => {
            const cs = getComputedStyle(h);
            const read = v => cs.getPropertyValue(`--${v}`).trim();
            document.querySelectorAll('[data-follow]').forEach(el => {
              el.setAttribute('colors', el.dataset.follow.split(',').map(read).join(','));
              if (el.dataset.followHaze) el.setAttribute('haze', read(el.dataset.followHaze));
            });
          };
          sync();
          new MutationObserver(sync).observe(h, { attributes: true, attributeFilter: ['data-p', 'data-theme'] });
        })();
      </script>
