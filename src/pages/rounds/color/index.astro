      <div class="wrap mock-end"><span>End of mock page · the round’s notes follow</span></div>

      <!-- ── 01 How we got here ────────────────────────────────────── -->
      <section class="band" id="story">
        <div class="wrap">
          <header class="sec">
            <span class="sec__n">01</span>
            <h2>From today’s palette to this one</h2>
            <p>Every change is deliberate, backed by how working color systems are built — for the website first, then graphics, data vis and apps.</p>
          </header>

          <article class="card fromto">
            <div class="fromto__side">
              <h3 class="card__h">From · 9 hues × 11 steps</h3>
              <div class="fromto__old">
                {OLD_FAMILIES.map(f => (
                  <>
                    <span class="fromto__fam">{f}</span>
                    <span class="fromto__ramp">{OLD_STEPS.map(st => <i style={`background:${OLD[f]?.[st]}`} title={`${f}-${st} ${OLD[f]?.[st]}`}></i>)}</span>
                    <span class="fromto__fate">{FATE[f]}</span>
                  </>
                ))}
              </div>
            </div>
            <div class="fromto__side">
              <h3 class="card__h">To · 6 hues × 7 steps <span class="muted">— palette in the bar</span></h3>
              <div class="fromto__new">
                {HUES.map(h => (
                  <>
                    <span class="fromto__fam">{h}</span>
                    <span class="fromto__ramp">{STEPS.map(st => <i style={`background:var(--${h}-${st})`}></i>)}</span>
                  </>
                ))}
              </div>
            </div>
          </article>

          <div class="moves">
            <div class="moves__head"><span>From</span><span>To</span><span>Why</span></div>
            {MOVES.map(m => (
              <div class="moves__row">
                <span class="moves__from">{m.from}</span>
                <span class="moves__to">{m.to}</span>
                <div class="moves__why">
                  <p set:html={m.why} />
                  <span class="moves__src">{m.src}</span>
                </div>
              </div>
            ))}
          </div>

        </div>
      </section>

      <!-- ── 02 The system ─────────────────────────────────────────── -->
      <section class="band" id="system">
        <div class="wrap">
          <header class="sec">
            <span class="sec__n">02</span>
            <h2>The system</h2>
            <p>6 hues × 7 steps. Every step except the key (400) sits at the <b>same lightness in every hue</b>, so a role means the same contrast whatever the color. Roles are marked on the steps they resolve to. <b>Each step has one label color</b> in every hue: ink on 100–300, white from 400 up. Interface labels never sit on the key, which is for marks.</p>
          </header>

          <article class="card ramps">
            <div class="ramps__head">
              <span></span>
              {STEPS.map(s => (
                <span class="ramps__step">
                  <b>{s}</b>
                  <em class="only-light">{roleAt('light', s).join(' · ') || '—'}</em>
                  <em class="only-dark">{roleAt('dark', s).join(' · ') || '—'}</em>
                </span>
              ))}
            </div>
            {HUES.map(h => (
              <div class="ramps__row">
                <span class="ramps__hue">
                  {h}
                  <small>{Object.entries(ROLE_HUE).filter(([, v]) => v === h).map(([r]) => r).join(' · ') || ''}{ACCENTS.includes(h) ? <span class="ramps__acc" data-acc={h}> accent</span> : ''}</small>
                </span>
                {STEPS.map(s => (
                  <span class="sw" style={`background:var(--${h}-${s});color:${s <= 300 ? '#221f2c' : '#fcfcfd'}`}>
                    {PKEYS.map(k => <code data-for={k}>{PAL[k].ramps[h][s]}</code>)}
                  </span>
                ))}
              </div>
            ))}
          </article>

          <div class="grid">
            <article class="card">
              <h3 class="card__h">Roles</h3>
              <table class="tbl tbl--roles">
                <thead><tr><th>Role</th><th>Light</th><th>Dark</th><th>Example</th><th>Used for</th></tr></thead>
                <tbody>
                  {ROLE_ROWS.map(r => (
                    <tr>
                      <td><code>{r.role}</code></td><td>{r.light}</td><td>{r.dark}</td>
                      <td><span class="ex">{HUES.map(h => (
                        r.role === 'fg' ? <b class="ex__txt" style={`color:var(--${h}-fg)`}>Aa</b>
                        : r.role === 'solid' ? <span class="ex__chip" style={`background:var(--${h}-solid);color:var(--${h}-on)`}>Aa</span>
                        : r.role === 'key' ? <span class="ex__chip" style={`background:var(--${h}-key)`}></span>
                        : r.role === 'tint' ? <span class="ex__chip" style={`background:var(--${h}-tint);color:var(--${h}-fg)`}>Aa</span>
                        : <span class="ex__chip" style={`background:var(--${h}-soft)`}></span>
                      ))}</span></td>
                      <td>{r.use}</td>
                    </tr>
                  ))}
                  <tr><td><code>ring</code></td><td>400 / 500</td><td>400 / 300</td>
                    <td><span class="ex">{HUES.map(h => <span class="ex__ring" style={`box-shadow:0 0 0 2px var(--${h}-ring)`}></span>)}</span></td>
                    <td>Focus, toggle edge — key if it reaches 3:1 on base, else fg</td></tr>
                  <tr><td><code>hover</code></td><td>500 → 600, 45%</td><td>300 → 200, 45%</td>
                    <td><span class="ex"><span class="ex__chip ex__chip--w" style="background:var(--accent-solid);color:var(--accent-on)">rest</span><span class="ex__chip ex__chip--w" style="background:var(--accent-hover);color:var(--accent-on)">hover</span></span></td>
                    <td>Solid hover (shown on the accent)</td></tr>
                  <tr class="tbl__group"><td colspan="5">Diagram neutrals — grayscale, no hue</td></tr>
                  <tr><td><code>ink</code></td><td>gray 700</td><td>gray 400</td>
                    <td><span class="ex"><svg width="84" height="26" viewBox="0 0 84 26" aria-hidden="true"><rect x="1.5" y="3.5" width="30" height="19" rx="4" fill="none" stroke="var(--ink)" stroke-width="1.5" /><path d="M46 13l6-6 6 6-6 6Z" fill="var(--ink)" /><circle cx="74" cy="13" r="7" fill="none" stroke="var(--ink)" stroke-width="1.5" /></svg></span></td>
                    <td>Diagram objects: icons, boxes, model marks</td></tr>
                  <tr><td><code>connector</code></td><td>gray 550</td><td>gray 550</td>
                    <td><span class="ex"><svg width="84" height="26" viewBox="0 0 84 26" aria-hidden="true"><path d="M4 18 C 26 18, 30 8, 52 8" fill="none" stroke="var(--connector)" stroke-width="1.5" stroke-dasharray="4 3" /><path d="M56 13h20m-4-4 4 4-4 4" fill="none" stroke="var(--connector)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></span></td>
                    <td>Diagram lines and arrows — ≥ 3:1 on base and raised, not on sunken</td></tr>
                </tbody>
              </table>
              <p class="card__note">Status: success = green · warning = amber · danger = red · info = blue. Each carries the same roles.</p>
            </article>
          </div>
        
          <div class="grid grid--2">
          <article class="card">
            <h3 class="card__h">Contrast, this palette</h3>
            <table class="tbl tbl--audit">
              <thead><tr><th>Hue</th><th>Example</th><th class="num">fg, worst surface</th><th class="num">key vs base</th><th class="num">label on solid</th></tr></thead>
              <tbody>
                {HUES.map(h => (
                  <tr>
                    <td><i class="dot" style={`background:var(--${h}-400)`}></i>{h}</td>
                    <td><span class="ex">
                      <span class="ex__chip ex__chip--w ex__on-sunken" title="fg on the recessed surface, the worst case"><b style={`color:var(--${h}-fg)`}>Text</b></span>
                      <span class="ex__chip ex__chip--sq" style={`background:var(--${h}-key)`} title="key on the page base"></span>
                      <span class="ex__chip ex__chip--w" style={`background:var(--${h}-solid);color:var(--${h}-on)`} title="label on solid">Label</span>
                    </span></td>
                    {(['fg_min', 'key_base', 'on_solid_ratio'] as const).map((f, fi) => (
                      <td class="num">
                        {PKEYS.map(k => {
                          const L = PAL[k].audit.light[h][f], D = PAL[k].audit.dark[h][f];
                          const min = fi === 0 ? 4.5 : fi === 1 ? 3 : 4.5;
                          return <span data-for={k}><span class={L < min ? 'bad' : ''}>{L}</span> / <span class={D < min ? 'bad' : ''}>{D}</span></span>;
                        })}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="card__note">light / dark. <span class="bad">Marked</span> = below its threshold (4.5 text, 3.0 boundary). A key that can’t reach 3:1 takes <code>fg</code> for boundaries.</p>
          </article>

          <article class="card">
            <h3 class="card__h">Chart series</h3>
            <p class="card__sub">Each series owns a hue at four strengths, so an entity keeps its color from a faint panel to a label. Validated order; violet and blue are never adjacent.</p>
            <table class="tbl tbl--series">
              <thead><tr><th>Series</th><th>tint</th><th>soft</th><th>key</th><th>fg</th></tr></thead>
              <tbody>
                {CAT.map((h, i) => (
                  <tr>
                    <td><code>series-{i + 1}</code> <span class="muted">{h}</span></td>
                    {['tint', 'soft', 'key', 'fg'].map(r => <td><i class="chip" style={`background:var(--series-${i + 1}-${r})`}></i></td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </article>

          </div>
          <article class="card spec">
            <div class="spec__head">
              <h3 class="card__h">Brand gradient</h3>
              <p class="card__sub">Nine custom stops, same order in every palette. They exist for the gradient only — a gradient built from ramp steps goes dusty, because interface tints are quiet on purpose. How the gradient is applied (halos, glows, dark stages, bands) belongs to graphics styles, a later push.</p>
            </div>
            <i class="spec__bar" style="background:linear-gradient(90deg in oklab,var(--spectrum))"></i>
            <div class="spec__stops">
              {data.spectrum.map((n: string, i: number) => <span><i style={`background:var(--spec-${i + 1})`}></i><b>{n}</b>{PKEYS.map(k => <code data-for={k}>{PAL[k].gradient[i]}</code>)}</span>)}
            </div>
            <p class="card__note">Today’s pastel, for reference: <i class="spec__ref" style={`background:linear-gradient(90deg,${PAL.brand.gradient.join(',')})`}></i></p>
          </article>
        </div>
      </section>

      <!-- ── 03 Data vis & presentations ─────────────────────────────────── -->
      <section class="band" id="info">
        <div class="wrap">
          <header class="sec">
            <span class="sec__n">03</span>
            <h2>Data vis &amp; presentations</h2>
            <p>Four color jobs, each with one rule: <b>categorical</b> (identity, fixed order), <b>sequential</b> (magnitude, one hue), <b>diverging</b> (polarity, neutral midpoint), <b>status</b> (reserved). Hover any mark.</p>
          </header>

          <div class="stats">
            {STATS.map((s, i) => (
              <article class="card stat">
                <span class="stat__k">{s.k}</span>
                <span class="stat__v">{s.v}</span>
                <span class={`delta ${s.up ? 'delta--good' : 'delta--bad'}`}>
                  <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d={s.up ? 'M6 15l6-6 6 6' : 'M6 9l6 6 6-6'} fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  {s.d} <span class="delta__lab">{s.up ? 'better' : 'worse'}</span>
                </span>
                <svg class="spark" viewBox="0 0 120 30" preserveAspectRatio="none" aria-hidden="true"><path d={s.path} /></svg>
              </article>
            ))}
          </div>

          <div class="grid grid--2">
            <!-- Stacked bars -->
            <article class="card viz">
              <h3 class="card__h">Compute hours by project</h3>
              <p class="card__sub">Categorical · six series in the validated order</p>
              <ul class="legend">
                {PROJECTS.map((p, i) => <li><i style={`background:var(--series-${i + 1})`}></i>{p}</li>)}
              </ul>
              <div class="stack">
                {STACK.map((row, r) => {
                  const tot = row.reduce((a, b) => a + b, 0);
                  return (
                    <div class="stack__row">
                      <span class="stack__lab">{QUARTERS[r]}</span>
                      <div class="stack__bar">
                        {row.map((v, i) => (
                          <span style={`flex:${v};background:var(--series-${i + 1})`} data-tip={`${PROJECTS[i]} · ${QUARTERS[r]}|${v}k hours (${Math.round(v / tot * 100)}%)`}></span>
                        ))}
                      </div>
                      <span class="stack__tot">{tot}k</span>
                    </div>
                  );
                })}
              </div>
            </article>

            <!-- Line chart -->
            <article class="card viz">
              <h3 class="card__h">Network activity, 2026</h3>
              <p class="card__sub">Categorical · three lines, crosshair on hover</p>
              <ul class="legend">
                {LSERIES.map((s, i) => <li><i style={`background:var(--series-${i + 1})`}></i>{s}</li>)}
              </ul>
              <div class="line" data-line={JSON.stringify({ x: MONTHS, s: LSERIES, v: LINES.map(l => l.map(n => Math.round(n))), px: MONTHS.map((_, i) => lx(i) / LW), w: LW })}>
                <svg viewBox={`0 0 ${LW} ${LH}`} role="img" aria-label="Line chart of three activity series across 2026">
                  {LTICKS.map(t => (<g class="axis"><line x1={LP.l} x2={LW - LP.r} y1={ly(t)} y2={ly(t)} /><text x={LP.l - 6} y={ly(t) + 3.5} text-anchor="end">{t}</text></g>))}
                  {MONTHS.map((m, i) => i % 2 === 0 && <text class="axis" x={lx(i)} y={LH - 8} text-anchor="middle">{m}</text>)}
                  {LPATHS.map((d, i) => <path class="line__path" d={d} style={`stroke:var(--series-${i + 1})`} />)}
                  <line class="line__x" x1="0" x2="0" y1={LP.t} y2={LH - LP.b} />
                  {LINES.map((_, i) => <circle class="line__dot" r="4.5" style={`fill:var(--series-${i + 1})`} />)}
                </svg>
              </div>
            </article>

            <!-- Heatmap -->
            <article class="card viz">
              <h3 class="card__h">Queries by hour</h3>
              <p class="card__sub">Sequential · the accent, 100 → 700 (anchor flips in dark)</p>
              <div class="heat">
                {HEAT.map((row, r) => (
                  <div class="heat__row">
                    <span class="heat__lab">{DAYS[r]}</span>
                    {row.map((v, c) => <span class="heat__cell" style={`background:var(--seq-${v + 1})`} data-tip={`${DAYS[r]} ${String(c).padStart(2, '0')}:00|${v * 180 + 40} queries`}></span>)}
                  </div>
                ))}
              </div>
              <div class="scale"><span>fewer</span>{STEPS.map((_, i) => <i style={`background:var(--seq-${i + 1})`}></i>)}<span>more</span></div>
            </article>

            <!-- Diverging -->
            <article class="card viz">
              <h3 class="card__h">Change in data partners vs 2025</h3>
              <p class="card__sub">Diverging · red ↔ blue through the neutral</p>
              <div class="div">
                {DIV.map(([k, v]) => (
                  <div class="div__row">
                    <span class="div__lab">{k}</span>
                    <div class="div__track">
                      <span class="div__bar" style={`--w:${Math.abs(v) / 45 * 50}%;background:var(--div-${divBucket(v)})`} data-neg={v < 0 ? '' : undefined} data-tip={`${k}|${v > 0 ? '+' : ''}${v}% partners`}></span>
                    </div>
                    <span class="div__v">{v > 0 ? '+' : ''}{v}%</span>
                  </div>
                ))}
              </div>
            </article>
          </div>

        </div>
      </section>

      <!-- ── 04 App-like interfaces ──────────────────────────────────────────── -->
      <section class="band" id="interface">
        <div class="wrap">
          <header class="sec">
            <span class="sec__n">04</span>
            <h2>App-like interfaces</h2>
            <p>Last in priority, and the densest use of state. Every component reads a <em>role</em> — <code>accent-fg</code>, <code>danger-tint</code> — never a step. Switch the palette or the accent and nothing here is re-authored.</p>
          </header>

          <div class="grid grid--3">
            <!-- Buttons -->
            <article class="card">
              <h3 class="card__h">Buttons</h3>
              <p class="card__sub">One solid button per group. Two candidates for what “solid” is:</p>
              <div class="row">
                <span class="row__lab">A · accent</span>
                <button class="btn btn--accent" type="button">Deploy</button>
                <button class="btn btn--quiet" type="button">Cancel</button>
              </div>
              <div class="row">
                <span class="row__lab">B · ink</span>
                <button class="btn btn--ink" type="button">Deploy</button>
                <button class="btn btn--quiet" type="button">Cancel</button>
              </div>
              <div class="row">
                <span class="row__lab">Danger</span>
                <button class="btn btn--danger" type="button">Revoke access</button>
                <button class="btn btn--quiet" type="button">Keep</button>
              </div>
              <p class="card__note">A spends the accent on the primary action; B keeps buttons neutral and saves color for state and data.</p>
            </article>

            <!-- Form -->
            <article class="card">
              <h3 class="card__h">Form</h3>
              <label class="fld">
                <span class="fld__lab">Dataset name</span>
                <input class="ctl" type="text" value="census-2021-eu" />
              </label>
              <label class="fld">
                <span class="fld__lab">Email</span>
                <input class="ctl ctl--err" type="email" value="researcher@" aria-invalid="true" />
                <span class="fld__err"><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="currentColor" /><path d="M12 7v6M12 16.5v.5" stroke="var(--c-raise-1)" stroke-width="2.2" stroke-linecap="round" /></svg>Enter a complete email address.</span>
              </label>
              <div class="checks">
                <label class="chk"><input type="checkbox" checked /><span>Allow remote queries</span></label>
                <label class="chk"><input type="checkbox" /><span>Publish metadata</span></label>
                <label class="tgl"><input type="checkbox" role="switch" checked /><span class="tgl__track"><span class="tgl__knob"></span></span><span>Differential privacy</span></label>
              </div>
              <p class="card__note">Click into a field — the focus ring is the accent’s <code>ring</code> role (the key where it reaches 3:1, otherwise <code>fg</code>).</p>
            </article>

            <!-- Status -->
            <article class="card">
              <h3 class="card__h">Status</h3>
              <div class="badges">
                <span class="badge badge--accent">Beta</span>
                <span class="badge badge--success"><i></i>Healthy</span>
                <span class="badge badge--warning"><i></i>Degraded</span>
                <span class="badge badge--danger"><i></i>Offline</span>
                <span class="badge badge--info"><i></i>Syncing</span>
                <span class="badge">Draft</span>
              </div>
              {[
                ['success', 'Query approved', 'The data owner approved your request. Results arrive within 24h.', 'M5 12.5l4.5 4.5L19 7.5'],
