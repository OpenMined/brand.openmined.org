---
/**
 * ROUND — COLOR SYSTEM
 * ════════════════════════════════════════════════════════════════════
 * Consolidates OMDS color from 10 families × 11 steps to 6 hues × 7
 * steps, adds the role layer the palette never had (accent, status,
 * dataviz), and puts three candidate palettes on the same page.
 *
 * NOT canon, NOT a brand surface. Sits in stylelint's ignoreFiles with
 * the other rounds. tokens.css is untouched.
 *
 * EVERY chromatic value comes from _palettes.json, which is written by
 * brand-v2-lab/research/2026-09-23-color-system/generate.py. Never edit
 * the JSON by hand — change the generator's parameters and re-run it.
 *
 * Surfaces are the settled 2026-09-23 values ("working surface colors,
 * display adjusted" — brand-v2-lab/rounds/working-surface-colors.md),
 * hard-set here so color is judged on the ground it will actually sit on.
 * Verified 2026-09-23 against the surfaces preview's computed values:
 * all 8 surface/line/text slots per mode and the shadow ladder match.
 *
 * URL params, mirroring the surfaces round:
 *   t  = light | dark
 *   p  = brand | heritage | deep | ink   (palette; deep is the default)
 *   a  = none | violet | blue | teal (accent hue; none = grayscale)
 * The brand gradient has no param — it follows the palette.
 */
import Base from '../../../layouts/Base.astro';
import ThemeToggle from '@brand/ThemeToggle.astro';
import data from './_palettes.json';
import { readFileSync } from 'node:fs';
import './_color.css';
import { logoCss, logoSvg, iconSvg } from './_logo';

type Hue = 'violet' | 'blue' | 'teal' | 'green' | 'amber' | 'red';
const HUES = data.hues as Hue[];
const STEPS = data.steps as number[];
const PAL = data.palettes as Record<string, any>;
const PKEYS = Object.keys(PAL);
const CAT = data.categorical as Hue[];
const ACCENTS: Hue[] = ['violet', 'blue', 'teal'];
// Bar dropdowns. The gradient has no control of its own — it follows the palette.
const P_OPTS = [
  { v: 'brand', label: 'Brand', desc: 'Today’s colors, re-cut into the new structure' },
  { v: 'heritage', label: 'Heritage', desc: 'Deep’s strength on today’s hue angles — orchid, rose, mint' },
  { v: 'deep', label: 'Deep', desc: 'Stronger hues stepped apart, deeper keys, gradient with depth' },
  { v: 'ink', label: 'Ink', desc: 'Deep’s hues, darker and calmer — depth over saturation' },
];
// Display order runs weakest → strongest change; Ink sits after Deep as its
// quieter sibling.
const ORDER = P_OPTS.map(o => o.v);
const A_OPTS = [
  { v: 'none', label: 'None', desc: 'Grayscale — color only for status and data' },
  { v: 'violet', label: 'Violet', desc: 'The brand’s historic color' },
  { v: 'blue', label: 'Blue', desc: 'The category default for tech products' },
  { v: 'teal', label: 'Teal', desc: 'Today’s de facto interactive color' },
];
const ROLE_HUE: Record<string, Hue | null> = {
  accent: null, success: 'green', warning: 'amber', danger: 'red', info: 'blue',
};

/* ── Token CSS, generated from the JSON ─────────────────────────────
   Three layers, exactly as the proposed architecture:
     primitives  --violet-100 … --red-700          per palette  (data-p)
     aliases     --accent-*, --success-* …         per accent   (data-a)
     roles       --accent-fg, --danger-tint …      per mode     (data-theme)
   Components only ever read the role layer. */
const css: string[] = [];

for (const k of PKEYS) {
  const p = PAL[k];
  const d: string[] = [];
  for (const h of HUES) {
    for (const s of STEPS) d.push(`--${h}-${s}:${p.ramps[h][s]}`);
    // A boundary (focus ring, toggle edge) needs 3:1 on its ground. Where the
    // key can't reach it, the ring takes the fg step instead.
    d.push(`--${h}-ring-l:var(--${h}-${p.audit.light[h].key_base >= 3 ? 400 : 500})`);
    d.push(`--${h}-ring-d:var(--${h}-${p.audit.dark[h].key_base >= 3 ? 400 : 300})`);
  }
  d.push(`--spectrum-own:${p.gradient.join(',')}`);
  p.gradient.forEach((h: string, i: number) => d.push(`--spec-${i + 1}:${h}`));
  css.push(`:root[data-p="${k}"]{${d.join(';')}}`);
}
css.push(`:root{--spectrum:var(--spectrum-own)}`);

const alias = (role: string, h: string) => [
  ...STEPS.map(s => `--${role}-${s}:var(--${h}-${s})`),
  `--${role}-on:var(--on-solid)`, `--${role}-ring-l:var(--${h}-ring-l)`, `--${role}-ring-d:var(--${h}-ring-d)`,
].join(';');
for (const a of ACCENTS) css.push(`:root[data-a="${a}"]{${alias('accent', a)}}`);
/* Accent "none": the accent roles resolve to the settled grayscale
   (working-surface-colors.md), so the interface is neutral and color is
   spent only on status and data. The ramp steps (sequential charts) are a
   monotone gray ladder; the roles are set per mode because a neutral solid
   is ink — dark on light, light on dark — which no single step can be. */
const GRAY_STEPS = ['#e6e5e9', '#dddde2', '#cfcdd6', '#b3b0bf', '#868394', '#5f5a72', '#353243'];
css.push(`:root[data-a="none"]{${STEPS.map((s, i) => `--accent-${s}:${GRAY_STEPS[i]}`).join(';')};--accent-fg:#221f2c;--accent-solid:#221f2c;--accent-key:#221f2c;--accent-hover:#353243;--accent-on:#fcfcfd;--accent-tint:#dddde2;--accent-soft:#cfcdd6;--accent-ring:#221f2c}`);
css.push(`:root[data-a="none"][data-theme="dark"]{--accent-fg:#fcfcfd;--accent-solid:#fcfcfd;--accent-key:#fcfcfd;--accent-hover:#cfcdd6;--accent-on:#16141b;--accent-tint:#353243;--accent-soft:#464257;--accent-ring:#fcfcfd}`);
css.push(`:root{${Object.entries(ROLE_HUE).filter(([, h]) => h).map(([r, h]) => alias(r, h!)).join(';')}}`);

// Per-hue roles, so examples can show any hue in the current mode.
// One on-color per step: the key (400) is for marks and never carries text;
// a fill holding a label is `solid` — 500 under white (light), 300 under ink
// (dark). `--on-solid` is set per mode with the surfaces, never per hue.
const hueRoles = (mode: 'light' | 'dark') => HUES.map(h => mode === 'light'
  ? `--${h}-key:var(--${h}-400);--${h}-on:var(--on-solid);--${h}-fg:var(--${h}-500);--${h}-solid:var(--${h}-500);--${h}-tint:var(--${h}-100);--${h}-soft:var(--${h}-200);--${h}-ring:var(--${h}-ring-l)`
  : `--${h}-key:var(--${h}-400);--${h}-on:var(--on-solid);--${h}-fg:var(--${h}-300);--${h}-solid:var(--${h}-300);--${h}-tint:var(--${h}-700);--${h}-soft:var(--${h}-600);--${h}-ring:var(--${h}-ring-d)`
).join(';');
const roleDecl = (mode: 'light' | 'dark') => Object.keys(ROLE_HUE).map(r => mode === 'light'
  ? `--${r}-key:var(--${r}-400);--${r}-fg:var(--${r}-500);--${r}-solid:var(--${r}-500);--${r}-tint:var(--${r}-100);--${r}-soft:var(--${r}-200);--${r}-ring:var(--${r}-ring-l);--${r}-hover:color-mix(in oklab,var(--${r}-500),var(--${r}-600) 45%)`
  : `--${r}-key:var(--${r}-400);--${r}-fg:var(--${r}-300);--${r}-solid:var(--${r}-300);--${r}-tint:var(--${r}-700);--${r}-soft:var(--${r}-600);--${r}-ring:var(--${r}-ring-d);--${r}-hover:color-mix(in oklab,var(--${r}-300),var(--${r}-200) 45%)`
).join(';');
// Dataviz. Series are one set for both modes — the validator passes Deep's
// keys in both bands, so there is no separate dark categorical set.
const series = CAT.map((h, i) => `--series-${i + 1}:var(--${h}-400)`).join(';');
// R1 — each series carries the full role set, so an entity can own a hue at
// several strengths (the deck's Bob / Ana / Charlie). Pointers only: no new values.
const seriesRoles = (mode: 'light' | 'dark') => CAT.map((h, i) => {
  const [t, so, f] = mode === 'light' ? [100, 200, 500] : [700, 600, 300];
  return `--series-${i + 1}-tint:var(--${h}-${t});--series-${i + 1}-soft:var(--${h}-${so});--series-${i + 1}-key:var(--${h}-400);--series-${i + 1}-fg:var(--${h}-${f})`;
}).join(';');
// R2 — diagram neutrals, named so nobody types #868394 by hand again.
//   ink        objects: icons, boxes, model marks   light grayscale-700 · dark 400
//   connector  lines and arrows                     grayscale-550 both modes
const diagL = '--ink:#464257;--connector:#868394';
const diagD = '--ink:#cfcdd6;--connector:#868394';
const seqL = STEPS.map((s, i) => `--seq-${i + 1}:var(--accent-${s})`).join(';');
const seqD = [...STEPS].reverse().map((s, i) => `--seq-${i + 1}:var(--accent-${s})`).join(';');
const divL = '--div-n3:var(--red-500);--div-n2:var(--red-400);--div-n1:var(--red-200);--div-p1:var(--blue-200);--div-p2:var(--blue-400);--div-p3:var(--blue-500)';
const divD = '--div-n3:var(--red-300);--div-n2:var(--red-400);--div-n1:var(--red-600);--div-p1:var(--blue-600);--div-p2:var(--blue-400);--div-p3:var(--blue-300)';

const S = data.surfaces as any;
const surfL = `--on-solid:#ffffff;--c-sunken:${S.light.sunken};--c-base:${S.light.base};--c-raise-1:${S.light['raise-1']};--c-raise-2:${S.light['raise-2']};--c-line:#dddde2;--c-line-strong:#cfcdd6;--c-h:#221f2c;--c-b:#353243;--c-m:#5e5a72;--c-ink:#221f2c;--c-on-ink:#fcfcfd;--c-shadow-1:0 2px 10px -4px rgb(70 66 87 / 0.05);--c-shadow-2:0 6px 16px -4px rgb(70 66 87 / 0.12), 0 2px 4px rgb(70 66 87 / 0.048);--c-shadow-in:inset 0 1px 5px 0 rgb(70 66 87 / 0.07);color-scheme:light`;
const surfD = `--on-solid:#16141b;--c-sunken:${S.dark.sunken};--c-base:${S.dark.base};--c-raise-1:${S.dark['raise-1']};--c-raise-2:${S.dark['raise-2']};--c-line:#353243;--c-line-strong:#464257;--c-h:#fcfcfd;--c-b:#cfcdd6;--c-m:#9591a3;--c-ink:#fcfcfd;--c-on-ink:#16141b;--c-shadow-1:0 2px 10px -4px rgb(0 0 0 / 0.14);--c-shadow-2:0 6px 16px -4px rgb(0 0 0 / 0.336), 0 2px 4px rgb(0 0 0 / 0.134);--c-shadow-in:inset 0 1px 5px 0 rgb(0 0 0 / 0.196);color-scheme:dark`;

css.push(`:root{${surfL};${roleDecl('light')};${hueRoles('light')};${series};${seriesRoles('light')};${diagL};${seqL};${divL};--div-mid:var(--c-line)}`);
css.push(`:root[data-theme="dark"]{${surfD};${roleDecl('dark')};${hueRoles('dark')};${seriesRoles('dark')};${diagD};${seqD};${divD};--div-mid:var(--c-line)}`);

// Per-palette readouts (hex, contrast) — all three are rendered, CSS shows one.
css.push(`[data-for]{display:none}` + PKEYS.map(k => `:root[data-p="${k}"] [data-for="${k}"]{display:inline}`).join(''));
// The logo, recolored per palette from its own hand-tuned stops (see _logo.ts).
css.push(logoCss(PAL));

const TOKEN_CSS = css.join('\n');

// Mock page — condensed from openmined.org's HomeFederatedNetwork.
const FED_SUBS = [
  { tag: 'Beta', title: 'Publishers', body: 'Make your assets AI-ready and queryable, with guaranteed attribution and fair compensation — without losing custody.', link: 'Join the Beta' },
  { tag: 'Beta', title: 'Genomics', body: 'Run collaborative genomic research without centralizing raw data. Sensitive files stay on participants’ devices.', link: 'Join the Beta' },
  { tag: 'Early access', title: 'Creators', body: 'Turn everything you’ve created into a knowledge base your audience can explore, and unlock new revenue from it.', link: 'Get early access' },
];

/* ── Seeded data, so every reload shows the same charts ───────────── */
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;

// Stacked bars — six series, four rows.
const PROJECTS = ['PySyft', 'Syft Hub', 'Courses', 'Research', 'Policy', 'Community'];
const QUARTERS = ['Q1', 'Q2', 'Q3', 'Q4'];
const STACK = QUARTERS.map(() => PROJECTS.map(() => Math.round(8 + rnd() * 30)));

// Line chart — three series over twelve months.
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const LINES = [0, 1, 2].map(i => {
  let v = 30 + i * 12; return MONTHS.map(() => (v = Math.max(8, v + (rnd() - 0.38) * 14)));
});
const LSERIES = ['Remote queries', 'Datasets connected', 'Active researchers'];
const LW = 560, LH = 220, LP = { l: 34, r: 12, t: 12, b: 26 };
const lmax = Math.ceil(Math.max(...LINES.flat()) / 20) * 20;
const lx = (i: number) => LP.l + (i * (LW - LP.l - LP.r)) / (MONTHS.length - 1);
const ly = (v: number) => LH - LP.b - (v / lmax) * (LH - LP.t - LP.b);
const LPATHS = LINES.map(s => s.map((v, i) => `${i ? 'L' : 'M'}${lx(i).toFixed(1)},${ly(v).toFixed(1)}`).join(''));
const LTICKS = [0, 0.25, 0.5, 0.75, 1].map(f => Math.round(f * lmax));

// Heatmap — sequential, one hue.
const DAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const HEAT = DAYS.map((_, r) => Array.from({ length: 24 }, (_, c) => {
  const work = Math.exp(-((c - 14) ** 2) / 30) * (r < 5 ? 1 : 0.35);
  return Math.min(6, Math.max(0, Math.round(work * 6 + (rnd() - 0.5) * 1.6)));
}));

// Diverging — change vs last year.
const DIV = [
  ['Europe', 42], ['North America', 28], ['UK', 17], ['Asia-Pacific', 9],
  ['Latin America', -6], ['Middle East', -14], ['Africa', -22], ['Other', -35],
] as [string, number][];
const divBucket = (v: number) => v <= -25 ? 'n3' : v <= -10 ? 'n2' : v < 0 ? 'n1' : v < 15 ? 'p1' : v < 30 ? 'p2' : 'p3';

// Sparkline for the stat tiles.
const spark = (n: number, up: boolean) => {
  let v = 20; const pts = Array.from({ length: n }, () => (v = Math.max(2, v + (rnd() - (up ? 0.35 : 0.65)) * 8)));
  const mx = Math.max(...pts), mn = Math.min(...pts);
  return pts.map((p, i) => `${i ? 'L' : 'M'}${(i * 120 / (n - 1)).toFixed(1)},${(30 - ((p - mn) / (mx - mn || 1)) * 26 - 2).toFixed(1)}`).join('');
};
const STATS = [
  { k: 'Remote queries answered', v: '1.28M', d: '+18.4%', up: true, path: spark(20, true) },
  { k: 'Median time to answer', v: '2.4s', d: '−0.6s', up: true, path: spark(20, false) },
  { k: 'Failed policy checks', v: '312', d: '+9.1%', up: false, path: spark(20, true) },
];

/* ── Today's palette, read from tokens.css ──────────────────────────
   The narrative section shows the palette being replaced beside the one
   replacing it. Read from the file, not re-typed, so it can't drift from
   what ships. */
const TOKENS = readFileSync(`${process.cwd()}/src/tokens/tokens.css`, 'utf8');
const OLD_FAMILIES = ['gold', 'orange', 'red', 'violet', 'blue', 'teal', 'green', 'lime', 'yellow'];
const OLD_STEPS = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950];
const OLD: Record<string, Record<number, string>> = {};
for (const m of TOKENS.matchAll(/--color-([a-z]+)-(\d+):\s*(#[0-9a-fA-F]{6})/g)) {
  if (OLD_FAMILIES.includes(m[1])) (OLD[m[1]] ??= {})[+m[2]] = m[3];
}
const FATE: Record<string, string> = {
  gold: '→ amber', orange: '→ amber + gradient', red: '→ red',
  violet: '→ violet', blue: '→ blue', teal: '→ teal', green: '→ green',
  lime: '→ gradient only', yellow: '→ gradient only',
};

const MOVES = [
  { from: '9 hue families', to: '6 hues', why: 'Six hues cover every job: an accent, four status meanings, six chart series. Gold and orange merge into amber.', src: 'Needed uses · Radix, Carbon, Primer size hue sets by job' },
  { from: '11 steps, chosen by eye', to: '7 steps, one per role', why: 'Four jobs per hue — tint, soft, text, solid — each mirrored for dark mode.', src: 'Material 3 exposes ~5 roles from 13 tones · Radix defines steps by use' },
  { from: 'A lightness ladder per family', to: 'One ladder for every hue', why: 'Same step, same contrast in every hue, so colored text passes AA by construction.', src: 'Stripe accessible palettes · Radix · Carbon · WCAG 2 (4.5:1 text, 3:1 UI)' },
  { from: 'Pick a step', to: 'Pick a role', why: 'Components name a role, so palettes and modes change without touching their code.', src: 'Three-tier tokens: primitive → semantic → component (Primer, Atlassian, Material)' },
  { from: 'Low-chroma pastels', to: 'Deep', why: 'Today’s hues read gray in charts. Deep passes every chart check and matches the team’s hand-mixed blues.', src: 'Dataviz standard: chroma ≥ 0.10, lightness bands, colorblind ΔE ≥ 8 · Live Graphics deck' },
  { from: 'A pastel gradient', to: 'A gradient with depth', why: 'Its own nine stops, since ramp steps go dusty. Depth comes from lightness range, not saturation.', src: 'Measured from speakeasy.com’s CSS · a ramps-only prototype' },
];


const ROLE_ROWS = [
  { role: 'tint', light: 100, dark: 700, use: 'Badge, callout, selected-row background' },
  { role: 'soft', light: 200, dark: 600, use: 'Decorative rule, selected outline, area fill' },
  { role: 'fg', light: 500, dark: 300, use: 'Colored text, links, icons — AA on every surface' },
  { role: 'key', light: 400, dark: 400, use: 'Marks with no text: chart series, dots, progress, strokes' },
  { role: 'solid', light: 500, dark: 300, use: 'Fills carrying a label: white in light, ink in dark, every hue' },
];
const roleAt = (mode: 'light' | 'dark', s: number) => ROLE_ROWS.filter(r => r[mode] === s).map(r => r.role);

/* Chart verdicts come from generate.py, which runs the dataviz validator on
   the series order. Summarized here in plain words. */
const FAIL_WORDS: [RegExp, string][] = [[/^Chroma floor/, 'some hues read gray'], [/^Lightness band/, 'some hues off-band'], [/^CVD/, 'colorblind pairs too close'], [/^Normal-vision/, 'neighbors too close']];
const summarize = (v: any) => {
  if (!v) return 'not validated';
  if (!v.ok) return 'Fails — ' + v.fails.map((f: string) => FAIL_WORDS.find(([re]) => re.test(f))?.[1] ?? f).join(', ');
  return `Passes — colorblind ΔE ${v.cvd}` + (v.warns.length ? '; some marks under 3:1, needs visible labels' : '; every mark ≥ 3:1');
};
const VERDICT = Object.fromEntries(ORDER.map(k => {
  const c = PAL[k].charts;
  return [k, { light: summarize(c?.light), dark: summarize(c?.dark), ok: !!(c?.light.ok && c?.dark.ok), clean: !!(c?.light.ok && c?.dark.ok && !c.light.warns.length && !c.dark.warns.length) }];
}));
---
<Base title="Color system" description="brand-v2 round: consolidating OMDS color into 6 hues × 7 steps with a role layer, three candidate palettes.">
  <Fragment set:html={`<style>${TOKEN_CSS}</style>`} />
  <script is:inline>
    // Before paint: palette, accent and gradient from the URL, so the first
    // frame is already the requested combination (no flash of the default).
    (() => {
      const q = new URLSearchParams(location.search), h = document.documentElement;
      const pick = (k, ok, d) => (ok.includes(q.get(k)) ? q.get(k) : d);
      h.dataset.p = pick('p', ['brand', 'heritage', 'deep', 'ink'], 'deep');
      h.dataset.a = pick('a', ['none', 'violet', 'blue', 'teal'], 'none');
      const t = q.get('t'); if (t === 'light' || t === 'dark') h.setAttribute('data-theme', t);
    })();
  </script>

  <div class="cr">
    <!-- ── Bar ─────────────────────────────────────────────────────── -->
    <header class="bar">
      <div class="bar__inner">
        <a class="bar__back" href="/" aria-label="Back to the brand reference">←</a>
        <span class="bar__title">Color system</span>
        <div class="bar__field">
          <span class="bar__lab" id="dd-p-lab">Palette</span>
          <div class="dd" data-dd="p">
            <button type="button" class="dd__btn" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="dd-p-lab dd-p-val">
              <span class="dd__val" id="dd-p-val"></span>
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </button>
            <ul class="dd__list" role="listbox" aria-labelledby="dd-p-lab" hidden>
              {P_OPTS.map(o => (
                <li role="option" data-v={o.v} data-label={o.label} tabindex="-1" aria-selected="false">
                  <span class="dd__txt"><b>{o.label}</b><span>{o.desc}</span></span>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="bar__field">
          <span class="bar__lab" id="dd-a-lab">Accent</span>
          <div class="dd" data-dd="a">
            <button type="button" class="dd__btn" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="dd-a-lab dd-a-val">
              <span class="dd__val" id="dd-a-val"></span>
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </button>
            <ul class="dd__list" role="listbox" aria-labelledby="dd-a-lab" hidden>
              {A_OPTS.map(o => (
                <li role="option" data-v={o.v} data-label={o.label} tabindex="-1" aria-selected="false">
                  <i class="dot" style={o.v === 'none' ? 'background:var(--c-h)' : `background:var(--${o.v}-400)`}></i><span class="dd__txt"><b>{o.label}</b><span>{o.desc}</span></span>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="bar__field">
          <span class="bar__lab">Color mode</span>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main>
      <!-- ── Hero ──────────────────────────────────────────────────── -->
      <section class="hero wrap">
        <div class="hero__copy">
          <Fragment set:html={logoSvg('hero-logo', 'hero__logo')} />
          <span class="eyebrow"><span class="eyebrow__dot"></span>brand-v2 · Round 1A · color</span>
          <h1>Fewer colors, each with a&nbsp;job.</h1>
          <p class="lead">The color palette consolidated: keep what works, give every color a role, and tune the values toward the desired register.</p>
        </div>
        <!-- Colorflow, laid out as openmined.org's home hero: full-bleed, behind
             the copy, bleeding into the section below. Its six stops are the
             palette's gradient stops in the site ribbon's order (red, gold,
             violet, blue, teal, green); data-follow names them. -->
        <div class="hero__stream" aria-hidden="true">
          <om-stream aspect-ratio="2" data-follow="spec-3,spec-1,spec-4,spec-5,spec-6,spec-7"></om-stream>
        </div>
        <script type="module" src="/embeds/om-stream.js" is:inline></script>
      </section>

      <!-- ══ Mock page ═══════════════════════════════════════════════
           A page in the round's colors, before the notes: the hero above,
           then a content section, the CTA and a footer. The section is
           openmined.org's "Federated AI Network", condensed. It shows the
