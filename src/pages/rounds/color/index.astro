              <a class="btn btn--accent" href="#" onclick="return false">Get started →</a>
            </div>
          </div>
        </div>
      </section>
      <!-- ── Gradient map CTA ──────────────────────────────────────── -->
      <!-- The site's CTA band (openmined.org CtaSection, gradient variant)
           with the raster replaced by <om-mesh>. Its eight points are the
           palette's gradient stops, gold through lime, in spectrum order. -->
      <section class="cta" id="gradient-map" aria-label="Gradient map example">
        <om-mesh class="cta__bg" aria-hidden="true" data-follow="spec-1,spec-2,spec-3,spec-4,spec-5,spec-6,spec-7,spec-8" data-follow-haze="c-base"></om-mesh>
