  .panel__meta { font-size: 0.8125rem; color: var(--s-text-body); }
  .panel__actions { display: flex; gap: var(--spacing-S); }

  /* Heading column on the BASE surface, card column at +1 beside it. */
  .prefs { display: grid; grid-template-columns: 1fr 1.15fr; gap: var(--spacing-full); align-items: start; }
  .prefs__intro { padding-block: var(--spacing-S); }
  .prefs__h { margin-bottom: var(--spacing-L) !important; max-width: 16ch; }
  .prefs__b { font-size: 1rem; line-height: 1.6; color: var(--s-text-body); margin: 0 0 var(--spacing-L); max-width: 46ch; }

  .switch__track {
    position: relative; width: 46px; height: 26px; flex: none; cursor: pointer;
    border-radius: var(--border-radius-full);
    background: var(--s-sunken);
    border: 1px solid var(--s-line-strong);
