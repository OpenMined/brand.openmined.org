  .switch__track.is-on .switch__knob { transform: translateX(20px); }

  /* inset fields — −1.
     global.css gives every <label> padding-left:5px and margin-bottom:8px.
     .field IS a label, so that margin pushed the input 8px below the button
     beside it. Reset both — the field owns its own spacing. */
  .field { display: grid; gap: var(--spacing-2XS); margin-bottom: 0; padding-left: 0; }
  .field__label { font-size: 0.75rem; color: var(--s-text-body); }
  /* Inset controls carry --s-line-strong; dividers inside cards carry
