     stay demonstrated whichever mode is chosen. */
  .mock[data-borders="selective"] .card,
  .mock[data-borders="selective"] .feature,
  .mock[data-borders="selective"] .nested,
  .mock[data-borders="selective"] .panel,
  .mock[data-borders="selective"] .press__item,
  .mock[data-borders="selective"] .cta,
  .mock[data-borders="selective"] .shadows__card,
  .mock[data-borders="selective"] .shadows--onraise,
  .mock[data-borders="selective"] .seg__btn.is-on { border-color: transparent; }

  .mock[data-borders="none"] *,
  .mock[data-borders="none"] *::before,
  .mock[data-borders="none"] *::after { border-color: transparent !important; }

  @media (max-width: 620px) {
