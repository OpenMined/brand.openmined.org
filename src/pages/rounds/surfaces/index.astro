---
/**
 * ROUND — SURFACE SYSTEM
 * ════════════════════════════════════════════════════════════════════
 * Testing ground for consolidating OMDS surfaces from eight tokens to
 * four levels: one below default, the default, and two above.
 *
 * NOT canon, NOT a brand surface. Sits in stylelint's ignoreFiles with
 * /diamond, /stream and /rounds. tokens.css is untouched — every value
 * lives in _surfaces.css, the only file the live-tuning UI will drive.
 *
 * FULL-BLEED: the mock IS the page, so it is judged the way a real page
 * is judged rather than as a picture of one. The only chrome is a thin
 * sticky bar; the narrative lives in a drawer behind the Info button,
 * which is also where the colour controls will go.
 *
 * TYPE / BUTTONS / LINKS are ported from the live site (openmined-org),
 * not invented here:
 *   type    → src/styles/global/typography.css + tokens.css (h1–h6 clamps,
 *             Rubik display / Inter body)
 *   button  → src/components/ui/Button.astro (.btn, .btn--outline)
 *   links   → src/styles/global/components.css (.link-hover-line)
 *   cards   → .card-float (lift + swell + shadow step)
 * The brand repo has no fluid type tokens of its own — that gap is Track
 * 1B. Until it lands, the mock carries the site's scale locally so the
 * surfaces are judged under real type rather than the brand repo's
 * static fallback.
 *
 * GRAYSCALE ONLY this pass. No hue anywhere.
 */
import Base from '../../../layouts/Base.astro';
import ThemeToggle from '@brand/ThemeToggle.astro';
import Button from '@brand/Button.astro';
import { readFileSync } from 'node:fs';
import './_surfaces.css';
import './_editor.css';

const SOLUTIONS = [
  {
    title: 'Sample card one',
    body: 'Placeholder body at about the length real copy would run, so wrapping behaves.',
    icon: 'M4 5h16M4 12h16M4 19h10',
  },
  {
    title: 'Sample card two',
    body: 'A second card, same level, so the +1 step can be judged across a row.',
    icon: 'M6 3v4a6 6 0 0 0 12 0V3M6 21v-4a6 6 0 0 1 12 0v4M7 8h10M7 16h10',
  },
  {
    title: 'Sample card three',
    body: 'Third card. Icons sit on the card surface with no chip behind them.',
    icon: 'M12 3l8 4v5c0 4.4-3.4 8.2-8 9-4.6-.8-8-4.6-8-9V7l8-4Z',
  },
];

const CAPABILITIES = [
  'This panel is +2, nested inside the +1 card',
  'The list sits directly on it — no further container',
  'The block below is −1, recessed into the +2',
];

/**
 * Real partner marks from public/logos/partners/, INLINED rather than rendered
 * through the PartnerLogo atom — that atom uses <img>, which cannot inherit
 * currentColor. Inlining is the documented route for a themeable 1-color mark
 * (see PartnerLogo.astro's header), and it is the point of the exercise: these
 * are foreign shapes, drawn to their owners' proportions, and the question is
 * whether they sit correctly on our surfaces.
 *
 * NOT OpenMined assets. Each is its owner's trademark, used nominatively and
 * unmodified in form — only inheriting a neutral colour, which the monochrome
 * icon variants exist for. See public/logos/partners/README.md.
 */
const PARTNER_BRANDS = ['github', 'docker', 'aws', 'google', 'slack', 'notion', 'figma', 'pypi'];
// process.cwd() is the project root during both dev and build. import.meta.url
// is NOT usable here — under SSR it resolves to the compiled chunk, not this file.
const partnerDir = `${process.cwd()}/public/logos/partners/`;
// partners.json is the source of truth for the display name — several icon.svg
// files carry no <title> (Google's sanctioned 1-colour knockout among them).
const PARTNERS_META = JSON.parse(readFileSync(`${partnerDir}partners.json`, 'utf8'));
const PRESS = PARTNER_BRANDS.map(brand => ({
  brand,
  name: PARTNERS_META[brand]?.name ?? PARTNERS_META.brands?.[brand]?.name ?? brand,
  svg: readFileSync(`${partnerDir}${brand}/icon.svg`, 'utf8'),
}));

// The specimen band shows the LADDER, one card per rung — not a t-shirt
// scale. It is deliberately exempt from the kind/trigger policy: it exists to
// show what each rung IS, so it always shows all of them.
const RUNGS = [
  { name: 'sunken',  sub: 'inset',  token: 'var(--s-shadow-sunken)' },
  { name: 'base',    sub: 'none',   token: 'var(--s-shadow-base)' },
  { name: 'raise-1', sub: '+1',     token: 'var(--s-shadow-raise-1)' },
  { name: 'raise-2', sub: '+2',     token: 'var(--s-shadow-raise-2)' },
];

const LEVELS = [
  { k: '−1', n: 'sunken',  d: 'wells, toggle tracks, inset fields, segmented track' },
  { k: '0',  n: 'base',    d: 'the page itself' },
  { k: '+1', n: 'raise-1', d: 'cards, nav, footer, panels' },
  { k: '+2', n: 'raise-2', d: 'nested cards, toggle knob, active segment' },
];
---

<Base title="Round — surface system" description="Full-page testing ground for a consolidated four-level surface system.">

  <!-- ── Thin sticky bar — the only chrome ─────────────────────────── -->
  <div class="bar">
    <div class="bar__inner">
      <a class="bar__back" href="/">←</a>
      <span class="bar__title">Surface system</span>

      <!-- live swatches for the ACTIVE palette; click one to jump to its row -->
      <div class="bar__pal" id="bar-pal" aria-label="Active surface palette"></div>

      <!-- Both switches are labelled with their subject. Neither control says
           what it governs on its own, and side by side they read as two
           colour-mode switches — "lighter / darker" next to light / dark is
           genuinely ambiguous. The label is the fix; "Color mode" is the
           repo's own term for this axis (CLAUDE.md § Color mode system).
           Colour mode is the primary axis, so it comes first. -->
      <div class="bar__field">
        <span class="bar__seglab">Color mode:</span>
        <ThemeToggle />
      </div>

      <!-- Elevation direction, deliberately secondary: "lighter" is the
           expected answer, so this reads as a check rather than a headline
           choice — hence no sunken track on its segmented control. -->
      <div class="bar__field">
        <span class="bar__seglab">Cards:</span>
        <div class="bar__seg bar__seg--minor" role="group"
             aria-label="Do raised surfaces sit lighter or darker than the page">
          <button type="button" class="bar__segbtn is-on" data-elev-set="lighter">lighter</button>
          <button type="button" class="bar__segbtn" data-elev-set="darker">darker</button>
        </div>
      </div>

      <button type="button" class="bar__info" id="info-toggle" aria-expanded="false" aria-controls="drawer">
        Info
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
      </button>
    </div>
  </div>

  <!-- ── Editor rail ───────────────────────────────────────────────
       Fixed to the right and the page reflows beside it rather than
       being covered, so you can nudge a value and watch the section you
       were already looking at respond. Overview first, one editor at a
       time — never a wall of identical sliders. -->
  <aside class="rail" id="drawer" hidden aria-label="Surface editor">
    <div class="rail__scroll">

      <section class="grp">
        <h3 class="grp__h">Surface palette: <span class="grp__tag" id="ed-pal-name"></span></h3>
        <div class="tiles" id="ed-slots"></div>
        <div id="ed-assign"></div>
      </section>

      <section class="grp">
        <h3 class="grp__h">Grayscale <span class="grp__tag">click a step to edit</span></h3>
        <div class="ramp" id="ed-steps"></div>
        <div id="ed-stepedit"></div>
        <details class="dis" id="ed-cast-wrap">
          <summary>Global cast</summary>
          <div id="ed-cast"></div>
        </details>
      </section>

      <section class="grp">
        <h3 class="grp__h">Outlines</h3>
        <div id="ed-borders"></div>
      </section>

      <section class="grp">
        <details class="dis">
          <summary>Shadows: <span class="grp__tag" id="ed-shadow-mode"></span></summary>
          <div id="ed-shadows"></div>
        </details>
      </section>

      <section class="grp grp--last">
        <!-- The brand Button takes no arbitrary props (no ...rest spread), so
             the hook sits on a wrapper rather than patching a canonical
             component. Click delegation uses closest(), so it still resolves. -->
        <div class="ed__actions">
          <span data-copy="link"><Button>Link</Button></span>
          <span data-copy="css"><Button>CSS</Button></span>
          <span data-copy="json"><Button variant="outline">JSON</Button></span>
          <span data-reset="all"><Button variant="outline">Reset</Button></span>
        </div>
        <p class="ed__note" id="ed-status">URL updates as you edit — paste it to share this exact state.</p>
        <details class="dis"><summary>Export preview</summary>
          <textarea class="ed__out" id="ed-out" readonly rows="10" aria-label="Export preview"></textarea>
        </details>
      </section>

    </div>
  </aside>

  <!-- ══ THE PAGE (full bleed) ═════════════════════════════════════ -->
  <div class="mock" data-elev="lighter" id="mock">

    <!-- Sticky-state sentinel. A 1px marker directly above the nav, watched by
         IntersectionObserver: the moment it passes under the editor bar the nav
         is stuck, and `data-stuck` goes true on .mock. An observer rather than a
         scroll listener so there is no per-frame work and nothing to throttle. -->
    <span class="nav__sentinel" id="nav-sentinel" aria-hidden="true"></span>

    <header class="nav" id="top" data-lvl="raise-1" data-sh="header">
      <div class="nav__inner">
        <span class="nav__logo"><span class="nav__dot"></span> Surface Test</span>
        <!-- Real in-page anchors, named for the bands that actually exist. The
             nav has to do real work for the sticky shadow to be judged: you have
             to be able to click through and watch it cross content. -->
        <nav class="nav__links">
          <a href="#top" aria-current="page">Overview</a>
          <a href="#levels">Levels</a>
          <a href="#cards">Cards</a>
          <a href="#settings">Settings</a>
          <a href="#inverse">Inverse</a>
          <a href="#shadows">Shadows</a>
        </nav>
        <a href="#mock" class="btn btn--outline btn--sm">Secondary</a>
        <a href="#mock" class="btn btn--sm">Primary</a>
      </div>
    </header>

    <main class="page">

      <!-- hero — content on the base surface -->
      <section class="wrap hero">
        <p class="eyebrow">Mockup · not a live page</p>
        <h1 class="hero__h">A test page for surface and color options</h1>
        <p class="hero__sub">
          Placeholder copy, held at roughly the length real copy would run so line
          breaks and vertical rhythm still behave like a page that ships.
        </p>
        <div class="hero__actions">
          <a href="#mock" class="btn">Primary action</a>
          <a href="#mock" class="btn btn--outline">Secondary action</a>
          <a href="#mock" class="link">Sample link →</a>
        </div>
      </section>

      <!-- feature (+1) with nested panel (+2) containing a well (−1) -->
      <section class="wrap" id="levels">
        <div class="feature" data-lvl="raise-1" data-sh="card">
          <div class="feature__body">
            <h2 class="feature__h">Three levels, nested</h2>
            <p>
              Sample section. This card is +1 on the page, the panel beside it is +2,
              and the block inside that is −1 — so the whole stack can be read in one
              glance without hunting for each level separately.
            </p>
            <a href="#mock" class="link">Sample link →</a>
          </div>

          <aside class="nested" data-lvl="raise-2" data-sh="nested">
            <span class="nested__cap">Capabilities</span>
            <ul class="nested__list">
              {CAPABILITIES.map(c => (
                <li>
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                  {c}
                </li>
              ))}
            </ul>
            <div class="well" data-lvl="sunken" data-sh="inset">
              <code>sample code block · surface −1</code>
            </div>
          </aside>
        </div>
      </section>

      <!-- solution cards — +1 on base -->
      <section class="wrap" id="cards">
        <h2 class="band__h">Sample cards · +1 on base</h2>
        <div class="cards">
          {SOLUTIONS.map(s => (
            <a href="#mock" class="card card-float" data-lvl="raise-1" data-sh="card">
              <span class="card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d={s.icon} />
                </svg>
              </span>
              <h3 class="card__h">{s.title}</h3>
              <p class="card__b">{s.body}</p>
              <span class="card__more">Learn more →</span>
            </a>
          ))}
        </div>
      </section>

      <!-- controls — heading/copy on the BASE surface (no card), controls in a
           +1 panel beside it. Puts base, +1 and −1 in one horizontal read. -->
      <section class="wrap prefs" id="settings">
        <!-- Body copy on the BASE surface, so running text is judged against the
             page itself rather than against a card. -->
        <div class="prefs__intro">
          <h2 class="prefs__h">Lorem ipsum dolor sit amet</h2>
          <p class="prefs__b">
            Consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore
            et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud
            exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
          </p>
          <p class="prefs__b">
            Duis aute irure dolor in reprehenderit in voluptate velit esse cillum
            dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non
            proident, sunt in culpa qui officia deserunt mollit anim id est laborum.
          </p>
          <a href="#mock" class="link">Lorem ipsum dolor →</a>
        </div>

        <!-- A real settings card: one rhythm — label + help on the left, control
             on the right — separated by rules, with a recessed action footer.
             Every level appears: +1 card, −1 footer/fields/tracks, +2 knob and
             active segment. -->
        <div class="panel" data-lvl="raise-1" data-sh="card">
          <div class="panel__head">
            <div>
              <h3 class="panel__h">Sample preferences</h3>
              <p class="panel__b">Controls sit <em>below</em> the surface they live on.</p>
            </div>
            <span class="pill" data-lvl="sunken" data-sh="inset"><i class="pill__dot"></i>Sample state</span>
          </div>

          <div class="setting">
            <div class="setting__text">
              <span class="setting__label">Sample toggle, on</span>
              <span class="setting__help">Track is −1; the knob is +2. Helper text is the body ink.</span>
            </div>
            <button type="button" class="switch__track is-on" role="switch" aria-checked="true" aria-label="Auto-approve" data-lvl="sunken" data-sh="inset">
              <span class="switch__knob" data-lvl="raise-2" data-sh="knob"></span>
            </button>
          </div>

          <div class="setting">
            <div class="setting__text">
              <span class="setting__label">Sample toggle, off</span>
              <span class="setting__help">Same control in its resting state, for comparison.</span>
            </div>
            <button type="button" class="switch__track" role="switch" aria-checked="false" aria-label="Public listing" data-lvl="sunken" data-sh="inset">
              <span class="switch__knob" data-lvl="raise-2" data-sh="knob"></span>
            </button>
          </div>

          <div class="setting">
            <div class="setting__text">
              <span class="setting__label">Sample segmented control</span>
              <span class="setting__help">Sunken track, with the active segment raised to +2.</span>
            </div>
            <div class="seg" role="group" aria-label="Default view" data-lvl="sunken" data-sh="inset">
              <button type="button" class="seg__btn is-on" data-lvl="raise-2" data-sh="knob">Grid</button>
              <button type="button" class="seg__btn">List</button>
              <button type="button" class="seg__btn">Map</button>
            </div>
          </div>

          <div class="setting setting--stack">
            <div class="setting__text">
              <span class="setting__label">Sample text field</span>
              <span class="setting__help">Inset into the card, bordered with the strong rule.</span>
            </div>
            <span class="field__input" data-lvl="sunken" data-sh="inset">placeholder value</span>
          </div>

          <div class="panel__foot" data-lvl="sunken" data-sh="inset">
            <span class="panel__meta">Sample footer · recessed strip</span>
            <div class="panel__actions">
              <a href="#mock" class="btn btn--outline btn--sm">Reset</a>
              <a href="#mock" class="btn btn--sm">Save changes</a>
            </div>
          </div>
        </div>
      </section>

      <section class="wrap" id="marks">
        <h2 class="band__h">Third-party marks · sample</h2>
        <div class="press">
          {PRESS.map(p => (
            <a href="#mock" class="press__item card-float" aria-label={p.name} data-lvl="raise-1" data-sh="card">
              <span class="press__mark" set:html={p.svg} />
              <span class="press__name">{p.name}</span>
            </a>
          ))}
        </div>
      </section>

      <!-- Inverse CARD floating on the normal base. The card is the mode
           change, not the section — so the inverse levels are judged against
           the ordinary page around them, which is how an inverse block
           actually appears on the site. Layered inside: +1 card, +2 badge,
           −1 field, plus body text and a rule directly on the card. -->
      <section class="wrap" id="inverse">
        <div class="cta" data-inverse data-lvl="base" data-sh="card">
          <div class="cta__top">
            <div class="cta__text">
              <span class="cta__badge" data-lvl="raise-1" data-sh="nested">Inverse sample</span>
              <h2 class="cta__h">This card runs opposite the page</h2>
              <p class="cta__b">Same four levels, flipped. Placeholder copy.</p>
            </div>
            <div class="cta__form">
              <label class="field">
                <span class="field__label">Sample field</span>
                <span class="field__input field__input--mute cta__field" data-lvl="sunken" data-sh="inset">placeholder@example.com</span>
              </label>
              <a href="#mock" class="btn">Primary</a>
            </div>
          </div>

          <ul class="inv__meta" data-lvl="raise-1" data-sh="card">
            <li><b>000</b> sample stat</li>
            <li><b>00</b> sample stat</li>
            <li><b>0.00</b> sample stat</li>
            <li><b>00%</b> sample stat</li>
            <li class="inv__meta-hi" data-lvl="raise-2" data-sh="nested"><b>Sample</b> highlighted · +2</li>
          </ul>
        </div>
      </section>

      <!-- shadow assessment, inside the page so it sits on the real surface -->
      <section class="wrap" id="shadows">
        <h2 class="band__h">The shadow ladder</h2>
        <p class="band__note">
          Every rung of the ladder — on the base surface, and again on +1. Flip
          direction and theme above: a shadow tuned for a light ground can read
          as grime on a dark one, and when raised surfaces are <em>darker</em> than the
          page a drop shadow argues with the value step instead of reinforcing it.
          Which components actually <em>take</em> their rung is the Shadows panel's
          second half; this band always shows all four.
        </p>
        <div class="shadows">
          {RUNGS.map(s => (
            <div class="shadows__card" data-lvl="raise-1" style={`box-shadow: ${s.token}`}>
              <span class="shadows__name">{s.name}</span>
              <span class="shadows__sub">{s.sub} · on base</span>
            </div>
          ))}
        </div>
        <div class="shadows shadows--onraise" data-lvl="raise-1">
          {RUNGS.map(s => (
            <div class="shadows__card shadows__card--2" data-lvl="raise-2" style={`box-shadow: ${s.token}`}>
              <span class="shadows__name">{s.name}</span>
              <span class="shadows__sub">{s.sub} · on +1</span>
            </div>
          ))}
        </div>
      </section>
    </main>

    <footer class="foot" data-lvl="raise-1">
      <div class="wrap">
        <div class="foot__cols">
          {['Column one', 'Column two', 'Column three', 'Column four'].map(h => (
            <div>
              <span class="foot__h">{h}</span>
              <a href="#mock" class="link-quiet">Sample link</a>
              <a href="#mock" class="link-quiet">Sample link</a>
              <a href="#mock" class="link-quiet">Sample link</a>
            </div>
          ))}
        </div>
        <div class="foot__base">
          <span>Mockup for surface review — not an OpenMined page.</span>
          <a href="#mock" class="link-quiet">Sample link</a>
        </div>
      </div>
    </footer>
  </div>

  <script>
    import {
      STEPS, SLOTS, PALETTES, SLOT_LABEL, PALETTE_LABEL, DEFAULT_ASSIGN,
      BORDER_MODES, BORDER_LABEL, BORDER_HELP,
      LEVELS, KINDS, TRIGGERS, DELTAS, deltaLabel, trigger, PRESETS, PRESET_LABEL,
      DEFAULT_LADDER, DEFAULT_INK, DEFAULT_APPLY, rungCss,
      newState, readBrandGrayscale, readRampShape, resolveGrayscale, stepValues,
      paletteKey, assignedStep, SAT_MAX_C,
      emitCss, exportCss, exportJson, encodeUrl, decodeUrl,
      type Step, type Slot, type StepEdit, type Level, type Delta,
    } from './_editor.ts';

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const mock = document.querySelector<HTMLElement>('.mock')!;
    const brand = readBrandGrayscale();

    const shape = readRampShape(brand);
    const st = decodeUrl(newState(), location.search);
    // Base.astro's inline script has already resolved the theme from
    // localStorage / system preference. Adopt it unless the URL names one —
    // otherwise the editor would stomp a shared dark-mode link back to light
    // and fight the brand ThemeToggle on every apply().
    if (!new URLSearchParams(location.search).has('t')) {
      const initial = document.documentElement.getAttribute('data-theme');
      if (initial === 'dark' || initial === 'light') st.theme = initial;
    }
    let resolved = resolveGrayscale(brand, st, shape);
    let gray = resolved.hex;

    // Live stylesheet the editor owns. _surfaces.css stays the no-JS default.
    const live = document.createElement('style');
    live.id = 'live-surfaces';
    document.head.appendChild(live);

    /* ── render ─────────────────────────────────────────────────────── */

    /**
     * Drag-safe update. renderAll() replaces innerHTML, which destroys the very
     * <input type="range"> being dragged — the browser loses the pointer
     * capture and the drag dies after one frame. That is why sliders responded
     * to a click (one discrete event) but not to a drag.
     * So during input we touch only the live stylesheet, the existing swatch
     * nodes, and the slider's own numeric readout. The full re-render runs on
     * `change`, i.e. once the drag ends.
     */
    function applyLive(src?: HTMLInputElement) {
      resolved = resolveGrayscale(brand, st, shape); gray = resolved.hex;
      live.textContent = emitCss(gray, st);
      document.querySelectorAll<HTMLElement>('[data-swatch]').forEach(el => {
        el.style.background = gray[el.dataset.swatch as Step];
      });
      // Keep the slider and its number input in lockstep, updating only the
      // one the user is NOT currently interacting with.
      if (src) {
        src.closest('.sl')?.querySelectorAll('input').forEach(i => {
          if (i !== src) (i as HTMLInputElement).value = src.value;
        });
      }
      history.replaceState(null, '', encodeUrl(brand, gray, st));
    }

    function apply() {
      resolved = resolveGrayscale(brand, st, shape); gray = resolved.hex;
      live.textContent = emitCss(gray, st);
      document.documentElement.setAttribute('data-theme', st.theme);
      // On <body>, NOT <html>. `[data-theme="dark"] [data-elev]` is a DESCENDANT
      // selector — with both attributes on the same element it can never match,
      // so dark-mode values silently failed to reach anything resolving from the
      // document root (the rail, and the inverse ink tokens). body is a
      // descendant of html, so the pairing resolves.
      document.body.dataset.elev = st.elev;
      document.querySelectorAll<HTMLElement>('[data-elev]').forEach(el => { el.dataset.elev = st.elev; });
      mock.dataset.borders = st.borders;
      document.querySelectorAll<HTMLElement>('[data-elev-set]').forEach(b => {
        b.classList.toggle('is-on', b.dataset.elevSet === st.elev);
      });
      history.replaceState(null, '', encodeUrl(brand, gray, st));
      renderAll();
    }

    /**
     * Slider + paired number input.
     *
     * Precision comes from four routes, three of them free:
     *  · drag            — coarse, the base step
     *  · SHIFT + drag    — fine, one tenth of the step (handled below)
     *  · arrow keys      — native to <input type=range>, moves by `step`;
     *                      Home/End jump to the ends, PageUp/Dn move x10
     *  · type a value    — the number input, for an exact figure
     *
     * Both inputs carry the same data-* hooks, so the existing read path
     * handles either without branching.
     */
    const ctrl = (
      label: string, hooks: string, value: number,
      o: { min: number; max: number; step: number; unit?: string; lead?: boolean },
    ) => `
      <label class="sl${o.lead ? ' sl--lead' : ''}">
        <span>${label}</span>
        <input type="range" min="${o.min}" max="${o.max}" step="${o.step}"
               data-coarse="${o.step}" data-fine="${o.step / 10}" value="${value}" ${hooks}>
        <span class="sl__val">
          <input type="number" class="sl__num" min="${o.min}" max="${o.max}" step="${o.step}"
                 value="${value}" ${hooks} aria-label="${label}">
          ${o.unit ? `<i>${o.unit}</i>` : ''}
        </span>
      </label>`;

    const swatch = (hex: string, extra = '') =>
      `<i class="sw ${extra}" style="background:${hex}"></i>`;

    // Selection state — UI only, never encoded in the URL.
    let selSlot: Slot | null = null;
    let selStep: Step | null = null;
    let selRung: Level = 'raise-1';

    function renderBarPal() {
      const pal = paletteKey(st);
      $('bar-pal').innerHTML = SLOTS.map(slot => {
        const step = assignedStep(st, pal, slot);
        return `<button type="button" class="bar__sw" data-goto="${slot}"
                  title="${SLOT_LABEL[slot]} → grayscale-${step} (${gray[step]})">
                  <i class="sw" data-swatch="${step}" style="background:${gray[step]}"></i></button>`;
      }).join('');
    }

    /* Overview grid: one tile per slot. Click a tile to assign a step. */
    function renderSlots() {
      const pal = paletteKey(st);
      $('ed-pal-name').textContent = PALETTE_LABEL[pal];
      $('ed-slots').innerHTML = SLOTS.map(slot => {
        const step = assignedStep(st, pal, slot);
        const dirty = step !== DEFAULT_ASSIGN[pal][slot];
        return `<button type="button" class="sw-card sw-card--tile ${selSlot === slot ? 'is-sel' : ''}"
          data-slot-pick="${slot}" title="${SLOT_LABEL[slot]} → grayscale-${step} (${gray[step]})">
          <span class="sw-card__color" data-swatch="${step}" style="background:${gray[step]}"></span>
          <span class="sw-card__info">
            <span class="sw-card__label">${SLOT_LABEL[slot]}</span>
            <span class="sw-card__hex">${step}${dirty ? ' •' : ''}</span>
          </span>
        </button>`;
      }).join('');

      if (!selSlot) { $('ed-assign').innerHTML = ''; return; }
      const cur = assignedStep(st, pal, selSlot);
      const dirty = cur !== DEFAULT_ASSIGN[pal][selSlot];
      $('ed-assign').innerHTML = `
        <div class="pick">
          <div class="pick__head">
            <b>${SLOT_LABEL[selSlot]}</b>
            <code>grayscale-${cur}</code>
            <button type="button" class="row__rev ${dirty ? 'is-dirty' : ''}" data-revert-slot="${selSlot}" ${dirty ? '' : 'disabled'} title="Revert to brand default">↺</button>
            <button type="button" class="pick__x" data-slot-pick="">✕</button>
          </div>
          <div class="ramp ramp--pick">
            ${STEPS.map(s2 => `<button type="button" class="sw-card ${s2 === cur ? 'is-sel' : ''}"
              data-assign="${s2}" title="grayscale-${s2} ${gray[s2]}">
              <span class="sw-card__color" data-swatch="${s2}" style="background:${gray[s2]}"></span>
              <span class="sw-card__info"><span class="sw-card__label">${s2}</span></span>
            </button>`).join('')}
          </div>
        </div>`;
    }

    /* The ramp stays small. Only the selected step opens an editor. */
    function renderSteps() {
      const pal = paletteKey(st);
      const inUse = new Set(SLOTS.map(sl => assignedStep(st, pal, sl)));
      $('ed-steps').innerHTML = STEPS.map(step => {
        const changed = gray[step].toLowerCase() !== brand[step].toLowerCase();
        return `<button type="button" class="sw-card ${selStep === step ? 'is-sel' : ''} ${inUse.has(step) ? 'is-used' : ''} ${changed ? 'is-changed' : ''}"
          data-step-pick="${step}" title="grayscale-${step} ${gray[step]}${inUse.has(step) ? ' · in use' : ''}">
          <span class="sw-card__color" data-swatch="${step}" style="background:${gray[step]}"></span>
          <span class="sw-card__info"><span class="sw-card__label">${step}${changed ? ' •' : ''}</span></span>
        </button>`;
      }).join('');

      if (!selStep) { $('ed-stepedit').innerHTML = ''; return; }
      const step = selStep;
      const v = stepValues(shape, st, step);
      const changed = gray[step].toLowerCase() !== brand[step].toLowerCase();
      const dL = v.L - shape.L[step];
      $('ed-stepedit').innerHTML = `
        <div class="pick">
          <div class="pick__head">
            ${swatch(gray[step])}
            <b>grayscale-${step}</b>
            <code>${gray[step]}</code>
            <button type="button" class="row__rev ${changed ? 'is-dirty' : ''}" data-revert-step="${step}" ${changed ? '' : 'disabled'} title="Revert to brand ${brand[step]}">↺</button>
            <button type="button" class="pick__x" data-step-pick="">✕</button>
          </div>

          ${ctrl('lightness', `data-step="${step}" data-ch="L"`, Number(v.L.toFixed(1)), { min: 0, max: 100, step: 0.5, lead: true })}
          <p class="ed__note">
            Brand ${shape.L[step].toFixed(1)}${Math.abs(dL) >= 0.05 ? ` · ${dL > 0 ? '+' : ''}${dL.toFixed(1)}` : ''}
            ${resolved.clamped.has(step) ? ' · tint clipped by sRGB at this lightness' : ''}
          </p>

          ${ctrl('hue', `data-step="${step}" data-ch="dh"`, v.dh, { min: -40, max: 40, step: 1, unit: '°' })}
          ${ctrl('tint', `data-step="${step}" data-ch="ds"`, v.ds, { min: -40, max: 40, step: 1, unit: '%' })}
          <p class="ed__note">
            Hue and tint are offsets from the global cast, so moving the cast
            carries them along. Resolves to ${Math.round(v.hue)}° / ${v.sat.toFixed(0)}%.
          </p>
        </div>`;
    }

    function renderCast() {
      const h = st.cast.hue ?? shape.hue;
      const sat = st.cast.sat ?? shape.satPct;
      const on = st.cast.hue !== null || st.cast.sat !== null;
      $('ed-cast-wrap').classList.toggle('is-on', on);
      $('ed-cast').innerHTML = `
        ${ctrl('hue', 'data-cast="hue"', Math.round(h), { min: 0, max: 360, step: 1, unit: '°' })}
        ${ctrl('tint', 'data-cast="sat"', Math.round(sat), { min: 0, max: 100, step: 1, unit: '%' })}
        <div class="ed__actions">
          <button type="button" class="ed__btn" data-reset="cast" ${on ? '' : 'disabled'}>Reset cast</button>
        </div>
        <p class="ed__note">
          The whole ramp's hue and tint strength. Every step keeps its share of the
          arc — light steps stay near-neutral — so tint 0% neutralises the ramp
          without touching lightness. Brand sits at ${Math.round(shape.hue)}° / ${Math.round(shape.satPct)}%.
        </p>`;
    }

    function renderBorders() {
      $('ed-borders').innerHTML = `
        <div class="segctl">
          ${BORDER_MODES.map(m => `<button type="button" class="segctl__b ${st.borders === m ? 'is-on' : ''}" data-border="${m}">${BORDER_LABEL[m]}</button>`).join('')}
        </div>
        <p class="ed__note">${BORDER_HELP[st.borders]}</p>`;
    }

    /* Same drill-down as colours: pick one size, edit only that one. */
    /* Shadows — three tables, in the order the model reads:
       the LADDER (shared), the INK (per palette), and which kinds APPLY it. */
    function renderShadows() {
      const pal = paletteKey(st);
      $('ed-shadow-mode').textContent = PALETTE_LABEL[pal];

      const r = st.shadow.ladder[selRung], dr = DEFAULT_LADDER[selRung];
      const ink = st.shadow.ink[pal], dink = DEFAULT_INK[pal];
      const rungDirty = (l: Level) => JSON.stringify(st.shadow.ladder[l]) !== JSON.stringify(DEFAULT_LADDER[l]);

      // A rung is previewed on the surface it belongs to, because a shadow is
      // only judgeable against its own ground.
      const preview = `<div class="shdprev" style="background: var(--s-${selRung === 'base' ? 'base' : selRung})">
          <i style="box-shadow: ${rungCss(r, ink, gray)}; background: var(--s-${selRung})"></i></div>`;

      const applyRows = KINDS.map(k => {
        const row = k.triggers.map(tk => {
          const t = trigger(tk)!;
          const cur = st.shadow.apply[k.key]?.[tk] ?? null;
          const opts = DELTAS.map(d =>
            `<option value="${d === null ? 'x' : d}" ${d === cur ? 'selected' : ''}>${deltaLabel(d)}</option>`).join('');
          return `<label class="shk__t"><span>${t.label}</span>
                    <select class="row__sel" data-apply="${k.key}.${tk}">${opts}</select></label>`;
        }).join('');
        const dirty = k.triggers.some(tk => (st.shadow.apply[k.key]?.[tk] ?? null) !== (DEFAULT_APPLY[k.key]?.[tk] ?? null));
        return `<div class="shk">
            <div class="shk__h"><b>${k.label}</b>
              <button type="button" class="row__rev ${dirty ? 'is-dirty' : ''}" data-revert-kind="${k.key}">↺</button>
            </div>
            <p class="ed__note">${k.note}</p>
            <div class="shk__ts">${row}</div>
          </div>`;
      }).join('');

      $('ed-shadows').innerHTML = `
        <p class="ed__note">The ladder is shared by all four palettes — geometry is
          distance off the page. Only the ink changes with the ground.</p>

        <div class="segctl" role="group" aria-label="Rung">
          ${LEVELS.map(l => `<button type="button" class="segctl__b ${selRung === l ? 'is-on' : ''} ${rungDirty(l) ? 'is-dirty' : ''}" data-rung-pick="${l}">${l === 'raise-1' ? '+1' : l === 'raise-2' ? '+2' : l === 'sunken' ? '−1' : '0'}</button>`).join('')}
        </div>
        ${preview}
        ${ctrl('y', `data-shd="${selRung}" data-k="y"`, r.y, { min: -24, max: 48, step: 1 })}
        ${ctrl('blur', `data-shd="${selRung}" data-k="blur"`, r.blur, { min: 0, max: 96, step: 1 })}
        ${ctrl('spread', `data-shd="${selRung}" data-k="spread"`, r.spread, { min: -24, max: 24, step: 1 })}
        ${ctrl('alpha', `data-shd="${selRung}" data-k="alpha"`, r.alpha, { min: 0, max: 1, step: 0.01 })}
        <div class="row">
          <label class="row__check"><input type="checkbox" data-rung-inset ${r.inset ? 'checked' : ''}><span>inset</span></label>
          <button type="button" class="row__rev ${rungDirty(selRung) ? 'is-dirty' : ''}" data-revert-rung="${selRung}">↺</button>
        </div>

        <h4 class="shk__sec">Ink: ${PALETTE_LABEL[pal]}</h4>
        <div class="row">
          <span class="row__label">color</span>
          ${swatch(gray[ink.step])}
          <select class="row__sel" data-ink-step>${STEPS.map(x => `<option value="${x}" ${x === ink.step ? 'selected' : ''}>${x}</option>`).join('')}</select>
        </div>
        ${ctrl('strength', 'data-ink-strength', ink.strength, { min: 0, max: 5, step: 0.05 })}
        <div class="row">
          <span class="ed__note">Multiplies every rung's alpha on this palette.</span>
          <button type="button" class="row__rev ${ink.step !== dink.step || ink.strength !== dink.strength ? 'is-dirty' : ''}" data-revert-ink="${pal}">↺</button>
        </div>

        <h4 class="shk__sec">Applied to</h4>
        <p class="ed__note">A trigger moves an element along the ladder — never to
          some other shadow. <b>Off</b> means no shadow at that trigger.</p>
        <div class="shk__presets">
          ${Object.keys(PRESETS).map(k => `<button type="button" class="segctl__b" data-preset="${k}">${PRESET_LABEL[k]}</button>`).join('')}
        </div>
        ${applyRows}`;
    }

    function renderAll() {
      renderBarPal(); renderSlots(); renderCast(); renderSteps(); renderBorders(); renderShadows();
    }

    /* ── events ─────────────────────────────────────────────────────── */

    const readSlider = (t: HTMLInputElement) => {
      if (t.dataset.cast) {
        (st.cast as any)[t.dataset.cast] = Number(t.value);
      } else if (t.dataset.step && t.dataset.ch) {
        const step = t.dataset.step as Step;
        const e: StepEdit = { ...(st.gray[step] ?? {}) };
        (e as any)[t.dataset.ch] = Number(t.value);
        st.gray[step] = e;
      } else if (t.dataset.shd) {
        (st.shadow.ladder[t.dataset.shd as Level] as any)[t.dataset.k!] = Number(t.value);
      } else if (t.hasAttribute('data-ink-strength')) {
        st.shadow.ink[paletteKey(st)].strength = Number(t.value);
      } else {
        return false;
      }
      return true;
    };

    // Continuous: no re-render, so the drag survives.
    document.addEventListener('input', e => {
      const t = e.target as HTMLInputElement;
      if (t.tagName === 'INPUT' && readSlider(t)) applyLive(t);
    });

    // Settled: full re-render so revert buttons, dots and labels catch up.
    document.addEventListener('change', e => {
      const t = e.target as HTMLInputElement;
      if (t.tagName === 'INPUT' && t.type === 'range' && readSlider(t)) apply();
    });

    document.addEventListener('change', e => {
      const t = e.target as HTMLSelectElement;
      if (t.dataset.slot) {
        const pal = paletteKey(st);
        (st.assign[pal] ||= {})[t.dataset.slot as Slot] = t.value as Step;
        apply();
      } else if (t.hasAttribute('data-rung-inset')) {
        st.shadow.ladder[selRung].inset = (t as HTMLInputElement).checked;
        apply();
      } else if (t.hasAttribute('data-ink-step')) {
        st.shadow.ink[paletteKey(st)].step = t.value as Step;
        apply();
      } else if (t.dataset.apply) {
        const [kind, tk] = t.dataset.apply.split('.');
        (st.shadow.apply[kind] ||= {})[tk] = t.value === 'x' ? null : Number(t.value);
        apply();
      }
    });

    document.addEventListener('click', async e => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('[data-elev-set],[data-border],[data-revert-slot],[data-revert-step],[data-revert-rung],[data-revert-ink],[data-revert-kind],[data-reset],[data-copy],[data-goto],[data-slot-pick],[data-step-pick],[data-assign],[data-rung-pick],[data-preset]');
      if (!t) return;

      if (t.hasAttribute('data-slot-pick')) {
        const v = t.dataset.slotPick!;
        selSlot = v && v !== selSlot ? (v as Slot) : null;
        renderAll(); return;
      }
      if (t.hasAttribute('data-step-pick')) {
        const v = t.dataset.stepPick!;
        selStep = v && v !== selStep ? (v as Step) : null;
        renderAll(); return;
      }
      if (t.dataset.assign && selSlot) {
        const pal = paletteKey(st);
        (st.assign[pal] ||= {})[selSlot] = t.dataset.assign as Step;
        apply(); return;
      }
      if (t.dataset.rungPick) { selRung = t.dataset.rungPick as Level; renderAll(); return; }
      if (t.dataset.preset) { st.shadow.apply = structuredClone(PRESETS[t.dataset.preset]); apply(); return; }

      if (t.dataset.elevSet) { st.elev = t.dataset.elevSet as 'lighter' | 'darker'; apply(); return; }
      if (t.dataset.border)  { st.borders = t.dataset.border as any; apply(); return; }
      if (t.dataset.revertSlot) {
        const pal = paletteKey(st);
        delete st.assign[pal]?.[t.dataset.revertSlot as Slot];
        apply(); return;
      }
      if (t.dataset.revertStep) { delete st.gray[t.dataset.revertStep as Step]; apply(); return; }
      if (t.dataset.revertRung) {
        st.shadow.ladder[t.dataset.revertRung as Level] = { ...DEFAULT_LADDER[t.dataset.revertRung as Level] };
        apply(); return;
      }
      if (t.dataset.revertInk) {
        st.shadow.ink[t.dataset.revertInk as keyof typeof DEFAULT_INK] = { ...DEFAULT_INK[t.dataset.revertInk as keyof typeof DEFAULT_INK] };
        apply(); return;
      }
      if (t.dataset.revertKind) {
        st.shadow.apply[t.dataset.revertKind] = { ...DEFAULT_APPLY[t.dataset.revertKind] };
        apply(); return;
      }
      if (t.dataset.reset === 'cast') { st.cast = { hue: null, sat: null }; apply(); return; }
      if (t.dataset.reset === 'all') {
        st.gray = {}; st.assign = {}; st.cast = { hue: null, sat: null };
        st.borders = 'selective';
        st.shadow = {
          ladder: structuredClone(DEFAULT_LADDER),
          ink: structuredClone(DEFAULT_INK),
          apply: structuredClone(DEFAULT_APPLY),
        };
        apply(); return;
      }
      if (t.dataset.goto) {
        if ($('drawer').hidden) $('info-toggle').click();
        $(`slot-${t.dataset.goto}`)?.scrollIntoView({ block: 'center', behavior: 'smooth' });
        return;
      }
      if (t.dataset.copy) {
        const text = t.dataset.copy === 'css' ? exportCss(brand, gray, st)
                   : t.dataset.copy === 'json' ? exportJson(brand, gray, st)
                   : location.href;
        $<HTMLTextAreaElement>('ed-out').value = text;
        try { await navigator.clipboard.writeText(text); $('ed-status').textContent = `Copied ${t.dataset.copy}.`; }
        catch { $('ed-status').textContent = 'Clipboard blocked — copy from the box above.'; }
      }
    });

    // Theme toggle is the brand component, so watch the attribute rather than
    // reaching into it — shadows and the palette strip are per-mode.
    new MutationObserver(() => {
      const t = document.documentElement.getAttribute('data-theme');
      if ((t === 'dark' || t === 'light') && t !== st.theme) { st.theme = t; apply(); }
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    /* ── page chrome ────────────────────────────────────────────────── */

    const infoBtn = $('info-toggle'), rail = $('drawer');
    infoBtn.addEventListener('click', () => {
      const open = infoBtn.getAttribute('aria-expanded') === 'true';
      infoBtn.setAttribute('aria-expanded', String(!open));
      rail.hidden = open;
      infoBtn.classList.toggle('is-open', !open);
      // Reflow the page beside the rail rather than letting it cover the
      // thing you are trying to judge.
      document.documentElement.classList.toggle('has-rail', !open);
    });

    document.querySelectorAll<HTMLElement>('.switch__track').forEach(tr => {
      tr.addEventListener('click', () => {
        const on = tr.classList.toggle('is-on');
        tr.setAttribute('aria-checked', String(on));
      });
    });
    document.querySelectorAll<HTMLElement>('.seg').forEach(seg => {
      seg.querySelectorAll<HTMLElement>('.seg__btn').forEach(b => {
        b.addEventListener('click', () => {
          seg.querySelectorAll('.seg__btn').forEach(x => {
            x.classList.remove('is-on');
            // The knob IS the active segment, so its tag travels with the
            // state rather than being pinned to whichever button shipped on.
            x.removeAttribute('data-sh');
            x.removeAttribute('data-lvl');
          });
          b.classList.add('is-on');
          b.setAttribute('data-lvl', 'raise-2');
          b.setAttribute('data-sh', 'knob');
        });
      });
    });

    /* ── Dev audit: a surface must declare the level it is painted with ──
       `background: var(--s-raise-1)` and `data-lvl="raise-1"` are two halves
       of one statement, and nothing holds them together — four sunken surfaces
       shipped untagged before this existed, so their inset shadow silently
       never appeared.

       Walks the CSSOM for rules that paint a level, then checks the elements
       those rules ACTUALLY match, so it uses the browser's own selector
       matching rather than a guess at which markup a class reaches. */
    function auditLevels() {
      const paints = new Map<string, string>();
      for (const sheet of Array.from(document.styleSheets)) {
        let rules: CSSRuleList;
        try { rules = sheet.cssRules; } catch { continue; } // cross-origin (fonts)
        for (const rule of Array.from(rules)) {
          if (!(rule instanceof CSSStyleRule)) continue;
          const bg = rule.style.getPropertyValue('background') || rule.style.getPropertyValue('background-color');
          const m = bg.match(/var\(--s-(sunken|base|raise-1|raise-2)\)/);
          if (m) paints.set(rule.selectorText, m[1]);
        }
      }
      const bad: { el: Element; expected: string; got: string }[] = [];
      for (const [sel, lvl] of paints) {
        let els: NodeListOf<HTMLElement>;
        try { els = mock.querySelectorAll<HTMLElement>(sel); } catch { continue; }
        for (const el of Array.from(els)) {
          if (el.dataset.lvl !== lvl) bad.push({ el, expected: lvl, got: el.dataset.lvl ?? '(none)' });
        }
      }
      if (bad.length) console.warn(`[surfaces] ${bad.length} element(s) painted with a level but not declaring it:`, bad);
      else console.info(`[surfaces] level audit clean — ${paints.size} painting rules checked`);
    }
    auditLevels();

    /* ── Sticky header state ──────────────────────────────────────────
       `data-stuck` on .mock the moment the sentinel passes under the editor
       bar. An IntersectionObserver rather than a scroll listener: no work
       per frame, nothing to throttle, and the browser does the maths.

       rootMargin pulls the root's top edge down by the bar height, so
       "stuck" means "the nav has reached its parked position" rather than
       "the nav has reached the top of the window" — which would fire late
       by exactly the height of the bar.

       --nav-h is published for the anchors' scroll-margin, measured rather
       than guessed so it stays right if the nav ever changes height. */
    {
      const mockEl = document.getElementById('mock')!;
      const navEl = mockEl.querySelector<HTMLElement>('.nav')!;
      const sentinel = document.getElementById('nav-sentinel')!;
      const barH = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--bar-h')) || 41;

      const publishNavH = () => document.documentElement.style.setProperty('--nav-h', `${navEl.offsetHeight}px`);
      publishNavH();
      if ('ResizeObserver' in window) new ResizeObserver(publishNavH).observe(navEl);

      new IntersectionObserver(
        ([e]) => { mockEl.dataset.stuck = e.isIntersecting ? 'false' : 'true'; },
        { rootMargin: `-${barH}px 0px 0px 0px`, threshold: 0 },
      ).observe(sentinel);
    }

    apply();
  </script>
</Base>

<style is:global>
  /* The mock is the page, so the document surface must be the mock surface —
     otherwise a seam shows above the nav and below the footer. */
  body { background-color: var(--s-base, var(--surface-background-default)); }
  /* global.css line 409 paints EVERY <section> with --surface-background-default,
     which leaks the real page's surface into the mock and clashes with --s-base.
     Worth flagging beyond this page: a <section> nested inside any differently
     surfaced container clashes by default, on the live site too. */
  .mock section, .mock main { background-color: transparent; }
</style>

<style>
  /* ══ THE MOCK ═══════════════════════════════════════════════════════
     Reads ONLY from --s-* levels + the site's real type/component rules.
     No grayscale step is referenced directly. ═══════════════════════ */

  .mock {
    background: var(--s-base);
    color: var(--s-text-body);
    /* Type ported from openmined-org (the brand repo has no fluid type yet —
       Track 1B). Rubik display h1–h4, Inter body, site clamps. */
    --font-primary: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-secondary: 'Rubik', 'Inter', sans-serif;
    --h1-min: 36px; --h1-max: 61px;
    --h2-min: 28px; --h2-max: 47px;
    --h3-min: 24px; --h3-max: 36px;
    --h4-min: 22px; --h4-max: 27px;
    font-family: var(--font-primary);
    /* site link seam */
    --link-hover-line-gap: 2px;
    --link-hover-line-pad: 2px;
  }

  /* global.css line 29 — `p, li, td, th, label { color: var(--text-body) }` —
     is a DIRECT rule, so it beats inherited colour and these elements take the
     brand's ink token rather than the mock's. Inside an inverse block that is
     the wrong ink entirely. Re-point them at our token, using :where() so the
     rule stays at (0,1,0) and every component's own colour still wins on order.
     (Fifth bug this round from global.css binding style to a bare element.) */
  .mock :where(p, li, td, th, label) { color: var(--s-text-body); }

  .mock h1, .mock h2, .mock h3, .mock h4 { color: var(--s-text-headline); letter-spacing: 0; font-weight: 400; line-height: 1.2; margin: 0; }
  .mock h1 { font-family: var(--font-secondary); font-size: clamp(var(--h1-min), 4.69vw, var(--h1-max)); }
  .mock h2 { font-family: var(--font-secondary); font-size: clamp(var(--h2-min), 3.62vw, var(--h2-max)); }
  .mock h3 { font-family: var(--font-secondary); font-size: clamp(var(--h3-min), 2.77vw, var(--h3-max)); }
  .mock h4 { font-family: var(--font-secondary); font-size: clamp(var(--h4-min), 2.08vw, var(--h4-max)); }

  /* width:100% is load-bearing. .page is a grid, and in grid layout an auto
     margin OVERRIDES stretch — the item collapses to fit-content and the
     margins eat the free space. Without it every section sized itself to its
     own content, so the hero, the prefs split, the integrations row and the
     newsletter card all ended up different widths while appearing centred. */
  .wrap { width: 100%; max-width: 1300px; margin-inline: auto; padding-inline: var(--spacing-3XL); }

  /* nav — +1 */
  /* ── Sticky header ──────────────────────────────────
     The one case where a full-bleed band plausibly earns a shadow: once it
     stops sitting in the flow and starts covering content, value alone no
     longer says which layer is on top. Parks under the editor bar, below it
     in the stack (bar 60, rail 58, nav 40) so tooling always wins.

     The shadow is a SCROLL STATE, not a resting property — nothing at the
     top of the page, shadow once content runs beneath. That is a third
     trigger alongside rest and hover, and it belongs to this element alone. */
  .nav__sentinel { display: block; height: 1px; margin-bottom: -1px; }
  .nav {
    background: var(--s-raise-1);
    border-bottom: 1px solid var(--s-line);
    position: sticky; top: var(--bar-h); z-index: 40;
    transition: box-shadow var(--transition-base);
  }
  /* The stuck shadow is emitted by the editor from the Header kind's `stuck`
     trigger. Nothing in component CSS names a shadow token any more — an
     element declares the level it sits on and the kind of thing it is, and
     the system decides the rest. */

  /* Anchor targets clear both the bar and the nav. --nav-h is measured at
     runtime rather than guessed, so it survives the nav changing height. */
  /* `.page > [id]` missed #top, which is the <header> and sits OUTSIDE <main>
     — so the Overview link landed with the nav tucked under the editor bar.
     Scoping to the mock covers every anchorable target instead of the ones
     that happen to be sections. */
  .mock [id] { scroll-margin-top: calc(var(--bar-h) + var(--nav-h, 64px) + var(--spacing-L)); }
  .nav__inner {
    width: 100%; max-width: 1300px; margin-inline: auto;
    padding: var(--spacing-M) var(--spacing-3XL);
    display: flex; align-items: center; gap: var(--spacing-L);
  }
  .nav__logo { display: flex; align-items: center; gap: var(--spacing-S); font-weight: 600; color: var(--s-text-headline); font-size: 1rem; }
  .nav__dot { width: 18px; height: 18px; border-radius: 5px; background: var(--s-text-headline); }
  .nav__links { display: flex; gap: var(--spacing-XL); margin-right: auto; margin-left: var(--spacing-XL); }

  /* ── Links: the site's .link-hover-line ─────────────────────────── */
  .nav__links a, .link, .card__more, .link-quiet {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-size: 0% 1px;
    background-position: left 0 bottom calc(var(--link-hover-line-pad) - var(--link-hover-line-gap));
    padding-bottom: var(--link-hover-line-pad);
    text-decoration: none;
    color: var(--s-text-body);
    transition: background-size var(--transition-base), color var(--transition-base);
  }
  .nav__links a:hover, .link:hover, .link-quiet:hover,
  .card:hover .card__more { background-size: 100% 1px; }
  .nav__links a[aria-current="page"] { background-size: 100% 1px; color: var(--s-text-headline); }
  .nav__links a { font-size: 0.9375rem; }
  .link { font-size: 0.9375rem; color: var(--s-text-headline); }
  .link-quiet { font-size: 0.875rem; color: var(--s-text-body); }
  .link-quiet:hover { color: var(--s-text-headline); }

  /* ── Buttons: the site's .btn / .btn--outline (neutral only) ────── */
  .btn {
    display: inline-flex; align-items: center; gap: 8px;
    background-color: var(--s-btn-bg);
    color: var(--s-btn-fg);
    padding: 11px 19px;
    min-height: 48px;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
    border: 1px solid transparent;
    border-radius: var(--border-radius-S);
    text-decoration: none;
    cursor: pointer;
    transition: background-color var(--transition-base), color var(--transition-base), border-color var(--transition-base);
  }
  .btn:hover { background-color: var(--s-btn-bg-hover); }
  .btn--outline { background-color: transparent; color: var(--s-text-headline); border-color: var(--s-text-headline); }
  .btn--outline:hover { background-color: transparent; border-color: var(--s-line-strong); color: var(--s-text-body); }
  .btn--sm { min-height: 38px; padding: 8px 14px; font-size: 0.875rem; }

  .page { padding-block: var(--spacing-full) var(--spacing-full); display: grid; gap: var(--spacing-full); }

  /* hero */
  .hero { max-width: 1300px; }
  .hero__h { max-width: 18ch; margin-bottom: var(--spacing-L); }
  .eyebrow { font-size: 1rem; color: var(--s-text-body); margin: 0 0 var(--spacing-M); }
  .hero__sub { font-size: 21px; line-height: 1.4; color: var(--s-text-body); max-width: 44ch; margin: 0 0 var(--spacing-3XL); }
  .hero__actions { display: flex; gap: var(--spacing-L); flex-wrap: wrap; align-items: center; }

  .band__h { font-size: 0.8125rem !important; font-family: var(--font-primary) !important; letter-spacing: 0.08em; text-transform: uppercase; color: var(--s-text-body) !important; margin-bottom: var(--spacing-XL) !important; font-weight: 500 !important; }
  .band__note { font-size: 0.9375rem; line-height: 1.6; color: var(--s-text-body); max-width: 62ch; margin: 0 0 var(--spacing-XL); }

  /* ── Card float: the site's hover language ──────────────────────── */
  .card-float {
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .card-float:hover, .card-float:focus-visible {
    transform: translateY(-2px) scale(1.005);
  }
  @media (prefers-reduced-motion: reduce) {
    .card-float { transition: none; }
    .card-float:hover, .card-float:focus-visible { transform: none; }
  }

  /* solution cards — +1 on base */
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-2XL); }
  .card {
    display: block; text-decoration: none;
    background: var(--s-raise-1);
    border: 1px solid var(--s-line);
    border-radius: var(--border-radius-S);
    padding: var(--spacing-3XL);
  }
  /* Icon sits directly on the card surface — no chip, no container. One less
     nested level means the card's own surface has to carry the icon on its own,
     which is a truer test of the +1 step. */
  .card__icon {
    display: block;
    color: var(--s-text-headline);
    margin-bottom: var(--spacing-XL);
  }
  .card__h { margin-bottom: var(--spacing-S) !important; }
  .card__b { font-size: 1rem; line-height: 1.5; color: var(--s-text-body); margin: 0 0 var(--spacing-L); }
  .card__more { font-size: 0.9375rem; color: var(--s-text-headline); display: inline-block; }

  /* feature (+1) with nested (+2) */
  .feature {
    background: var(--s-raise-1);
    border: 1px solid var(--s-line);
    border-radius: var(--border-radius-L);
    padding: var(--spacing-full);
    display: grid; grid-template-columns: 1.15fr 1fr; gap: var(--spacing-full);
  }
  .feature__h { margin-bottom: var(--spacing-L) !important; max-width: 14ch; }
  .feature__body p { font-size: 1rem; line-height: 1.6; color: var(--s-text-body); margin: 0 0 var(--spacing-L); }

  .nested {
    background: var(--s-raise-2);
    border: 1px solid var(--s-line);
    border-radius: var(--border-radius-S);
    padding: var(--spacing-2XL);
  }
  .nested__cap { display: block; font-size: 0.6875rem; letter-spacing: 0.07em; text-transform: uppercase; color: var(--s-text-body); margin-bottom: var(--spacing-L); }
  .nested__list { list-style: none; padding: 0; margin: 0 0 var(--spacing-XL); display: grid; gap: var(--spacing-M); }
  .nested__list li { display: flex; gap: var(--spacing-S); font-size: 0.875rem; line-height: 1.45; color: var(--s-text-body); }
  .nested__list svg { color: var(--s-text-headline); flex: none; margin-top: 3px; }

  /* −1 well inside +2 */
  .well {
    background: var(--s-sunken);
    border: 1px solid var(--s-line);
    border-radius: var(--border-radius-XS);
    padding: var(--spacing-M) var(--spacing-L);
    font-size: 0.8125rem; color: var(--s-text-body);
    overflow-x: auto;
  }

  /* ── Settings card — +1 holding −1 elements ──────────────────────
     Padding lives on the rows, not the card, so the dividers run edge to
     edge. One rhythm throughout: text left, control right, rule between. */
  .panel {
    background: var(--s-raise-1);
    border: 1px solid var(--s-line);
    border-radius: var(--border-radius-S);
    overflow: hidden;
  }

  .panel__head {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: var(--spacing-L);
    padding: var(--spacing-2XL);
    border-bottom: 1px solid var(--s-line);
  }
  .panel__h { margin-bottom: var(--spacing-2XS) !important; }
  .panel__b { margin: 0; font-size: 0.875rem; color: var(--s-text-body); }

  /* status pill — neutral, on the recessed level */
  .pill {
    display: inline-flex; align-items: center; gap: var(--spacing-XS);
    background: var(--s-sunken); border: 1px solid var(--s-line);
    border-radius: var(--border-radius-full);
    padding: 0.35em 0.8em;
    font-size: 0.75rem; color: var(--s-text-body); white-space: nowrap;
  }
  .pill__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--s-text-headline); }

  /* the repeating row */
  .setting {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--spacing-2XL);
    padding: var(--spacing-XL) var(--spacing-2XL);
    border-bottom: 1px solid var(--s-line);
  }
  .setting--stack { flex-direction: column; align-items: stretch; gap: var(--spacing-M); }
  .setting__text { display: grid; gap: 3px; }
  .setting__label { font-size: 0.9375rem; font-weight: 500; color: var(--s-text-headline); }
  .setting__help { font-size: 0.8125rem; line-height: 1.45; color: var(--s-text-body); max-width: 44ch; }

  /* recessed action footer — the −1 level closing the card */
  .setting:last-of-type { border-bottom: none; }
  .panel__foot {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--spacing-L); flex-wrap: wrap;
    padding: var(--spacing-L) var(--spacing-2XL);
    background: var(--s-sunken);
  }
  .panel__meta { font-size: 0.8125rem; color: var(--s-text-body); }
  .panel__actions { display: flex; gap: var(--spacing-S); }

  /* Heading column on the BASE surface, card column at +1 beside it. */
  .prefs { display: grid; grid-template-columns: 1fr 1.15fr; gap: var(--spacing-full); align-items: start; }
  .prefs__intro { padding-block: var(--spacing-S); }
  .prefs__h { margin-bottom: var(--spacing-L) !important; max-width: 16ch; }
  .prefs__b { font-size: 1rem; line-height: 1.6; color: var(--s-text-body); margin: 0 0 var(--spacing-L); max-width: 46ch; }

  .switch__track {
    position: relative; width: 46px; height: 26px; flex: none; cursor: pointer;
    border-radius: var(--border-radius-full);
    background: var(--s-sunken);
    border: 1px solid var(--s-line-strong);
    padding: 0;
    transition: background-color var(--transition-base);
  }
  .switch__track.is-on { background: var(--s-text-headline); border-color: var(--s-text-headline); }
  .switch__knob {
    position: absolute; top: 2px; left: 2px; width: 20px; height: 20px;
    border-radius: 50%; background: var(--s-raise-2);
    transition: transform var(--transition-base);
  }
  .switch__track.is-on .switch__knob { transform: translateX(20px); }

  /* inset fields — −1.
     global.css gives every <label> padding-left:5px and margin-bottom:8px.
     .field IS a label, so that margin pushed the input 8px below the button
     beside it. Reset both — the field owns its own spacing. */
  .field { display: grid; gap: var(--spacing-2XS); margin-bottom: 0; padding-left: 0; }
  .field__label { font-size: 0.75rem; color: var(--s-text-body); }
  /* Inset controls carry --s-line-strong; dividers inside cards carry
     --s-line. Both survive `outlines: selective`, so the two rule weights
     always have a live example on the page. */
  .field__input {
    display: block;
    background: var(--s-sunken);
    border: 1px solid var(--s-line-strong);
    border-radius: var(--border-radius-S);
    padding: 0.75em 0.9em;
    font-size: 0.9375rem; color: var(--s-text-headline);
  }
  .field__input--mute { color: var(--s-text-body); }

  /* segmented control — sunken track, raised active segment */
  .seg {
    display: inline-flex; gap: 2px; padding: 3px;
    background: var(--s-sunken);
    border: 1px solid var(--s-line-strong);
    border-radius: var(--border-radius-S);
  }
  .seg__btn {
    font: inherit; font-size: 0.875rem; cursor: pointer;
    padding: 0.5em 1em; border: 1px solid transparent; border-radius: var(--border-radius-XS);
    background: transparent; color: var(--s-text-body);
  }
  .seg__btn.is-on { background: var(--s-raise-2); color: var(--s-text-headline); border-color: var(--s-line); }

  /* Partner marks — foreign shapes on our surfaces, which is the test.
     Inherit currentColor so they take the surface's own text token rather
     than any brand colour; the monochrome icon variants exist for this. */
  /* One row, equal columns, full container width. The mark scales with the
     viewport so the row holds together as the container narrows (including
     when the editor rail reflows the page) rather than wrapping early. */
  .press { display: grid; grid-template-columns: repeat(8, 1fr); gap: var(--spacing-M); }
  .press__item {
    background: var(--s-raise-1); border: 1px solid var(--s-line);
    border-radius: var(--border-radius-S);
    padding: var(--spacing-XL) var(--spacing-S);
    text-decoration: none; min-width: 0;
    display: flex; flex-direction: column; align-items: center; gap: var(--spacing-M);
    color: var(--s-text-body);
  }
  .press__item:hover { color: var(--s-text-headline); }
  .press__mark { display: block; line-height: 0; }
  .press__mark :global(svg) {
    width: clamp(28px, 3.4vw, 52px); height: clamp(28px, 3.4vw, 52px); display: block;
  }
  .press__name {
    font-size: 0.8125rem; text-align: center;
    max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  /* ── Inverse CARD ────────────────────────────────────────────────
     The card is the mode change, floating on the ordinary page base — so
     the inverse levels are judged against the normal surfaces surrounding
     them, which is how an inverse block actually appears on the site. */
  .cta {
    background: var(--s-base);                    /* the inverse BASE, on the page's normal base */
    border: 1px solid var(--s-line);
    border-radius: var(--border-radius-L); padding: var(--spacing-full);
    display: grid; gap: var(--spacing-3XL);
  }
  /* Two columns on desktop. flex + wrap collapsed to a stack once the form
     grew to three fields — the two children simply could not both fit their
     content width. An explicit grid holds the split and lets the FORM wrap
     internally instead, which is the part that should give. */
  .cta__top {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--spacing-full);
    align-items: center;
  }
  .cta__text { max-width: 44ch; }
  .cta__badge {                                    /* +1 on the inverse base */
    display: inline-block; background: var(--s-raise-1); color: var(--s-text-body);
    font-size: 0.6875rem; letter-spacing: 0.07em; text-transform: uppercase;
    padding: 4px 10px; border-radius: var(--border-radius-full);
    margin-bottom: var(--spacing-L);
  }
  .cta__h { margin-bottom: var(--spacing-S) !important; }
  .cta__b { margin: 0; font-size: 1rem; color: var(--s-text-body); }
  /* Stacked: two fields over a full-width button, so the inset −1 surface is
     read as a column of controls rather than a row of stubs. */
  .cta__form { display: grid; gap: var(--spacing-M); }
  .cta__form .field { margin-bottom: 0; }
  .cta__form .btn { justify-content: center; }
  .cta__field { display: flex; align-items: center; }

  /* Stat row as a card one level above the inverse base, holding a +2 element
     of its own — so the full base → +1 → +2 chain is present inside inverse,
     not just on the ordinary page. */
  .inv__meta {
    list-style: none; margin: 0;
    /* width:auto — sized by its own content and left-aligned, so the card
       reads as a component sitting on the +1 surface rather than a full-width
       band. justify-self keeps it from stretching as a grid item. */
    width: auto; justify-self: start;
    background: var(--s-raise-1);
    border-radius: var(--border-radius-S);
    /* The card owns its padding, so the dividers stop at the inner edge
       rather than running the full height to the border. */
    /* center, not stretch — items size to their own content, so a divider is
       as tall as the stat it sits beside rather than the whole row. The taller
       promoted tile then centres itself against them. */
    padding: var(--spacing-2XL);
    display: flex; flex-wrap: wrap; align-items: center;
    font-size: 0.9375rem;
    color: var(--s-text-headline);
  }
  /* 1.5x the 2XL step. Derived from the scale rather than a raw value, so it
     still tracks if the spacing tokens move. */
  .inv__meta li {
    color: var(--s-text-headline);
    padding-inline: calc(var(--spacing-2XL) * 1.5);
    /* A little block padding so the divider reads as a deliberate rule rather
       than a hairline clipped to the cap height of the text. */
    padding-block: var(--spacing-XS);
    display: flex; align-items: center;
  }
  .inv__meta li:first-child { padding-inline-start: 0; }
  /* One stat promoted to +2 — a plausible "featured figure" treatment, and the
     only place the third level appears inside inverse. Sits on the +1 stat
     card, which sits on the inverse base. */
  /* Promoted tile: its own box, so it sets its own padding on all four sides
     rather than inheriting the row's asymmetric inline rhythm. */
  .inv__meta-hi {
    background: var(--s-raise-2);
    border-radius: var(--border-radius-S);
    padding-block: var(--spacing-3XL) !important;
    padding-inline: var(--spacing-XL) !important;
    margin-inline-start: calc(var(--spacing-2XL) * 0.5);
  }

  /* Vertical rules between stats, in the strong weight — a second live example
     of --s-line-strong, and one that survives `outlines: selective`.
     Scoped with :not() rather than overridden afterwards: Astro appends its
     [data-astro-cid] to every compound, so `li[cid] + li[cid]` lands at (0,4,2)
     and no sane override beats it. Excluding the promoted tile up front says
     what is meant — dividers separate ordinary stats — and cannot be lost to
     a specificity race. */
  .inv__meta li:not(.inv__meta-hi) + li:not(.inv__meta-hi) {
    border-left: 1px solid var(--s-line-strong);
  }
  .inv__meta b { font-weight: 600; margin-right: var(--spacing-2XS); }

  /* shadows */
  .shadows { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: var(--spacing-2XL); margin-bottom: var(--spacing-2XL); }
  .shadows--onraise { background: var(--s-raise-1); border: 1px solid var(--s-line); border-radius: var(--border-radius-S); padding: var(--spacing-2XL); margin-bottom: 0; }
  .shadows__card {
    background: var(--s-raise-1); border: 1px solid var(--s-line);
    border-radius: var(--border-radius-S); padding: var(--spacing-XL);
    display: grid; gap: 2px;
  }
  .shadows__card--2 { background: var(--s-raise-2); }
  .shadows__name { font-family: monospace; font-size: 0.8125rem; color: var(--s-text-headline); }
  .shadows__sub { font-size: 0.6875rem; color: var(--s-text-body); }

  /* footer — +1, like the nav */
  .foot { background: var(--s-raise-1); border-top: 1px solid var(--s-line); padding-block: var(--spacing-full) var(--spacing-3XL); }
  .foot__cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: var(--spacing-3XL); margin-bottom: var(--spacing-full); }
  .foot__cols div { display: grid; gap: var(--spacing-M); align-content: start; }
  .foot__h { font-size: 0.875rem; font-weight: 600; color: var(--s-text-headline); }
  .foot__base { border-top: 1px solid var(--s-line); padding-top: var(--spacing-XL); display: flex; justify-content: space-between; gap: var(--spacing-M); font-size: 0.875rem; color: var(--s-text-body); flex-wrap: wrap; }

  /* ── Outline policy ──────────────────────────────────────────────
     A ladder of four, each rung named for the highest thing that still
     keeps an outline:

       All        every card, panel and control — today's behaviour
       Controls   recessed controls + dividers; cards go
       Dividers   nothing enclosed; only single-edge separating rules
       None       nothing anywhere

     `Controls` strips CARD outlines only. Recessed controls keep
     --s-line-strong and card dividers keep --s-line, so both rule tokens
     stay demonstrated whichever mode is chosen. Card outlines coming off
     is the honest test: the +1 step then has to carry the card on value
     alone. */
  .mock[data-borders="selective"] .card,
  .mock[data-borders="selective"] .feature,
  .mock[data-borders="selective"] .nested,
  .mock[data-borders="selective"] .panel,
  .mock[data-borders="selective"] .press__item,
  .mock[data-borders="selective"] .cta,
  .mock[data-borders="selective"] .shadows__card,
  .mock[data-borders="selective"] .shadows--onraise,
  .mock[data-borders="selective"] .seg__btn.is-on { border-color: transparent; }

  /* `dividers` goes one rung further: nothing is ENCLOSED. Cards, panels,
     wells, inputs, pills, segmented controls and the outline button all lose
     their box; only the single-edge rules that separate one thing from the
     next survive.

     Written as strip-then-restore rather than as another list of exceptions.
     The exception list would have to name every bordered thing on the page
     and would silently leak an outline the day a new component lands; the
     restore list names the six dividers, which is the shorter, more stable
     and more honest statement — it says what a divider IS rather than
     leaving it to whatever happened not to be caught.

     Restoring border-COLOR only is what keeps `.setting:last-of-type`'s
     `border-bottom: none` intact: that rule kills the style, and a colour
     cannot resurrect an edge that has no style to draw. */
  .mock[data-borders="dividers"] *,
  .mock[data-borders="dividers"] *::before,
  .mock[data-borders="dividers"] *::after { border-color: transparent !important; }

  /* The six dividers. Each is a single edge on an element that has no other
     border, so setting all four colours only ever paints the one that has a
     style — no need to restore per side. */
  .mock[data-borders="dividers"] .nav,          /* nav  → page          */
  .mock[data-borders="dividers"] .panel__head,  /* head → settings list */
  .mock[data-borders="dividers"] .setting,      /* row  → row           */
  .mock[data-borders="dividers"] .foot,         /* page → footer        */
  .mock[data-borders="dividers"] .foot__base {  /* footer cols → legal  */
    border-color: var(--s-line) !important;
  }
  /* Stat-to-stat, in the strong weight — so both rule tokens stay
     demonstrated in this mode too, as they are under `Controls`. */
  .mock[data-borders="dividers"] .inv__meta li:not(.inv__meta-hi) + li:not(.inv__meta-hi) {
    border-color: var(--s-line-strong) !important;
  }

  .mock[data-borders="none"] *,
  .mock[data-borders="none"] *::before,
  .mock[data-borders="none"] *::after { border-color: transparent !important; }

