  .cta__text { max-width: 34ch; }
  .cta__badge {                                    /* +2 inside the +1 card */
    display: inline-block; background: var(--s-raise-2); color: var(--s-text-body);
    font-size: 0.6875rem; letter-spacing: 0.07em; text-transform: uppercase;
    padding: 4px 10px; border-radius: var(--border-radius-full);
    margin-bottom: var(--spacing-L);
  }
  .cta__h { margin-bottom: var(--spacing-S) !important; }
  .cta__b { margin: 0; font-size: 1rem; color: var(--s-text-body); }
  .cta__form { display: flex; gap: var(--spacing-M); align-items: flex-end; }
