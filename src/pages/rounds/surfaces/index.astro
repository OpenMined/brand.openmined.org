  .seg__btn.is-on { background: var(--s-raise-2); color: var(--s-text-headline); border-color: var(--s-line); box-shadow: var(--s-shadow-sm); }

  /* Partner marks — foreign shapes on our surfaces, which is the test.
     Inherit currentColor so they take the surface's own text token rather
     than any brand colour; the monochrome icon variants exist for this. */
  /* One row, equal columns, full container width. The mark scales with the
     viewport so the row holds together as the container narrows (including
     when the editor rail reflows the page) rather than wrapping early. */
  .press { display: grid; grid-template-columns: repeat(8, 1fr); gap: var(--spacing-M); }
  .press__item {
