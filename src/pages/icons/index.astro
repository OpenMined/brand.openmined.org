---
/**
 * BRAND SITE (v2) — Icons. Words from design/ (tag `icons`); icons are Iconoir's
 * regular set, inlined at build time by components/site/Icon.astro (no CDN).
 * "The set" is a view of icons/set.json: every v2 icon (source, style, review
 * status). The live site's icons mapped to the set are on the icons round
 * (/rounds/icons/). All drawings come through src/lib/icons.ts.
 */
import Site from '../../layouts/Site.astro';
import PageHero from '../../components/site/PageHero.astro';
import DocGrid from '../../components/site/DocGrid.astro';
import DecisionList from '../../components/site/DecisionList.astro';
import Icon from '../../components/site/Icon.astro';
import ColorIcon from '../../components/site/ColorIcon.astro';
import TwoToneDefs from '../../components/site/TwoToneDefs.astro';
import { doc, byTag, decisionsFor } from '../../lib/design';
import { ICONS, LIVE, iconSvg } from '../../lib/icons';
import { HUES, TWO_TONE_COMPANION } from '../../lib/tokens';

const foundation = doc('foundations/iconography');
const { Content } = foundation;
const rules = byTag('icons', 'Guideline', 'Behavior');
const decisions = decisionsFor('icons');
const NAV: [string, string][] = [['in-use', 'In use'], ['status', 'Status icons'], ['color', 'In color'], ['sizes', 'Sizes'], ['set', 'The set'], ['how', 'How it works'], ['rules', 'Rules'], ['decisions', 'Decisions'], ['see', 'See it']];

const SRC: Record<string, string> = { iconoir: 'Iconoir', own: 'Our own', partner: 'Partner mark' };
/** The v2 set, with the live icons each one replaces. */
const SET = Object.entries(ICONS).map(([name, e]) => ({ name, ...e, replaces: Object.entries(LIVE).filter(([, l]) => l.use === name).map(([n]) => n) }));
const APPROVED = SET.filter(i => i.status === 'approved').length;
const STATUS = [
  { s: 'success', icon: 'check-circle', label: 'Check' },
  { s: 'danger', icon: 'xmark-circle', label: 'X' },
  { s: 'warning', icon: 'warning-triangle', label: 'Warning' },
  { s: 'info', icon: 'info-circle', label: 'Info' },
];
/** Colorways: each hue's two-tone gradient (--gradient-two-tone-<hue>) on a few set icons. */
const COLORWAYS = HUES.map(h => ({ hue: h, companion: TWO_TONE_COMPANION[h] }));
const COLOR_ICONS = ['database', 'sparks', 'code', 'settings'];
const ARR = iconSvg('arrow-right');
---
<Site title={foundation.title} description={foundation.description} current="icons">
  <PageHero eyebrow="Foundations" title={foundation.title} description={foundation.description} status={foundation.status} nav={NAV} source="Iconoir regular, inlined at build" />

  <section class="band" id="in-use">
    <div class="wrap">
      <header class="sec"><h2>In use</h2><p>Outlined and mono by default, in the color of the text around them.</p></header>
      <div class="grid grid--3">
        <article class="card">
          <h3>Next to a word</h3>
          <div class="actions">
            <button type="button" class="btn btn--solid"><Icon name="download" size={20} />Download</button>
            <button type="button" class="btn">Read more<Icon name="arrow-right" size={20} /></button>
          </div>
          <p class="muted">Inline icons take the button's text color. 20px beside 16px text.</p>
        </article>
        <article class="card">
          <h3>In a line of text</h3>
          <p><a href="#set">See the full set <Icon name="arrow-right" /></a></p>
          <p class="muted"><Icon name="lock" /> Private by default. Inline icons are 1em and take the line's color, muted here.</p>
        </article>
        <article class="card">
          <h3>On their own</h3>
          <div class="actions">
            <button type="button" class="btn icon-btn"><Icon name="menu" size={20} label="Menu" /></button>
            <button type="button" class="btn icon-btn"><Icon name="search" size={20} label="Search" /></button>
            <button type="button" class="btn icon-btn"><Icon name="xmark" size={20} label="Close" /></button>
          </div>
          <p class="muted">Universal icons only, each with an accessible name.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="band" id="status">
    <div class="wrap">
      <header class="sec"><h2>Status icons</h2><p>One of two exceptions to mono (the other is <a href="#color">color mode</a>): a status icon takes its status's <code>fg</code> role.</p></header>
      <article class="card">
        <ul class="icon-status">
          {STATUS.map(x => (
            <li style={`color:var(--${x.s}-fg)`}><Icon name={x.icon} size={24} /><span><b style="color:inherit">{x.label}</b> <code>--{x.s}-fg</code></span></li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section class="band" id="color">
    <div class="wrap">
      <header class="sec"><h2>In color</h2><p>A color mode for icons where the design calls for it: the hue’s two-tone gradient moves in the stroke, with a soft glow behind (<em>if color, then motion</em>). Mono stays the default. Each colorway is named by its primary hue; the companion comes with it. Exploring.</p></header>
      <div class="grid grid--3">
        {COLORWAYS.map(c => (
          <article class="card colorway">
            <div class="colorway__icons">{COLOR_ICONS.map(n => <ColorIcon name={n} hue={c.hue} size={32} />)}</div>
            <h3>{c.hue}</h3>
            <p class="muted"><code>--gradient-two-tone-{c.hue}</code> · {c.hue} + {c.companion}</p>
          </article>
        ))}
      </div>
    </div>
    <TwoToneDefs />
  </section>

  <section class="band" id="sizes">
    <div class="wrap">
      <header class="sec"><h2>Sizes</h2><p>Inline icons are 1em. On their own: 16px for dense rows, 20px by default, 24px (the grid) for emphasis. Every icon draws at a 2 stroke on the 24 grid, which scales with the icon up to 24px; above 24px the line holds at 2px, so large icons (32px in cards, 40px in a diagram) don’t grow heavy.</p></header>
      <article class="card">
        <ul class="icon-sizes">
          {[16, 20, 24, 32, 40].map(px => <li><Icon name="shield-check" size={px} /><span class="muted">{px}px{px === 20 && ' · default'} · {(Math.min(2, 48 / px) * px / 24).toFixed(px > 24 ? 0 : 2)}px line</span></li>)}
          <li><span style="font-size:var(--font-size-md)"><Icon name="shield-check" /> 1em, inline</span></li>
        </ul>
      </article>
    </div>
  </section>

  <section class="band" id="set">
    <div class="wrap">
      <header class="sec"><h2>The set</h2><p>Every icon v2 uses, from <code>icons/set.json</code>: {SET.length} icons, {APPROVED} approved, {SET.length - APPROVED} proposed. Components ask for an icon by its name here; the entry decides the drawing (Iconoir, our own in <code>public/icons/</code>, or a partner mark), so an icon changes everywhere by editing one line. A name that isn't in the set fails the build.</p></header>
      <article class="card">
        <div class="tbl-wrap">
          <table class="tbl icon-cmp">
            <thead><tr><th>Icon</th><th>Name</th><th>Source</th><th>Style</th><th>Status</th><th>Replaces (live)</th><th>Note</th></tr></thead>
            <tbody>
              {SET.map(i => (
                <tr>
                  <td class="icon-cmp__glyph"><Icon name={i.name} size={24} /></td>
                  <td><code>{i.name}</code></td>
                  <td>{SRC[i.src]}{i.file && <> · <code>{i.file}</code></>}</td>
                  <td>{i.style ?? 'line'}</td>
                  <td>{i.status === 'approved' ? <b>approved</b> : <span class="muted">proposed</span>}</td>
                  <td>{i.replaces.length ? i.replaces.map((r, k) => <>{k > 0 && ', '}<code>{r}</code></>) : <span class="muted">—</span>}</td>
                  <td class="muted">{i.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </article>
    </div>
  </section>

  <section class="band" id="how">
    <div class="wrap">
      <header class="sec"><h2>How it works</h2></header>
      <div class="guide-prose"><Content /></div>
    </div>
  </section>

  <section class="band" id="rules">
    <div class="wrap">
      <header class="sec"><h2>Rules</h2></header>
      <DocGrid docs={rules} />
    </div>
  </section>

  <section class="band" id="decisions">
    <div class="wrap">
      <header class="sec"><h2>Decisions</h2><p>Why things are the way they are, oldest first. Open a row for the full record.</p></header>
      <DecisionList docs={decisions} />
    </div>
  </section>

  <section class="band" id="see">
    <div class="wrap">
      <header class="sec"><h2>See it</h2></header>
      <div class="grid grid--3">
        <a class="card card--link" href="/rounds/motion/"><h3 class="card__h">Color and interaction round <Fragment set:html={ARR} /></h3><p>Icons in color: the glow and two-tone options, side by side.</p></a>
        <a class="card card--link" href="/rounds/icons/"><h3 class="card__h">Icons round <Fragment set:html={ARR} /></h3><p>Every icon on the live site, next to the set icon that replaces it.</p></a>
        <a class="card card--link" href="https://iconoir.com"><h3 class="card__h">Iconoir <Fragment set:html={ARR} /></h3><p>Browse all 1,383 outlined icons. Use the regular set; we draw it at a 2 stroke.</p></a>
        <a class="card card--link" href="/graphics/#logo"><h3 class="card__h">Partner marks <Fragment set:html={ARR} /></h3><p>Brand logos for tools and partners, used as supplied.</p></a>
      </div>
    </div>
  </section>
</Site>
