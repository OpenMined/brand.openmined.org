---
/**
 * BRAND SITE (v2) — Typography. Rev 1, status `exploring`: v2 type hasn't
 * started. Shows the v1 baseline and the website's fluid system — the one the
 * brand is to extract (decided 2026-09-15). Sizes below are read from:
 *   v1       src/tokens/global.css (h1–h6 element defaults)
 *   website  openmined-org src/styles/tokens.css (--hN-min/max) and
 *            src/styles/global/typography.css (the clamp() middle values)
 */
import Site from '../../layouts/Site.astro';
import PageHero from '../../components/site/PageHero.astro';
import TokenTable from '../../components/site/TokenTable.astro';
import DecisionList from '../../components/site/DecisionList.astro';
import { doc, decisionsFor } from '../../lib/design';
const prose = doc('patterns/prose');

const foundation = doc('foundations/typography');
const { Content } = foundation;
const decisions = decisionsFor('typography');

const LADDER = [
  { tag: 'h1', family: 'Rubik', v1: 61, min: 36, vw: 4.69, max: 61, lh: 1.2 },
  { tag: 'h2', family: 'Rubik', v1: 47, min: 28, vw: 3.62, max: 47, lh: 1.2 },
  { tag: 'h3', family: 'Rubik', v1: 36, min: 24, vw: 2.77, max: 36, lh: 1.2 },
  { tag: 'h4', family: 'Rubik', v1: 27, min: 22, vw: 2.08, max: 27, lh: 1.2 },
  { tag: 'h5', family: 'Inter', v1: 21, min: 18, vw: 1.62, max: 21, lh: 1.4 },
  { tag: 'h6', family: 'Inter', v1: 20, min: 16, vw: 1.54, max: 20, lh: 1.5 },
];
/** Text styles other than headings: v2 token where one exists, else the live site's value (openmined.org typography.css / base.css). */
const STYLES: { name: string; spec: string; source: string; style: string; sample: string }[] = [
  { name: 'Body', spec: 'Inter 400 · 1rem · lh 1.5 · --text-body', source: '--font-size-md', style: 'font-size:var(--font-size-md);line-height:1.5', sample: 'Researchers can answer questions about data they never see.' },
  { name: 'Small', spec: 'Inter 400 · 0.875rem · lh 1.5', source: '--font-size-sm', style: 'font-size:var(--font-size-sm);line-height:1.5', sample: 'Supporting text: descriptions, captions, notes.' },
  { name: 'Lead', spec: 'Inter 400 · 21px · lh 1.4 · muted', source: 'live .text-subtitle · no token yet', style: 'font-size:21px;line-height:1.4;color:var(--text-muted)', sample: 'An introduction that sits under a page title.' },
  { name: 'Label', spec: 'Inter 500 · 1rem', source: '--font-size-md · forms', style: 'font-size:var(--font-size-md);font-weight:500;color:var(--text-headline)', sample: 'Email Address' },
  { name: 'Caption', spec: 'Inter 500 · 11px', source: 'live .text-caption · no token yet', style: 'font-size:11px;font-weight:500', sample: 'Figure 1. Data stays with its owner.' },
  { name: 'Eyebrow', spec: 'live: body text, no style of its own', source: 'live .text-eyebrow · open', style: 'font-size:var(--font-size-md)', sample: 'Federated learning' },
  { name: 'Strong, emphasis', spec: 'Inter 600 · italic', source: 'element defaults', style: '', sample: '<b>Strong</b> and <em>emphasis</em> inside body text.' },
  { name: 'Inline code', spec: 'Mono · 0.875em', source: 'element default', style: '', sample: 'Install with <code>pip install syft</code>.' },
];
const NAV: [string, string][] = [['sizes', 'Text sizes'], ['styles', 'Text styles'], ['prose', 'Prose'], ['families', 'Families'], ['scale', 'Heading scale'], ['how', 'Where it stands'], ['decisions', 'Decisions'], ['see', 'See it']];
---
<Site title={foundation.title} description={foundation.description} current="typography">
  <PageHero eyebrow="Foundations" title={foundation.title} description={foundation.description} status={foundation.status} nav={NAV} source="two v2 text sizes so far" />

  <section class="band" id="sizes">
    <div class="wrap">
      <header class="sec"><h2>Text sizes</h2><p>The first v2 type tokens: the body size and a small size for supporting text, both regular weight by default. The full scale comes with the type round.</p><p class="status">Status: <b>exploring</b></p></header>
      <div class="text-sizes">
        <p style="font-size:var(--font-size-md)"><code>--font-size-md</code> · 1rem. Body text: reading text, form labels, values and options.</p>
        <p style="font-size:var(--font-size-sm)"><code>--font-size-sm</code> · 0.875rem. Supporting text: form descriptions, captions, notes.</p>
      </div>
      <TokenTable names={foundation.tokens} />
    </div>
  </section>

  <section class="band" id="styles">
    <div class="wrap">
      <header class="sec"><h2>Text styles</h2><p>The styles besides headings that pages need. Body and small use the v2 text sizes; the rest show the live site's values until the type round gives them tokens. Links are on the <a href="/interface/#links">Interface</a> page.</p></header>
      <article class="card">
        <div class="tbl-wrap">
          <table class="tbl text-styles">
            <thead><tr><th>Style</th><th>Spec</th><th>From</th><th>Sample</th></tr></thead>
            <tbody>{STYLES.map(t => <tr><td><b>{t.name}</b></td><td>{t.spec}</td><td><code>{t.source}</code></td><td class="text-styles__sample" style={t.style}><Fragment set:html={t.sample} /></td></tr>)}</tbody>
          </table>
        </div>
      </article>
    </div>
  </section>

  <section class="band" id="prose">
    <div class="wrap">
      <header class="sec"><h2>Prose</h2><p>{prose.description}</p><p class="status">Status: <b>{prose.status}</b> · rhythm ported from openmined.org</p></header>
      <article class="card">
        <div class="om-prose">
          <h2>Data stays where it lives</h2>
          <p>Most of the world's useful data can't be shared. It sits with hospitals, publishers and governments, behind good reasons: privacy, competition, law. <a href="#prose">Attribution-based control</a> lets a researcher ask a question of that data without ever seeing it.</p>
          <p>The owner keeps the data. The researcher gets an answer, and a record of exactly which sources produced it.</p>
          <h3>How a question travels</h3>
          <p>A question goes out to every data owner that agreed to take part. Each one runs it locally and returns a result, never a row.</p>
          <ul>
            <li>The owner reviews the code before it runs.</li>
            <li>Only the agreed result leaves the owner's servers.</li>
            <li>Every answer is signed and logged.</li>
          </ul>
          <blockquote><p>“We could finally study the whole population, not the slice we were allowed to copy.”</p></blockquote>
          <h4>What the owner sees</h4>
          <p>Each request arrives with its code, its purpose and the researcher's identity. Run it with <code>syft.approve()</code> or decline it.</p>
          <h5>A fifth-level heading</h5>
          <p>Inter 600 in prose, where the display face would be too large.</p>
          <h6>A sixth-level heading</h6>
          <p>The smallest heading, still distinct from body text.</p>
          <hr />
          <p class="om-prose__small">Small text closes a section: a source, a note, a date. Updated 9 October 2026.</p>
        </div>
      </article>
      <div class="notes"><div><ul>
        <li><b>Ported:</b> the flow rhythm (16px between blocks), each heading's break (32 before and 24 after an h2; 24 before and 16 after h3–h6), stacked headings, the rule, list and quote treatment, and the live heading sizes.</li>
        <li><b>Left in the website:</b> heading downsizing per post, the WordPress shims and the opt-in spacious sections.</li>
        <li><b>Open for Bennett:</b> whether a minimal prose rhythm belongs in the brand at all. The type plan's lean is rhythm yes, the elaborate cascade no; this example shows that minimal version.</li>
      </ul></div></div>
    </div>
  </section>

  <section class="band" id="families">
    <div class="wrap">
      <header class="sec"><h2>Families</h2><p>Both are Google Fonts, so they also work in Google Docs without add-ons.</p></header>
      <div class="families">
        <article class="card"><span class="muted">Display · headings h1–h4 · 400</span><p class="family__sample" style="font-family: var(--font-d)">Rubik</p><p class="muted">The quick brown fox jumps over the lazy dog</p></article>
        <article class="card"><span class="muted">Text · body, interface, h5–h6</span><p class="family__sample" style="font-family: var(--font-b)">Inter</p><p class="muted">The quick brown fox jumps over the lazy dog</p></article>
      </div>
    </div>
  </section>

  <section class="band" id="scale">
    <div class="wrap">
      <header class="sec"><h2>Heading scale</h2><p>Rendered with the website's fluid sizes: each level scales with the viewport between a minimum and a maximum. v1 uses the maximum at every width. Resize the window to see them move.</p></header>
      <article class="card">
        <div class="ladder-type">
          {LADDER.map(l => (
            <div class="ladder-type__row">
              <span class="ladder-type__meta"><b>{l.tag}</b><span>{l.family} 400 · lh {l.lh}</span><span>v1: {l.v1}px fixed</span><span>web: {l.min}–{l.max}px</span></span>
              <span class="ladder-type__sample" style={`font-family: ${l.family === 'Rubik' ? 'var(--font-d)' : 'var(--font-b)'}; font-size: clamp(${l.min}px, ${l.vw}vw, ${l.max}px); line-height: ${l.lh}`}>Attribution-based control</span>
            </div>
          ))}
        </div>
      </article>
    </div>
  </section>

  <section class="band" id="how">
    <div class="wrap">
      <header class="sec"><h2>Where it stands</h2></header>
      <div class="prose"><Content /></div>
    </div>
  </section>

  <section class="band" id="decisions">
    <div class="wrap">
      <header class="sec"><h2>Decisions</h2><p>Why things are the way they are, oldest first. Open a row for the full record.</p></header>
      <DecisionList docs={decisions} />
    </div>
  </section>

  <section class="band" id="see">
    <div class="wrap">
      <header class="sec"><h2>See it</h2></header>
      <div class="grid grid--2">
        <a class="card card--link" href="/v1/#typography"><h3 class="card__h">v1 reference: typography <ion-icon name="arrow-forward-outline" aria-hidden="true"></ion-icon></h3><p>The released type specimen, with prose.</p></a>
        <a class="card card--link" href="https://openmined.org/"><h3 class="card__h">openmined.org <ion-icon name="arrow-forward-outline" aria-hidden="true"></ion-icon></h3><p>The live site, where the fluid system runs on real pages.</p></a>
      </div>
    </div>
  </section>
</Site>
