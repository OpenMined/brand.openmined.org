---
/**
 * BRAND SITE (v2) — Page reviews: real openmined.org pages with v2 applied,
 * and what came up. Working material, not a guide page: the pages themselves
 * live in src/page-reviews/ (README there); the notes in findings.ts.
 */
import Site from '../../layouts/Site.astro';
import Icon from '../../components/site/Icon.astro';
import { PAGES, SOURCE, routeFor } from '../../page-reviews/reviews';
import { FINDINGS } from '../../page-reviews/findings';

const LABEL = Object.fromEntries(PAGES.map((p) => [p.key, p.label]));
const NAV: [string, string][] = [['pages', 'The pages'], ['how', 'How it works'], ...FINDINGS.map((g, i): [string, string] => [`f${i}`, g.group])];
---
<Site title="Page reviews" description="Real openmined.org pages with the v2 design system applied, and the design challenges that come up." current="page-reviews">
  <section class="wrap hero">
    <span class="eyebrow"><span class="eyebrow__dot"></span>Working material</span>
    <h1>Page reviews</h1>
    <p class="lead">Real openmined.org pages, ported here so v2 can be tried on them: what holds, what breaks, and what the system doesn’t cover yet.</p>
    <p class="status">Status: <b>first pass, reviewed Oct 12</b> · snapshot of {SOURCE.repo} at <code>{SOURCE.sha}</code> ({SOURCE.date}) · not part of the guide</p>
    <nav class="page-nav" aria-label="On this page">{NAV.map(([id, t]) => <a href={`#${id}`}>{t}</a>)}</nav>
  </section>

  <section class="band" id="pages">
    <div class="wrap">
      <header class="sec"><h2>The pages</h2><p>Each page is the v2 pass over the ported markup; openmined.org itself is the reference for the live version. A bar at the bottom switches pages.</p></header>
      <div class="grid grid--2">
        {PAGES.map((p) => (
          <article class="card" id={p.key}>
            <h3 class="card__h">{p.label}</h3>
            <p class="muted"><a href={routeFor(p.key)}>v2 pass</a> · <a href={p.live}>openmined.org <Icon name="open-new-window" /></a></p>
            <p class="muted">{FINDINGS.flatMap((g) => g.items).filter((f) => f.pages.includes(p.key)).length} findings below.</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" id="how">
    <div class="wrap">
      <header class="sec"><h2>How it works</h2></header>
      <div class="notes">
        <div>
          <p><b>The port.</b> The pages’ components, styles and data are copied from openmined.org into <code>src/page-reviews/openmined-org/</code>, with only the changes a different repo needs (no SEO, analytics or real HubSpot forms; the forms are static mocks). Each change is marked <code>PORT</code> in its file. Links to these two pages stay in the review; every other link goes to openmined.org.</p>
          <p><b>The v2 pass</b> is two stylesheets over the same markup. <code>v2/bridge.css</code> points the live token names at v2 tokens, which carries most of it: every color, corner and shadow. <code>v2/pass.css</code> makes the changes a token can’t, each one naming the rule it applies. Three <code>PORT SEAM</code>s let v2 reach what CSS can’t: icons, and the colors of the two hero graphics.</p>
        </div>
        <div>
          <p><b>Not the guide.</b> This is a test bed. Findings that settle become guidelines or decisions in <code>design/</code>; the pages themselves are expected to go before release.</p>
          <p><b>Refreshing.</b> The snapshot is fixed at <code>{SOURCE.sha}</code>. See <code>src/page-reviews/README.md</code> to re-port or remove it.</p>
        </div>
      </div>
    </div>
  </section>

  {FINDINGS.map((g, i) => (
    <section class="band" id={`f${i}`}>
      <div class="wrap">
        <header class="sec"><h2>{g.group}</h2></header>
        <div class="tbl-wrap">
          <table class="tbl">
            <thead><tr><th>Finding</th><th>First pass</th><th>Open</th></tr></thead>
            <tbody>
              {g.items.map((f) => (
                <tr>
                  <td><b>{f.title}</b><br /><span class="meta">{f.pages.map((k) => LABEL[k]).join(', ')}{f.rule && <> · <code>{f.rule}</code></>}</span></td>
                  <td>{f.did}</td>
                  <td>{f.open}{f.review && <p class="meta review"><b>Review</b> · {f.review}</p>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  ))}
</Site>
