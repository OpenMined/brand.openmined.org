---
/**
 * BRAND SITE (v2) — home: the overview, rendered from design/overview.md.
 * The v1 reference page lives at /v1/ until v2 is released.
 */
import Site from '../layouts/Site.astro';
import LinkCard from '../components/site/LinkCard.astro';
import InfoDiagram from '../components/site/InfoDiagram.astro';
import { doc } from '../lib/design';

const overview = doc('overview');
// The diagram goes at the end of "How it's built", just before Principles; the
// words on both sides are design/overview.md, unchanged.
const cut = overview.html.indexOf('<h2 id="principles"');
if (cut < 0) throw new Error('overview.md: no Principles heading to place the diagram before');
const [before, after] = [overview.html.slice(0, cut), overview.html.slice(cut)];
---
<Site title="Overview" description={overview.description} current="overview">
  <section class="wrap wrap--read hero">
    <p class="text-eyebrow">v2 · in progress</p>
    <h1>OpenMined Design System</h1>
    <p class="text-lead">{overview.description}</p>
    {overview.status !== 'released' && <p class="status">Status: <b>{overview.status}</b></p>}
    <div class="card note-card"><p><b>This home page is a placeholder.</b> A proper front door, for people and for AI agents, comes once more of the system is decided. Start with the overview below, or a topic in the nav.</p></div>
  </section>

  <section class="band">
    <div class="wrap wrap--read">
      <div class="guide-prose" set:html={before} />
      <figure class="sysfig">
        <div class="sysfig__scroll"><InfoDiagram variant="v1" /></div>
        <figcaption>The central source on the left; everything that reads it on the right. The dashed box is generated, never edited by hand. Parts labeled <em>planned</em> or <em>possible</em> don't exist yet.</figcaption>
      </figure>
      <div class="guide-prose" set:html={after} />
    </div>
  </section>

  <section class="band">
    <div class="wrap wrap--read">
      <header class="sec"><h2>Archives</h2><p>Reachable while v2 is in progress.</p></header>
      <div class="grid grid--2">
        <LinkCard href="/rounds/" title="Review rounds">Every round: when it opened, what it explored, and where its working favorites live in the guide.</LinkCard>
        <LinkCard href="/v1/" title="v1 reference">The released brand: tokens, components, logos and embeds, as served today.</LinkCard>
      </div>
    </div>
  </section>

</Site>
