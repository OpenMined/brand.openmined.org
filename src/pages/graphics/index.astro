---
/**
 * BRAND SITE (v2) — Graphics. Rev 1, built from the color round's gradient
 * work and the diagram round. Words from design/ (tag `graphics`); values from
 * the v2 build. The diagram is src/diagrams/Abc1.astro (also an example).
 */
import Site from '../../layouts/Site.astro';
import ExampleLinks from '../../components/site/ExampleLinks.astro';
import PageHero from '../../components/site/PageHero.astro';
import BuildRef from '../../components/site/BuildRef.astro';
import DocGrid from '../../components/site/DocGrid.astro';
import DecisionList from '../../components/site/DecisionList.astro';
import FigA from '../../diagrams/Abc1.astro';
import { doc, byTag, decisionsFor } from '../../lib/design';
import { MODES, HUES, hex, listStops } from '../../lib/tokens';

/** How to load each embed, shown with it. */
const USE = {
  diamond: `<script type="module" src="https://design.openmined.org/embeds/om-diamond.js"></script>\n<om-diamond style="max-width:420px"></om-diamond>\n<!-- gradient="spectrum" (a name from /embeds/brand-colors.js) or colors="#…,#…" -->`,
  stream: `<script type="module" src="https://design.openmined.org/embeds/om-stream.js"></script>\n<om-stream aspect-ratio="2"></om-stream>\n<!-- gradient="stream" | colors="…" · aspect-ratio · crop-top · crop-bottom · rot-speed · rot-axis="along|across|spiral" -->`,
  mesh: `<script type="module" src="https://design.openmined.org/embeds/om-mesh.js"></script>\n<om-mesh mode="clouds" style="position:absolute; inset:0"></om-mesh>\n<!-- colors="…" (eight stops) · haze="…" · mode · speed · drift · opacity · saturation: see the file's header -->`,
};

const diagrams = doc('patterns/diagrams');
const DiagramsContent = diagrams.Content;
const rules = byTag('graphics', 'Guideline', 'Behavior');
const decisions = decisionsFor('graphics');

const NAV: [string, string][] = [['gradient', 'Gradient'], ['keys', 'Hue keys'], ['motion', 'Colorflow and gradient map'], ['diagrams', 'Diagrams'], ['embeds', 'Using the embeds'], ['rules', 'Rules'], ['decisions', 'Decisions'], ['examples', 'Examples']];

---
<Site title="Graphics" description="The gradient, the hue keys graphics use, and diagrams, all drawn from the palette." current="graphics">
  <PageHero eyebrow="Visual language" title="Graphics" description="The gradient, the hue keys graphics use, and diagrams, all drawn from the palette so a palette change reaches every graphic." status="released" nav={NAV} />

  <section class="band" id="gradient">
    <div class="wrap">
      <header class="sec"><h2>Gradient</h2><p>Graphics draw from the brand gradient: nine stops from gold to yellow, the extra stops, and each graphic's own list. They're defined on <a href="/color/#gradient">Color</a>.</p></header>
      <i class="spec__bar" aria-hidden="true"></i>
    </div>
  </section>

  <section class="band" id="keys">
    <div class="wrap">
      <header class="sec"><h2>Hue keys</h2><p>The color graphics and chart marks use: each hue's 500, named <code>--{'{hue}'}-key</code>. A fixed step, not a role, so a graphic's colors hold when the mode switches (only the mode's saturation offset changes them).</p></header>
      <article class="card">
        <div class="spec__stops" style="--stops: 6">
          {HUES.map(h => (
            <span>
              <i style={`background:var(--${h}-key)`}></i>
              <b><code>--{h}-key</code></b>
              {MODES.map(m => <code class={`only-${m}`}>{hex(m, `${h}-key`)}</code>)}
            </span>
          ))}
        </div>
      </article>
      <BuildRef tokens={['--gradient-spectrum', '--gradient-flow', '--gradient-map', ...HUES.map(h => `--${h}-key`), ...Array.from({ length: 6 }, (_, i) => `--series-${i + 1}`)]} />
    </div>
  </section>

  <section class="band" id="motion">
    <div class="wrap">
      <header class="sec"><h2>Colorflow and gradient map</h2><p>The two animated graphics built on the gradient. Both read the gradient stops on this page, so they follow the palette and the color mode.</p></header>
      <article class="card">
        <h3>Colorflow <code>&lt;om-stream&gt;</code></h3>
        <p class="muted">A ribbon in six of the gradient's stops, its own list <code>--gradient-flow</code> (red, gold, violet, blue, teal, green): the order the site's home hero uses.</p>
        <div class="flow-stage" aria-hidden="true">
          <om-stream aspect-ratio="2" data-follow={listStops('flow')}></om-stream>
        </div>
      </article>
      <article class="card">
        <h3>Gradient map <code>&lt;om-mesh&gt;</code></h3>
        <p class="muted">A call-to-action background as a live mesh: eight points ringing the box and blending toward the center. Its colors are its own list, <code>--gradient-map</code>: magenta on the left and no blue.</p>
        <div class="mesh-stage">
          <om-mesh class="mesh-stage__bg" aria-hidden="true" mode="clouds" speed="1" drift="0.15" flow="0.11" edge="0" size="0.8" cover="4" soft="0.65" billow="1" opacity="0.6" saturation="1.1" data-follow={listStops('map')} data-follow-haze="surface-base"></om-mesh>
          <div class="mesh-stage__card">
            <h3>Talk to Our Team</h3>
            <p class="muted">Find out more about OpenMined</p>
            <span class="btn btn--solid">Request a Conversation</span>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="band" id="diagrams">
    <div class="wrap">
      <header class="sec"><h2>Diagrams</h2><p>{diagrams.description}{diagrams.status !== 'released' && <> Status: <b>{diagrams.status}</b>.</>}</p></header>
      <figure class="dex">
        <FigA />
        <figcaption class="dex__cap">Direction A, attribution in color: each source keeps its hue; where attribution is lost the colors drain to gray, and where it's kept they reach the person asking.</figcaption>
      </figure>
      <div class="guide-prose"><DiagramsContent /></div>
    </div>
  </section>

  <section class="band" id="embeds">
    <div class="wrap">
      <header class="sec"><h2>Using the embeds</h2><p>The animated brand graphics are framework-free web components in <code>/embeds/</code>: one script tag and an element, in any page. Each is independent; several on a page are fine, and each cleans up when removed. They draw with the v2 colors (<code>/embeds/brand-colors.js</code>, generated from the tokens, light mode's values); to follow the page's mode, pass the page's own colors, as the graphics on this page do (<code>data-follow</code>, in the examples). A Claude artifact can't load them by URL: paste the file in. The logo and partner marks are on <a href="/logo/">Logos</a>.</p></header>
      <div class="grid grid--3">
        <article class="card">
          <h3>Diamond <code>&lt;om-diamond&gt;</code></h3>
          <om-diamond class="diamond-stage" aria-hidden="true"></om-diamond>
          <pre class="code-block"><code>{USE.diamond}</code></pre>
        </article>
        <article class="card">
          <h3>Colorflow <code>&lt;om-stream&gt;</code></h3>
          <p class="muted">Shown above, under <a href="#motion">Colorflow and gradient map</a>.</p>
          <pre class="code-block"><code>{USE.stream}</code></pre>
        </article>
        <article class="card">
          <h3>Gradient map <code>&lt;om-mesh&gt;</code></h3>
          <p class="muted">Shown above, behind its card.</p>
          <pre class="code-block"><code>{USE.mesh}</code></pre>
        </article>
      </div>
    </div>
  </section>

  <section class="band" id="rules">
    <div class="wrap">
      <header class="sec"><h2>Rules</h2></header>
      <DocGrid docs={rules} />
    </div>
  </section>

  <section class="band" id="decisions">
    <div class="wrap">
      <header class="sec"><h2>Decisions</h2><p>Why things are the way they are, oldest first. Open a row for the full record.</p></header>
      <DecisionList docs={decisions} />
    </div>
  </section>

  <ExampleLinks slugs={["diagram-abc-1", "diagram-abc-2", "diagram-abc-3"]} />
  <script type="module" src="/embeds/om-stream.js" is:inline></script>
  <script type="module" src="/embeds/om-mesh.js" is:inline></script>
  <script type="module" src="/embeds/om-diamond.js" is:inline></script>
  <script is:inline>
    // Palette-following embeds (ported from the color round): each [data-follow]
    // element gets its `colors` (and `haze`) from the named v2 tokens, re-read
    // when the color mode changes, so the embeds show v2 colors in both modes.
    (() => {
      const h = document.documentElement;
      const sync = () => {
        const cs = getComputedStyle(h);
        const read = v => cs.getPropertyValue(`--${v}`).trim();
        document.querySelectorAll('[data-follow]').forEach(el => {
          el.setAttribute('colors', el.dataset.follow.split(',').map(read).join(','));
          if (el.dataset.followHaze) el.setAttribute('haze', read(el.dataset.followHaze));
        });
      };
      sync();
      new MutationObserver(sync).observe(h, { attributes: true, attributeFilter: ['data-theme'] });
    })();
  </script>
</Site>
