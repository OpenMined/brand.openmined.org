---
/**
 * BRAND SITE (v2) — Graphics. Rev 1, built from the color round's gradient
 * work and the diagram round. Words from design/ (tag `graphics`); values from
 * the v2 build. The diagram figure is the round's own, embedded with the
 * rounds' page-local names (ALIASES_CSS).
 */
import Site from '../../layouts/Site.astro';
import PageHero from '../../components/site/PageHero.astro';
import TokenTable from '../../components/site/TokenTable.astro';
import DocGrid from '../../components/site/DocGrid.astro';
import DecisionList from '../../components/site/DecisionList.astro';
import FigA from '../rounds/diagrams/_a/Fig1.astro';
import { ALIASES_CSS } from '../rounds/_working';
import { doc, byTag, decisionsFor } from '../../lib/design';
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { MODES, HUES, GRADIENT_STOPS, EXTRA_STOPS, hex, target, listStops } from '../../lib/tokens';

const foundation = doc('foundations/gradient');
const { Content } = foundation;
const diagrams = doc('patterns/diagrams');
const DiagramsContent = diagrams.Content;
const rules = byTag('graphics', 'Guideline', 'Behavior');
const decisions = decisionsFor('graphics');
const ref = (name: string) => target('light', `gradient-${name}`)?.replace('-key', '') ?? null;

const NAV: [string, string][] = [['gradient', 'Gradient'], ['keys', 'Hue keys'], ['motion', 'Colorflow and gradient map'], ['diagrams', 'Diagrams'], ['logo', 'Logos and embeds'], ['how', 'How it works'], ['tokens', 'Tokens'], ['rules', 'Rules'], ['decisions', 'Decisions'], ['see', 'See it']];
const ARR = '<ion-icon name="arrow-forward-outline" aria-hidden="true"></ion-icon>';

/* Partner marks, from public/logos/partners/partners.json (the source of truth).
   One color by default, like the live site: every brand's icon.svg is a one-color
   glyph (currentColor), inlined so it takes the text color in both modes. The
   official color files are one toggle away. */
const PARTNERS_DIR = join(process.cwd(), 'public', 'logos', 'partners');
const PARTNERS = Object.entries(JSON.parse(readFileSync(join(PARTNERS_DIR, 'partners.json'), 'utf8')).brands as Record<string, any>)
  .map(([key, b]) => ({
    key, name: b.name as string, owner: b.trademark as string, gaps: (b.gaps ?? []).length as number,
    color: b.iconColor && existsSync(join(PARTNERS_DIR, b.iconColor)) ? `/logos/partners/${b.iconColor}` : null,
    mono: readFileSync(join(PARTNERS_DIR, b.icon), 'utf8').replace(/<svg/, '<svg class="partner__glyph" aria-hidden="true" focusable="false"'),
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
const partnerRule = doc('guidelines/partner-marks-as-supplied');
---
<Site title="Graphics" description="The gradient, the hue keys graphics use, and diagrams, all drawn from the palette." current="graphics">
  <Fragment set:html={`<style>${ALIASES_CSS}</style>`} />
  <PageHero eyebrow="Visual language" title="Graphics" description="The gradient, the hue keys graphics use, and diagrams, all drawn from the palette so a palette change reaches every graphic." status="working" nav={NAV} />

  <section class="band" id="gradient">
    <div class="wrap">
      <header class="sec"><h2>Gradient</h2><p>{foundation.description} Family stops are hue keys; gold, orange, lime and yellow are fitted to the palette.</p></header>
      <article class="card spec-card">
        <i class="spec__bar" aria-hidden="true"></i>
        <div class="spec__stops">
          {GRADIENT_STOPS.map(n => (
            <span>
              <i style={`background:var(--gradient-${n})`}></i>
              <b>{n}</b>
              {MODES.map(m => <code class={`only-${m}`}>{hex(m, `gradient-${n}`)}<br />{ref(n) ? `${ref(n)} key` : 'fitted'}</code>)}
            </span>
          ))}
        </div>
        {EXTRA_STOPS.length > 0 && (
          <div class="spec__extra">
            <p class="muted">Extra stops, for graphics only: not in the spectrum, used by a graphic's own list.</p>
            <div class="spec__stops">
              {EXTRA_STOPS.map((n: string) => (
                <span>
                  <i style={`background:var(--gradient-${n})`}></i>
                  <b>{n}</b>
                  {MODES.map(m => <code class={`only-${m}`}>{hex(m, `gradient-${n}`)}<br />fitted · exploring</code>)}
                </span>
              ))}
            </div>
          </div>
        )}
      </article>
    </div>
  </section>

  <section class="band" id="keys">
    <div class="wrap">
      <header class="sec"><h2>Hue keys</h2><p>The color graphics and chart marks use: each hue's 500, named <code>--{'{hue}'}-key</code>. A fixed step, not a role, so a graphic's colors hold when the mode switches (only the mode's saturation offset changes them).</p></header>
      <article class="card">
        <div class="spec__stops" style="grid-template-columns: repeat(6, minmax(0, 1fr))">
          {HUES.map(h => (
            <span>
              <i style={`background:var(--${h}-key)`}></i>
              <b><code>--{h}-key</code></b>
              {MODES.map(m => <code class={`only-${m}`}>{hex(m, `${h}-key`)}</code>)}
            </span>
          ))}
        </div>
      </article>
    </div>
  </section>

  <section class="band" id="motion">
    <div class="wrap">
      <header class="sec"><h2>Colorflow and gradient map</h2><p>The two animated graphics built on the gradient, ported from the color round. Both read the v2 gradient stops on this page, so they follow the palette and the color mode.</p></header>
      <article class="card">
        <h3>Colorflow <code>&lt;om-stream&gt;</code></h3>
        <p class="muted">A ribbon in six of the gradient's stops, its own list <code>--gradient-flow</code> (red, gold, violet, blue, teal, green): the order the site's home hero uses.</p>
        <div class="flow-stage" aria-hidden="true">
          <om-stream aspect-ratio="2" data-follow={listStops('flow')}></om-stream>
        </div>
      </article>
      <article class="card">
        <h3>Gradient map <code>&lt;om-mesh&gt;</code></h3>
        <p class="muted">The site's call-to-action background rebuilt as a live mesh: eight points ringing the box and blending toward the center, in the color round's "Clouds" setting. Its colors are its own list, <code>--gradient-map</code>: magenta on the left and no blue, as in the live raster. Being compared in the <a href="/rounds/gradient-map/">gradient map round</a>.</p>
        <div class="mesh-stage">
          <om-mesh class="mesh-stage__bg" aria-hidden="true" mode="clouds" speed="1" drift="0.15" flow="0.11" edge="0" size="0.8" cover="4" soft="0.65" billow="1" opacity="0.6" saturation="1.1" data-follow={listStops('map')} data-follow-haze="surface-base"></om-mesh>
          <div class="mesh-stage__card">
            <h3>Talk to Our Team</h3>
            <p class="muted">Find out more about OpenMined</p>
            <span class="btn btn--solid">Request a Conversation</span>
          </div>
        </div>
        <label class="mesh-sat">
          <span>Saturation <b class="js-sat-out">1.10</b></span>
          <input class="js-sat" type="range" min="1" max="1.8" step="0.05" value="1.1" aria-label="Gradient map saturation" />
          <span class="muted">Exploring. Blending eight hues pulls the field toward gray; this gives the chroma back (OKLab, lightness and hue kept). 1 is the map as it was.</span>
        </label>
      </article>
    </div>
  </section>

  <section class="band" id="diagrams">
    <div class="wrap">
      <header class="sec"><h2>Diagrams</h2><p>{diagrams.description} Status: <b>{diagrams.status}</b>.</p></header>
      <figure class="dex">
        <FigA />
        <figcaption class="dex__cap">Direction A, attribution in color: each source keeps its hue; where attribution is lost the colors drain to gray, and where it's kept they reach the person asking.</figcaption>
      </figure>
      <div class="prose"><DiagramsContent /></div>
      <div class="grid grid--3">
        <a class="card card--link" href="/rounds/diagrams/original/"><h3 class="card__h">Original <Fragment set:html={ARR} /></h3><p>The live article's graphics, for comparison.</p></a>
        <a class="card card--link" href="/rounds/diagrams/a/"><h3 class="card__h">A · Attribution in color <Fragment set:html={ARR} /></h3><p>Each source keeps a hue; attribution lost drains to gray.</p></a>
        <a class="card card--link" href="/rounds/diagrams/b/"><h3 class="card__h">B · Technical plate <Fragment set:html={ARR} /></h3><p>A few colors with one job each.</p></a>
      </div>
    </div>
  </section>

  <section class="band" id="logo">
    <div class="wrap">
      <header class="sec"><h2>Logos and embeds</h2><p>OpenMined's logo keeps its own colors in every palette and mode; partner marks are used as their owners supply them. The animated embeds show v2 colors here because this page passes them in; used on their own, they fall back to built-in colors that are still v1 until they're re-tuned.</p></header>
      <div class="grid grid--2">
        <article class="card">
          <img class="only-light" src="/logos/OpenMined-Logo.svg" alt="OpenMined" height="40" style="height:40px;width:auto;align-self:flex-start" />
          <img class="only-dark" src="/logos/OpenMined-Logo-Dark.svg" alt="OpenMined" height="40" style="height:40px;width:auto;align-self:flex-start" />
          <p class="muted">Full color on light; reversed on dark. All logo files are on the <a href="/v1/#logos">v1 reference</a>.</p>
        </article>
        <article class="card">
          <h3>Embeds</h3>
          <p class="muted"><code>&lt;om-diamond&gt;</code>, <code>&lt;om-stream&gt;</code> (the colorflow) and <code>&lt;om-mesh&gt;</code> (the gradient map) are framework-free web components. Shown live on the <a href="/v1/">v1 reference</a> and in the <a href="/rounds/color/?p=ink&a=none&l=og&ml=0_1.1_0_all">color round</a>.</p>
        </article>
      </div>
      <article class="card">
        <h3>Partner marks</h3>
        <p class="muted">{partnerRule.description} {PARTNERS.length} tools and partners, from <code>public/logos/partners/</code> (<code>partners.json</code> records each mark's owner, official source, variants and gaps). One color by default, in the color of the text around them; {PARTNERS.filter(p => p.color).length} also have an official color file.</p>
        <div class="actions partners-view" role="group" aria-label="Show partner marks in">
          <button type="button" class="btn js-pview" aria-pressed="true" data-view="mono">One color</button>
          <button type="button" class="btn js-pview" aria-pressed="false" data-view="color">Official color</button>
        </div>
        <ul class="partners">
          {PARTNERS.map(p => (
            <li title={`${p.name}, a trademark of ${p.owner}`}>
              <span class="partner__mark partner__mark--mono"><Fragment set:html={p.mono} /></span>
              <span class="partner__mark partner__mark--color">{p.color ? <img src={p.color} alt="" loading="lazy" /> : <Fragment set:html={p.mono} />}</span>
              <span class="partner__name">{p.name}</span>
            </li>
          ))}
        </ul>
        <p class="muted">Each mark is the trademark of its owner. Rules: <a href="#guidelines-partner-marks-as-supplied">Partner marks are used as supplied</a>. Used inline next to text, they follow the <a href="/icons/#sizes">icon sizes</a>.</p>
      </article>
    </div>
  </section>

  <section class="band" id="how">
    <div class="wrap">
      <header class="sec"><h2>How it works</h2></header>
      <div class="prose"><Content /></div>
    </div>
  </section>

  <section class="band" id="tokens">
    <div class="wrap">
      <header class="sec"><h2>Tokens</h2></header>
      <TokenTable names={[...foundation.tokens, ...HUES.map(h => `--${h}-key`), ...Array.from({ length: 6 }, (_, i) => `--series-${i + 1}`)]} />
    </div>
  </section>

  <section class="band" id="rules">
    <div class="wrap">
      <header class="sec"><h2>Rules</h2></header>
      <DocGrid docs={rules} />
    </div>
  </section>

  <section class="band" id="decisions">
    <div class="wrap">
      <header class="sec"><h2>Decisions</h2><p>Why things are the way they are, oldest first. Open a row for the full record.</p></header>
      <DecisionList docs={decisions} />
    </div>
  </section>

  <section class="band" id="see">
    <div class="wrap">
      <header class="sec"><h2>See it</h2></header>
      <div class="grid grid--2">
        <a class="card card--link" href="/rounds/diagrams/"><h3 class="card__h">Diagram round <Fragment set:html={ARR} /></h3><p>The Attribution-Based Control article's opening, with its graphics redrawn in two directions.</p></a>
        <a class="card card--link" href="/rounds/#gradient"><h3 class="card__h">Working favorites <Fragment set:html={ARR} /></h3><p>The gradient and graphics section, alongside the rest of the working values.</p></a>
      </div>
    </div>
  </section>
  <script type="module" src="/embeds/om-stream.js" is:inline></script>
  <script type="module" src="/embeds/om-mesh.js" is:inline></script>
  <script is:inline>
    // Palette-following embeds (ported from the color round): each [data-follow]
    // element gets its `colors` (and `haze`) from the named v2 tokens, re-read
    // when the color mode changes, so the embeds show v2 colors in both modes.
    (() => {
      const h = document.documentElement;
      const sync = () => {
        const cs = getComputedStyle(h);
        const read = v => cs.getPropertyValue(`--${v}`).trim();
        document.querySelectorAll('[data-follow]').forEach(el => {
          el.setAttribute('colors', el.dataset.follow.split(',').map(read).join(','));
          if (el.dataset.followHaze) el.setAttribute('haze', read(el.dataset.followHaze));
        });
      };
      sync();
      new MutationObserver(sync).observe(h, { attributes: true, attributeFilter: ['data-theme'] });
    })();
    // Partner marks: one color (default) or the official color files
    document.querySelectorAll('.js-pview').forEach(b => b.addEventListener('click', () => {
      document.querySelector('.partners')?.classList.toggle('is-color', b.dataset.view === 'color');
      document.querySelectorAll('.js-pview').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
    }));
    // Gradient map saturation slider (exploring)
    (() => {
      const input = document.querySelector('.js-sat'), out = document.querySelector('.js-sat-out'), mesh = document.querySelector('.mesh-stage om-mesh');
      if (!input || !mesh) return;
      input.addEventListener('input', () => { mesh.setAttribute('saturation', input.value); out.textContent = (+input.value).toFixed(2); });
    })();
  </script>
</Site>
