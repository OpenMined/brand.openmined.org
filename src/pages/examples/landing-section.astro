---
/** Example: a landing section (src/lib/examples.ts): openmined.org's federated network
 *  as reviewed, the same section the Home page example uses (src/examples/sections/). */
import Website from '../../examples/kit/Website.astro';
import FederatedNetwork from '../../examples/sections/FederatedNetwork.astro';
---
<Website chrome={false} slug="landing-section" init={`omds.twoTone(); omds.hoverCards(); omds.cardFlows();`}>
  <style is:inline slot="head">
    main { padding-block: var(--spacing-section); }
  </style>
  <FederatedNetwork />
</Website>
