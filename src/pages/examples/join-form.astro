---
/** Example: a join form over the gradient map (src/lib/examples.ts). From the home
 *  page review's call to action; the HubSpot form rebuilt in the field markup, with
 *  labels. The panel is the example kit's join panel (src/examples/kit/). */
import Website from '../../examples/kit/Website.astro';
import JoinPanel from '../../examples/kit/JoinPanel.astro';
import { FOLLOW_JS } from '../../lib/examples';
---
<Website chrome={false} slug="join-form" init={`omds.buttonHover(); omds.fieldLights();
${FOLLOW_JS}`}>
  <Fragment slot="head">
    <script type="module" src="/embeds/om-mesh.js" is:inline></script>
    <style is:inline>
      .kit-join .fm { gap: var(--spacing-xl); }
      .kit-join .btn { width: 100%; }
    </style>
  </Fragment>
  <JoinPanel heading="Take control of your data's future" body="Join the OpenMined community to stay informed, get involved, and shape how privacy and AI evolve together.">
    <form class="fm" onsubmit="return false">
      <div class="fm-grid">
        <div class="fld"><label class="fld__label" for="first">First name<span class="fld__req">*</span></label><input class="ctl" id="first" autocomplete="given-name" required aria-required="true"></div>
        <div class="fld"><label class="fld__label" for="last">Last name</label><input class="ctl" id="last" autocomplete="family-name"></div>
        <div class="fld fld--full"><label class="fld__label" for="email">Email<span class="fld__req">*</span></label><input class="ctl" id="email" type="email" autocomplete="email" placeholder="you@example.org" required aria-required="true"></div>
        <div class="fld fld--full"><label class="fld__label" for="problem">What data access problem are you working on?</label><textarea class="ctl" id="problem" rows="3"></textarea></div>
      </div>
      <ul class="opts">
        <li><label class="opt"><input class="opt__box" type="checkbox" checked><span>Get email updates</span></label></li>
        <li><label class="opt"><input class="opt__box" type="checkbox"><span>Get an invite to the OpenMined Slack community</span></label></li>
      </ul>
      <button class="btn btn--solid" type="submit">Join</button>
    </form>
    <p slot="fine">We only write about OpenMined. Unsubscribe any time.</p>
  </JoinPanel>
</Website>
