---
/** Example: ABC figure 2 (src/lib/examples.ts), from src/diagrams/Abc2.astro. */
import Example from '../../layouts/Example.astro';
import Abc from '../../diagrams/Abc2.astro';
---
<Example slug="diagram-abc-2" init={`omds.lineFlow();`}>
  <style is:inline slot="head">
    .ex { padding-block: var(--spacing-5xl); }
    .ex figcaption { margin-top: var(--spacing-md); }
  </style>
  <section class="ex">
    <div class="container">
      <figure style="margin: 0">
        <Abc />
        <figcaption class="text-small">The rings of impact. Each source keeps its hue; the pulses run in each line's highlight. Under reduced motion, the still frame.</figcaption>
      </figure>
    </div>
  </section>
</Example>
