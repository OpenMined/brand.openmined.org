---
/** Example: openmined.org's home page in v2, as reviewed (the home page review, tag
 *  rounds-archive): the same sections, words, marks and layout, built from the
 *  system's components and embeds. Org logos are the page's own (public/examples/home/).
 *  The hero diamond is the site's own embed (the kit's DiamondHero). The page shell
 *  (header, footer, widths, join panel) is the example kit (src/examples/kit/); each
 *  section's values come from the review's CSS. */
import Website from '../../examples/kit/Website.astro';
import JoinPanel from '../../examples/kit/JoinPanel.astro';
import DiamondHero from '../../examples/kit/DiamondHero.astro';
import FederatedNetwork from '../../examples/sections/FederatedNetwork.astro';
import ORGS from '../../examples/data/organizations.json';
import { readFileSync } from 'node:fs';
import { listStops } from '../../lib/tokens';
import { FOLLOW_JS } from '../../lib/examples';

type Org = { id: string; name: string; logo: string; monochrome?: boolean; roles: string[] };
const orgs = ORGS as Org[];
const byId = Object.fromEntries(orgs.map(o => [o.id, o]));
/** A mark as the page shows it: one-color marks inline (they take the text color), the rest as images. */
const mark = (o: Org) => o.monochrome && o.logo.endsWith('.svg')
  ? readFileSync(`public${o.logo}`, 'utf8').replace(/<\?xml[^>]*>/, '').replace(/<svg/, `<svg role="img" aria-label="${o.name}"`)
  : `<img src="${o.logo}" alt="${o.name}">`;
const PARTNERS = orgs.filter(o => o.roles.includes('partner'));
/** The partnership strip shows every mark in one color, the text color (as the live site
 *  and the review do): an SVG's own fills and strokes become currentColor. Image-only marks
 *  stay as supplied. */
const monoMark = (o: Org) => o.logo.endsWith('.svg')
  ? readFileSync(`public${o.logo}`, 'utf8').replace(/<\?xml[^>]*>/, '')
      .replace(/(fill|stroke)="(?!none|url)[^"]*"/g, '$1="currentColor"')
      .replace(/(fill|stroke):\s*(?!none|url)[^;"]+/g, '$1:currentColor')
      .replace(/<svg/, `<svg role="img" aria-label="${o.name}"`)
  : `<img src="${o.logo}" alt="${o.name}">`;

const PRESS: [string, string][] = [
  ['deepmind', 'Piloting the world’s first double-blind AI evaluations'], ['anthropic', 'Secure Enclaves for AI Evaluation'],
  ['aisi', 'Frontier AI Taskforce: second progress report'], ['royal-society', 'From privacy to partnership: The role of PETs in data governance and collaborative analysis'],
  ['uk-dsit', 'Privacy-preserving third-party audits on Unreleased Digital Assets with PySyft'], ['us-nist', 'Winners Announced in First Phase of UK-US PETs Prize Challenges'],
  ['us-white-house', 'OSTP-NSF-PCAST Event on Opportunities at the AI Research Frontier'], ['us-senate', 'Driving US Innovation in AI: A Roadmap for AI Policy in the US Senate'],
  ['us-executive-office', 'National Strategy to Advance Privacy-Preserving Data Sharing and Analytics'], ['us-nsf', 'Democratizing the future of AI R&D: NSF to launch National AI Research Resource pilot'],
  ['us-census', 'A New Model for International, Privacy-Preserving Data Science'], ['us-ntia', 'AI Accountability Policy Report'],
  ['christchurch-call', 'Christchurch Call Initiative on Algorithmic Outcomes'], ['microsoft', 'Expanding our commitments to countering violent extremism online'],
  ['x', 'Investing in privacy enhancing tech to advance transparency in ML'], ['reddit', 'Introducing a New Subreddit for Researchers'],
  ['meta', 'Privacy and Machine Learning Courses'], ['google', 'Partnering with Google to make differential privacy more widely accessible'],
  ['pytorch', 'OpenMined and PyTorch partner to launch fellowship funding for privacy-preserving ML community'], ['un-big-data', 'The PET Guide'],
  ['technologists-public-good', 'Facilitating Access to Non-Public Data: A World in Which All Data is “Open”'], ['stanford-ssir', 'Reimagining Our High-Tech World'],
];
---
<Website slug="home" current="Home" init={`omds.themeToggle(); omds.twoTone(); omds.buttonHover(); omds.hoverCards(); omds.cardFlows(); omds.linkCards(); omds.fieldLights();\n${FOLLOW_JS}`}>
  <Fragment slot="head">
    <script type="module" src="/embeds/om-stream.js" is:inline></script>
    <script type="module" src="/embeds/om-mesh.js" is:inline></script>
    <style is:inline>
      main { position: relative; isolation: isolate; }
      /* Hero: text and the diamond side by side over the colorflow, which bleeds below */
      .hero { position: relative; padding: 0 0 var(--kit-spacing-max); margin-bottom: var(--kit-spacing-max); }
      .hero__grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; margin-bottom: var(--spacing-lg); }
      .hero h1 { margin: 0 0 var(--spacing-3xl); font-size: clamp(var(--font-size-h1-min), 4.69vw, 2.75rem); }
      .hero__taglines { margin: 0 0 var(--spacing-4xl); }
      .hero__taglines span { display: block; text-wrap: balance; }
      .hero__help { display: flex; flex-wrap: wrap; gap: 0 var(--spacing-lg); }
      .hero__help .link-text { font-weight: var(--font-weight-semibold); }
      .hero__bio { max-width: 735px; margin: 0 auto; text-align: center; }
      .hero__bio p { margin: 0 0 var(--spacing-4xl); }
      .hero__ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--spacing-sm) var(--spacing-xl); }
      .hero__stream { position: absolute; left: 0; right: 0; bottom: calc(-100vw / 2 * 0.59); z-index: -1; pointer-events: none; }
      .hero__stream om-stream { display: block; width: 100%; }
      /* Partnerships: the marks in one color, the text color */
      .partners { margin-block: var(--spacing-section); }
      .partners__label { margin: 0 0 var(--spacing-5xl); text-align: center; }
      .partners ul { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--spacing-5xl); margin: 0; padding: 0; list-style: none; color: var(--text-body); }
      .partners li { display: flex; align-items: center; }
      .partners li :is(svg, img) { width: auto; max-width: 145px; height: auto; max-height: 48px; }
      /* Press room: logo cards on white plates, then Keep exploring */
      .press { margin-block: var(--spacing-section); }
      .press__heading { margin: 0; padding-bottom: var(--spacing-sm); border-bottom: var(--stroke-sm) solid var(--line); font-size: clamp(var(--font-size-h4-min), 2.08vw, var(--font-size-h4-max)); }
      .press__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr)); gap: var(--spacing-xl); margin-top: var(--spacing-3xl); }
      .press .lcard--logo { color: var(--gray-900); }
      .press .lcard__text { font-size: var(--font-size-sm); }
      .explore { display: flex; flex-direction: column; align-items: center; margin-top: var(--spacing-section); text-align: center; }
      .explore h2 { margin: 0 0 var(--spacing-2xl); font-size: clamp(var(--font-size-h4-min), 2.08vw, var(--font-size-h4-max)); }
      .kit-join .btn { width: 100%; }
      .kit-join .fm { gap: var(--spacing-xl); }
      @media (max-width: 991px) {
        .hero { padding-bottom: calc(100% / 2 * 0.273); margin-bottom: 0; }
        .hero__grid { grid-template-columns: 1fr; }
        .hero__stream { bottom: calc(-100vw / 2 * 0.484); }
        .partners, .press { margin-block: var(--spacing-5xl); }
        .partners ul { gap: var(--spacing-3xl); }
        .partners li :is(svg, img) { max-width: 100px; max-height: 40px; }
      }
    </style>
  </Fragment>

  <section class="hero">
    <div class="container kit-col-10">
      <div class="hero__grid">
        <div>
          <h1>The missing layer for collective intelligence</h1>
          <p class="hero__taglines"><span>-&gt; Unlock insights from data you can't access.</span><span>-&gt; Create value from data you can't share.</span></p>
          <div class="hero__help"><span>How We Help:</span>{['Publishers', 'Creators', 'Genomics', 'AI Auditors'].map(l => <a class="link-text" href="#"><span class="link-text__label">{l}</span></a>)}</div>
        </div>
        <div aria-hidden="true"><DiamondHero /></div>
      </div>
      <div class="hero__bio content-links">
        <p>We're OpenMined, a non-profit community building technology that enables secure computation across siloed data — unlocking collective intelligence while preserving <a href="#">attribution-based control</a>.</p>
        <div class="hero__ctas"><a class="btn btn--solid" href="#">Donate</a><a class="btn" href="#">About the Foundation</a></div>
      </div>
    </div>
    <div class="hero__stream" aria-hidden="true"><om-stream aspect-ratio="2" crop-top="0.28" crop-bottom="0.01" data-follow={listStops('flow')}></om-stream></div>
  </section>

  <FederatedNetwork />

  <section class="partners">
    <div class="container">
      <p class="partners__label">Partnerships</p>
      <ul>{PARTNERS.map(o => <li set:html={monoMark(o)} />)}</ul>
    </div>
  </section>

  <section class="press">
    <div class="container">
      <h2 class="press__heading">Press Room</h2>
      <div class="press__grid">
        {PRESS.map(([id, title]) => byId[id] && (
          <a class="lcard lcard--logo" data-section="always-light" href="#">
            <span class="lcard__logo" set:html={mark(byId[id])} />
            <span class="lcard__text">{title}</span>
          </a>
        ))}
      </div>
      <div class="explore">
        <h2>Keep Exploring</h2>
        <a class="btn btn--solid" href="#">Read the latest updates</a>
      </div>
    </div>
  </section>

  <JoinPanel heading="Take Control of Your Data's Future" body="Join the OpenMined community to stay informed, get involved, and shape how privacy and AI evolve together.">
    <form class="fm" onsubmit="return false">
      <div class="fm-grid">
        <div class="fld"><input class="ctl" aria-label="First name" placeholder="First name" autocomplete="given-name"></div>
        <div class="fld"><input class="ctl" aria-label="Last name" placeholder="Last name" autocomplete="family-name"></div>
        <div class="fld fld--full"><input class="ctl" type="email" aria-label="Email" placeholder="Email" autocomplete="email" required aria-required="true"></div>
        <div class="fld fld--full"><textarea class="ctl" rows="3" aria-label="What data access problem are you working on?" placeholder="What data access problem are you working on?"></textarea></div>
      </div>
      <ul class="opts">
        <li><label class="opt"><input class="opt__box" type="checkbox"><span>Get email updates</span></label></li>
        <li><label class="opt"><input class="opt__box" type="checkbox"><span>Get an OpenMined Slack Community invite</span></label></li>
      </ul>
      <button class="btn btn--solid" type="submit">Join</button>
    </form>
    <Fragment slot="fine">
      <p>Joining subscribes you to the <em>OpenMined Newsletter</em> and confirms you agree with our <a href="#">privacy policy</a>.</p>
      <p><a href="#">Explore ways to get involved ↗</a></p>
    </Fragment>
  </JoinPanel>
</Website>
