---
/**
 * BRAND SITE (v2) — Interface. Rev 1, built from the surfaces round's form lab
 * and its button rules. Words from design/ (tag `interface`); values from the
 * v2 build. Focus rings are still open.
 */
import Site from '../../layouts/Site.astro';
import ExampleLinks from '../../components/site/ExampleLinks.astro';
import LinkCard from '../../components/site/LinkCard.astro';
import PageHero from '../../components/site/PageHero.astro';
import TokenTable from '../../components/site/TokenTable.astro';
import DocGrid from '../../components/site/DocGrid.astro';
import DecisionList from '../../components/site/DecisionList.astro';
import HoverCard from '../../components/site/HoverCard.astro';
import TwoToneDefs from '../../components/site/TwoToneDefs.astro';
import { doc, byTag, decisionsFor } from '../../lib/design';
import Icon from '../../components/site/Icon.astro';
import BuildRef from '../../components/site/BuildRef.astro';
import { componentCode } from '../../lib/components';

const button = doc('components/button');
const link = doc('components/link');
const hoverCard = doc('components/hover-card');
const linkCard = doc('components/link-card');
const statusChip = doc('components/status-chip');
const form = doc('components/form-field');
const motion = doc('foundations/motion');
const card = doc('components/card');
const tag = doc('components/tag');
const table = doc('components/table');
const tabsDoc = doc('components/tabs');
const navDoc = doc('components/nav');
const meterDoc = doc('components/meter');
const pagerDoc = doc('components/pager');
const accordion = doc('components/accordion');
const steps = doc('components/steps');
const codeBlock = doc('components/code-block');
// Each component's files and reference markup, read from components/.
const CODE = {
  button: componentCode(['button', 'button-hover'], ['button-hover']),
  link: componentCode(['link', 'link-flow']),
  hoverCard: componentCode(['hover-card'], ['hover-card']),
  linkCard: componentCode(['link-card'], ['link-card']),
  statusChip: componentCode(['status-chip']),
  field: componentCode(['field'], ['field']),
  control: componentCode(['control']),
  card: componentCode(['card']),
  tag: componentCode(['tag']),
  table: componentCode(['table']),
  tabs: componentCode(['tabs'], ['tabs']),
  nav: componentCode(['nav']),
  meter: componentCode(['meter']),
  pager: componentCode(['nav', 'pager']),
  accordion: componentCode(['accordion']),
  steps: componentCode(['steps']),
  codeBlock: componentCode(['code-copy'], ['code-copy']),
};
const rules = byTag('interface', 'Guideline', 'Behavior');
const decisions = decisionsFor('interface');
/** One section per component inside Components, in page order: its anchor and its guidance file. */
const SECTIONS: [string, typeof button][] = [['buttons', button], ['links', link], ['hover-cards', hoverCard], ['link-cards', linkCard], ['status-chips', statusChip], ['cards', card], ['tables', table], ['meters', meterDoc], ['tabs', tabsDoc], ['navs', navDoc], ['pagers', pagerDoc], ['tags', tag], ['steps', steps], ['accordions', accordion], ['code-blocks', codeBlock], ['forms', form]];
const NAV: [string, string][] = [['motion', 'Motion'], ['components', 'Components'], ['guidance', 'Guidance'], ['rules', 'Rules'], ['decisions', 'Decisions'], ['examples', 'Examples']];
const components = SECTIONS.map(([, d]) => d);
/** A small dataset for the table and tabs demos. */
const ROWS = [['SyftHub', '11,118', 'success', 'Live'], ['Syft Space', '2,904', 'info', 'Beta'], ['Data network pilot', '412', 'warning', 'Pending review'], ['Legacy gateway', '0', 'danger', 'Retired']];
/** Status chips: a label per status, as a list of things might carry them. */
const CHIPS = [['success', 'Approved'], ['warning', 'Pending review'], ['danger', 'Failed'], ['info', 'New']];
/** The form lab's text-type fields (from the surfaces round's form lab). */
const TEXT_FIELDS = [
  { id: 'name', type: 'text', label: 'Full name', req: true, desc: 'Single-line text: the default field type.', ph: 'Jane Doe' },
  { id: 'email', type: 'email', label: 'Email address', req: true, desc: '', ph: 'Email Address', bare: true },
  // Placeholder as the label (the website's default): no title or description; the
  // placeholder names the field and aria-label gives it an accessible name.
  { id: 'tel', type: 'tel', label: 'Phone', req: false, desc: '', ph: 'Phone Number', bare: true },
  { id: 'size', type: 'number', label: 'Team size', req: false, desc: "Number input, with the browser's stepper left in place.", ph: '12' },
];
---
<Site title="Interface" description="Buttons, links, hover cards and form controls, and their states, on the surface levels." current="interface">
  <PageHero eyebrow="Components" title="Interface" description="Buttons, links, hover cards and form controls, and their states. Controls are defined by how they behave. A boundary comes from a level and a shadow; an outline appears only as a line over the same surface, as on the secondary button." status="released" nav={NAV}>
    <!-- The interactive layer this page shows (design/behaviors/interaction-states.md): set before
         the components below render, remembered for this page only. -->
    <script is:inline>
      try { if (localStorage.getItem('interface-layer') === 'minimal') document.documentElement.setAttribute('data-interaction', 'minimal'); } catch {}
    </script>
  </PageHero>

  <section class="band" id="motion">
    <div class="wrap">
      <header class="sec"><h2>{motion.title}</h2><p>{motion.description}</p>{motion.status !== 'released' && <p class="status">Status: <b>{motion.status}</b></p>}</header>
      <TokenTable names={motion.tokens} />
    </div>
  </section>

  <section class="band" id="components">
    <div class="wrap">
      <header class="sec"><h2>Components</h2><p>Each component as it renders, with its code and tokens; the guidance for each is under Guidance below.</p></header>
      <nav class="nav" aria-label="Components">{SECTIONS.map(([id, d]) => <a class="nav__item" href={`#${id}`}>{d.title}</a>)}</nav>
      <div class="layer-toggle">
        <button type="button" id="layer-switch" class="switch" role="switch" aria-checked="false" aria-labelledby="layer-label" aria-describedby="layer-info"><span class="switch__knob"></span></button>
        <label id="layer-label" for="layer-switch"><b>Show minimal interactive layer</b></label>
        <p id="layer-info" class="muted">Off, the components below show the full interactive layer: color in motion, from the add-on files. On, they show the minimal interactive layer: plain CSS with no motion, built into every component. <a href="#behaviors-interaction-states">Interaction states</a></p>
      </div>
      <div class="stack stack--5xl">
        <section class="component stack stack--xl" id="buttons">
          <header class="sec"><h3 class="h3">{button.title}</h3><p>{button.description}</p>{button.status !== 'released' && <p class="status">Status: <b>{button.status}</b></p>}</header>
          <article class="card">
            <div class="actions">
              <button type="button" class="btn btn--solid">Submit</button>
              <button type="button" class="btn">Cancel</button>
              <button type="button" class="btn">Save draft</button>
            </div>
            <div class="actions">
              <button type="button" class="btn btn--solid"><Icon name="download" size={20} />Download</button>
              <button type="button" class="btn">Read more<Icon name="arrow-right" size={20} /></button>
              <button type="button" class="btn btn--icon" aria-label="Search"><Icon name="search" size={20} /></button>
              <button type="button" class="btn btn--icon" aria-label="Menu"><Icon name="menu" size={20} /></button>
              <button type="button" class="btn" disabled>Disabled</button>
            </div>
            <p class="muted">One solid button per group; the others are secondary, an outline in the body text color with no fill. Both are grayscale at rest. On hover or keyboard focus they fill with the accent in motion: the hue keys flowing under a faint shimmer, with a glow, starting where the clock puts them, the secondary opposite the primary.</p>
          </article>
          <BuildRef code={CODE.button} tokens={['--emphasis', '--on-emphasis', '--accent-key', '--on-key']} />
        </section>
        <section class="component stack stack--xl" id="links">
          <header class="sec"><h3 class="h3">{link.title}</h3><p>{link.description}</p>{link.status !== 'released' && <p class="status">Status: <b>{link.status}</b></p>}</header>
          <div class="grid grid--3">
            <article class="card link-demo">
              <h4 class="block-title">Content link</h4>
              <p>A link inside running text, like <a class="link-content" href="#links">attribution-based control</a>, takes the color of the text around it. Its underline draws in when the page loads; on hover a line in the full OM gradient grows over it from the left, its colors flowing, with a soft glow, and leaves to the right. The text never changes color.</p>
              <p class="muted">Any plain link in a paragraph or a prose region gets it.</p>
            </article>
            <article class="card link-demo">
              <h4 class="block-title">Text button</h4>
              <p class="actions"><a class="link-text" href="#links"><span class="link-text__label">Read more</span><Icon name="arrow-right" size={18} /></a><a class="link-text" href="#links"><span class="link-text__label">Download the report</span><Icon name="download" size={18} /></a></p>
              <p class="muted">An action that reads as text, standing on its own: no line at rest; on hover the accent's line draws in under the label from the left and leaves to the right, flowing in the full layer, as on a content link. The icon follows the label and isn't underlined.</p>
            </article>
            <article class="card link-demo">
              <h4 class="block-title">Nav link</h4>
              <nav class="link-demo__nav" aria-label="Nav links (example)"><a class="link-nav" href="#links" aria-current="page">Research</a><a class="link-nav" href="#links">Blog</a><a class="link-nav" href="#links">Events</a><a class="link-nav" href="#links">Donate</a></nav>
              <p class="muted">For a row of many links, a nav or a footer, where color on every hover would crowd the row: the gray line draws in on hover and stays under the current page.</p>
            </article>
          </div>
          <BuildRef code={CODE.link} tokens={link.tokens} />
        </section>
        <section class="component stack stack--xl" id="hover-cards">
          <header class="sec"><h3 class="h3">{hoverCard.title}</h3><p>{hoverCard.description}</p>{hoverCard.status !== 'released' && <p class="status">Status: <b>{hoverCard.status}</b></p>}</header>
          <div class="hcards">
            <HoverCard href="#hover-cards" icon="flash" hue="amber" title="Quickstart" text="Get up and running in 5 minutes" />
            <HoverCard href="#hover-cards" icon="download" hue="blue" title="Installation" text="Desktop app or Docker deployment" />
            <HoverCard href="#hover-cards" icon="view-structure-up" hue="green" title="Core concepts" text="Learn the building blocks" />
          </div>
          <div class="hcards-large">
            <HoverCard href="#hover-cards" icon="network" hue="green" size="large" title="Start your own federated sub-network" text="Launch a privacy-preserving network for your domain, whether that be in climate, healthcare, finance, or beyond." />
          </div>
          <p class="muted">Hover a card: it lifts and tilts away from the pointer, the light follows the pointer (in light mode the card shades except around it), the icon takes its hue's moving two-tone and a colorflow in the same two-tone rises in the lower third. The arrow stays mono.</p>
          <BuildRef code={CODE.hoverCard} tokens={hoverCard.tokens} />
          <TwoToneDefs />
        </section>
        <section class="component stack stack--xl" id="link-cards">
          <header class="sec"><h3 class="h3">{linkCard.title}</h3><p>{linkCard.description}</p>{linkCard.status !== 'released' && <p class="status">Status: <b>{linkCard.status}</b></p>}</header>
          <div class="grid grid--3">
            <LinkCard href="#link-cards" title="Review rounds">Every round: when it opened, what it explored, and where its favorites live.</LinkCard>
            <LinkCard href="#link-cards" title="v1 reference">The released brand: tokens, components, logos and embeds.</LinkCard>
            <LinkCard href="#link-cards" title="Typography">Rubik for display, Inter for text, on a fluid scale.</LinkCard>
          </div>
          <h4 class="block-title">Logo and post</h4>
          <div class="card-grid">
            <a class="lcard lcard--logo" data-section="always-light" href="#link-cards"><span class="lcard__logo"><img src="/logos/OpenMined-Logo.svg" alt="OpenMined" /></span><span class="lcard__text">A logo supplied as an image, on a white plate</span></a>
            <a class="lcard lcard--post" href="#link-cards" data-text="light"><span class="lcard__cover demo-cover" aria-hidden="true"></span><span class="lcard__meta"><time datetime="2026-10-12">Oct 12, 2026</time> · Research</span><span class="lcard__title">Attribution-based control, explained</span></a>
          </div>
          <BuildRef code={CODE.linkCard} tokens={linkCard.tokens} />
        </section>
        <section class="component stack stack--xl" id="status-chips">
          <header class="sec"><h3 class="h3">{statusChip.title}</h3><p>{statusChip.description}</p>{statusChip.status !== 'released' && <p class="status">Status: <b>{statusChip.status}</b></p>}</header>
          <article class="card">
            <div class="status-rows">
              <div class="status-row">
                <span class="status-row__lab"><b>Quiet</b> · ring and text in <code>fg</code></span>
                <div class="actions">{CHIPS.map(([s, t]) => <span class={`status-chip status-chip--${s}`}>{t}</span>)}</div>
              </div>
              <div class="status-row">
                <span class="status-row__lab"><b>Strong</b> · <code>key</code> fill, white text</span>
                <div class="actions">{CHIPS.map(([s, t]) => <span class={`status-chip status-chip--strong status-chip--${s}`}>{t}</span>)}</div>
              </div>
              <div class="status-row">
                <span class="status-row__lab"><b>No status</b> · body text</span>
                <div class="actions"><span class="status-chip">Draft</span></div>
              </div>
            </div>
          </article>
          <BuildRef code={CODE.statusChip} tokens={statusChip.tokens} />
        </section>
        <section class="component stack stack--xl" id="cards">
          <header class="sec"><h3 class="h3">{card.title}</h3><p>{card.description}</p>{card.status !== 'released' && <p class="status">Status: <b>{card.status}</b></p>}</header>
          <div class="card-grid">
            <div class="card"><h4 class="card__title">Federated learning</h4><p>Train a model on data that never leaves its owner's server.</p></div>
            <div class="card card--icon"><Icon name="lock" size={32} class="card__icon" /><div><h4 class="card__title">Private by design</h4><p>Only the answer leaves; the data stays where it lives.</p></div></div>
            <div class="card card--icon card--stacked"><Icon name="network" size={32} class="card__icon" /><div><h4 class="card__title">One network</h4><p>Every node speaks the same protocol.</p></div></div>
          </div>
          <BuildRef code={CODE.card} tokens={card.tokens} />
        </section>
        <section class="component stack stack--xl" id="tables">
          <header class="sec"><h3 class="h3">{table.title}</h3><p>{table.description}</p>{table.status !== 'released' && <p class="status">Status: <b>{table.status}</b></p>}</header>
          <div class="table-wrap"><table class="table table--rows">
            <thead><tr><th>Project</th><th class="num">Queries</th><th>Status</th></tr></thead>
            <tbody>{ROWS.map(([n, q, s, l], i) => <tr aria-current={i === 0 ? 'true' : undefined}><td>{n}</td><td class="num">{q}</td><td><span class={`status-chip status-chip--${s}`}>{l}</span></td></tr>)}</tbody>
          </table></div>
          <h4 class="block-title">Compact</h4>
          <div class="table-wrap"><table class="table table--compact">
            <thead><tr><th>Project</th><th class="num">Queries</th></tr></thead>
            <tbody>{ROWS.map(([n, q]) => <tr><td>{n}</td><td class="num">{q}</td></tr>)}</tbody>
          </table></div>
          <BuildRef code={CODE.table} tokens={table.tokens} />
        </section>
        <section class="component stack stack--xl" id="meters">
          <header class="sec"><h3 class="h3">{meterDoc.title}</h3><p>{meterDoc.description}</p>{meterDoc.status !== 'released' && <p class="status">Status: <b>{meterDoc.status}</b></p>}</header>
          <div class="table-wrap"><table class="table table--rows table--compact">
            <thead><tr><th>Datasite</th><th>Storage used</th></tr></thead>
            <tbody>{[['Clinical notes', 12, 40], ['Census microdata', 37, 40], ['Survey panel', 0, 40], ['Hospital admissions', 1, 40]].map(([n, x, y], i) => (
              <tr aria-current={i === 2 ? 'true' : undefined}><td>{n}</td><td><span class="meter" role="meter" aria-label="Storage used" aria-valuenow={x} aria-valuemin="0" aria-valuemax={y} aria-valuetext={`${x} of ${y} GB`}><span class="meter__track">{x as number > 0 && <span class="meter__fill" style={`width: ${Math.round((x as number) / (y as number) * 100)}%`}></span>}</span><span class="meter__label">{x} of {y} GB</span></span></td></tr>
            ))}</tbody>
          </table></div>
          <BuildRef code={CODE.meter} tokens={meterDoc.tokens} />
        </section>
        <section class="component stack stack--xl" id="tabs">
          <header class="sec"><h3 class="h3">{tabsDoc.title}</h3><p>{tabsDoc.description}</p>{tabsDoc.status !== 'released' && <p class="status">Status: <b>{tabsDoc.status}</b></p>}</header>
          <div class="tabs" data-tabs>
            <div class="tabs__list" role="tablist" aria-label="How it works">
              <button class="tabs__tab" role="tab" aria-selected="true">For researchers</button>
              <button class="tabs__tab" role="tab" aria-selected="false">For data owners</button>
            </div>
            <div class="tabs__panel stack stack--sm" role="tabpanel"><h4>Ask questions of data you can't see</h4><p>Find a dataset, send a query, and get back only the answer. The data stays with its owner, and you never handle a copy.</p></div>
            <div class="tabs__panel stack stack--sm" role="tabpanel"><h4>Share answers, not your data</h4><p>Keep your data where it is, and approve each query or set a policy. Only the answers you allow ever leave your server.</p></div>
          </div>
          <BuildRef code={CODE.tabs} tokens={tabsDoc.tokens} />
        </section>
        <section class="component stack stack--xl" id="navs">
          <header class="sec"><h3 class="h3">{navDoc.title}</h3><p>{navDoc.description}</p>{navDoc.status !== 'released' && <p class="status">Status: <b>{navDoc.status}</b></p>}</header>
          {[['', 'Quiet (default)'], ['nav--wash', 'Wash'], ['nav--strong', 'Strong']].map(([mod, label]) => (
            <div class="stack stack--sm">
              <h4 class="block-title">{label}</h4>
              <nav class={`nav ${mod}`.trim()} aria-label={`${label} example`}>
                <a class="nav__item" href="#navs" aria-current="page">Overview</a><a class="nav__item" href="#navs">Datasites</a><a class="nav__item" href="#navs">Requests</a><a class="nav__item" href="#navs">Settings</a>
              </nav>
            </div>
          ))}
          <h4 class="block-title">A view filter, on a card</h4>
          <div class="card stack stack--md">
            <div class="nav nav--strong" role="group" aria-label="View" data-nav-demo>
              <button type="button" class="nav__item" aria-pressed="true">All<span class="nav__count">4</span></button><button type="button" class="nav__item" aria-pressed="false">Needs attention<span class="nav__count">2</span></button>
            </div>
          </div>
          <script is:inline>
            document.querySelectorAll('[data-nav-demo]').forEach(g => g.addEventListener('click', e => {
              const b = e.target.closest('.nav__item'); if (!b) return;
              g.querySelectorAll('.nav__item').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
            }));
          </script>
          <BuildRef code={CODE.nav} tokens={navDoc.tokens} />
        </section>
        <section class="component stack stack--xl" id="pagers">
          <header class="sec"><h3 class="h3">{pagerDoc.title}</h3><p>{pagerDoc.description}</p>{pagerDoc.status !== 'released' && <p class="status">Status: <b>{pagerDoc.status}</b></p>}</header>
          <h4 class="block-title">Page 5 of 12</h4>
          <nav class="nav nav--wash pager" aria-label="Pages (example)">
            <a class="nav__item pager__step" href="#pagers" rel="prev"><Icon name="nav-arrow-left" size={16} />Previous</a>
            <span class="pager__pages">
              <a class="nav__item" href="#pagers">1</a><span class="pager__gap" aria-hidden="true">…</span><a class="nav__item" href="#pagers">4</a><a class="nav__item" href="#pagers" aria-current="page">5</a><a class="nav__item" href="#pagers">6</a><span class="pager__gap" aria-hidden="true">…</span><a class="nav__item" href="#pagers">12</a>
            </span>
            <a class="nav__item pager__step" href="#pagers" rel="next">Next<Icon name="nav-arrow-right" size={16} /></a>
          </nav>
          <h4 class="block-title">The first page, on a card</h4>
          <div class="card">
            <nav class="nav nav--wash pager" aria-label="Pages, on a card (example)">
              <span class="nav__item pager__step" aria-disabled="true"><Icon name="nav-arrow-left" size={16} />Previous</span>
              <span class="pager__pages">
                <a class="nav__item" href="#pagers" aria-current="page">1</a><a class="nav__item" href="#pagers">2</a><a class="nav__item" href="#pagers">3</a>
              </span>
              <a class="nav__item pager__step" href="#pagers" rel="next">Next<Icon name="nav-arrow-right" size={16} /></a>
            </nav>
          </div>
          <BuildRef code={CODE.pager} tokens={pagerDoc.tokens} />
        </section>
        <section class="component stack stack--xl" id="tags">
          <header class="sec"><h3 class="h3">{tag.title}</h3><p>{tag.description}</p>{tag.status !== 'released' && <p class="status">Status: <b>{tag.status}</b></p>}</header>
          <ul class="tags"><li><span class="tag">Research</span></li><li><span class="tag">Privacy</span></li><li><a class="tag" href="#tags">Federated learning</a></li><li><a class="tag" href="#tags">Policy</a></li></ul>
          <BuildRef code={CODE.tag} tokens={tag.tokens} />
        </section>
        <section class="component stack stack--xl" id="steps">
          <header class="sec"><h3 class="h3">{steps.title}</h3><p>{steps.description}</p>{steps.status !== 'released' && <p class="status">Status: <b>{steps.status}</b></p>}</header>
          <div class="grid grid--2">
            <ol class="steps steps--connector">
              <li class="steps__item"><span class="steps__num" aria-hidden="true">1</span><div><h4 class="steps__title">Install Syft Space</h4><p>One command on the server that holds the data.</p></div></li>
              <li class="steps__item"><span class="steps__num" aria-hidden="true">2</span><div><h4 class="steps__title">Connect your data</h4><p>Point it at a folder or a database.</p></div></li>
              <li class="steps__item"><span class="steps__num" aria-hidden="true">3</span><div><h4 class="steps__title">Answer queries</h4><p>Approve each request, or set a policy.</p></div></li>
            </ol>
            <ol class="steps steps--outline steps--connector">
              <li class="steps__item"><span class="steps__num" aria-hidden="true">1</span><div><h4 class="steps__title">Find a dataset</h4><p>Browse what the network holds.</p></div></li>
              <li class="steps__item"><span class="steps__num" aria-hidden="true">2</span><div><h4 class="steps__title">Send a query</h4><p>Code runs where the data lives.</p></div></li>
              <li class="steps__item"><span class="steps__num" aria-hidden="true">3</span><div><h4 class="steps__title">Get the answer</h4><p>Only the result comes back.</p></div></li>
            </ol>
          </div>
          <BuildRef code={CODE.steps} tokens={steps.tokens} />
        </section>
        <section class="component stack stack--xl" id="accordions">
          <header class="sec"><h3 class="h3">{accordion.title}</h3><p>{accordion.description}</p>{accordion.status !== 'released' && <p class="status">Status: <b>{accordion.status}</b></p>}</header>
          <div class="accordions">
            <details class="accordion" open><summary class="accordion__summary"><span class="accordion__title">Does my data leave my server?</span><span class="accordion__icon" aria-hidden="true"><Icon name="nav-arrow-down" size={16} /></span></summary><div class="accordion__body"><p>No. A query runs where the data lives and only its answer comes back, after you approve it.</p></div></details>
            <details class="accordion"><summary class="accordion__summary"><span class="accordion__title">Who can send a query?</span><span class="accordion__icon" aria-hidden="true"><Icon name="nav-arrow-down" size={16} /></span></summary><div class="accordion__body"><p>Anyone you allow, under the policy you set.</p></div></details>
            <details class="accordion"><summary class="accordion__summary"><span class="accordion__title">What does it cost?</span><span class="accordion__icon" aria-hidden="true"><Icon name="nav-arrow-down" size={16} /></span></summary><div class="accordion__body"><p>Syft Space is free and open source.</p></div></details>
          </div>
          <BuildRef code={CODE.accordion} tokens={accordion.tokens} />
        </section>
        <section class="component stack stack--xl" id="code-blocks">
          <header class="sec"><h3 class="h3">{codeBlock.title}</h3><p>{codeBlock.description}</p>{codeBlock.status !== 'released' && <p class="status">Status: <b>{codeBlock.status}</b></p>}</header>
          <pre class="code-block"><code>npm install @openmined/syft-space
    syft-space init --data ./records</code></pre>
          <BuildRef code={CODE.codeBlock} tokens={codeBlock.tokens} />
        </section>
        <section class="component stack stack--xl" id="forms">
          <div class="fm-split">
            <div class="fm-split__text">
              <header class="sec"><h3 class="h3">{form.title}</h3><p>{form.description}</p>{form.status !== 'released' && <p class="status">Status: <b>{form.status}</b></p>}</header>
              <BuildRef code={CODE.field} tokens={['--line-focus']} label="Field: code and tokens" />
              <BuildRef code={CODE.control} label="Controls: code" />
            </div>
            <article class="card fm-split__form">
              <form class="fm demo-form" onsubmit="return false">
                {TEXT_FIELDS.map(f => (
                  <div class="fld">
                    {!f.bare && <label class="fld__label" for={`f-${f.id}`}>{f.label}{f.req && <span class="fld__req">*</span>}</label>}
                    {f.desc && <p class="fld__desc">{f.desc}</p>}
                    <input class="ctl" id={`f-${f.id}`} type={f.type} placeholder={f.ph} aria-label={f.bare ? f.ph : undefined} />
                  </div>
                ))}
                <div class="fld">
                  <label class="fld__label" for="f-role">Role</label>
                  <p class="fld__desc">Select: native control, our surface.</p>
                  <div class="fld__ctl--select">
                    <select class="ctl" id="f-role"><option>Choose an option</option><option>Researcher</option><option>Engineer</option></select>
                  </div>
                </div>
                <div class="fld">
                  <label class="fld__label" for="f-date">Start date</label>
                  <p class="fld__desc">Date input, with the browser's picker intact.</p>
                  <input class="ctl" id="f-date" type="date" />
                </div>
                <div class="fld">
                  <label class="fld__label" for="f-msg">Message</label>
                  <p class="fld__desc">Textarea: resizes vertically only.</p>
                  <textarea class="ctl" id="f-msg" rows="3" placeholder="Placeholder copy"></textarea>
                </div>
                <div class="fld">
                  <span class="fld__label">Interests</span>
                  <p class="fld__desc">Checkbox list. Boxes are a recess and cast at rest.</p>
                  <ul class="opts">
                    {['Federated learning', 'Secure enclaves', 'Differential privacy'].map((o, i) => (
                      <li><label class="opt"><input class="opt__box" type="checkbox" checked={i === 0} /><span>{o}</span></label></li>
                    ))}
                  </ul>
                </div>
                <div class="fld">
                  <span class="fld__label">Contact preference</span>
                  <p class="fld__desc">Radio list: the same recess, round.</p>
                  <ul class="opts">
                    {['Email', 'No contact'].map((o, i) => (
                      <li><label class="opt"><input class="opt__box" type="radio" name="pref" checked={i === 0} /><span>{o}</span></label></li>
                    ))}
                  </ul>
                </div>
                <div class="fld">
                  <span class="fld__label">Notifications</span>
                  <p class="fld__desc">A toggle: a recess you operate, inset 3px.</p>
                  <div class="actions">
                    <button type="button" class="switch" role="switch" aria-checked="true" aria-label="Notifications on"><span class="switch__knob"></span></button>
                    <button type="button" class="switch" role="switch" aria-checked="false" aria-label="Digest off"><span class="switch__knob"></span></button>
                  </div>
                </div>
                <div class="fld">
                  <label class="fld__label" for="f-file">Attachment</label>
                  <p class="fld__desc">File input: the button is the only part that can be styled.</p>
                  <input class="ctl ctl--file" id="f-file" type="file" />
                </div>

                <h4 class="fm-sub">States</h4>
                <div class="fld">
                  <label class="fld__label" for="f-focus">Focused</label>
                  <p class="fld__desc">A solid gray line with the inset.</p>
                  <input class="ctl is-focus" id="f-focus" type="text" value="Typing a value" />
                </div>
                <div class="fld">
                  <label class="fld__label" for="f-filled">Filled</label>
                  <input class="ctl" id="f-filled" type="text" value="A completed value" />
                </div>
                <div class="fld">
                  <label class="fld__label" for="f-dis">Disabled</label>
                  <input class="ctl" id="f-dis" type="text" value="Not editable" disabled />
                </div>
                <div class="fld">
                  <label class="fld__label" for="f-err">Error<span class="fld__req">*</span></label>
                  <input class="ctl" id="f-err" type="email" value="not-an-email" />
                  <ul class="fld__errs"><li>Please enter a valid email address.</li></ul>
                </div>

                <div class="actions">
                  <button type="submit" class="btn btn--solid">Submit</button>
                  <button type="button" class="btn">Cancel</button>
                </div>
              </form>
            </article>
          </div>
        </section>
      </div>
    </div>
  </section>

  <section class="band" id="guidance">
    <div class="wrap">
      <header class="sec"><h2>Guidance</h2><p>Each component's guidance in full.</p></header>
      <DocGrid docs={components} />
    </div>
  </section>

  <section class="band" id="rules">
    <div class="wrap">
      <header class="sec"><h2>Rules</h2></header>
      <DocGrid docs={rules} />
    </div>
  </section>

  <section class="band" id="decisions">
    <div class="wrap">
      <header class="sec"><h2>Decisions</h2><p>Why things are the way they are, oldest first. Open a row for the full record.</p></header>
      <DecisionList docs={decisions} />
    </div>
  </section>

  <ExampleLinks slugs={["dashboard", "join-form", "product-steps"]} />

<script>
  // The layer switch: on sets data-interaction="minimal" on the page; the label stays the same.
  const html = document.documentElement;
  const sw = document.getElementById('layer-switch');
  const sync = () => {
    const minimal = html.getAttribute('data-interaction') === 'minimal';
    sw?.setAttribute('aria-checked', String(minimal));
  };
  sw?.addEventListener('click', () => {
    const minimal = html.getAttribute('data-interaction') !== 'minimal';
    if (minimal) html.setAttribute('data-interaction', 'minimal'); else html.removeAttribute('data-interaction');
    try { localStorage.setItem('interface-layer', minimal ? 'minimal' : 'full'); } catch {}
    sync();
  });
  sync();
</script>
</Site>
