---
/**
 * BRAND SITE (v2) — Color. Rev 1, built from the color, spectrum and naming
 * rounds. Words from design/ (tag `color`);
 * values from src/tokens/v2/ via src/lib/tokens.ts.
 */
import Site from '../../layouts/Site.astro';
import ExampleLinks from '../../components/site/ExampleLinks.astro';
import PageHero from '../../components/site/PageHero.astro';
import BuildRef from '../../components/site/BuildRef.astro';
import DocGrid from '../../components/site/DocGrid.astro';
import DecisionList from '../../components/site/DecisionList.astro';
import TwoToneDefs from '../../components/site/TwoToneDefs.astro';
import ColorIcon from '../../components/site/ColorIcon.astro';
import { doc, byTag, decisionsFor } from '../../lib/design';
import { MODES, HUES, STEPS, SERIES, STATUS, SAT, hex, primitive, stepOf, contrast, stepLabel, readout, TWO_TONE_COMPANION, HIGHLIGHT, GRADIENT_STOPS, EXTRA_STOPS, GRADIENT_LISTS, listStops, target, type Mode } from '../../lib/tokens';

import HUES_LIGHT from '../../../tokens/light/hues.json';
import HUES_DARK from '../../../tokens/dark/hues.json';

const foundation = doc('foundations/color');
/* Steps at the edge of the sRGB gamut: the mode's saturation offset is pulled back
   to what screens can show (gamutMapped in tokens/), so some match in both modes. */
const GAMUT = HUES.flatMap(h => STEPS.filter(s => (HUES_LIGHT as any)[h]?.[s]?.$extensions?.['org.openmined']?.gamutMapped).map(s => {
  const l = (HUES_LIGHT as any)[h][s].$value.hex, d = (HUES_DARK as any)[h][s].$value.hex;
  return { name: `${h} ${s}`, same: l === d, l, d };
}));
const { Content } = foundation;
const rules = byTag('color', 'Guideline', 'Behavior');
const decisions = decisionsFor('color');

/** Roles that land on a gray step, listed on the gray card. */
const GRAY_ROLES = ['surface-sunken', 'surface-base', 'surface-raise-1', 'surface-raise-2', 'line', 'line-strong', 'text-headline', 'text-body', 'text-muted'];
/** White before the scale, black after it: the ends sit where they fall in lightness. */
const GRAYS = ['white', ...STEPS.map(s => `gray-${s}`), 'black'];
const grayUse = (m: Mode, g: string) => GRAY_ROLES.filter(r => primitive(m, r) === g).map(r => r.replace('surface-', ''));
const grayName = (g: string) => g.replace('gray-', '');
/** A swatch's readout color as a token, never a literal (gray is the same in both modes). */
const readoutColor = (m: Mode, h: string) => h === hex(m, 'gray-800') ? 'var(--gray-800)' : 'var(--gray-50)';

const HUE_ROLES = ['subtle', 'soft', 'fg', 'key'];
const ROLE_USE: Record<string, string> = {
  subtle: 'Quiet colored background', soft: 'Decorative rule, area fill', fg: 'Colored text, links, icons',
  key: 'Marks, and the colored fill, labeled in --on-key (white)',
};
const rolesAt = (m: Mode, s: string) => HUE_ROLES.filter(r => stepOf(m, `blue-${r}`) === s);
const statusOf = (h: string) => Object.entries(STATUS).filter(([, v]) => v === h).map(([k]) => k);

const SURF = ['surface-sunken', 'surface-base', 'surface-raise-1', 'surface-raise-2'];
/* Status roles: each status's hue, and the contrast of what the status chips draw
   with it (fg text on the page levels at worst; white on the key). */
const GROUNDS3 = ['surface-base', 'surface-raise-1', 'surface-raise-2'];
const STATUS_ROWS = Object.entries(STATUS).map(([s, h]) => ({
  s, h,
  fg: MODES.map(m => ({ m, c: Math.min(...GROUNDS3.map(g => contrast(hex(m, `${s}-fg`), hex(m, g)))) })),
  key: MODES.map(m => ({ m, c: contrast(hex(m, 'white'), hex(m, `${h}-key`)) })),
}));
const TEXT = ['text-headline', 'text-body', 'text-muted'];
const LINES = ['line', 'line-strong'];
const cr = (m: Mode, a: string, b: string) => contrast(hex(m, a), hex(m, b));

/** The brand gradient: its stops, the graphics-only extra stops, and each graphic's own list. */
const gradient = doc('foundations/gradient');
const ref = (name: string) => target('light', `gradient-${name}`)?.replace('-key', '') ?? null;

/** Two-tone gradients: one per hue, its companion read from the token's middle stop. */
const twoTone = doc('foundations/two-tone');
const TWO_TONE = HUES.map(h => ({ hue: h, token: `--gradient-two-tone-${h}`, companion: TWO_TONE_COMPANION[h] }));
/** Highlights: one per hue, the lit-up part of a moving line, shown pulsing along a line in the hue. */
const highlight = doc('foundations/highlight');
const HIGHLIGHTS = HUES.map(h => ({ hue: h, token: `--gradient-highlight-${h}`, color: HIGHLIGHT[h] }));
const NAV: [string, string][] = [['palette', 'Palette'], ['role-examples', 'Roles'], ['text', 'Text and lines'], ['series', 'Chart series'], ['gradient', 'Gradient'], ['two-tone', 'Two-tone'], ['highlight', 'Highlights'], ['how', 'How it works'], ['rules', 'Rules'], ['decisions', 'Decisions'], ['examples', 'Examples']];
---
<Site title={foundation.title} description={foundation.description} current="color">
  <PageHero eyebrow="Foundations" title={foundation.title} description={foundation.description} status={foundation.status} nav={NAV} />

  <section class="band" id="palette">
    <div class="wrap">
      <header class="sec"><h2>Palette</h2><p>One gray and six hues, 50–950. Hues are offset per mode (saturation ×{SAT.light.toFixed(2)} light, ×{SAT.dark.toFixed(2)} dark); gray is the same in both. Labels under each step show which roles land on it in the current mode. Steps marked <em>provisional</em> have no job yet.</p></header>
      <article class="card spec-card" aria-label="Gray">
        <h3>Gray</h3>
        <div class="grays__row">
          {GRAYS.map(g => (
            <div class="grays__cell" data-gray={g.startsWith('gray-') ? grayName(g) : undefined}>
              <span class="sw" style={`background:var(--${g})`}>
                <code class="only-light js-ghex" style={`color:${readoutColor('light', readout('light', hex('light', g)))}`}>{hex('light', g)}</code>
                <code class="only-dark js-ghex" style={`color:${readoutColor('dark', readout('dark', hex('dark', g)))}`}>{hex('dark', g)}</code>
              </span>
              <b class="grays__step">{grayName(g)}</b>
              {MODES.map(m => <em class={`grays__use only-${m}`}>{grayUse(m, g).join(' · ')}</em>)}
            </div>
          ))}
        </div>
        <p class="muted">The grays carry a slight midtone saturation boost, most in the middle steps (amount 0.008, center 54, width 15; built into the tokens).</p>
      </article>
      <article class="card spec-card" aria-label="Hues">
        <h3>Hues</h3>
        <div class="ramps">
          <div class="ramps__head">
            <span></span>
            {STEPS.map(s => (
              <span class="ramps__step">
                <b>{s}{['50', '900', '950'].includes(s) && ' · provisional'}</b>
                {MODES.map(m => <em class={`only-${m}`}>{rolesAt(m, s).join(' · ') || '—'}</em>)}
              </span>
            ))}
          </div>
          {HUES.map(h => (
            <div class="ramps__row">
              <span class="ramps__hue">{h}<small>{statusOf(h).join(' · ')}</small></span>
              {STEPS.map(s => (
                <span class="sw" style={`background:var(--${h}-${s})`}>
                  {MODES.map(m => <code class={`only-${m}`} style={`color:${readoutColor(m, stepLabel(m, s))}`}>{hex(m, `${h}-${s}`)}</code>)}
                </span>
              ))}
            </div>
          ))}
        </div>
        <div class="gamut-note">
          <p><b>Why some steps don’t change between modes.</b> The saturation offset can only go as far as screens can show. A few steps already sit at the edge of the sRGB gamut (teal 500’s red channel is 0, for example), so the light mode’s ×{SAT.light.toFixed(2)} is pulled back to the nearest color a screen can show, and with dark at ×{SAT.dark.toFixed(2)} they land on the same value in both modes. That’s expected, not a bug: they’re already as saturated as a screen allows. If a step should differ between modes, the lever is lightness, not saturation.</p>
          <p class="muted">Same in both modes: {GAMUT.filter(g => g.same).map(g => `${g.name} (${g.l})`).join(', ')}. At the edge in light but still slightly different: {GAMUT.filter(g => !g.same).map(g => `${g.name} (${g.l} light, ${g.d} dark)`).join(', ') || 'none'}. Read from the token files, where these steps are marked <code>gamutMapped</code>.</p>
        </div>
      </article>
    </div>
  </section>

  <section class="band" id="role-examples">
    <div class="wrap">
      <header class="sec"><h2>Roles</h2><p>Components use roles, never steps. Each role names a step per mode; the examples are every hue in the current mode.</p></header>
      <article class="card">
        <div class="tbl-wrap">
          <table class="tbl tbl--roles">
            <thead><tr><th>Role</th><th>Light</th><th>Dark</th><th>Example</th></tr></thead>
            <tbody>
              {HUE_ROLES.map(r => (
                <tr>
                  <td><code>{r}</code><br /><span class="muted">{ROLE_USE[r]}</span></td>
                  <td>{stepOf('light', `blue-${r}`)}</td><td>{stepOf('dark', `blue-${r}`)}</td>
                  <td><span class="ex">{HUES.map(h => (
                    r === 'fg' ? <b class="ex__txt" style={`color:var(--${h}-fg)`}>Aa</b>
                    : r === 'key' ? <span class="ex__chip" style={`background:var(--${h}-key);color:var(--on-key)`}>Aa</span>
                    : r === 'subtle' ? <span class="ex__chip" style={`background:var(--${h}-subtle);color:var(--${h}-fg)`}>Aa</span>
                    : <span class="ex__chip" style={`background:var(--${h}-${r})`}></span>
                  ))}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </article>
      <article class="card">
        <h3>Status</h3>
        <p>Four statuses, each a hue by role: <code>--success-fg</code>, <code>--danger-key</code> and so on, with every role a hue has. Components name the status, never the hue. The <a href="/interface/#status-chips">status chips</a> draw with <code>fg</code> (quiet), and <code>key</code> labeled in <code>--on-key</code> (strong).</p>
        <div class="tbl-wrap">
          <table class="tbl tbl--roles">
            <thead><tr><th>Status</th><th>Hue</th><th>fg</th><th class="num">fg on the page, lowest</th><th>key</th><th class="num">White on key</th></tr></thead>
            <tbody>
              {STATUS_ROWS.map(r => (
                <tr>
                  <td><code>--{r.s}-*</code></td>
                  <td>{r.h}</td>
                  <td><b class="ex__txt" style={`color:var(--${r.s}-fg)`}>Aa</b></td>
                  <td class="num">{r.fg.map(x => <span class={`only-${x.m}`}>{x.c.toFixed(2)}</span>)}</td>
                  <td><span class="ex__chip" style={`background:var(--${r.s}-key)`}></span></td>
                  <td class="num">{r.key.map(x => <span class={`only-${x.m}`}>{x.c.toFixed(2)}</span>)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </article>
    </div>
  </section>

  <section class="band" id="text">
    <div class="wrap">
      <header class="sec"><h2>Text and lines</h2><p>Contrast of each text and line role on each surface; text below 4.5:1 is marked. Text colors on the four levels are on <a href="/typography/#color">Typography</a>.</p></header>
      <article class="card">
        <div class="tbl-wrap">
          <table class="tbl">
            <thead><tr><th>Role</th><th>Mode</th>{SURF.map(s => <th>on {s.replace('surface-', '')}</th>)}</tr></thead>
            <tbody>
              {[...TEXT, ...LINES].flatMap(r => MODES.map(m => (
                <tr>
                  <td>{m === 'light' && <code>--{r}</code>}</td>
                  <td>{m} · <code>{primitive(m, r).replace('-', ' ')}</code></td>
                  {SURF.map(s => { const c = cr(m, r, s); return <td class={TEXT.includes(r) && c < 4.5 ? 'bad' : ''}>{c.toFixed(2)}</td>; })}
                </tr>
              )))}
            </tbody>
          </table>
        </div>
      </article>
      <BuildRef tokens={foundation.tokens} />
    </div>
  </section>

  <section class="band" id="series">
    <div class="wrap">
      <header class="sec"><h2>Chart series</h2><p>Six series in a validated order; violet and blue are never adjacent. Each series owns a hue at four strengths, so an entity keeps its color from a faint panel to a label.</p></header>
      <article class="card">
        <div class="tbl-wrap">
        <table class="tbl tbl--series">
          <thead><tr><th>Series</th><th>subtle</th><th>soft</th><th>key</th><th>fg</th></tr></thead>
          <tbody>
            {SERIES.map((h, i) => (
              <tr>
                <td><code>--series-{i + 1}</code> <span class="muted">{h}</span></td>
                {['subtle', 'soft', 'key', 'fg'].map(r => <td><i class="chip" style={`background:var(--${h}-${r})`}></i></td>)}
              </tr>
            ))}
          </tbody>
        </table>
        </div>
      </article>
    </div>
  </section>

  <section class="band" id="gradient">
    <div class="wrap">
      <header class="sec"><h2>{gradient.title}</h2><p>{gradient.description} Family stops are hue keys; gold, orange, lime and yellow are fitted to the palette.{gradient.status !== 'released' && <> Status: <b>{gradient.status}</b>.</>}</p></header>
      <article class="card spec-card">
        <i class="spec__bar" aria-hidden="true"></i>
        <div class="spec__stops">
          {GRADIENT_STOPS.map(n => (
            <span>
              <i style={`background:var(--gradient-${n})`}></i>
              <b>{n}</b>
              {MODES.map(m => <code class={`only-${m}`}>{hex(m, `gradient-${n}`)}<br />{ref(n) ? `${ref(n)} key` : 'fitted'}</code>)}
            </span>
          ))}
        </div>
        {EXTRA_STOPS.length > 0 && (
          <div class="spec__extra">
            <p class="muted">Extra stops, for graphics only: not in the spectrum, used by a graphic's own list.</p>
            <div class="spec__stops">
              {EXTRA_STOPS.map((n: string) => (
                <span>
                  <i style={`background:var(--gradient-${n})`}></i>
                  <b>{n}</b>
                  {MODES.map(m => <code class={`only-${m}`}>{hex(m, `gradient-${n}`)}<br />fitted</code>)}
                </span>
              ))}
            </div>
          </div>
        )}
        <div class="tbl-wrap">
        <table class="tbl tbl--two-tone">
          <thead><tr><th>List</th><th>Gradient</th><th>Stops</th></tr></thead>
          <tbody>
            {GRADIENT_LISTS.map(l => (
              <tr>
                <td><code>--gradient-{l.name}</code>{l.status !== 'released' && <><br /><span class="muted">{l.status}</span></>}</td>
                <td><i class="tt-bar" style={`background:var(--gradient-${l.name})`}></i></td>
                <td class="muted">{listStops(l.name).split(',').map(n => n.replace('gradient-', '').replace('-key', ' key')).join(', ')}</td>
              </tr>
            ))}
          </tbody>
        </table>
        </div>
        <div class="guide-prose"><gradient.Content /></div>
      </article>
    </div>
  </section>

  <section class="band" id="two-tone">
    <div class="wrap">
      <header class="sec"><h2>{twoTone.title}</h2><p>{twoTone.description}{twoTone.status !== 'released' && <> Status: <b>{twoTone.status}</b>.</>}</p></header>
      <article class="card">
        <div class="tbl-wrap">
        <table class="tbl tbl--two-tone">
          <thead><tr><th>Token</th><th>Companion</th><th>Gradient</th><th>On an icon</th></tr></thead>
          <tbody>
            {TWO_TONE.map(t => (
              <tr>
                <td><code>{t.token}</code></td>
                <td><span class="tt-pair"><i class="tt-dot" style={`background:var(--${t.hue}-key)`}></i>{t.hue} + <i class="tt-dot" style={`background:var(--gradient-two-tone-${t.hue}-companion)`}></i>{t.companion}</span></td>
                <td><i class="tt-bar" style={`background:var(${t.token})`}></i></td>
                <td><ColorIcon name="settings" hue={t.hue} size={28} /></td>
              </tr>
            ))}
          </tbody>
        </table>
        </div>
        <div class="guide-prose"><twoTone.Content /></div>
      </article>
    </div>
    <TwoToneDefs />
  </section>

  <section class="band" id="highlight">
    <div class="wrap">
      <header class="sec"><h2>{highlight.title}</h2><p>{highlight.description}{highlight.status !== 'released' && <> Status: <b>{highlight.status}</b>.</>}</p></header>
      <article class="card">
        <div class="tbl-wrap">
        <table class="tbl tbl--two-tone">
          <thead><tr><th>Token</th><th>Highlight</th><th>On a line</th></tr></thead>
          <tbody>
            {HIGHLIGHTS.map(t => (
              <tr>
                <td><code>{t.token}</code></td>
                <td><span class="tt-pair"><i class="tt-dot" style={`background:var(--${t.hue}-key)`}></i>{t.hue} + <i class="tt-dot" style={`background:var(${t.token})`}></i>{t.color}</span></td>
                <td><svg class="hl-line" viewBox="0 0 240 12" aria-hidden="true"><path d="M2 6H238" style={`stroke:var(--${t.hue}-key);--flow-tone:var(${t.token})`} data-flow /></svg></td>
              </tr>
            ))}
          </tbody>
        </table>
        </div>
        <div class="guide-prose"><highlight.Content /></div>
      </article>
    </div>
  </section>

  <section class="band" id="how">
    <div class="wrap">
      <header class="sec"><h2>How it works</h2></header>
      <div class="guide-prose"><Content /></div>
    </div>
  </section>

  <section class="band" id="rules">
    <div class="wrap">
      <header class="sec"><h2>Rules</h2></header>
      <DocGrid docs={rules} />
    </div>
  </section>

  <section class="band" id="decisions">
    <div class="wrap">
      <header class="sec"><h2>Decisions</h2><p>Why things are the way they are, oldest first. Open a row for the full record.</p></header>
      <DecisionList docs={decisions} />
    </div>
  </section>

  <ExampleLinks slugs={["home", "dashboard", "diagram-abc-1"]} />
</Site>

