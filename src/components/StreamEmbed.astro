---
/**
 * Thin wrapper around the portable <om-stream> web component (public/embeds/).
 * The component is the canonical, framework-agnostic asset — this just renders
 * the element and loads its module so the reference site dogfoods it.
 * Consuming projects use <om-stream> directly; see CLAUDE.md › Portable embeds.
 */
interface Props {
  id?: string;
  gradient?: string;       // named gradient, e.g. "stream"
  colors?: string;         // explicit comma-separated hex stops (overrides gradient)
  aspectRatio?: number;
  rotSpeed?: number;
  rotAxis?: string;        // along | across | spiral
}
const { id, gradient, colors, aspectRatio, rotSpeed, rotAxis } = Astro.props;
---

<om-stream
  id={id}
  gradient={gradient}
  colors={colors}
  aspect-ratio={aspectRatio}
  rot-speed={rotSpeed}
  rot-axis={rotAxis}
></om-stream>
<script type="module" src="/embeds/om-stream.js" is:inline></script>
