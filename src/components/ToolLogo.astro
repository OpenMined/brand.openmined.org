---
/**
 * ToolLogo — a third-party integration/tool mark (NOT an OpenMined asset).
 * Renders an official tool mark from public/logos/tools/. These are the
 * trademarks of their owners, used nominatively; never recolor where the owner
 * forbids it. See public/logos/tools/README.md + tools.json.
 *
 * Color-mode aware (2026-10-12):
 * - `icon` (one color) is inlined, so it takes the text color around it in any mode.
 * - A color variant with a `-dark` file beside it (`icon-color-dark.svg`,
 *   `logo-dark.svg`) shows that file wherever the page or a section is dark:
 *   [data-theme="dark"], data-section="always-dark", or "invert" on a light page.
 * - A color variant without one is the same file in both modes; the brand site's
 *   build check (src/lib/tools.ts) makes sure such a file reads on both.
 */
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  brand: string;                                   // e.g. "github", "asana"
  variant?: 'icon' | 'icon-color' | 'logo' | 'logo-black' | 'logo-white';
  size?: number | string;                          // height in px (icons) — width auto
  alt?: string;
  class?: string;
}
const { brand, variant = 'icon-color', size = 32, alt, class: className = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dir = join(process.cwd(), 'public', 'logos', 'tools', brand);
const h = typeof size === 'number' ? `${size}px` : size;
const label = alt ?? `${brand} logo`;
const style = `height:${h};width:auto;display:inline-block;vertical-align:middle;`;

const mono = variant === 'icon'
  ? readFileSync(join(dir, 'icon.svg'), 'utf8')
      .replace(/<\?xml[^>]*>|<!--[\s\S]*?-->/g, '')
      .replace(/<svg\b/, `<svg role="img" aria-label="${label}" style="${style}"`)
  : null;
const src = `${base}/logos/tools/${brand}/${variant}.svg`;
const darkSrc = !mono && existsSync(join(dir, `${variant}-dark.svg`)) ? `${base}/logos/tools/${brand}/${variant}-dark.svg` : null;
---
{mono ? (
  <span class={`tool-logo ${className}`} set:html={mono} />
) : darkSrc ? (
  <span class={`tool-logo tool-logo--modes ${className}`}>
    <img class="tool-logo__light" src={src} alt={label} style={style} loading="lazy" />
    <img class="tool-logo__dark" src={darkSrc} alt={label} style={style} loading="lazy" />
  </span>
) : (
  <img class={`tool-logo ${className}`} src={src} alt={label} style={style} loading="lazy" />
)}

<style is:global>
  /* Light file by default; the dark file wherever the context is dark. A
     section's own mode beats the page's (always-light inside a dark page):
     :where() keeps every context at zero specificity, so the later rule wins. */
  .tool-logo--modes .tool-logo__dark { display: none !important; }
  :where([data-theme='dark'], [data-section='always-dark'], :root:not([data-theme='dark']) [data-section='invert']) .tool-logo--modes .tool-logo__light { display: none !important; }
  :where([data-theme='dark'], [data-section='always-dark'], :root:not([data-theme='dark']) [data-section='invert']) .tool-logo--modes .tool-logo__dark { display: inline-block !important; }
  :where([data-section='always-light'], [data-theme='dark'] [data-section='invert']) .tool-logo--modes .tool-logo__light { display: inline-block !important; }
  :where([data-section='always-light'], [data-theme='dark'] [data-section='invert']) .tool-logo--modes .tool-logo__dark { display: none !important; }
</style>
