---
/**
 * Thin wrapper around the portable <om-diamond> web component (public/embeds/).
 * The component is the canonical, framework-agnostic asset — this just renders
 * the element and loads its module so the reference site dogfoods it.
 * Consuming projects use <om-diamond> directly; see CLAUDE.md › Portable embeds.
 */
interface Props {
  id?: string;
  gradient?: string;  // named gradient, e.g. "spectrum"
  colors?: string;    // explicit comma-separated hex stops (overrides gradient)
}
const { id, gradient, colors } = Astro.props;
---

<om-diamond id={id} gradient={gradient} colors={colors}></om-diamond>
<script type="module" src="/embeds/om-diamond.js" is:inline></script>
