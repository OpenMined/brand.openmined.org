---
const rings = [
  { value: 62, status: 'On schedule', modifier: 'progress-ring--success', detail: 'Five of eight milestones complete.' },
  { value: 35, status: 'At risk', modifier: 'progress-ring--warning', detail: 'The review milestone is approaching its due date.' },
  { value: 100, status: 'Complete', modifier: 'progress-ring--sm', detail: 'All milestones are complete.' },
];
---
<div class="grid grid--3">
  {rings.map(({ value, status, modifier, detail }) => (
    <details class="card card--compact">
      <summary class="demo-row">
        <svg class:list={['progress-ring', modifier]} viewBox="0 0 64 64" role="img" aria-label={`${value}% progress`} style={`--progress-ring-value: ${value}`}>
          <circle class="progress-ring__track" cx="32" cy="32" r="29" pathLength="100" />
          <circle class="progress-ring__fill" cx="32" cy="32" r="29" pathLength="100" />
          <text class="progress-ring__text" x="50%" y="50%">{value}%</text>
        </svg>
        <span>{status}</span>
      </summary>
      <p>{detail}</p>
    </details>
  ))}
</div>
