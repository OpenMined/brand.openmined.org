---
/** /wip/ demo: each status as a dot beside its words, and the quiet chip for comparison. */
const S: [string, string][] = [['success', 'On track'], ['warning', 'At risk'], ['danger', 'Blocked'], ['info', 'In review'], ['none', 'No status']];
---
<div class="card card--compact stack stack--sm">
  {S.map(([s, t]) => <span class="demo-row"><span class={`status-dot status-dot--${s}`} aria-hidden="true"></span>{t}</span>)}
  <span class="demo-row"><span class="status-chip status-chip--warning">At risk</span><span class="muted">the quiet chip, for comparison</span></span>
</div>
