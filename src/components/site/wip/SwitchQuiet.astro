---
/** /wip/ demo: the quiet switch beside a quiet chip, and the switch for comparison. It drives the page's color mode. */
import ThemeToggle from '../ThemeToggle.astro';
---
<div class="card card--compact"><div class="demo-row">
  <span class="status-chip status-chip--success">Live</span>
  <ThemeToggle class="switch--quiet" />
  <span class="muted">Quiet switch</span>
  <button type="button" class="switch" role="switch" aria-checked="false" aria-label="Example setting"><span class="switch__knob"></span></button>
  <span class="muted">The switch, for comparison</span>
</div></div>
<p class="muted">The quiet switch changes this page's color mode.</p>
