---
/**
 * Icon — a v2 icon by its name in icons/set.json, inlined at build time (no CDN),
 * in currentColor, with the stroke for its size. The set decides the drawing:
 * Iconoir (regular), our own (public/icons/), or a partner mark. All of it goes
 * through src/lib/icons.ts; a name missing from the set fails the build.
 */
import { iconSvg } from '../../lib/icons';

interface Props { name: string; size?: number | string; label?: string; class?: string }
const { name, size = '1em', label, class: cls = '' } = Astro.props;
---
<Fragment set:html={iconSvg(name, { size, label, cls })} />
