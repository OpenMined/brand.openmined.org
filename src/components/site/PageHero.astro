---
/** Topic page header: eyebrow, title, summary, status, anything the page adds (the slot), and the on-page nav. */
interface Props { eyebrow: string; title: string; description: string; status: string; nav: [string, string][]; source?: string }
const { eyebrow, title, description, status, nav, source = 'values from the v2 token build' } = Astro.props;
---
<section class="wrap hero">
  <p class="text-eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p class="text-lead">{description}</p>
  <p class="status">{status !== 'released' && <>Status: <b>{status}</b> · </>}{source}</p>
  <slot />
  <nav class="page-nav" aria-label="On this page">{nav.map(([id, t]) => <a class="link-text" href={`#${id}`}><span class="link-text__label">{t}</span></a>)}</nav>
</section>
