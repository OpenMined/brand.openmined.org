---
/**
 * BRAND SITE (v2) — the color mode switch in the header: the v2 toggle
 * (components/control.css .switch), on when the page is dark. The click is
 * handled by the .js-switch-theme listener in Site.astro.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<button
  type="button"
  role="switch"
  aria-checked="false"
  aria-label="Dark mode"
  class:list={['switch', 'js-switch-theme', className]}
>
  <span class="switch__knob"></span>
</button>

<script is:inline>
  // Keep aria-checked in sync with the page theme; .switch draws from it.
  // Guarded so multiple toggles share one observer.
  (() => {
    if (window.__omThemeToggleAria) return;
    window.__omThemeToggleAria = true;
    const sync = () => {
      const dark = document.documentElement.getAttribute('data-theme') === 'dark';
      document
        .querySelectorAll('.switch.js-switch-theme')
        .forEach((el) => el.setAttribute('aria-checked', String(dark)));
    };
    new MutationObserver(sync).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
    document.addEventListener('DOMContentLoaded', sync);
    sync();
  })();
</script>
