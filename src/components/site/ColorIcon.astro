---
/**
 * ColorIcon — a set icon in a hue's two-tone gradient, moving in the stroke, with a
 * blurred copy behind as its glow (the working favorite from the Color and interaction round, /rounds/motion/).
 * Needs <TwoToneDefs /> once on the page. Exploring.
 */
import { iconSvg } from '../../lib/icons';
interface Props { name: string; hue: string; size?: number; label?: string }
const { name, hue, size = 32, label } = Astro.props;
const svg = iconSvg(name, { size, label });
const copy = iconSvg(name, { size });
---
<span class="color-icon" data-hue={hue} style={`--ci-stroke:url(#tt-${hue}) var(--${hue}-key)`}><span class="color-icon__glow" aria-hidden="true" set:html={copy} /><Fragment set:html={svg} /></span>
