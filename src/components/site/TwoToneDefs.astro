---
/**
 * TwoToneDefs — the moving two-tone gradients, once per page that shows colored
 * icons (ColorIcon.astro, HoverCard.astro), rendered at build time. The SVG and
 * its reduced-motion pause come from the v2 component (components/two-tone.js),
 * one gradient per palette hue. Exploring (design/foundations/two-tone.md,
 * behaviors/color-moves.md).
 */
import { HUES } from '../../lib/tokens';
import { twoToneDefsSvg } from '../../../components/two-tone.js';
const svg = twoToneDefsSvg(HUES);
---
<Fragment set:html={svg} />
<script>
  import { pauseWithReducedMotion } from '../../../components/two-tone.js';
  pauseWithReducedMotion();
</script>
