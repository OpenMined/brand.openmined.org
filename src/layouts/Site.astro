---
/**
 * BRAND SITE (v2) — the shell every page of the new site uses.
 * Styled with the v2 tokens it documents, and only those: v1's tokens.css isn't
 * loaded (v2 has spacing, motion, stacking, fonts and page width since 2026-10-27).
 * The nav lists only pages that exist (lab PLAN, B: pages are made as each
 * topic is worked). Two headers: the brand guide's (its pages, then Review
 * rounds, v1 reference and the color mode) and, on any page under /rounds/ or
 * /page-reviews/ built on this layout, the review rounds' (every round and page review, from
 * src/lib/rounds.ts, with a way back to the guide).
 */
import '@tokens/v2/tokens.css';
// The v2 components first, then the site's own styles, which lay them out.
import '@components/index.css';
import '../styles/site.css';
import '../styles/card-flow.css';
import ThemeToggle from '../components/site/ThemeToggle.astro';
import { ROUNDS, REVIEW_PAGES, isCurrent } from '../lib/rounds';

interface Props {
  title: string;
  description?: string;
  current?: string;
}
const { title, description = 'OpenMined brand and design system: tokens, guidance and assets.', current } = Astro.props;

/** Pages of the new site, in order. Add one when its page is built. */
const PAGES = [
  { key: 'overview', label: 'Overview', href: '/' },
  { key: 'surfaces', label: 'Surfaces', href: '/surfaces/' },
  { key: 'layout', label: 'Layout', href: '/layout/' },
  { key: 'color', label: 'Color', href: '/color/' },
  { key: 'graphics', label: 'Graphics', href: '/graphics/' },
  { key: 'icons', label: 'Icons', href: '/icons/' },
  { key: 'interface', label: 'Interface', href: '/interface/' },
  { key: 'typography', label: 'Typography', href: '/typography/' },
];
/** Which header: the review rounds' on their pages (rounds and page reviews). */
const path = Astro.url.pathname;
const inRounds = path.startsWith('/rounds/') || path.startsWith('/page-reviews/');
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <script is:inline>
      const stored = localStorage.getItem('theme');
      const system = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.setAttribute('data-theme', stored ?? (system ? 'dark' : 'light'));
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title === 'Overview' ? 'OpenMined Design System' : `${title} · OpenMined Design System`}</title>
    <link rel="icon" type="image/svg+xml" href="/logos/OpenMined-Icon.svg" />
    <!-- Google Fonts scaffold, as v1 — self-host before production -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Rubik:wght@400&display=swap" rel="stylesheet" />
  </head>
  <body class={inRounds ? 'rounds-shell' : 'guide'}>
    <header class="bar">
      <div class="bar__inner">
        {inRounds ? <>
          <a class="bar__title" href="/">← Brand guide</a>
          <nav class="bar__nav bar__nav--reviews" aria-label="Page reviews">
            {REVIEW_PAGES.map((p, i) => <a class:list={[i === 0 ? 'bar__group' : 'bar__link']} href={p.href} aria-current={isCurrent(p.href, path) ? 'page' : undefined}>{p.label}</a>)}
          </nav>
          <nav class="bar__nav bar__nav--rounds" aria-label="Review rounds">
            {ROUNDS.map(p => <a class="bar__link" href={p.href} aria-current={isCurrent(p.href, path) ? 'page' : undefined}>{p.label}</a>)}
          </nav>
        </> : <>
          <a class="bar__title" href="/">OpenMined Design System</a>
          <span class="bar__tag">v2 · in progress</span>
          <nav class="bar__nav" aria-label="Site">
            {PAGES.map(p => <a class="bar__link" href={p.href} aria-current={p.key === current ? 'page' : undefined}>{p.label}</a>)}
            <span class="bar__sep" aria-hidden="true"></span>
            <a class="bar__link" href="/rounds/">Review rounds</a>
            <a class="bar__link" href="/v1/">v1 reference</a>
          </nav>
        </>}
        <ThemeToggle />
      </div>
    </header>

    <!-- Plain links in the guide's text are content links (design/components/link.md). -->
    <main class={inRounds ? undefined : 'content-links'}>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">Values from the v2 token build (<code>tokens/</code>); guidance from <code>design/</code>. Nothing here is released yet.</div>
    </footer>

    <script>
      import { buttonHover } from '@components/button-hover.js';
      import { fieldLights } from '@components/field.js';
      import { hoverCards } from '@components/hover-card.js';
      import { linkCards } from '@components/link-card.js';
      import { cardFlows } from '../scripts/gl/card-flow';
      import { HOVER_FLOWS } from '../scripts/gl/units/hover-flow';
      // The Color and interaction round's own buttons (.mbtn) draw their own layers.
      buttonHover('.btn:not(.mbtn)');
      hoverCards();
      linkCards();
      // Hover cards' colorflow: each card names its unit (HoverCard's `flow`).
      cardFlows(document.querySelectorAll<HTMLElement>('.hcard[data-flow]'), (card) => HOVER_FLOWS[card.dataset.flow ?? ''] ?? null);
      // The round's own fields (.mo-fm) run their own light.
      fieldLights('.ctl:not(.mo-fm .ctl)');
      document.addEventListener('click', (e: MouseEvent) => {
        if ((e.target as HTMLElement).closest('.js-switch-theme')) {
          const html = document.documentElement;
          const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          html.setAttribute('data-theme', next);
          localStorage.setItem('theme', next);
        }
      });
    </script>
  </body>
</html>
