{
  "name": "openmined-brand-reference",
  "type": "module",
  "version": "2.1.1",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "mkdir -p public/tokens && cp src/tokens/*.css src/tokens/*.json public/tokens/",
    "build": "astro build",
    "build:review": "OMDS_DRAFTS=1 astro build",
    "preview": "astro preview",
    "lint": "stylelint \"src/**/*.{css,astro}\" \"components/**/*.css\" && node tools/classes/check.mjs",
    "lint:fix": "stylelint \"src/**/*.{css,astro}\" \"components/**/*.css\" --fix",
    "tokens": "node tools/palette/generate.mjs && node tools/tokens/build.mjs",
    "tokens:check": "node tools/palette/generate.mjs --check && node tools/tokens/build.mjs --check && node tools/contrast/check.mjs",
    "contrast": "node tools/contrast/check.mjs --report",
    "impact": "node tools/impact/impact.mjs",
    "census": "node tools/census/census.mjs",
    "icons:import": "node tools/icons/import.mjs",
    "examples:thumbs": "node tools/examples/thumbs.mjs",
    "logos:import": "node tools/logos/import-org.mjs"
  },
  "dependencies": {
    "@tabler/icons": "3.50.0",
    "astro": "^4.16.0",
    "lucide-static": "1.65.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "postcss-html": "^1.7.0",
    "stylelint": "^16.10.0",
    "stylelint-declaration-strict-value": "^1.10.6"
  }
}
